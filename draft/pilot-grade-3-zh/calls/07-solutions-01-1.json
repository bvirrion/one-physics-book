 "result": "1| \\section*{\u7b2c \\ref{ch:g3:measuring-mass} \u7ae0 --- \u6d4b\u91cf\u8d28\u91cf}\n2|=\n3| \\begin{solution}{exo:g3:measuring-mass:1}\n4| \u7269\u4f53\u6240\u542b\u201c\u4e1c\u897f\u201d\u7684\u591a\u5c11\u3002\u5355\u4f4d\u6709\u514b\u548c\n5| \u5343\u514b\uff0c\u5176\u4e2d $\\qty{1}{kg} = \\qty{1000}{g}$\u3002\n6| \\end{solution}\n7|=\n8| \\begin{solution}{exo:g3:measuring-mass:2}\n9| \u56de\u5f62\u9488\uff1a\\qty{1}{g}\u3002\u82f9\u679c\uff1a\\qty{150}{g}\u3002\u725b\u5976\u76d2\uff1a\n10| \\qty{1}{kg}\u3002\u732b\uff1a\\qty{4}{kg}\u3002\n11| \\end{solution}\n12|=\n13| \\begin{solution}{exo:g3:measuring-mass:3}\n14| $500 + 200 + 200 = 900$\uff1a\u5357\u74dc\u7684\u8d28\u91cf\u662f \\qty{900}{g}\u3002\n15| \\end{solution}\n16|=\n17| \\begin{solution}{exo:g3:measuring-mass:4}\n18| \u5982\u679c\u7a7a\u79e4\u76d8\u5df2\u7ecf\u503e\u659c\uff0c\u6bcf\u6b21\u79f0\u91cf\u90fd\u4f1a\u504f\u5411\u540c\u4e00\u8fb9\u2014\u2014\n19| \u5c31\u50cf\u90a3\u4e2a\u4f5c\u5f0a\u5546\u4eba\u7684\u957f\u80f3\u818a\u3002\u7a7a\u8f7d\u65f6\u4fdd\u6301\u6c34\u5e73\uff0c\n20| \u4fbf\u8bc1\u660e\u4e86\u8d77\u70b9\u516c\u5e73\u3002\n21| \\end{solution}\n22|=\n23| \\begin{solution}{exo:g3:measuring-mass:5}\n24| \u6c99\u6ee9\u7403\u5f88\u5927\uff0c\u4f46\u4e3b\u8981\u662f\u7a7a\u6c14\u2014\u2014\u4e1c\u897f\u5c11\uff0c\u8d28\u91cf\u5c0f\u3002\n25| \u6613\u62c9\u7f50\u5f88\u5c0f\uff0c\u5374\u88c5\u6ee1\u4e86\u4e1c\u897f\u2014\u2014\u8d28\u91cf\u66f4\u5927\uff0c\u6240\u4ee5\u628a\u79e4\u76d8\u538b\u4e0b\u53bb\u3002\n26| \u8d28\u91cf\u8861\u91cf\u7684\u662f\u4e1c\u897f\u7684\u591a\u5c11\uff0c\u800c\u4e0d\u662f\u4f53\u79ef\u5927\u5c0f\u3002\n27| \\end{solution}\n28|=\n29| \\begin{solution}{exo:g3:measuring-mass:6}\n30| $\\qty{2}{kg} = \\qty{2000}{g}$\uff1b\u534a\u5343\u514b\u662f \\qty{500}{g}\uff1b\n31| $\\qty{1200}{g}$ \u591a\u4e8e $\\qty{1}{kg} = \\qty{1000}{g}$\u3002\n32| \\end{solution}\n33|=\n34| \\begin{solution}{exo:g3:measuring-mass:7}\n35| \u4ecd\u7136\u662f \\qty{100}{g}\uff1a\u63b0\u788e\u6539\u53d8\u7684\u662f\u5f62\u72b6\uff0c\u4e0d\u662f\u4e1c\u897f\u7684\u591a\u5c11\u2014\u2014\n36| \u201c\u540c\u6837\u7684\u4e1c\u897f\uff0c\u540c\u6837\u7684\u8d28\u91cf\u201d\uff0c\u6240\u6709\u788e\u5757\u90fd\u653e\u5728\u79e4\u76d8\u4e0a\uff0c\n37| \u4e00\u8d77\u79f0\u91cf\u3002\n38| \\end{solution}\n39|=\n40| \\begin{solution}{exo:g3:measuring-mass:8}\n41| \u53a8\u623f\u79e4\u5185\u90e8\u662f\u4e00\u6839\u88ab\u538b\u7f29\u7684\u5f39\u7c27\uff0c\u7528\u6765\u6bd4\u8f83\uff1b\n42| \u53cc\u76d8\u5929\u5e73\u5219\u662f\u8ba9\u781d\u7801\u4e0e\u7269\u4f53\u5728\u7b49\u81c2\u4e24\u7aef\u6bd4\u8f83\u2014\u2014\n43| \u8fd9\u6b63\u662f\u6760\u6746\u7ae0\u8282\u4e2d\u7684\u6760\u6746\u539f\u7406\u3002\n44| \\end{solution}\n45|=\n46| \\begin{solution}{exo:g3:measuring-mass:9}\n47| \u7b2c\u4e00\u79cd\u65b9\u6cd5\uff1a$500 + 200 + 100 = \\qty{800}{g}$ \u7684\u781d\u7801\u4e0e\u9762\u7c89\u76f8\u5bf9\u3002\n48| \u7b2c\u4e8c\u79cd\u65b9\u6cd5\uff1a\u628a \\qty{100}{g} \u7684\u781d\u7801\\emph{\u548c\u9762\u7c89\u653e\u5728\u4e00\u8d77}\uff0c\n49| \u53e6\u4e00\u8fb9\u662f $500 + 200 + 200 = \\qty{900}{g}$\uff1b\u5929\u5e73\u5e73\u8861\u65f6\uff0c\n50| \u9762\u7c89 $+ \\qty{100}{g}$ \u7b49\u4e8e \\qty{900}{g}\uff0c\u6240\u4ee5\u9762\u7c89\u662f\n51| $900 - 100 = \\qty{800}{g}$\u3002\n52| \\end{solution}\n53|=\n54| \\begin{solution}{exo:g3:measuring-mass:10}\n55| \u8d28\u91cf\u5b88\u6052\u5b9a\u5f8b\u5e76\u6ca1\u6709\u5931\u6548\uff1a\u6ca1\u6709\u4e1c\u897f\u6d88\u5931\uff0c\u53ea\u662f\u88ab\u5206\u5f00\u4e86\u3002\n56| \u7f3a\u5c11\u7684 \\qty{40}{g} \u662f\u679c\u76ae\u3002\n57| \u518d\u79f0\u4e00\u6b21\u5373\u53ef\u8bc1\u660e\uff1a\u679c\u76ae\u5355\u72ec\u79f0\u5e94\u4e3a \\qty{40}{g}\uff0c\u4e14 $160 + 40 =\n58| \\qty{200}{g}$\u3002\n59| \\end{solution}\n60|=\n61| \\begin{solution}{exo:g3:measuring-mass:11}\n62| \u5b83\u4eec\u7684\u8d28\u91cf\\emph{\u76f8\u540c}\u2014\u2014\u5404\u4e3a\u4e00\u5343\u514b\u3002\u7fbd\u6bdb\n63| \u5360\u7684\u7a7a\u95