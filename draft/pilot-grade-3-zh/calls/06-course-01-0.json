 "result": "```\n1| \\chapter{\u8eab\u8fb9\u7684\u58f0\u97f3}\\label{ch:g3:sound-around-us}\n2|=\n3| \u54fc\u4e00\u54fc\u4f60\u6700\u559c\u6b22\u7684\u6b4c \u2014\u2014 \u54fc\u7684\u65f6\u5019\uff0c\u7528\u4e24\u6839\u624b\u6307\u8f7b\u8f7b\n4| \u6309\u4f4f\u5589\u5499\u7684\u524d\u9762\u3002\u611f\u89c9\u5230\u98a4\u52a8\u4e86\u5417\uff1f\u4f60\u521a\u521a\n5| \u5c31\u6478\u5230\u4e86\u58f0\u97f3\u7684\u8bde\u751f\u4e4b\u5904\u3002\u6bcf\u4e00\u79cd\u58f0\u97f3\u3001\u6bcf\u4e00\u9762\u9f13\u3001\n6| \u6bcf\u4e00\u6247\u5431\u5440\u4f5c\u54cd\u7684\u95e8\uff0c\u53d1\u51fa\u58f0\u97f3\u7684\u65b9\u5f0f\u90fd\u5b8c\u5168\u76f8\u540c\uff0c\n7| \u672c\u7ae0\u5c31\u6765\u627e\u51fa\u5176\u4e2d\u7684\u7a8d\u95e8\u3002\n8|=\n9| \\section{\u58f0\u97f3\u4ece\u54ea\u91cc\u6765}\n10|=\n11| \\begin{definition}[\u632f\u52a8]\\label{def:g3:sound-around-us:vibration}\n12| \u79f0\\emph{\u632f\u52a8}\\index{\u632f\u52a8}\u4e3a\u975e\u5e38\u5feb\u901f\u7684\u98a4\u52a8\u2014\u2014\n13| \u5373\u6bcf\u79d2\u5185\u591a\u6b21\u91cd\u590d\u7684\u6765\u56de\u8fd0\u52a8\uff0c\n14| \u5f80\u5f80\u5feb\u5f97\u8ba9\u4eba\u773c\u65e0\u6cd5\u8ddf\u4e0a\u3002\u62e8\u52a8\u7684\u5409\u4ed6\u5f26\u4f1a\u632f\u52a8\uff1a\u4f60\n15| \u53ea\u80fd\u770b\u5230\u4e00\u7247\u6a21\u7cca\uff0c\u4f46\u6307\u5c16\u80fd\u611f\u89c9\u5230\u55e1\u55e1\u7684\u9707\u98a4\u3002\n16| \\end{definition}\n17|=\n18| \\begin{definition}[\u58f0\u97f3]\\label{def:g3:sound-around-us:sound}\n19| \u79f0\\emph{\u58f0\u97f3}\\index{\u58f0\u97f3}\u4e3a\u5f53\u67d0\u4e2a\u7269\u4f53\u632f\u52a8\uff0c\n20| \u5176\u98a4\u52a8\u901a\u8fc7\u7a7a\u6c14\u4f20\u5230\u6211\u4eec\u8033\u4e2d\u65f6\uff0c\u6211\u4eec\u542c\u5230\u7684\u4e1c\u897f\u3002\n21| \u53d1\u51fa\u632f\u52a8\u7684\u7269\u4f53\u662f\u58f0\u97f3\u7684\\emph{\u58f0\u6e90}\u2014\u2014\u4e00\u6839\u5f26\u3001\u4e00\u5f20\u9f13\u9762\u3001\n22| \u4e00\u53ea\u94c3\u94db\uff0c\u6216\u4f60\u81ea\u5df1\u7684\u5589\u5499\u3002\n23| \\end{definition}\n24|=\n25| \\begin{method}[\u8ba9\u7c73\u7c92\u8df3\u821e]\\label{met:g3:sound-around-us:rice}\n26| \u8981\\emph{\u770b\u89c1}\u58f0\u97f3\u662f\u600e\u6837\u4ea7\u751f\u7684\uff1a\n27| \\begin{enumerate}\n28|   \\item \u5728\u9f13\u9762\u4e0a\u6492\u51e0\u7c92\u7c73\uff08\u4e5f\u53ef\u4ee5\u6492\u5728\u94c1\u7f50\u7684\u5851\u6599\u76d6\u4e0a\uff0c\n29|         \u6216\u7ef7\u7d27\u7684\u6c14\u7403\u76ae\u4e0a\uff09\uff1b\n30|   \\item \u6572\u51fb\u7c73\u7c92\u9644\u8fd1\u7684\u9f13\u9762\u2014\u2014\u201c\u549a\u201d\uff01\u7c73\u7c92\u8df3\u8d77\u6765\u4e86\uff01\n31|   \\item \u73b0\u5728\u53ea\u9700\u79bb\u9f13\u9762\u5f88\u8fd1\uff0c\u5bf9\u7740\u5b83\\emph{\u5927\u558a}\uff1a\u7c73\u7c92\n32|         \u53c8\u4f1a\u98a4\u52a8\u8d77\u6765\uff0c\u5373\u4f7f\u6ca1\u6709\u88ab\u78b0\u5230\u3002\n33| \\end{enumerate}\n34| \u53ea\u8981\u9f13\u9762\u53d1\u58f0\uff0c\u5b83\u5c31\u5728\u632f\u52a8\u2014\u2014\u5373\u4f7f\u662f\u4ece\u4f60\u5634\u91cc\u4f20\u6765\u7684\u58f0\u97f3\uff0c\n35| \u4e5f\u4f1a\u4f7f\u5b83\u98a4\u52a8\u3002\n36| \\end{method}\n37|=\n38| \\begin{omfigure}\n39| \\includegraphics[width=0.58\\linewidth]{images/book1/drum.jpg}\n40|=\n41| {\\small \u7c73\u7c92\u5b9e\u9a8c\u7528\u7684\u771f\u9f13\uff1a\u767d\u8272\u7684\u90e8\u5206\u662f\n42| \u4f1a\u98a4\u52a8\u7684\u9f13\u9762\u3002\u5728\u4e0a\u9762\u6492\u51e0\u7c92\u7c73\uff0c\u6572\u51fb\u7c73\u7c92\u9644\u8fd1\u2014\u2014\n43| \u4f1a\u53d1\u58f0\u7684\u9f13\u9762\u5c31\u662f\u4f1a\u98a4\u52a8\u7684\u9f13\u9762\uff0c\u7c73\u7c92\u8df3\u821e\u6b63\u8bf4\u660e\u8fd9\u4e00\u70b9\u3002\n44| \\emph{Photo: Vladimir Morozov, CC BY 2.0.}}\n45| \\end{omfigure}\n46|=\n47| \\begin{proposition}[\u6ca1\u6709\u632f\u52a8\uff0c\u5c31\u6ca1\u6709\u58f0\u97f3]\\label{prop:g3:sound-around-us:novib}\n48| \u6bcf\u4e00\u79cd\u58f0\u97f3\u90fd\u6765\u81ea\u632f\u52a8\u2014\u2014\u632f\u52a8\u4e00\u65e6\u505c\u6b62\uff0c\n49| \u58f0\u97f3\u4e5f\u4f1a\u7acb\u523b\u968f\u4e4b\u505c\u6b62\u3002\u6572\u54cd\u4e00\u53ea\u94d9\u94b9\uff0c\u8ba9\u5b83\u54cd\u7740\uff1b\n50| \u7136\u540e\u7528\u53cc\u624b\u7d27\u7d27\u6293\u4f4f\u5b83\uff1a\u4f60\u7684\u624b\u4e00\u63e1\u4f4f\uff0c\n51| \u98a4\u52a8\u505c\u6b62\uff0c\u7acb\u5373\u5c31\u5b89\u9759\u4e86\u3002\n52| \\end{proposition}\n53|=\n54| \\begin{example}[\u5904\u5904\u90fd\u6709\u58f0\u6e90]\\label{ex:g3:sound-around-us:sources}\n55| \u627e\u4e00\u627e\u6bcf\u79cd\u58f0\u97f3\u80cc\u540e\u7684\u632f\u52a8\uff1a\u5409\u4ed6\u2014\u2014\u62e8\u52a8\u7684\u7434\u5f26\n56| \u5728\u98a4\u52a8\uff1b\u9f13\u2014\u2014\u88ab\u6572\u51fb\u7684\u9f13\u9762\u5728\u98a4\u52a8\uff1b\u4f60\u7684\u58f0\u97f3\u2014\u2014\u4e24\u6839\n57| \u5c0f\u5c0f\u7684\u58f0\u5e26\u5728\u98a4\u52a8\uff0c\u80ba\u91cc\u547c\u51fa\u7684\u6c14\u6d41\u7ecf\u8fc7\u5b83\u4eec\u65f6\uff0c\n58| \u5c31\u662f\u4f60\u624b\u6307\u611f\u89c9\u5230\u7684\u55e1\u55e1\u58f0\uff1b\u55e1\u55e1\u98de\u7684\u82cd\u8747\u2014\u2014\u5b83\u7684\n59| \u7fc5\u8180\u6bcf\u79d2\u98a4\u52a8\u6570\u767e\u6b21\uff1b\u88ab\u7528\u529b\u5173\u4e0a\u7684\u95e8\u2014\u2014\u6574\u6247\u95e8\n60| \u548c\u5b83\u7684\u95e8\u6846\u4f1a\u98a4\u52a8\u4e00\u4f1a\u513f\u3002\n61| \\end{example}\n62|=\n63| \\section{\u5927\u58f0\u4e0e\u5c0f\u58f0\uff0c\u9ad8\u4e0e\u4f4e}\n64|=\n65| \\begin{example}[\u54cd\u4eae\u5c31\u662f\u632f\u52a8\u5e45\u5ea6\u5927]\\label{ex:g3:sound-around-us:loud}\n66| \u8f7b\u8f7b\u62e8\u52a8\u4e00\u6839\u7ef7\u7d27\u7684\u6a61\u76ae\u7b4b\uff1a\u53ea\u770b\u5230\u4e00\u70b9\u70b9\u6a21\u7cca\uff0c\u53d1\u51fa\u8f7b\u8f7b\u7684\u201c\u55e1\u201d\u58f0\u3002\n67| \u7528\u529b\u62e8\u52a8\uff1a\u770b\u5230\u4e00\u5927\u7247\u6a21\u7cca\uff0c\u53d1\u51fa\u54cd\u4eae\u7684\u201c\u55e1\u201d\u58f0\u3002\u58f0\u6e90\u632f\u52a8\u5f97\n68| \u8d8a\u5389\u5bb3\u2014\u2014\u6765\u56de\u6446\u52a8\u7684\u5e45\u5ea6\u8d8a\u5927\u2014\u2014\u58f0\u97f3\u5c31\u8d8a\\emph{\u54cd\u4eae}\u3002\n69| \u7c73\u7c92\u4e5f\u80fd\u8bf4\u660e\u8fd9\u4e00\u70b9\uff1a\u8f7b\u6572\u4e00\u4e0b\uff0c\u7c73\u7c92\u5fae\u5fae\u98a4\u6