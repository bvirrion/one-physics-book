 "result": "\\chapter{\u7535\u8def\u4e0e\u5b89\u5168}\\label{ch:g6:circuits-and-safety}\n=\n\u4e09\u5e74\u6765\uff0c\u4f60\u4e0e\u56de\u8def\u3001\u706f\u6ce1\u548c\u652f\u8def\u6253\u4ea4\u9053\uff0c\u5df2\u7ecf\u6210\u4e3a\u4e00\u540d\u7535\u8def\u642d\u5efa\u8005\u3002\u4eca\u5e74\u4f60\u8981\u6210\u4e3a\u66f4\u7a00\u7f55\u7684\u89d2\u8272\uff1a\u7535\u8def\u7684\\emph{\u4e66\u5199\u8005}\\index{\u4e66\u5199\u8005}\u3002\n\u5404\u56fd\u7684\u7535\u5de5\u90fd\u8bfb\u5199\u540c\u4e00\u79cd\u65e0\u5b57\u7684\u8bed\u8a00\u2014\u2014\u800c\u5b83\u7684\u8bed\u6cd5\uff0c\u52a0\u4e0a\u4e00\u7ae0\u6765\u4e4b\u4e0d\u6613\u7684\u5b89\u5168\u77e5\u8bc6\uff0c\u6b63\u662f\u7075\u5de7\u7684\u63a5\u7ebf\u4e0e\u70e7\u4f24\u624b\u6307\u4e4b\u95f4\u7684\u754c\u7ebf\u3002\n=\n\n\\section{\u65e0\u5b57\u7684\u8bed\u8a00}\n=\n\\begin{definition}[\u7535\u8def\u56fe]\\label{def:g6:circuits-and-safety:diagram}\n\\emph{\u7535\u8def\u56fe}\\index{\u7535\u8def\u56fe}\u662f\u7535\u8def\u7684\u6807\u51c6\u753b\u6cd5\uff1a\u6bcf\u4e2a\u5668\u4ef6\u7528\u7ea6\u5b9a\u7684\\emph{\u7b26\u53f7}\\index{\u7b26\u53f7}\u8868\u793a\uff0c\u5bfc\u7ebf\u5219\u753b\u6210\u5e26\u76f4\u89d2\u7684\u76f4\u7ebf\u3002\u7535\u8def\u56fe\u8868\u660e\u7535\u8def\u5982\u4f55\\emph{\u8fde\u63a5}\u2014\u2014\u8c01\u7ed9\u8c01\u4f9b\u7535\uff0c\u54ea\u91cc\u5206\u53c9\u2014\u2014\u800c\u6709\u610f\u5ffd\u7565\u5b9e\u9645\u5bfc\u7ebf\u5728\u684c\u9762\u4e0a\u5982\u4f55\u873f\u8712\u3002\n\\end{definition}\n=\n\\begin{omfigure}\n=\n\\begin{tikzpicture}[scale=0.8]\n=\n  \\draw (0.4,3.4) to[battery1] (2.4,3.4);\n=\n  \\node[right, font=\\small] at (2.7,3.4)\n=\n    {\u7535\u6c60\uff08\u957f\u7ebf\u4e3a $+$ \u6781\uff09};\n=\n  \\draw (0.4,2.2) to[lamp] (2.4,2.2);\n=\n  \\node[right, font=\\small] at (2.7,2.2) {\u706f\u6ce1};\n=\n  \\draw (0.4,1.0) to[spst] (2.4,1.0);\n=\n  \\node[right, font=\\small] at (2.7,1.0) {\u5f00\u5173\uff0c\u65ad\u5f00};\n=\n  \\draw (7.4,3.4) to[cspst] (9.4,3.4);\n=\n  \\node[right, font=\\small] at (9.7,3.4) {\u5f00\u5173\uff0c\u95ed\u5408};\n=\n  \\draw (7.4,2.2) -- (8.05,2.2);\n=\n  \\draw[thick] (8.4,2.2) circle (0.35);\n=\n  \\node[font=\\small] at (8.4,2.2) {M};\n=\n  \\draw (8.75,2.2) -- (9.4,2.2);\n=\n  \\node[right, font=\\small] at (9.7,2.2) {\u7535\u52a8\u673a};\n=\n  \\draw (7.4,1.0) -- (8.05,1.0);\n=\n  \\draw[thick] (8.4,1.0) circle (0.35);\n=\n  \\draw[thick] (8.16,0.76) -- (8.64,1.24);\n=\n  \\draw (8.75,1.0) -- (9.4,1.0);\n=\n  \\node[right, font=\\small] at (9.7,1.0) {\u8702\u9e23\u5668};\n=\n\\end{tikzpicture}\n=\n=\n{\\small \u7b26\u53f7\u8868\uff1a\u672c\u4e66\u4e2d\u7684\u516d\u4e2a\u7b26\u53f7\u51e0\u4e4e\u53ef\u4ee5\u753b\u51fa\u6240\u6709\u7535\u8def\u3002\u4e16\u754c\u5404\u5730\u7684\u5de5\u4f5c\u95f4\u8bfb\u5230\u7684\u90fd\u662f\u540c\u6837\u7684\u8bb0\u53f7\u3002}\n=\n\\end{omfigure}\n=\n=\n\\begin{method}[\u4ece\u5b9e\u7269\u5230\u56fe\u7eb8\uff0c\u518d\u4ece\u56fe\u7eb8\u5230\u5b9e\u7269]\\label{met:g6:circuits-and-safety:translate}\n=\n\u8981\\emph{\u753b\u51fa}\u4e00\u4e2a\u5df2\u642d\u597d\u7684\u7535\u8def\uff1a\n=\n\\begin{enumerate}\n=\n  \\item \u5217\u51fa\u5668\u4ef6\uff0c\u5e76\u9009\u5b9a\u6bcf\u4e2a\u5668\u4ef6\u7684\u7b26\u53f7\uff1b\n=\n  \\item \u7528\u624b\u6307\u4ece\u7535\u6c60\u7684 $+$ \u6781\u6cbf\u5b9e\u9645\u56de\u8def\u8d70\u4e00\u904d\uff0c\u8bb0\u4e0b\u5668\u4ef6\u7684\u987a\u5e8f\u548c\u6bcf\u4e00\u5904\u5206\u53c9\uff1b\n=\n        \n=\n  \\item \u91cd\u753b\u6210\u6574\u9f50\u7684\u77e9\u5f62\uff1a\u7b26\u53f7\u6392\u5e03\u5747\u5300\uff0c\u5bfc\u7ebf\u7b14\u76f4\uff0c\u62d0\u89d2\u4e3a\u76f4\u89d2\u2014\u2014\u8fde\u63a5\u5173\u7cfb\u4e0d\u53d8\uff0c\u4e0d\u7559\u873f\u8712\u7684\u7ebf\u3002\n=\n\\end{enumerate}\n=\n\u8981\u6839\u636e\u7535\u8def\u56fe\\emph{\u642d\u5efa}\uff0c\u5219\u628a\u4e0a\u8ff0\u8fc7\u7a0b\u5012\u8fc7\u6765\u505a\u2014\u2014\n=\n\u4e4b\u540e\u7167\u4f8b\u68c0\u67e5\uff1a\u4ece $+$ \u6781\u51fa\u53d1\u7684\u6bcf\u6761\u56de\u8def\u90fd\u5fc5\u987b\u7ecf\u8fc7\u81f3\u5c11\u4e00\u4e2a\u5668\u4ef6\u56de\u5230 $-$ \u6781\u3002\n=\n\\end{method}\n=\n=\n\\begin{example}[\u540c\u4e00\u7535\u8def\uff0c\u4e24\u79cd\u753b\u50cf]\\label{ex:g6:circuits-and-safety:portraits}\n=\n\u684c\u4e0a\u6709\uff1a\u4e00\u8282\u7535\u6c60\u3001\u4e00\u56e2\u7ed5\u5728\u94c5\u7b14\u76d2\u4e0a\u7684\u9cc4\u9c7c\u5939\u5bfc\u7ebf\u3001\u4e00\u53ea\u9760\u5728\u4e66\u4e0a\u7684\u706f\u6ce1\uff0c\u4ee5\u53ca\u4e00\u4e2a\u60ac\u5782\u7740\u7684\u5f00\u5173\u3002\n=\n\u7eb8\u4e0a\u5219\u662f\u4e00\u4e2a\u5e73\u6574\u7684\u77e9\u5f62\u2014\u2014\u7535\u6c60\u5728\u5de6\uff0c\u5f00\u5173\u5728\u4e0a\uff0c\u706f\u6ce1\u5728\u53f3\u3002\u6742\u4e71\u7684\u5bfc\u7ebf\u4e0e\u6574\u9f50\u7684\u77e9\u5f62\u662f\\emph{\u540c\u4e00\u4e2a\u7535\u8def}\uff1a\u6bcf\u4e00\u5904\u8fde\u63a5\u90fd\u76f8\u540c\u3002\u8981\u5224\u65ad\u4e24\u4e2a\u7535\u8def\u662f\u5426\u76f8\u540c\uff0c\u53ea\u9700\u95ee\u4e00\u4e2a\u95ee\u9898\uff1a\u8c01\u4e0e\u8c01\u76f8\u8fde\uff1f\n=\n\\end{example}\n=\n=\n\\begin{example}[\u7535\u52a8\u673a\u4e0e\u8702\u9e23\u5668\u52a0\u5165\u6e38\u620f]\\label{ex:g6:circuits-and-safety:motor}\n=\n\u4f60\u7684\u5957\u4ef6\u91cc\u65b0\u589e\u4e86\u4e24\u79cd\u5668\u4ef6\uff0c\u5b83\u4eec\u5728\u7535\u8def\u56fe\u4e2d\u7684\u8868\u73b0\u4e0e\u706f\u6ce1\u4e00\u6837\uff1a\u53ea\u8981\u6709\u7535\u6d41\u901a\u8fc7\uff0c\\emph{\u7535\u52a8\u673a}\\index{\u7535\u52a8\u673a}\uff08\u5706\u5708\u4e2d\u7684 M \u7b26\u53f7\uff09\u5c31\u4f1a\u8f6c\u52a8\u2014\u2014\u98ce\u6247\u3001\u73a9\u5177\u8f66\u3001\u7535\u94bb\u90fd\u662f\u4f8b\u5b50\uff1b\u53ea\u8981\u63a5\u901a\u7535\u6e90\uff0c\\emph{\u8702\u9e23\u5668}\\index{\u8702\u9e23\u5668}\uff08\u753b\u6709\u4e00\u9053\u659c\u7ebf\u7684\u5706\u5708\uff09\u5c31\u4f1a\u53d1\u58f0\u2014\u2014\u95e8\u94c3\u3001\u8b66\u62a5\u5668\u90fd\u662f\u4f8b\u5b50\u3002\u4e32\u8054\u4e0e\u5e76\u8054\u7684\u89c4\u5219\u5bf9\u5b83\u4eec\u540c\u6837\u9002\u7528\uff1a\u4e0e\u5176\u4e32\u8054\u7684\u5f00\u5173\u63a7\u5236\u5b83\u4eec\uff1b\u5e76\u8054\u7684\u652f\u8def\u5219\u4f7f\u5b83\u4eec\u5f7c\u6b64\u72ec\u7acb\u3002\n=\n\\end{example}\n=\n=\n\\section{\u65e7\u89c4\u5219\uff0c\u65b0\u8bed\u8a00}\n=\n=\n\\begin{example}[\u50cf\u884c\u5bb6\u4e00\u6837\u8bfb\u7535\u8def\u56fe]\\label{ex:g6:circuits-and-safety:reading}\n=\n\u5bf9\u4efb\u610f\u4e00\u5f20\u7535\u8def\u56fe\uff0c\u7528\u5e76\u8054\u7535\u8def\u4e00\u7ae0\u4e2d\u7684\u624b\u6307\u8d70\u7ebf\u6cd5\u68c0\u67e5\uff1a\u4ece $+$ \u6781\u51fa\u53d1\uff0c\u8d70\u904d\u6bcf\u4e00\u6761\u901a\u5411 $-$ \u6781\u7684\u8def\u5f84\u3002\u6240\u6709\u5668\u4ef6\u90fd\u5728\u540c\u4e00\u6761\u8def\u5f84\u4e0a\uff1a\u4e3a\u4e32\u8054\u2014\u2014\u4efb\u4e00\u5904\u65ad\u5f00\u5373\u5168\u90e8\u505c\u6b62\uff0c\u5668\u4ef6\u987a\u5e8f\u65e0\u5173\uff0c\u4eae\u5ea6\u76f8\u540c\u5206\u62c5\u3002\u8def\u5f84\u5728\u8282\u70b9\u5904\u5206\u53c9\uff1a\u4e3a\u5e76\u8054\u2014\u2014\u5404\u652f\u8def\u4e92\u4e0d\u5f71\u54cd\uff0c\u6bcf\u6761\u652f\u8def\u90fd\u6709\u5168\u90e8\u4eae\u5ea6\uff0c\u5f00\u5173\u7684\u4f4d\u7f6e\u6b64\u65f6\u6210\u4e3a\u4e00\u4e2a\u771f\u6b63\u7684\u51b3\u5b9a\u3002\u8bed\u8a00\u53d8\u4e86\uff0c\u89c4\u5f8b\u6ca1\u6709\u53d8\u3002\n=\n\\end{example}\n=\n=\n\\begin{omfigure}\n=\n\\begin{tikzpicture}[scale=0.8]\n=\n  \\draw (0,0) to[battery1] (0,3.2)\n=\n    to[cspst] (2.6,3.2);\n=\n  \\draw (2.6,3.2) to[short] (2.6,2.4)\n=\n    to[lamp] (5.8,2.4) to[short] (5.8,3.2);\n=\n  \\draw (2.6,3.2) to[short] (2.6,4.0) -- (3.4,4.0);\n=\n  \\draw[thick] (3.75,4.0) circle (0.35);\n=\n  \\node[font=\\small] at (3.75,4.0) {M};\n=\n  \\draw (4.1,4.0) -- (5.8,4.0) to[short] (5.8,3.2);\n=\n  \\draw (5.8,3.2) to[short] (7.4,3.2) to[short] (7.4,0)\n=\n    to[short] (0,0);\n=\n  \\fill (2.6,3.2) circle (2pt);\n=\n  \\fill (5.8,3.2) circle (2pt);\n=\n\\end{tikzpicture}\n=\n=\n{\\small \u5148\u8bfb\u56fe\u518d\u63a5\u7ebf\uff1a\u516c\u5171\u8def\u5f84\u4e0a\u6709\u4e00\u4e2a\u5f00\u5173\uff0c\u7136\u540e\u5206\u53c9\u2014\u2014\u4e00\u6761\u652f\u8def\u63a5