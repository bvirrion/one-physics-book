 "result": "1| \\chapter{\u4e07\u6709\u5f15\u529b\u4e0e\u91cd\u529b}\\label{ch:g10:universal-gravitation}\n2|=\n3| \u677e\u624b\u653e\u5f00\u4e00\u53ea\u82f9\u679c\uff0c\u5b83\u4fbf\u4e0b\u843d\u3002\u6708\u7403\u8ddd\u5730\u5fc3\u516d\u5341\u4e2a\u5730\u7403\u534a\u5f84\u4e4b\u9065\uff0c\u5374\u4f3c\u4e4e\u4ece\u4e0d\u4e0b\u843d\u3002\n4| \u725b\u987f\u7684\u4f1f\u5927\u6d1e\u89c1\u5728\u4e8e\uff0c\u6708\u7403\\emph{\u786e\u5b9e}\u5728\u4e0b\u843d\u2014\u2014\n5| \u6bcf\u79d2\u7ea6 1.4 \u6beb\u7c73\uff0c\u6070\u7b49\u4e8e\n6| \u5f15\u529b\u968f\u8ddd\u79bb\u5e73\u65b9\u51cf\u5f31\u6240\u9884\u8a00\u7684\u91cf\u3002\u4e00\u4e2a\u516c\u5f0f\uff0c\u914d\u4ee5\u4e00\u4e2a\n7| \u666e\u9002\u5e38\u91cf\uff0c\u652f\u914d\u7740\u82f9\u679c\u3001\u6708\u7403\u3001\u6f6e\u6c50\u4e0e\u884c\u661f\u3002\n8| \u7b2c\u4e00\u5206\u518c\u4ee5\u6587\u5b57\u63cf\u8ff0\u4e86\u5f15\u529b\uff1b\n9| \u672c\u7ae0\u5219\u8981\u6d4b\u91cf\u5b83\u3002\n10|=\n11| \\section{\u4e07\u6709\u5f15\u529b\u5b9a\u5f8b}\n12|=\n13| \\begin{definition}[\u4e07\u6709\u5f15\u529b]\\label{def:g10:universal-gravitation:force}\n14| \u4efb\u610f\u4e24\u4e2a\u7269\u4f53\u90fd\u76f8\u4e92\u5438\u5f15\uff0c\u65e0\u8bba\u5b83\u4eec\u7531\u4f55\u79cd\u7269\u8d28\u6784\u6210\uff0c\n15| \u4e5f\u65e0\u8bba\u5b83\u4eec\u76f8\u8ddd\u591a\u8fdc\u3002\u8fd9\u79cd\u5438\u5f15\u79f0\u4e3a\\emph{\u4e07\u6709\u5f15\u529b\n16| }\\index{\u4e07\u6709\u5f15\u529b}\uff0c\u800c\u8fd9\u4e00\u73b0\u8c61\u79f0\u4e3a\n17| \\emph{\u4e07\u6709\u5f15\u529b}\\index{\u4e07\u6709\u5f15\u529b}\u3002\u5b83\u65e0\u9700\u63a5\u89e6\u3001\u7ef3\u7d22\uff0c\n18| \u4e5f\u65e0\u9700\u4ecb\u8d28\uff0c\u5e76\u4e14\u5b83\u662f\\emph{\u76f8\u4e92\u7684}\uff1a\u6bcf\u4e2a\u7269\u4f53\u90fd\u62c9\u52a8\u5bf9\u65b9\u3002\n19| \\end{definition}\n20|=\n21| \\begin{theorem}[\u4e07\u6709\u5f15\u529b\u5b9a\u5f8b]\\label{thm:g10:universal-gravitation:law}\n22| \u8d28\u91cf\u5206\u522b\u4e3a $m_1$ \u548c $m_2$\uff08\u5355\u4f4d\u4e3a \\unit{kg}\uff09\u7684\u4e24\u4