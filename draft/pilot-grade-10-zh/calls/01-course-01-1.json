10^{9}$ \\\\\n46|\u6beb & m & $10^{-3}$  & \u592a & T & $10^{12}$ \\\\\n47|=\n48|=\n49|\u7531\u6b64\u53ef\u5f97 $\\qty{1}{nm} = \\qty{e-9}{m}$ \u4ee5\u53ca $\\qty{1}{km} = \\qty{e3}{m}$\u3002\n50|=\n51|=\n52|\\begin{example}[\u8bfb\u61c2\u8bcd\u5934]\\label{ex:g10:orders-of-magnitude:prefixes}\n53|\u7eff\u5149\u7684\u6ce2\u957f\u7ea6\u4e3a $\\qty{500}{nm} = \\qty{5.00e-7}{m}$\uff1b\u4eba\u7684\u5934\u53d1\n54|\u7c97\u7ec6\u7ea6\u4e3a $\\qty{70}{\\micro m} = \\qty{7.0e-5}{m}$\uff1b\u6708\u7403\u7ed5\u5730\u7403\n55|\u8fd0\u884c\u7684\u8ddd\u79bb\u7ea6\u4e3a $\\qty{384}{Mm} = \\qty{3.84e8}{m}$\u3002\u4e00\u6ef4\u96e8\u6ef4\n56|\u7684\u8d28\u91cf\u7ea6\u4e3a $\\qty{30}{mg} = \\qty{3.0e-5}{kg}$\u2014\u2014\u8bf7\u6ce8\u610f\uff0c\u56fd\u9645\u5355\u4f4d\u5236\u7684\n57|\u8d28\u91cf\u57fa\u672c\u5355\u4f4d\u662f\u4e03\u4e2a\u57fa\u672c\u5355\u4f4d\u4e2d\u552f\u4e00\u81ea\u5e26\u8bcd\u5934\u7684\u90a3\u4e00\u4e2a\u3002\n58|=\n59|=\n60|\\section{\u79d1\u5b66\u8bb0\u6570\u6cd5\u4e0e\u6709\u6548\u6570\u5b57}\n61|=\n62|\\begin{definition}[\u79d1\u5b66\u8bb0\u6570\u6cd5]\\label{def:g10:orders-of-magnitude:scinot}\n63|\u4e00\u4e2a\u6570\u82e5\u5199\u6210\\emph{\u79d1\u5b66\u8bb0\u6570\u6cd5}\\index{\u79d1\u5b66\u8bb0\u6570\u6cd5}\u5f62\u5f0f\uff0c\n64|\u5219\u53ef\u5199\u4f5c\uff1a\n65|=\n66|a \\times 10^{n}, \\qquad 1 \\leq a < 10, \\quad n \\text{ \u4e3a\u6574\u6570.}\n67|=\n68|\u56e0\u5b50 $a$ \u79f0\u4e3a\\emph{\u5c3e\u6570}\\index{\u5c3e\u6570}\uff0c\u6574\u6570\n69|$n$ \u79f0\u4e3a\\emph{\u6307\u6570}\\index{\u6307\u6570}\u3002\n70|\u7531\u6b64\u53ef\u5f97 $\\num{149600000} = \\num{1.496e8}$ \u4e0e\n71|$\\num{0.00052} = \\num{5.2e-4}$\u3002\n72|=\n73|=\n74|\\begin{proposition}[\u5341\u7684\u5e42\u7684\u8fd0\u7b97]\\label{prop:g10:orders-of-magnitude:powers}\n75|\u5bf9\u6240\u6709\u6574\u6570 $m$ \u4e0e $n$\uff1a\n76|=\n77|=\n78|=\n79|=\n80|=\n81|=\n82|=\n83|\\begin{proof}[\u90e8\u5206\u8bc1\u660e]\n84|\u5bf9\u6b63\u6307\u6570\uff0c\u6570\u4e00\u6570\u56e0\u5b50\u4e2a\u657