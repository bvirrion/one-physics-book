{"sha": "e15132384a02f3ec51d61fd0fa7f48f36b26cee0d2b350ddb0b12bf405110e98", "body": ["\\section*{第 \\ref{ch:g10:pressure} 章 --- 压强：从运动到潜水}", "", "\\begin{solution}{exo:g10:pressure:1}", "大接触面：$S = \\qty{0.15}{m^2}$，$P = 600/0.15 = \\qty{4.0}{kPa}$。", "小接触面：$S = \\qty{0.060}{m^2}$，$P = \\qty{10}{kPa}$。在沙地上，", "大接触面压强更小，下陷更少。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:2}", "$\\qty{0.25}{MPa} = \\qty{250}{kPa} = \\qty{2.5e5}{Pa}$.", "$3.0/\\num{2.0e-4} = \\qty{15}{kPa}$ 超过", "$60/0.050 = \\qty{1.2}{kPa}$：较小的力压强更大。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:3}", "$\\rho g h = 1000 \\times 9.81 \\times 3.0 \\approx \\qty{29}{kPa}$;", "绝对压强 $P = 101 + 29 = \\qty{130}{kPa}$。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:4}", "$V_2 = 100 \\times 4.0 / 250 = \\qty{1.6}{L}$;", "在 \\qty{50}{kPa} 下，$V_2 = 400/50 = \\qty{8.0}{L}$。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:5}", "$F = 65 \\times 9.81 \\approx \\qty{638}{N}$。刀刃：", "$638/\\num{1.2e-3} \\approx \\qty{5.3e5}{Pa} = \\qty{530}{kPa}$。鞋底：", "$638/0.036 \\approx \\qty{18}{kPa}$。比值 $\\approx 30$：刀刃", "切入冰中，鞋底则不会。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:6}", "拇指：$20/\\num{1.2e-4} \\approx \\qty{1.7e5}{Pa} = \\qty{170}{kPa}$。", "墙面：$20/\\num{1.0e-8} = \\qty{2.0e9}{Pa}$。同样的 \\qty{20}{N} 力作用于", "尖端处的面积小 $12\\,000$ 倍，因此只有在那里", "压强才超过材料所能承受的限度。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:7}", "$\\Delta P = \\rho g h = 1025 \\times 9.81 \\times 30 \\approx", "\\qty{3.0e5}{Pa}$，因此", "$F = \\num{3.0e5} \\times 0.50 \\approx \\qty{1.5e5}{N}$ --- 相当于", "质量为 $F/g \\approx \\qty{1.5e4}{kg}$（十五吨）的物体所受的重力。", "没有船员能逆着海水把舱门向外推开。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:8}", "$\\rho = \\dfrac{P}{g h} = \\dfrac{\\num{66.2e3}}{9.81 \\times 5.00}", "\\approx \\qty{1350}{kg/m^3}$。不是淡水（$\\qty{1000}{kg/m^3}$）：", "密度明显更大的液体，例如浓盐水。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:9}", "$h = P_0/(\\rho g)$：水", "$\\num{1.01e5}/9810 \\approx \\qty{10.3}{m}$；水银", "$\\num{1.01e5}/(13600 \\times 9.81) \\approx \\qty{0.76}{m}$。一根", "\\qty{76}{cm} 的管子放在书桌上即可，而 \\qty{10}{m} 的水气压计", "需要一个楼梯间——水银的密度占了上风。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:10}", "$V = 6000/240 = \\qty{25}{mL}$; $P = 6000/75 = \\qty{80}{kPa}$.", "$P$ 与 $V$ 的关系是双曲线；$P$ 与 $1/V$ 的关系是", "过原点的直线，斜率为 \\qty{6000}{kPa.mL}。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:11}", "在 \\qty{20}{m} 深处：$P = 101 + 2 \\times 101 = \\qty{303}{kPa}$，三", "个大气压。在水面处，", "$V = 0.50 \\times 303/101 = \\qty{1.5}{cm^3}$：气泡体积变为原来的三倍。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:12}", "\\emph{1.} $F = \\num{1.01e5} \\times \\num{1.2e-3} \\approx \\qty{121}{N}$,", "可托住质量 $m = 121/9.81 \\approx \\qty{12}{kg}$ 的物体。", "", "\\emph{2.} $\\Delta P = 101 - 20 = \\qty{81}{kPa}$:", "$F = \\num{8.1e4} \\times \\num{1.2e-3} \\approx \\qty{97}{N}$，", "约能托住 \\qty{9.9}{kg} 的物体。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:13}", "玻意耳：$12 \\times (200 - 50) = \\qty{1800}{L}$ 地面压强下的空气可用。", "在 \\qty{30}{m} 深处，每次吸气的压强为 \\qty{4}{bar}，因此", "环境压强下 \\qty{15}{L/min} 的用气量，", "折合地面空气 $15 \\times 4 = \\qty{60}{L/min}$：$1800/60 =", "\\qty{30}{min}$。在 \\qty{10}{m} 深处（$\\qty{2}{bar}$）：", "\\qty{30}{L/min}，故可用 \\qty{60}{min}。深度要用空气来付出代价。", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:14}", "$P = P_0 \\dfrac{V_0}{V} = 101 \\times \\dfrac{6.0}{1.5} =", "\\qty{404}{kPa}$。取 $\\rho g \\approx \\qty{10.1}{kPa/m}$，", "$h = (404 - 101)/10.1 \\approx \\qty{30}{m}$.", "\\end{solution}", "", "\\begin{solution}{exo:g10:pressure:15}", "\\emph{1.} 重力 $F = 1200 \\times 9.81 \\approx \\qty{1.18e4}{N}$；", "压强 $P = F/S = \\num{1.18e4}/0.040 \\approx \\qty{2.9e5}{Pa}$；小", "活塞：$f = P s = \\num{2.9e5} \\times \\num{2.0e-4} \\approx \\qty{59}{N}$", "——力被除以 $S/s = 200$。", "", "\\emph{2.} 液体体积守恒：", "$400 \\times 2.0 = \\qty{800}{cm^3}$ 必须来自小圆筒，", "其行程为 $800/2.0 = \\qty{400}{cm} = \\qty{4.0}{m}$。功：", "一侧为 $59 \\times 4.0 \\approx \\qty{235}{J}$，", "另一侧为 $\\num{1.18e4} \\times 0.020 \\approx \\qty{235}{J}$——", "升降机用距离换取力，而功不变。", "\\end{solution}", ""]}