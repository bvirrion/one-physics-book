 "result": "\\section*{\u7b2c \\ref{ch:g1:five-senses} \u7ae0 --- \u89c2\u5bdf\u4e16\u754c\uff1a\u4e94\u79cd\u611f\u5b98}\n=\n\\begin{solution}{exo:g1:five-senses:1}\n=\n\u89c6\u89c9 --- \u773c\u775b\uff1b\u542c\u89c9 --- \u8033\u6735\uff1b\u89e6\u89c9 --- \u76ae\u80a4\uff1b\u55c5\u89c9 --- \u9f3b\u5b50\uff1b\n\u5473\u89c9 --- \u820c\u5934\u3002\n\\end{solution}\n=\n\\begin{solution}{exo:g1:five-senses:2}\n(a) \u542c\u89c9\u3002(b) \u5473\u89c9\u3002(c) \u89e6\u89c9\u3002(d) \u89c6\u89c9\u3002\n\\end{solution}\n=\n\\begin{solution}{exo:g1:five-senses:3}\n\u95fb\u5230\u9999\u5473\u6700\u5148\u627e\u5230\u86cb\u7cd5\u2014\u2014\u9999\u5473\u4ece\u95e8\u7f1d\u4e0b\u9762\u98d8\u4e86\u8fdb\u6765\u3002\n\u5403\u8fd9\u5757\u86cb\u7cd5\u8981\u7528\u5230\u89c6\u89c9\u3001\u89e6\u89c9\u3001\u55c5\u89c9\u548c\u5473\u89c9\uff0c\u5982\u679c\u5916\u76ae\u53d1\u51fa\u5494\u5693\u58f0\uff0c\u8fd8\u4f1a\u7528\u5230\u542c\u89c9\u3002\n\\end{solution}\n=\n\\begin{solution}{exo:g1:five-senses:4}\n\u7b54\u6848\u4e0d\u4e00\uff1b\u5927\u591a\u6570\u5c0f\u670b\u53cb\u80fd\u6570\u51fa $4$ \u6216 $5$ \u79cd\u58f0\u97f3\uff0c\u800c\u6700\u8ba9\u4eba\u60ca\u8bb6\u7684\uff0c\n\u5f80\u5f80\u662f\u4e00\u4e9b\u5f88\u5b89\u9759\u7684\u58f0\u97f3\u2014\u2014\u51b0\u7bb1\u7684\u55e1\u55e1\u58f0\uff0c\u6216\u8005\u81ea\u5df1\u7684\u547c\u5438\u58f0\u3002\n\\end{solution}\n=\n\\begin{solution}{exo:g1:five-senses:5}\n\u4f8b\u5982\uff1a\u201c\u6211\u7684\u978b\u5b50\u662f\u84dd\u8272\u7684\uff0c\u6a61\u80f6\u505a\u7684\uff0c\u6bd4\u6211\u7684\u624b\u8fd8\u957f\u3002\u201d\n\u4efb\u4f55\u4e09\u4e2a\u51c6\u786e\u7684\u8bcd\uff0c\u53ea\u8981\u670b\u53cb\u80fd\u591f\u6838\u5bf9\uff0c\u90fd\u662f\u6b63\u786e\u7684\u3002\n\\end{solution}\n=\n\\begin{solution}{exo:g1:five-senses:6}\n\u5b89\u5a1c\u7684\u53e5\u5b50\u662f\u89c2\u5bdf\u7ed3\u679c\uff0c\u9760\u89e6\u89c9\u5f97\u5230\u3002\u9c8d\u52c3\u7684\u53e5\u5b50\u662f\u770b\u6cd5\uff1a\n\u201c\u6700\u597d\u201d\u8fd9\u4e2a\u8bcd\uff0c\u65e0\u8bba\u7528\u770b\u8fd8\u662f\u7528\u6478\uff0c\u90fd\u6ca1\u6cd5\u6838\u5bf9\u3002\n\\end{solution}\n=\n\\begin{solution}{exo:g1:five-senses:7}\n(a) \u55c5\u89c9\u3002(b) \u89e6\u89c9\u2014\u2014\u5373\u4f7f\u79bb\u5f97\u4e0d\u8fd1\uff0c\u76ae\u80a4\u4e5f\u80fd\u611f\u89c9\u5230\u70ed\u91cf\u3002(c) \u542c\u89c9\u3002\n\\end{solution}\n=\n\\begin{solution}{exo:g1:five-senses:8}\n\u53ea\u7528\u89e6\u89c9\u5c31\u80fd\u8f7b\u677e\u8fa8\u8ba4\u8fd9\u4e09\u6837\u4e1c\u897f\uff1a\u91d1\u5c5e\u52fa\u5b50\uff08\u786c\u3001\u51c9\u3001\u5149\u6ed1\uff09\uff0c\n\u6d77\u7ef5\uff08\u8f6f\u3001\u8f7b\uff09\uff0c\u9e45\u5375\u77f3\uff08\u786c\u3001\u91cd\u3001\u5706\uff09\u3002\n\u52fa\u5b50\u901a\u5e38\u6700\u5bb9\u6613\u8fa8\u8ba4\u2014\u2014\u51b0\u51c9\u7684\u91d1\u5c5e\u5f88\u96be\u88ab\u8bef\u8ba4\u3002\n\\end{solution}\n=\n\\begin{solution}{exo:g1:five-senses:9}\n\u628a\u4e00\u6839\u7ec6\u7ef3\u6cbf\u7740\u7b2c\u4e00\u6761\u7ebf\u6446\u597d\uff0c\u526a\u6389\u6216\u634f\u4f4f\uff0c\u4f7f\u5176\u957f\u5ea6\u4e0e\u4e4b\u76f8\u540c\uff0c\n\u7136\u540e\u628a\u5b83\u6cbf\u7b2c\u4e8c\u6761\u7ebf\u6446\u653e\uff1a\u7ec6\u7ef3\u65e0\u9700\u773c\u775b\u5224\u65ad\uff0c\u5c31\u80fd\u6bd4\u8f83\u4e24\u6761\u7ebf\u7684\u957f\u77ed\u3002\n\u540c\u4e00\u6839\u7ec6\u7ef3\u8fd8\u53ef\u4ee5\u6cbf\u5f2f\u66f2\u7684\u7ebf\u6446\u653e\uff0c\u7136\u540e\u62c9\u76f4\u2014\u2014\u56e0\u6b64\u8fd9\u79cd\u65b9\u6cd5\u751a\u81f3\u80fd\u6bd4\u8f83\n\u66f2\u7ebf\u4e0e\u76f4\u7ebf\u3002\n\\end{solution}\n=",
