 "result": "1| \\chapter{\u72ed\u4e49\u76f8\u5bf9\u8bba\uff1a\u65f6\u95f4\u5ef6\u7f13}\\label{ch:g12:special-relativity}\n2|=\n3| \u6bcf\u9897 GPS \u536b\u661f\u90fd\u643a\u5e26\u4e00\u53f0\u539f\u5b50\u949f\uff0c\u5176\u7cbe\u5ea6\u53ef\u8fbe\n4| \u4e09\u767e\u4e07\u5e74\u4ec5\u5dee\u4e00\u79d2\u2014\u2014\u4f46\u53d1\u5c04\u524d\uff0c\u5de5\u7a0b\u5e08\u4f1a\u6709\u610f\u5c06\u5176\u8c03\u6162\uff1a\u82e5\u4e0d\u52a0\u8c03\u6574\uff0c\n5| \u5b83\u6bcf\u5929\u4f1a\u5feb 38 \u5fae\u79d2\uff0c\u5230\u660e\u5929\u508d\u665a\uff0c\n6| \u4f60\u7684\u624b\u673a\u5c31\u4f1a\u628a\u4f60\u5b9a\u4f4d\u5728\u79bb\u4f60\u6240\u5728\u4e4b\u5904\u5341\u4e00\u5343\u7c73\u5916\u3002\n7| \u9519\u4e0d\u5728\u65f6\u949f\u2014\u2014\u65f6\u95f4\u672c\u8eab\u5bf9\u8fd0\u52a8\u8005\u4e0e\u9759\u6b62\u8005\u7684\u6d41\u901d\u65b9\u5f0f\u5404\u4e0d\u76f8\u540c\uff1a\n8| \u672c\u7ae0\u5c06\u6cbf\u7740\u7231\u56e0\u65af\u5766\u7684\u601d\u8def\uff0c\u4ece\u4e00\u4e2a\u987d\u56fa\u7684\u4e8b\u5b9e\u8d70\u5230\u8fd9\u4e00\u7ed3\u8bba\u3002\n9|=\n10|\\section{\u6709\u4e00\u4e2a\u901f\u7387\u4e0d\u80af\u76f8\u52a0}\n11|=\n12| \u901f\u7387\u4f9d\u8d56\u4e8e\u53c2\u8003\u7cfb\uff0c\u5e76\u6309\u52a0\u6cd5\u5408\u6210\n13| \uff08\\cref{ch:g10:relative-motion}\uff09\uff1a\u4e00\u540d\u4e58\u5ba2\u4ee5 \\qty{4}{km/h} \u7684\u901f\u7387\u671d\u8f66\u5934\u8d70\u53bb\uff0c\n14| \u800c\u706b\u8f66\u4ee5 \\qty{300}{km/h} \u7684\u901f\u7387\u884c\u9a76\uff0c\u8def\u8fb9\u89c2\u5bdf\u8005\u6d4b\u5f97\u8be5\u4e58\u5ba2\u7684\u901f\u7387\u4e3a \\qty{304}{km/h}\u3002\n15|=\n16|\\begin{definition}[\u60ef\u6027\u53c2\u8003\u7cfb]\\label{def:g12:special-relativity:inertial}\n17| \u79f0\\emph{\u60ef\u6027\u53c2\u8003\u7cfb}\\index{\u60ef\u6027\u53c2\u8003\u7cfb}\u4e3a\u4e00\u79cd\u53c2\u8003\u7cfb\n18| \uff08\\cref{ch:g10:relative-motion}\uff09\uff0c\u5728\u5176\u4e2d\u4e0d\u53d7\u529b\u7684\u7269\u4f53\n19| \u901f\u5ea6\u4fdd\u6301\u4e0d\u53d8\uff1a\u5730\u9762\u8fd1\u4f3c\u6ee1\u8db3\u6b64\u6761\u4ef6\uff0c\u4ee5\u53ca\u76f8\u5bf9\u5730\u9762\n20| \u505a\u5300\u901f\u76f4\u7ebf\u8fd0\u52a8\u7684\u6bcf\u4e00\u53c2\u8003\u7cfb\u3002\n21|\\end{definition}\n22|=\n23| \u628a\u8fd9\u4e00\u89c4\u5219\u63a8\u5230\u6781\u7aef\uff1a\u706b\u8f66\u8f66\u5934\u706f\u7684\u5149\u675f\u5e94\u5f53\n24| \u4ee5 $c + \\qty{300}{km/h}$ \u7684\u901f\u7387\u63a0\u8fc7\u5730\u9762\u89c2\u5bdf\u8005\u30021887 \u5e74\uff0c\u8fc8\u514b\u8033\u5b59\u4e0e\u83ab\u96f7\n25| \u6bd4\u8f83\u4e86\u5149\u6cbf\u5730\u7403 \\qty{30}{km/s} \u516c\u8f6c\u65b9\u5411\u4e0e\u5782\u76f4\u8be5\u65b9\u5411\u7684\u5149\u901f\uff0c\n26| \u4ee5\u5bfb\u627e\u8fd9\u79cd\u5dee\u5f02\uff1b\u4ee5\u6781\u9ad8\u7684\u7cbe\u5ea6\uff0c\u4ed6\u4eec\n27| \u5374\u4e00\u65e0\u6240\u83b7\u2014\u2014\u65e0\u8bba\u54ea\u4e2a\u65b9\u5411\u3001\u54ea\u4e2a\u5b63\u8282\uff0c\u5149\u901f\u90fd\u662f\u540c\u4e00\u4e2a $c$\u3002\u7231\u56e0\u65af\u5766\u4e8e 1905 \u5e74\n28| \u76f8\u4fe1\u4e86\u8fd9\u4e00\u5b9e\u9a8c\uff0c\u5e76\u4ee5\u4e4b\u4e3a\u4f9d\u636e\u91cd\u5efa\u65f6\u95f4\u4e0e\u7a7a\u95f4\uff0c\u57fa\u7840\u662f\u4e24\u6761\u516c\u8bbe\uff0c\n29| \u5176\u5224\u636e\u5728\u4e8e\u5b83\u4eec\u7684\u63a8\u8bba\u2014\u2014\u4e00\u4e2a\u4e16\u7eaa\u4ee5\u6765\u7ecf\u53d7\u4f4f\u4e86\u68c0\u9a8c\uff0c\u4ece\u672a\u5931\u8d25\u3002\n30|=\n31|\\begin{theorem}[\u72ed\u4e49\u76f8\u5bf9\u8bba\u7684\u4e24\u6761\u516c\u8bbe]\\label{thm:g12:special-relativity:postulates}\n32| \\index{\u72ed\u4e49\u76f8\u5bf9\u8bba}\\index{\u76f8\u5bf9\u8bba\u516c\u8bbe}\n33|\\begin{enumerate}\n34|  \\item \\emph{\u76f8\u5bf9\u6027\u539f\u7406}\uff1a\u7269\u7406\u5b9a\u5f8b\u5728\u6bcf\u4e2a\u60ef\u6027\u53c2\u8003\u7cfb\u4e2d\n35|        \u5f62\u5f0f\u76f8\u540c\uff1b\u6ca1\u6709\u54ea\u4e2a\u53c2\u8003\u7cfb\u53ef\u79f0\u201c\u771f\u6b63\u9759\u6b62\u201d\u3002\n36|  \\item \\emph{$c$ \u7684\u4e0d\u53d8\u6027}\uff1a\u771f\u7a7a\u4e2d\u7684\u5149\u5728\u6bcf\u4e2a\u60ef\u6027\u53c2\u8003\u7cfb\u4e2d\n37|        \u4ee5 $c = \\qty{3.00e8}{m/s}$ \u4f20\u64ad\uff0c\n38|        \u65e0\u8bba\u5149\u6e90\u6216\u89c2\u5bdf\u8005\u5982\u4f55\u8fd0\u52a8\u3002\n39|\\end{enumerate}\n40|\\end{theorem}\n41|=\n42|=\n43|\\section{\u544a\u522b\u201c\u540c\u4e00\u65f6\u523b\u201d}\n44|=\n45|\\begin{proposition}[\u540c\u65f6\u6027\u7684\u76f8\u5bf9\u6027]\\label{prop:g12:special-relativity:simultaneity}\n46|\\index{\u540c\u65f6\u6027}\n47| \u5728\u4e00\u4e2a\u60ef\u6027\u53c2\u8003\u7cfb\u4e2d\u540c\u65f6\u53d1\u751f\u7684\u4e24\u4e2a\u4e8b\u4ef6\uff0c\u4e00\u822c\u800c\u8a00\n48| \u5728\u53e6\u4e00\u60ef\u6027\u53c2\u8003\u7cfb\u4e2d\u5219\u4e0d\u518d\u540c\u65f6\uff1a\u201c\u5904\u5904\u6b64\u523b\u201d\u4f9d\u53c2\u8003\u7cfb\u800c\u5b9a\u3002\n49|\\end{proposition}\n50|=\n51|\\begin{proof}\n52| \u7231\u56e0\u65af\u5766\u7684\u706b\u8f66\u3002\u4e24\u9053\u95ea\u7535\u5206\u522b\u51fb\u4e2d\u8fd0\u52a8\u4e2d\u706b\u8f66\u7684\u4e24\u7aef\uff0c\n53| \u4f7f\u94c1\u8f68\u70e7\u7126\u3002\u7ad9\u53f0\u4e0a\u7684\u89c2\u5bdf\u8005 $M$ \u4f4d\u4e8e\u4e24\u5904\u6807\u8bb0\u7684\u6b63\u4e2d\u95f4\uff0c\n54| \u540c\u65f6\u6536\u5230\u4e24\u9053\u95ea\u5149\uff1b\u4e24\u9053\u95ea\u5149\u5404\u81ea\u4ee5\u76f8\u540c\u901f\u7387 $c$ \u8d70\u8fc7\u76f8\u540c\u8ddd\u79bb\uff0c\n55| \u56e0\u6b64\u4e24\u6b21\u51fb\u4e2d\u540c\u65f6\u53d1\u751f\u3002\u4e58\u5ba2 $M'$ \u4f4d\u4e8e\u8f66\u53a2\u6b63\u4e2d\uff0c\n56| \u4ed6\\emph{\u8fce\u7740}\u8f66\u5934\u7684\u95ea\u5149\u8fd0\u52a8\uff0c\u8be5\u95ea\u5149\u5148\u5230\u8fbe\u4ed6\uff1b\n57| \u4f46\u5728\u4ed6\u7684\u53c2\u8003\u7cfb\u4e2d\uff0c\u4e24\u9053\u95ea\u5149\u540c\u6837\u8d70\u8fc7\u76f8\u7b49\u7684\u8ddd\u79bb\uff08\u534a\u5217\u8f66\u957f\uff09\uff0c\n58| \u5e76\u4ee5\u76f8\u540c\u901f\u7387 $c$ \u4f20\u64ad\u2014\u2014\u8fd9\u6b63\u662f\u7b2c\u4e8c\u516c\u8bbe\uff01\u2014\u2014\u56e0\u6b64\u8f66\u5934\u7684\u51fb\u4e2d\u5148\u53d1\u751f\u3002\n59| \u4e24\u79cd\u5224\u65ad\u5728\u5404\u81ea\u7684\u53c2\u8003\u7cfb\u4e2d\u90fd\u662f\u6b63\u786e\u7684\uff0c\n60| \u8fd9\u4e00\u5206\u6b67\uff08\u5bf9\u4e00\u5217\u706b\u8f66\u800c\u8a00\u4ec5\u4e3a\u7eb3\u79d2\u91cf\u7ea7\uff09\u6b63\u662f\u4eba\u4eec\u4ece\u672a\u5bdf\u89c9\u7684\u539f\u56e0\u3002\n61|\\end{proof}\n62|=\n63|=\n64|=\n65|=\n66|=\n67|=\n68|=\n69|=\n70|=\n71|=\n72|=\n73|=\n74|=\n75|=\n76|=\n77| {\\small \u7231\u56e0\u65af\u5766\u7684\u706b\u8f66\uff1a\u6765\u81ea $A$ \u4e0e $B$ \u7684\u95ea\u5149\u540c\u65f6\u5230\u8fbe $M$\uff1b$M'$\n78| \u8fce\u7740 $B$ \u5904\u7684\u95ea\u5149\u884c\u9a76\uff0c\u5148\u4e0e\u4e4b\u76f8\u9047\u2014\u2014\u5e76\u65ad\u5b9a\u5b83\u5148\u51fb\u4e2d\u3002}\n79|=\n80|=\n81|\\section{\u5149\u949f\u4e0e $\\gamma$ \u56e0\u5b50}\n82|=\n83|\\begin{definition}[\u4e8b\u4ef6\uff0c\u56fa\u6709\u65f6]\\label{def:g12:special-relativity:proper-time}\n84| \u79f0\\emph{\u4e8b\u4ef6}\\index{\u4e8b\u4ef6}\u4e3a\u5728\u67d0\u4e00\u5730\u70b9\u3001\u67d0\u4e00\u65f6\u523b\u53d1\u751f\u7684\n85| \u4e00\u4ef6\u4e8b\u2014\u2014\u4e00\u6b21\u6ef4\u7b54\u3001\u4e00\u6b21\u95ea\u5149\u3001\u4e00\u6b21\u8870\u53d8\u3002\u540c\u4e00\u65f6\u949f\u5728\n86| \u4e24\u4e2a\u4e8b\u4ef6\u5904\u5747\u5b58\u5728\u65f6\uff0c\u5b83\u5728\u4e8c\u8005\u4e4b\u95f4\u6240\u8bfb\u51fa\u7684\u65f6\u95f4\u95f4\u9694\u5373\u4e3a\n87| \\emph{\u56fa\u6709\u65f6}\\index{\u56fa\u6709\u65f6} $\\Delta t_0$\u3002\u82e5\u65f6\u949f\u76f8\u5bf9\u67d0\u4e00\u53c2\u8003\u7cfb\u8fd0\u52a8\uff0c\n88| \u5219\u8be5\u53c2\u8003\u7cfb\u6d4b\u5f97\u7684\u65f6\u95f4\u95f4\u9694\u4e00\u822c\u4e0d\u540c\uff0c\u8bb0\u4e3a $\\Delta t$\u3002\n89|\\end{definition}\n90|=\n91|\\begin{theorem}[\u65f6\u95f4\u5ef6\u7f13]\\label{thm:g12:special-relativity:dilation}\n92|\\index{\u65f6\u95f4\u5ef6\u7f13}\\index{$\\gamma$ \u56e0\u5b50}\n93| \u82e5\u65f6\u949f\u4ee5\u6052\u5b9a\u901f\u7387 $v$ \u7a7f\u8fc7\u67d0\u4e00\u60ef\u6027\u53c2\u8003\u7cfb\u8fd0\u52a8\uff0c\n94| \u5219\u5728\u8be5\u53c2\u8003\u7cfb\u4e2d\u6d4b\u5f97\u5176\u8d70\u65f6\u53d8\u6162\uff1a\u5bf9\u4e8e\u540c\u4e00\u65f6\u949f\u4e0a\u7684\u4e24\u4e2a\u4e8b\u4ef6\uff0c\n95|=\n96|=\n97|=\n98|=\n99|\\end{theorem}\n100|=\n101|\\begin{proof}\n102| \u6784\u9020\u5c3d\u53ef\u80fd\u7b80\u5355\u7684\u65f6\u949f\uff1a\u4e24\u9762\u76f8\u5bf9\u7684\u955c\u5b50\u76f8\u8ddd $L$\uff0c\n103| \u4e24\u955c\u4e4b\u95f4\u6709\u4e00\u5149\u5b50\u6765\u56de\u53cd\u5c04\uff1b\u5f80\u8fd4\u4e00\u6b21\u5373\u4e3a\u4e00\u4e2a\u6ef4\u7b54\uff0c\u9759\u6b62\u65f6\n104| \u4e00\u4e2a\u6ef4\u7b54\u6301\u7eed $\\Delta t_0 = 2L/c$\u3002\u73b0\u5c06\u8be5\u65f6\u949f\u56fa\u5b9a\u5728\u4e00\u8258\n105| \u4ee5\u901f\u7387 $v$ \u8fd0\u52a8\u7684\u8239\u4e0a\uff0c\u955c\u9762\u4e0e\u8fd0\u52a8\u65b9\u5411\u5782\u76f4\uff0c\u5e76\u4ece\u5730\u9762\u8ba1\u91cf\u4e00\u4e2a\n106| \u6ef4\u7b54\uff1a\u5149\u5b50\u5411\u4e0a\u884c\u8fdb\u65f6\uff0c\u955c\u5b50\u5411\u4fa7\u9762\u79fb\u52a8\uff0c\n107| \u56e0\u6b64\u5149\u5b50\u6cbf\u659c\u7ebf\u98de\u884c\u2014\u2014\u540c\u65f6\u8fdb\u884c\u4e24\u79cd\u8fd0\u52a8\uff0c\u4e0e\n108| \\cref{ch:g12:kinematics-2d}\u4e2d\u7684\u629b\u4f53\u76f8\u4f3c\u3002\u82e5\u4e00\u4e2a\u6ef4\u7b54\u6301\u7eed $\\Delta t$\uff0c\n109| \u5219\u6bcf\u534a\u4e2a\u6ef4\u7b54\uff0c\u5149\u5b50\u6c34\u5e73\u524d\u8fdb $v\\,\\Delta t/2$\u3001\u7ad6\u76f4\u524d\u8fdb $L$\uff1b\u800c\u4e14\u2014\u2014\n110| \u5173\u952e\u4e00\u6b65\u2014\u2014\u7b2c\u4e8c\u516c\u8bbe\u786e\u5b9a\u4e86\u5149\u5b50\u5728\u5730\u9762\u7684\u901f\u7387\u4e3a\n111| $c$\uff0c\u56e0\u6b64\u659c\u5411\u534a\u7a0b\u7684\u8def\u5f84\u957f\u4e3a $c\\,\\Delta t/2$\u3002\u636e\u6bd5\u8fbe\u54e5\u62c9\u65af\u5b9a\u7406\uff1a\n112|=\n113|=\n114|=\n115|=\n116|=\n117| \u4e0e\u4e4b\u5e76\u884c\u8fd0\u52a8\u7684\u4efb\u4f55\u65f6\u949f\u2014\u2014\u624b\u8868\u3001\u5fc3\u8df3\u3001\u8870\u53d8\u4e2d\u7684\u539f\u5b50\u6838\u2014\u2014\n118| \u90fd\u5fc5\u987b\u4fdd\u6301\u540c\u6b65\uff0c\u5426\u5219\u8fd9\u4e00\u6bd4\u8f83\u5c31\u4f1a\u66b4\u9732\u8239\u7684\u8fd0\u52a8\uff0c\n119| \u4ece\u800c\u8fdd\u53cd\u7b2c\u4e00\u516c\u8bbe\u3002\n120|\\end{proof}\n121|=",
