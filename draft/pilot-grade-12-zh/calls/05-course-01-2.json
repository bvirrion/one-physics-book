 "result": "1| \\chapter{\u4e8c\u7ef4\u8fd0\u52a8\u5b66}\\label{ch:g12:kinematics-2d}\n2|=\n3| \u770b\u4e00\u8f86\u6c7d\u8f66\u4ee5\u7a33\u5b9a\u7684 \\qty{30}{km/h} \u7ed5\u73af\u5c9b\u884c\u9a76\uff1a\u6307\u9488\n4| \u59cb\u7ec8\u4e0d\u52a8\uff0c\u4f46\u6bcf\u4f4d\u4e58\u5ba2\u90fd\u611f\u5230\u88ab\u7529\u5411\u4e00\u4fa7\u2014\u2014\u8fd0\u52a8\n5| \u5728\u53d8\u5316\uff0c\u53d8\u5316\u7684\u5e76\u4e0d\u662f\u901f\u7387\u3002\u6bcf\u4e00\u65f6\u523b\u4e00\u4e2a\u6570\n6| \u5df2\u4e0d\u591f\u7528\uff1a\u5e73\u9762\u5185\u7684\u8fd0\u52a8\u9700\u8981\u7528\u7bad\u5934\u8868\u793a\u3002\u672c\u7ae0\n7| \u4e3a\u8fd0\u52a8\u7684\u8d28\u70b9\u914d\u5907\u4e09\u4e2a\u91cf\u2014\u2014\u4f4d\u7f6e\u3001\u901f\u5ea6\u3001\u52a0\u901f\u5ea6\u2014\u2014\n8| \u5b83\u4eec\u7531\u5bfc\u6570\u76f8\u4e92\u8054\u7cfb\uff0c\u5e76\u501f\u52a9\u51e0\u4f55\u56fe\u5f62\n9| \u8bfb\u51fa\u6574\u7c7b\u8fd0\u52a8\u7684\u7279\u5f81\u3002\n10|=\n11| \\section{\u4f4d\u7f6e\u77e2\u91cf}\n12|=\n13| \u8fd0\u52a8\u53ea\u6709\u76f8\u5bf9\u4e8e\u6307\u5b9a\u7684\u53c2\u8003\u7cfb\u624d\u6709\u610f\u4e49\u2014\u2014\u53c2\u8003\u7cfb\u7531\u521a\u4f53\n14| \u52a0\u4e0a\u4e00\u53ea\u65f6\u949f\u6784\u6210\uff08\u89c1\\cref{ch:g10:relative-motion}\uff09\u3002\u672c\u5e74\u5ea6\u7684\u65b0\u5185\u5bb9\u662f\n15| \u7cbe\u786e\u5316\uff1a\u5728\u53c2\u8003\u7cfb\u4e0a\u53d6\u539f\u70b9 $O$ \u4e0e\u4e24\u6761\u4e92\u76f8\u5782\u76f4\u7684\n16| \u5e26\u523b\u5ea6\u7684\u5750\u6807\u8f74 $Ox$\u3001$Oy$\uff0c\u5e76\u8bb0\u5f55\u8d28\u70b9\u5728\u6bcf\u4e00\u65f6\u523b\u7684\n17| \u4f4d\u7f6e\uff0c\u5199\u6210\u4e00\u5bf9\u51fd\u6570\u3002\n18|=\n19| \\begin{definition}[\u4f4d\u7f6e\u77e2\u91cf]\\label{def:g12:kinematics-2d:position}\n20| \u5728\u914d\u6709\u539f\u70b9 $O$ \u4e0e\u5750\u6807\u8f74 $Ox$\u3001$Oy$ \u7684\u53c2\u8003\u7cfb\u4e2d\uff0c\n21| \\emph{\u4f4d\u7f6e\u77e2\u91cf}\\index{\u4f4d\u7f6e\u77e2\u91cf}\u5373\u8fd0\u52a8\u8d28\u70b9 $M$\n22| \u5728\u65f6\u523b $t$ \u7684\u4f4d\u7f6e\u4e3a $\\vect{OM}(t)$\uff0c\u5176\u5750\u6807\u4e3a\n23| $\\bigl(x(t),\\, y(t)\\bigr)$\uff1a\u5173\u4e8e\u65f6\u95f4\u7684\u4e24\u4e2a\u51fd\u6570\uff0c\u5404\u5bf9\u5e94\u4e00\u6761\u5750\u6807\u8f74\u3002\n24| $M$ \u968f $t$ \u53d8\u5316\u6240\u63cf\u51fa\u7684\u66f2\u7ebf\u5373\u4e3a\u5b83\u7684\u8f68\u8ff9\u3002\n25|=\n26|=\n27| \\section{\u901f\u5ea6\u77e2\u91cf}\n28|=\n29| \\begin{definition}[\u901f\u5ea6\u77e2\u91cf]\\label{def:g12:kinematics-2d:velocity}\n30| \u5728\u5f88\u77ed\u7684\u65f6\u95f4\u95f4\u9694\u5185\uff0c\u8d28\u70b9\u7684\u4f4d\u79fb\u4e3a\n31| $\\vect{OM}(t+\\Delta t) - \\vect{OM}(t)$\uff1b\u9664\u4ee5 $\\Delta t$\uff0c\u518d\u4ee4\u65f6\u95f4\u95f4\u9694\u8d8b\u4e8e\u96f6\uff0c\n32| \u5373\u5f97\u5230\u4f60\u5728\u6570\u5b66\u8bfe\u7a0b\u4e2d\u5b66\u8fc7\u7684\u5bfc\u6570\uff0c\n33| \u53ea\u4e0d\u8fc7\u5206\u522b\u4f5c\u7528\u4e8e\u6bcf\u4e2a\u5750\u6807\u3002\n34| \\emph{\u901f\u5ea6\u77e2\u91cf}\\index{\u901f\u5ea6\u77e2\u91cf}\u662f $M$ \u7684\u4f4d\u7f6e\u77e2\u91cf\u7684\u5bfc\u6570\uff0c\n35| $\\vect v(t) = \\bigl(x'(t),\\, y'(t)\\bigr)$\uff0c\u5355\u4f4d\u4e3a\n36| \\unit{m/s}\u3002\u5176\u6a21 $v = \\sqrt{x'^2 + y'^2}$ \u5373\u4e3a\n37| \\emph{\u901f\u7387}\\index{\u901f\u7387}\u2014\u2014\u901f\u5ea6\u8ba1\u4e0a\u663e\u793a\u7684\u90a3\u4e2a\u6570\u3002\n38|=\n39|=\n40| \\begin{example}[\u65e0\u4eba\u673a\u7684\u6c34\u5e73\u98de\u884c]\\label{ex:g12:kinematics-2d:drone}\n41| \u4e00\u67b6\u65e0\u4eba\u673a\u7684\u8fd0\u52a8\u89c4\u5f8b\u4e3a $x(t) = 4.0\\,t$\uff0c$y(t) = 3.0\\,t$\uff08\n42| \u957f\u5ea6\u5355\u4f4d\u4e3a\u7c73\uff0c\u65f6\u95f4\u5355\u4f4d\u4e3a\u79d2\uff09\uff1a\u8f68\u8ff9\u4e3a\u76f4\u7ebf $y = \\tfrac34 x$\uff0c\u901f\u5ea6\n43| \u5728\u4efb\u610f\u65f6\u523b\u5747\u4e3a $\\vect v = (4.0, 3.0)$\uff0c\u901f\u7387\n44| \u4e3a $\\sqrt{4.0^2 + 3.0^2} = \\qty{5.0}{m/s}$\uff0c\u4e14\u4fdd\u6301\u4e0d\u53d8\u3002\n45|=\n46|=\n47| \\begin{proposition}[\u901f\u5ea6\u4e0e\u8f68\u8ff9\u76f8\u5207]\\label{prop:g12:kinematics-2d:tangent}\n48| \u5728\u6bcf\u4e00\u65f6\u523b\uff0c$\\vect v(t)$ \u90fd\u4e0e\u8f68\u8ff9\u5728\n49| $M$ \u5f53\u524d\u6240\u5728\u4f4d\u7f6e\u5904\u76f8\u5207\uff0c\u5e76\u6307\u5411\u8fd0\u52a8\u65b9\u5411\u3002\n50|=\n51|=\n52|=\n53| \u4f4d\u79fb\u662f\u8f68\u8ff9\u7684\u4e00\u6761\u5f26\uff1b\u5f53 $\\Delta t$ \u8d8b\u4e8e\u96f6\u65f6\uff0c\n54| \u5f26\u7684\u65b9\u5411\u8d8b\u4e8e\u5207\u7ebf\u7684\u65b9\u5411\u3002\n55|=\n56|=\n57| \\section{\u52a0\u901f\u5ea6\u77e2\u91cf}\n58|=\n59| \\begin{definition}[\u52a0\u901f\u5ea6\u77e2\u91cf]\\label{def:g12:kinematics-2d:acceleration}\n60| \\emph{\u52a0\u901f\u5ea6\u77e2\u91cf}\\index{\u52a0\u901f\u5ea6\u77e2\u91cf}\u662f\u8d28\u70b9 $M$ \u7684\n61| \u901f\u5ea6\u77e2\u91cf\u7684\u5bfc\u6570\uff0c\n62|=\n63| \\bigl(x''(t),\\, y''(t)\\bigr)$\uff0c\u5355\u4f4d\u4e3a \\unit{m/s^2}\uff1a\u8868\u793a\u901f\u5ea6\u77e2\u91cf\u5f53\u524d\u53d8\u5316\u7684\u5feb\u6162\uff0c\n64| \u4ee5\u53ca\u5176\u53d8\u5316\u7684\u65b9\u5411\u3002\n65|=\n66|=\n67| \\begin{remark}[\u52a0\u901f\u800c\u901f\u7387\u4e0d\u53d8]\\label{rem:g12:kinematics-2d:turning}\n68| $\\vect a \\neq \\vect 0$\uff0c\u53ea\u8981\u901f\u5ea6\\emph{\u77e2\u91cf}\u53d1\u751f\u53d8\u5316\u5c31\u6210\u7acb\u2014\u2014\n69| \u5927\u5c0f\u6216\\emph{\u65b9\u5411}\u4efb\u4e00\u53d8\u5316\uff1a\u5239\u8f66\u7684\u6c7d\u8f66\n70| \u6cbf\u540e\u9000\u65b9\u5411\u6709\u52a0\u901f\u5ea6\uff1b\u4ee5\u6052\u5b9a\u901f\u7387\u8f6c\u5f2f\u7684\u6c7d\u8f66\uff08\u6cbf\u4fa7\u5411\uff09\u540c\u6837\u6709\u52a0\u901f\u5ea6\u3002\n71| \u8fd9\u6b63\u662f\u529b\u6240\u63a7\u5236\u7684\u91cf\n72| \uff08\u89c1\\cref{ch:g11:forces-and-motion,ch:g12:newtons-laws}\uff09\u3002\n73|=\n74|=\n75| \\begin{method}[\u8bfb\u53d6\u9891\u95ea\u7167\u7247]\\label{met:g12:kinematics-2d:chrono}\n76| \\emph{\u9891\u95ea\u7167\u7247}\\index{\u9891\u95ea\u7167\u7247}\u8bb0\u5f55\u4e86\n77| \u8fd0\u52a8\u8d28\u70b9\u7684\u4f4d\u7f6e $M_0, M_1, M_2, \\dots$\uff0c\n78| \u65f6\u95f4\u95f4\u9694\u76f8\u7b49\uff0c\u5747\u4e3a $\\Delta t$\u3002\n79|=\n80|   \\item \u70b9\u95f4\u8ddd\u53cd\u6620\u901f\u7387\uff1a\u95f4\u8ddd\u76f8\u7b49\u5219\u901f\u7387\u4e0d\u53d8\uff1b\n81|         \u95f4\u8ddd\u589e\u5927\u5219\u901f\u7387\u589e\u5927\uff1b\u95f4\u8ddd\u51cf\u5c0f\u5219\u901f\u7387\u51cf\u5c0f\u3002\n82|   \\item $M_i$ \u5904\u7684\u901f\u5ea6\u4e3a\u5bf9\u79f0\u5f26\uff0c\n83|         $\\vect v_i \\approx \\vect{M_{i-1}M_{i+1}}/(2\\,\\Delta t)$,\n84|         \u753b\u5728 $M_i$ \u5904\uff0c\u4e0e\u865a\u7ebf\u8def\u5f84\u76f8\u5207\u3002\n85|   \\item \u6c42 $M_i$ \u5904\u7684\u52a0\u901f\u5ea6\uff1a\u5c06 $\\vect v_{i-1}$ \u4e0e\n86|         $\\vect v_{i+1}$ \u5e73\u79fb\u5230 $M_i$\uff0c\u753b\u51fa\n87|         $\\Delta\\vect v = \\vect v_{i+1} - \\vect v_{i-1}$ \u9996\u5c3e\u76f8\u63a5\uff1b\n88|         \u7136\u540e $\\vect a_i \\approx \\Delta\\vect v/(2\\,\\Delta t)$\u3002\n89|=\n90|=\n91|=\n92|=\n93|=\n94|=\n95|=\n96|=\n97|=\n98|=\n99|=\n100|=\n101|=\n102|=\n103|=\n104|=\n105|=\n106|=\n107|=\n108|=\n109|=\n110|=\n111|=\n112|=",
