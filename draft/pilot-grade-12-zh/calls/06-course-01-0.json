 "result": "1| \\chapter{\u725b\u987f\u5b9a\u5f8b}\\label{ch:g12:newtons-laws}\n2|=\n3| \u60f3\u8c61\u628a\u4e00\u53f0\u6d74\u5ba4\u4f53\u91cd\u79e4\u642c\u8fdb\u7535\u68af\u3002\u8f7f\u53a2\u5411\u4e0a\u52a0\u901f\u65f6\uff0c\u6307\u9488\u8bfb\u6570\u504f\u5927\uff0c\u76f8\u5f53\u4e8e\u591a\u51fa\u7ea6\u4e09\u5343\u514b\u7684\u91cd\u91cf\uff1b\u63a5\u8fd1\u9876\u90e8\u65f6\u6307\u9488\u8bfb\u6570\u504f\u5c0f\uff1b\u65e0\u8bba\u54ea\u79cd\u60c5\u5f62\uff0c\u8f66\u53a2\u91cc\u5e76\u6ca1\u6709\u4efb\u4f55\u4e1c\u897f\u6539\u53d8\uff0c\u6539\u53d8\u7684\u53ea\u662f\u8fd0\u52a8\u3002\u672c\u7ae0\u9648\u8ff0\u6307\u9488\u80cc\u540e\u7684\u4e09\u6761\u5b9a\u5f8b\uff0c\u5e76\u628a\u5b83\u4eec\u953b\u9020\u6210\u8d2f\u7a7f\u6574\u4e2a\u529b\u5b66\u7684\u65b9\u6cd5\uff1a\u9009\u53d6\u7cfb\u7edf\uff0c\u753b\u51fa\u53d7\u529b\uff0c\u6295\u5f71 $\\sum \\vect F = m\\vect a$\u3002\n8|=\n9| \\section{\u52a8\u91cf\u4e0e\u7cbe\u786e\u5316\u7684\u7b2c\u4e00\u5b9a\u5f8b}\n10|=\n11| \\begin{definition}[\u52a8\u91cf]\\label{def:g12:newtons-laws:momentum}\n12| \u8d28\u91cf\u4e3a $m$\uff08\\unit{kg}\uff09\u3001\u901f\u5ea6\u4e3a $\\vect v$ \u8fd0\u52a8\u7684\u7269\u4f53\uff0c\u5176\\emph{\u52a8\u91cf}\\index{\u52a8\u91cf}\u662f\u77e2\u91cf\n13| \n14| \\[\n15| \\vect p = m \\vect v \\qquad (\\unit{kg.m/s}):\n16| \\]\n17| \u5373\u4ee5\u8d28\u91cf\u52a0\u6743\u7684\u901f\u5ea6\uff1b\u5bf9\u4e8e\u7cfb\u7edf\uff0c\u5219\u4e3a\u5404\u90e8\u5206\u52a8\u91cf\u7684\u77e2\u91cf\u548c\u3002\n18| \\end{definition}\n19|=\n20| \\begin{definition}[\u60ef\u6027\u53c2\u8003\u7cfb]\\label{def:g12:newtons-laws:inertial}\n21| \\emph{\u60ef\u6027\u53c2\u8003\u7cfb}\\index{\u60ef\u6027\u53c2\u8003\u7cfb}\u662f\u8fd9\u6837\u4e00\u79cd\u53c2\u8003\u7cfb\uff1a\u5176\u4e2d\u6bcf\u4e2a\u5b64\u7acb\u7269\u4f53\u2014\u2014\u4e0d\u53d7\u529b\uff0c\u6216\u6240\u53d7\u529b\u76f8\u4e92\u62b5\u6d88\u2014\u2014\u90fd\u6cbf\u76f4\u7ebf\u505a\u5300\u901f\u8fd0\u52a8\uff08\u89c1\\cref{ch:g10:inertia}\uff09\u3002\n22| \u5730\u9762\u5728\u76f8\u5f53\u9ad8\u7684\u7cbe\u5ea6\u4e0a\u662f\u60ef\u6027\u7cfb\uff0c\u6cbf\u76f4\u7ebf\u5300\u901f\u8fd0\u52a8\u7684\u4efb\u4f55\u8f66\u53a2\u5728\u5730\u9762\u4e0a\u770b\u4e5f\u662f\u60ef\u6027\u7cfb\uff1b\u5239\u8f66\u4e2d\u7684\u706b\u8f66\u6216\u8f6c\u52a8\u7684\u65cb\u8f6c\u6728\u9a6c\u5219\u4e0d\u662f\uff1a\u6b64\u65f6\uff0c\u677e\u6563\u7684\u884c\u674e\u65e0\u4eba\u63a8\u52a8\u5374\u4f1a\u81ea\u884c\u52a0\u901f\u3002\n23| \\end{definition}\n24|=\n25|=\n26|=\n27|=\n28| \\begin{theorem}[\u725b\u987f\u7b2c\u4e00\u5b9a\u5f8b]\\label{thm:g12:newtons-laws:first}\\index{\u725b\u987f\u7b2c\u4e00\u5b9a\u5f8b}\n29| \u5728\u60ef\u6027\u7cfb\u4e2d\uff0c\u5b64\u7acb\u7cfb\u7edf\u7684\u52a8\u91cf\u4e0d\u53d8\uff1a$\\vect p$\n30| \u4e3a\u5e38\u91cf\uff0c\u5373 $d\\vect p/dt = \\vect 0$\u3002\n31| \\end{theorem}\n32| \\admitted\n33|=\n34| \\begin{remark}[\u60ef\u6027\u539f\u7406\u7684\u4e24\u6b21\u7cbe\u786e\u5316]\\label{rem:g12:newtons-laws:sharpened}\n35| \\cref{ch:g10:inertia}\u4e2d\u7684\u60ef\u6027\u539f\u7406\u7ecf\u8fc7\u4e24\u6b21\u63d0\u5347\uff1a\u5b83\u6307\u660e\u4e86\u6210\u7acb\u7684\\emph{\u8303\u56f4}\u2014\u2014\u60ef\u6027\u7cfb\u6070\u6070\u88ab\u5b9a\u4e49\u4e3a\u60ef\u6027\u539f\u7406\u6210\u7acb\u7684\u53c2\u8003\u7cfb\u2014\u2014\u5e76\u4e14\u5b83\u6240\u7ea6\u675f\u7684\u662f\u4e00\u4e2a\u77e2\u91cf $m\\vect v$\uff0c\u8fd9\u4e00\u8bb0\u8d26\u65b9\u5f0f\u5728\u672c\u7ae0\u672b\u5c3e\u4f1a\u663e\u73b0\u51fa\u5176\u4ef7\u503c\u3002\n36|=\n37|=\n38| \\end{remark}\n39|=\n40| \\section{\u725b\u987f\u7b2c\u4e8c\u5b9a\u5f8b}\n41|=\n42| \\begin{theorem}[\u725b\u987f\u7b2c\u4e8c\u5b9a\u5f8b]\\label{thm:g12:newtons-laws:second}\\index{\u725b\u987f\u7b2c\u4e8c\u5b9a\u5f8b}\n43| \u5728\u60ef\u6027\u7cfb\u4e2d\uff0c\u7269\u4f53\u6240\u53d7\u5408\u529b\u7b49\u4e8e\u5176\u52a8\u91cf\u7684\u53d8\u5316\u7387\uff1b\u5bf9\u4e8e\u8d28\u91cf\u6052\u5b9a\u7684\u60c5\u5f62\uff0c\u7531 $\\vect p = m\\vect v$ \u53ef\u5f97\n44| \n45| \\[\n46| \\sum \\vect F = \\frac{d\\vect p}{dt} = m\\,\\frac{d\\vect v}{dt} = m \\vect a .\n47| \\]\n48| \\end{theorem}\n49| \\admitted\n50|=\n51| \\begin{remark}[\u81ea\u7136\u5b9a\u5f8b\u53ca\u5176\u5355\u4f4d]\\label{rem:g12:newtons-laws:nature}\n52| \u8fd9\u4e00\u5b9a\u5f8b\u65e0\u6cd5\u8bc1\u660e\uff1a\u5b83\u662f\u4e00\u6761\u81ea\u7136\u5b9a\u5f8b\uff0c\u7ecf\u8fc7\u4e09\u4e2a\u591a\u4e16\u7eaa\u7684\u5b9e\u9a8c\u68c0\u9a8c\u3002\u53bb\u5e74\uff08\u89c1\\cref{ch:g11:forces-and-motion}\uff09\u7ed9\u51fa\u4e86\u5b83\u7684\u5f71\u5b50\uff0c\n53| $\\Delta v \\propto F\\,\\Delta t/m$\uff1b\u5bfc\u6570\uff08\u89c1\\cref{ch:g12:kinematics-2d}\uff09\u4f7f\u5176\u5728\u6bcf\u4e00\u65f6\u523b\u90fd\u7cbe\u786e\u6210\u7acb\u2014\u2014\u5176\u7ec6\u8282\u7559\u5f85\u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\u3002\u529b\u6709\u4e86\u5355\u4f4d\uff0c$\\unit{N} = \\unit{kg.m/s^2}$\uff1b\u4ec5\u53d7\u91cd\u529b\u7684\u7269\u4f53\u6ee1\u8db3 $m\\vect a = m\\vect g$\uff1a\u4efb\u4f55\u8d28\u91cf\u7684\u7269\u4f53\u90fd\u4ee5 $\\vect a = \\vect g$ \u4e0b\u843d\uff0c\u4e14 $g = \\qty{9.81}{N/kg} = \\qty{9.81}{m/s^2}$\u2014\u2014\u8fd9\u4e24\u79cd\u8bfb\u6cd5\u662f\u4e00\u81f4\u7684\u3002\n59|=\n60| \\begin{example}[\u5e73\u5747\u529b\uff0c\u65e0\u9700\u7ec6\u8282]\\label{ex:g12:newtons-laws:average}\n61| \u4e00\u8f86 \\qty{1300}{kg} \u7684\u6c7d\u8f66\u5728 \\qty{8.0}{s} \u5185\u7531\u9759\u6b62\u52a0\u901f\u5230 \\qty{100}{km/h}\uff08\\qty{27.8}{m/s}\uff09\uff1a\u65e0\u8bba\u9010\u65f6\u523b\u7684\u8fc7\u7a0b\u5982\u4f55\uff0c\u5408\u529b\u7684\u5e73\u5747\u503c\u4e3a $\\Delta p/\\Delta t = 1300 \\times 27.8/8.0 \\approx \\qty{4.5e3}{N}$\u2014\u2014\u52a8\u91cf\u628a\u4e00\u4e2a\u529b\u7684\u95ee\u9898\u5316\u4e3a\u524d\u540e\u4e24\u4e2a\u72b6\u6001\u7684\u8bb0\u8d26\u3002\n65|=\n66|=\n67|=\n68| \\section{\u725b\u987f\u7b2c\u4e09\u5b9a\u5f8b}\n69|=\n70| \\begin{theorem}[\u725b\u987f\u7b2c\u4e09\u5b9a\u5f8b]\\label{thm:g12:newtons-laws:third}\\index{\u725b\u987f\u7b2c\u4e09\u5b9a\u5f8b}\n71| \u82e5\u7269\u4