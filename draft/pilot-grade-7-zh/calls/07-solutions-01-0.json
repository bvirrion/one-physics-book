c\u8fdc\u79bb\u706f\u5149\uff1b\u5c0f\u7403\u53ea\u6709\n109|\u5728\u6ee1\u6708\u4f4d\u7f6e\u65f6\u624d\u4f1a\u843d\u5165\u5176\u4e2d\uff0c\n110|\u800c\u4e14\u8fd8\u987b\u6070\u597d\u6392\u6210\u4e00\u7ebf\uff1a\u90a3\u662f\u6708\u98df\uff0c\u800c\u4e0d\u662f\u6708\u76f8\u3002\n111|\\textbf{7.} \u6708\u7403\u6070\u597d\u6bcf\u7ed5\u884c\u4e00\u5468\u4fbf\u81ea\u8f6c\u4e00\u5468\uff0c\u56e0\u6b64\u540c\u4e00\n112|\u534a\u7403\u6c38\u8fdc\u671d\u5411\u5730\u7403 --- \u8fde\u7389\u5154\u7684\u56fe\u6848\u5728\u5185\uff1b\u80cc\u9762\n113|\u5219\u76f4\u5230\u6709\u6444\u50cf\u673a\u7ed5\u98de\u8fc7\u53bb\u624d\u88ab\u770b\u5230\u3002\n114|\\textbf{8.} \u81ea\u8f6c\u4e0e\u516c\u8f6c\u4fdd\u6301\u5b8c\u7f8e\u540c\u6b65\uff1a\u6708\u7403\u6cbf\u8f68\u9053\u524d\u8fdb\u65f6\uff0c\n115|\u5b83\u6070\u597d\u8f6c\u8fc7\u8db3\u591f\u7684\u89d2\u5ea6\uff0c\u4f7f\u540c\u4e00\u9762\u59cb\u7ec8\u671d\u5411\u6211\u4eec ---\n116|\u5c31\u50cf\u821e\u8005\u7ed5\u7740\u821e\u4f34\u8f6c\u5708\u65f6\u59cb\u7ec8\u9762\u671d\u5bf9\u65b9\uff1a\n117|\u786e\u5b9e\u5728\u81ea\u8f6c\uff08\u65c1\u89c2\u8005\u80fd\u770b\u5230\u5404\u4e2a\u4fa7\u9762\uff09\uff0c\n118|\u5374\u53ea\u5411\u821e\u4f34\u5c55\u793a\u4e00\u9762\u3002\n119|\\textbf{9.} \u5348\u591c\u5347\u8d77\u5bf9\u5e94\u4e0b\u5f26\u6708\u7684\u65f6\u523b\u8868 ---\n120|\u5373\u6e10\u4e8f\u7684\u4e00\u4fa7\uff1a\u4e0b\u5f26\u6708\uff08\u88ab\u7167\u4eae\u7684\u4e00\u534a\n121|\u671d\u5411\u6e05\u6668\u592a\u9633\u7684\u65b9\u5411\uff09\u3002\n122|\\textbf{10.} \u9519\u8bef\u4e4b\u5904\uff1a\u86fe\u7709\u6708\u9760\u8fd1\u592a\u9633\uff0c\u56e0\u6b64\u5348\u591c\u65f6\n123|\u7edd\u4e0d\u53ef\u80fd\u9ad8\u6302\u7a7a\u4e2d\uff1b\u4e24\u89d2\\emph{\u80cc\u79bb}\u592a\u9633\uff0c\u4ece\u4e0d\u6307\u5411\u592a\u9633\uff1b\n124|\u5348\u591c\u51fa\u73b0\u65e5\u843d\u8272\u5f69\uff0c\u672c\u8eab\u540c\u6837\u4e0d\u53ef\u80fd\uff1b\n125|\u4e09\u6b21\u51fa\u9519\uff0c\u4e09\u632f\u51fa\u5c40\u3002\n126|\\textbf{11.} \u4e0d\u80fd\uff1a\u65e5\u98df\u8