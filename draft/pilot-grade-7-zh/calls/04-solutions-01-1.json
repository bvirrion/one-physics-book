1f\u6b63\u7684\u4fdd\u9669\u4e1d\n105|\u7194\u65ad\u4e86 --- \u8fd9\u662f\u6b63\u5e38\u7684 --- \u4e5f\u8bb8\u4e0d\u6b62\u4e00\u6b21\uff1b\u6709\u4eba\n106|\u7528\u9521\u7b94\u201c\u89e3\u51b3\u201d\u4e86\u8fd9\u4e2a\u9ebb\u70e6\uff08\u89c1\u7b2c\u4e09\u4ef6\u8bc1\u7269\uff09\uff1b\u7b49\n107|\u88ab\u5543\u574f\u7684\u7535\u7ebf\u6700\u7ec8\u77ed\u8def\u65f6\uff0c\u5df2\u65e0\u4efb\u4f55\u4fdd\u62a4\uff0c\u4e8e\u662f\n108|\u5927\u7535\u6d41\u628a\u5899\u5185\u7ebf\u8def\u70e7\u6210\u4e86\u706b\uff0c\u800c\u4e0d\u662f\u5728\u9ed1\u6697\u4e2d\n109|\u968f\u4fdd\u9669\u4e1d\u7684\u7194\u65ad\u800c\u621b\u7136\u800c\u6b62\u3002\n110|\\textbf{5.} \u7535\u6d41\u603b\u4f1a\u4f7f\u5176\u6240\u7ecf\u7684\u5bfc\u7ebf\u53d1\u70ed\uff1b\u51b2\u5f97\u8d8a\u731b\uff0c\n111|\u53d1\u70ed\u8d8a\u5389\u5bb3\u3002\u706f\u6ce1\u8bc1\u660e\u4e86\u8fd9\u79cd\u53d1\u70ed\u662f\u53ef\u4ee5\u9a6f\u670d\u7684 --- \u5176\u706f\u4e1d\n112|\u5728\u5b89\u5168\u7684\u706f\u6ce1\u4e2d\u88ab\u8bbe\u8ba1\u4e3a\u767d\u70bd\u53d1\u5149\u3002\u8fd9\u91cc\u7f3a\u5c11\u7684\u662f\n113|\u8ba9\u70ed\u91cf\u6709\u6240\u5b89\u653e\u7684\u8bbe\u8ba1\uff0c\u4ee5\u53ca\u963b\u6b62\u5b83\u7684\u4efb\u4f55\u4fdd\u62a4\u88c5\u7f6e\u3002\n114|\\textbf{6.} \u7279\u610f\u505a\u7ec6\uff0c\u4f7f\u5b83\u5728\u7535\u8def\u6240\u6709\u5bfc\u7ebf\u4e2d\n115|\u6700\u5148\u7194\u5316\uff1a\u4fdd\u62a4\u88c5\u7f6e\u628a\u81f4\u547d\u7684\u53d1\u70ed\u96c6\u4e2d\u5728\u81ea\u5df1\n116|\u4e09\u5398\u7c73\u957f\u7684\u90a3\u4e00\u6bb5\u4e2d --- \u4ee5\u81ea\u5df1\u7684\u727a\u7272\uff0c\u4f7f\u5899\u5185\u7684\u6570\u7c73\u5bfc\u7ebf\u4e0d\u81f4\u53d7\u635f\u3002\n117|\\textbf{7.} \u4fdd\u62a4\u88c5\u7f6e\u5fc5\u987b\u5728\u6070\u5f53\u7684\u65f6\u523b \\emph{\u5931\u6548}\uff1a\u5b83\u7684\n118|\u4f18\u70b9\u6070\u6070\u5728\u4e8e\u7ecf\u8fc7\u8bbe\u8ba1\u7684\u8584\u5f31\u73af\u8282\u3002\u9521\u7b94\u4f5c\u4e3a\n119|\u5bfc\u4f53\u7684\u4f18\u826f\u6027\u80fd\uff0c\u6b63\u662f\u5bf9\u4fdd\u62a4\u5173\u5361\u7684\u8d25\u574f ---\n120|\u901a\u884c\u65e0\u963b\uff0c\u5374\u6beb\u65e0\u4fdd\u62a4\u3002\n121|\\textbf{8.} \u5b89\u5168\u5e76\u4e0d\u50cf\u793c\u8282\u90a3\u6837\u53ef\u4ee5\u76f8\u52a0\uff1a\u4e09\u80a1\u5408\u4e4e\u89c4\u5b9a\u7684\n122|\u7535\u6d41\u5728\u540c\u4e00\u6761\u8def\u4e0a\u76f8\u52a0\uff0c\u4fbf\u6210\u4e86\u4e00\u80a1\u8fdd\u89c4\u7684\u5927\u7535\u6d41 --- \u652f\u8def\n123|\u670d\u4ece\u7684\u662f\u7b97\u672f\uff0c\u800c\u975e\u4eba\u7684\u610f\u56fe\u3002\n124|\\textbf{9.} \u9521\u7b94\u7684\u95ee\u9898\u3002\u8fc7\u8f7d\u548c\u88ab\u5543\u574f\u7684\u7535\u7ebf\u90fd\u662f\n125|\u7cfb\u7edf\u8bbe\u8ba1\u65f6\u5c31\u5e94\u80fd\u627f\u53d7\u7684\u610f\u5916 --- \u4fdd\u62a4\u88c5\u7f6e\u6b63\u662f\u4e3a\u6b64\u800c\u8bbe\uff1b\n126|\u8ba9\u4fdd\u62a4\u88c5\u7f6e\u5931\u6548\uff0c\u628a\u672c\u53ef\u627f\u53d7\u7684\u6545\u969c\u53d8\u6210\u4e86\n127|\u707e\u96be\u3002\n128|\\textbf{10.} \u82e5\u5b89\u88c5\u771f\u6b63\u7684\u4fdd\u9669\u4e1d\uff1a\u7535\u7ebf\u77ed\u8def\uff0c\u5927\u7535\u6d41\n129|\u9aa4\u7136\u6d8c\u6765\uff0c\u4fdd\u9669\u4e1d\u77ac\u95f4\u7194\u65ad --- \u53a8\u623f\u9677\u5165\n130|\u9ed1\u6697\uff1b\u5bb6\u4eba\u56de\u6765\u540e\uff0c\u770b\u5230\u7684\u662f\u7194\u65ad\u7684\u4fdd\u9669\u4e1d\u548c\u88ab\u5543\u574f\u7684\u7535\u7ebf\uff0c\n131|\u5600\u5495\u51e0\u53e5\uff0c\u628a\u4e24\u8005\u4fee\u597d\uff0c\u5374\u4ece\u4e0d\u77e5\u9053\u5f53\u665a\u7684\u60c5\u51b5\n132|\u9669\u4e9b\u6709\u591a\u4e25\u91cd\u3002\n133|\\textbf{11.} \u6bcf\u4e2a\u53d1\u70ed\u7535\u5668\u5404\u63d2\u5728\u81ea\u5df1\u7684\u5899\u4e0a\u63d2\u5ea7\u4e0a\uff0c\u63a5\u5728\u5404\u81ea\n134|\u4fdd\u62a4\u8db3\u591f\u7684\u652f\u8def\u4e0a\uff1b\u63d2\u7ebf\u677f\u4ec5\u7528\u4e8e\n135|\u706f\u5177\u548c\u5145\u7535\u5668\uff0c\u5e76\u9075\u5b88\u4e00\u6761\u957f\u671f\u89c4\u5b9a\uff1a\u6bcf\u4e2a\u63d2\u5ea7\u53ea\u63a5\n136|\u4e00\u4ef6\u8017\u7535\u5927\u7684\u7528\u7535\u5668\uff0c\u63d2\u7ebf\u677f\u7edd\u4e0d\u53ef\u7ed9\u7535\u6696\u5668\u4f9b\u7535\u300