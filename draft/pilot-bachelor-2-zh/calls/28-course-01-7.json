 "result": "1|\\chapter{\u70ed\u529b\u5b66\u52bf}\\label{ch:b2:thermodynamic-potentials}\n2|=\n3|\u5feb\u901f\u62c9\u4f38\u4e00\u6839\u6a61\u76ae\u7b4b\uff0c\u518d\u628a\u5b83\u8d34\u5230\u5507\u8fb9\uff1a\u5b83\u662f\u6e29\u7684\uff1b\n4|\u8ba9\u5b83\u6536\u7f29\uff0c\u5b83\u5c31\u662f\u51c9\u7684\u3002\u5728\u5b83\u4e0a\u9762\u6302\u4e00\u4e2a\u91cd\u7269\uff0c\u5e76\u7528\n5|\u5439\u98ce\u673a\u52a0\u70ed\u5b83\uff1a\u5b83\\emph{\u7f29\u77ed}\u4e86\u3002\u6ca1\u6709\u54ea\u79cd\u94a2\u5f39\u7c27\u5982\u6b64\uff0c\u800c\n6|\u5176\u539f\u56e0\u662f\uff1a\u6a61\u76ae\u7b4b\u7684\u5f20\u529b\u5e76\u975e\u80fd\u91cf\u95ee\u9898\uff0c\u800c\u662f\n7|\u71b5 --- \u88ab\u62c9\u4f38\u7684\u94fe\u6392\u5217\u7684\u65b9\u5f0f\u66f4\u5c11\u3002\n8|\u8981\u5206\u6790\u8fd9\u7c7b\u95ee\u9898\uff0c\u9700\u8981\u5f04\u6e05\u6052\u6e29\n9|\u6216\u6052\u6e29\u6052\u538b\u4e0b\u7684\u7cfb\u7edf\u503e\u5411\u4e8e\u600e\u6837\u53d8\u5316\uff0c\u4ee5\u53ca\n10|\u80fd\u4ece\u4e2d\u63d0\u53d6\u591a\u5c11\u529f\u3002\u8fd9\u7c7b\u95ee\u9898\uff0c\u5185\u80fd\u548c\n11|\u71b5\u53ea\u80fd\u7b28\u62d9\u5730\u56de\u7b54\uff0c\u56e0\u4e3a\u5b83\u4eec\u8bf4\u7684\u662f\n12|\u5b64\u7acb\u7cfb\u7edf\u7684\u8bed\u8a00\u3002\u672c\u7ae0\u5f15\u5165\u4e3a\u5b9e\u9a8c\u5ba4\u6761\u4ef6\u800c\u6784\u9020\u7684\n13|\u4e24\u4e2a\u51fd\u6570\uff0c\u5373\\emph{\u4ea5\u59c6\u970d\u5179\u81ea\u7531\u80fd} $F = U -\n14|TS$ \u4e0e\\emph{\u5409\u5e03\u65af\u81ea\u7531\u7113} $G = H - TS$\uff0c\u8868\u660e\u5b83\u4eec\n15|\u5ea6\u91cf\u53ef\u56de\u6536\u7684\u529f\uff0c\u5e76\u968f\u8d8b\u4e8e\u5e73\u8861\u800c\u51cf\u5c0f\uff0c\u5e76\n16|\u7531\u5176\u5fae\u5206\u5bfc\u51fa\u9ea6\u514b\u65af\u97e6\u5173\u7cfb\uff0c\u5b83\u4eec\u8054\u7cfb\u7740\n17|\u539f\u672c\u65e0\u4eba\u4f1a\u60f3\u5230\u76f8\u5173\u7684\u91cf\uff0c\u5e76\u5c06\u6574\u4e2a\u7406\u8bba\u7528\u4e8e\n18|\u4e24\u76f8\u5e73\u8861\uff0c\u5176\u4e2d $G$ \u51b3\u5b9a\u54ea\u4e00\u76f8\u80dc\u51fa\uff0c\n19|\u5e76\u7ed9\u51fa\u514b\u62c9\u73c0\u9f99\u516c\u5f0f\u3002\n20|=\n21|=\n22|=\n23|=\n24|{\\small \u9ece\u660e\u65f6\u5206\u6e56\u9762\u4e0a\u51b0\u4e0e\u6c34\u5171\u5b58\uff1a\u5728\u7194\n25|\u70b9\u65f6\u4e24\u76f8\u6bcf\u5343\u514b\u7684\u81ea\u7531\u7113\u76f8\u540c\uff0c\u800c\u4e00\n26|\u5fae\u5c0f\u7684\u538b\u5f3a\u6216\u6e29\u5ea6\u53d8\u5316\u5373\u53ef\u6253\u7834\u5e73\u8861 --- \u5176\n27|\u5e45\u5ea6\u7531\u514b\u62c9\u73c0\u9f99\u659c\u7387\u7ed9\u51fa\u3002}\n28|=\n29|=\n30|\\section{\u57fa\u672c\u6052\u7b49\u5f0f\u53ca\u5176\u53d8\u91cf}\n31|=\n32|\\begin{proposition}[\u57fa\u672c\u6052\u7b49\u5f0f]\\label{prop:b2:thermodynamic-potentials:identity}\n33|\u5bf9\u4e8e\u7ec4\u5206\u56fa\u5b9a\u7684\u5c01\u95ed\u7cfb\u7edf\uff0c\u5185\u80fd\n34|\u89c6\u4e3a\u71b5\u4e0e\u4f53\u79ef\u7684\u51fd\u6570\uff0c\u6ee1\u8db3\n35|=\n36|=\n37|=\n38|=\n39|=\n40|\u800c\u7113 $H = U + PV$ \u6ee1\u8db3 $\\dd H = T\\,\\dd S + V\\,\\dd P$\u3002\n41|\u6bcf\u4e2a\u51fd\u6570\u5728\u5176\\emph{\u81ea\u7136\u53d8\u91cf}\\index{\u81ea\u7136\n42|\u53d8\u91cf} --- $(S,V)$ \u5bf9\u5e94 $U$\uff0c$(S,P)$ \u5bf9\u5e94 $H$ --- \u5305\u542b\n43|\u7cfb\u7edf\u7684\u5168\u90e8\u70ed\u529b\u5b66\uff1a\u5176\u504f\u5bfc\u6570\u7ed9\u51fa\u5176\u4ed6\n44|\u72b6\u6001\u53c2\u91cf\u3002\u70ed\u529b\u5b66\u7b2c\u4e8c\u5b9a\u5f8b\u6307\u51fa\uff0c\u5b64\u7acb\u7cfb\u7edf\n45|\uff08$U$\u3001$V$ \u56fa\u5b9a\uff09\u7684\u5e73\u8861\u6001\u662f $S$ \u53d6\u6700\u5927\u503c\u7684\u72b6\u6001\u3002\n46|=\n47|=\n48|=\n49|\u53ef\u9006\u8fc7\u7a0b\u7684\u70ed\u529b\u5b66\u7b2c\u4e00\u5b9a\u5f8b\u4e3a $\\dd U = \\delta Q_{\\text{rev}}\n50|+ \\delta W_{\\text{rev}} = T\\,\\dd S - P\\,\\dd V$\uff0c\u53ea\u6d89\u53ca\u72b6\u6001\n51|\u51fd\u6570\uff0c\u56e0\u6b64\u5bf9\u5e73\u8861\u6001\u4e4b\u95f4\u7684\u4efb\u4e00\u65e0\u7a77\u5c0f\n52|\u53d8\u5316\u5747\u6210\u7acb\u3002\u52a0\u4e0a $\\dd(PV)$ \u5373\u5f97 $H$ \u7684\u8868\u8fbe\u5f0f\u3002\n53|=\n54|=\n55|\\begin{remark}[\u4e3a\u4f55\u5f15\u5165\u65b0\u51fd\u6570]\\label{rem:b2:thermodynamic-potentials:why}\n56|\u5b9e\u9a8c\u5e76\u975e\u5728\u56fa\u5b9a\u71b5\u4e0b\u8fdb\u884c\u3002\u5316\u5b66\u5bb6\u7684\u70e7\u74f6\u5904\u4e8e\n57|\u5ba4\u6e29\u4e0e\u5927\u6c14\u538b\u5f3a\u4e4b\u4e0b\uff1b\u7f6e\u4e8e\u70ed\u6e90\u4e2d\u7684\n58|\u6d3b\u585e\u5219\u5de5\u4f5c\u4e8e\u56fa\u5b9a $T$ \u7684\u6761\u4ef6\u4e0b\u3002\n59|\u4eba\u4eec\u5e0c\u671b\u5f97\u5230\u81ea\u7136\u53d8\u91cf\u4e3a $(T,V)$ \u4e0e $(T,P)$ \u7684\u51fd\u6570\uff0c\u5b83\u4eec\u5728\u8fd9\u4e9b\n60|\u6761\u4ef6\u4e0b\u6240\u8d77\u7684\u4f5c\u7528\uff0c\u6070\u5982 $S$ \u5bf9\u5b64\u7acb\u7cfb\u7edf\u6240\u8d77\u7684\uff1a\u5224\u65ad\n61|\u7cfb\u7edf\u5411\u4f55\u65b9\u6f14\u5316\uff0c\u4ee5\u53ca\u5b83\u80fd\u8f93\u51fa\u591a\u5c11\u529f\u3002\u4e00\u4e2a\n62|\\emph{\u52d2\u8ba9\u5fb7\u53d8\u6362} --- \u51cf\u53bb $TS$\uff0c\u628a $S$ \u6362\u6210 $T$ \u4f5c\u4e3a\n63|\u81ea\u53d8\u91cf\uff0c\u7531\u6b64\u6784\u9020\u51fa\u5b83\u4eec\u3002\n64|=\n65|=\n66|\\section{\u81ea\u7531\u80fd\u4e0e\u81ea\u7531\u7113}\n67|=\n68|\\begin{definition}[\u4ea5\u59c6\u970d\u5179\u81ea\u7531\u80fd\uff0c\u5409\u5e03\u65af\u81ea\u7531\u7113]\\label{def:b2:thermodynamic-potentials:FG}\n69|=\n70|F = U - TS \\quad\\text{(\\emph{\u81ea\u7531\u80fd}\\index{\u81ea\u7531\u80fd})}, \\qquad\n71|G = H - TS = U + PV - TS \\quad\\text{(\\emph{\u81ea\u7531\u7113}\\index{\u81ea\u7531\u7113})}.\n72|=\n73|\u4e8c\u8005\u5747\u4e3a\u5e7f\u5ef6\u72b6\u6001\u51fd\u6570\uff0c\u5355\u4f4d\u4e3a\u7126\u8033\u3002\n74|=\n75|=\n76|\\begin{theorem}[\u5fae\u5206\u4e0e\u5bfc\u51fa\u91cf]\\label{thm:b2:thermodynamic-potentials:dFdG}\n77|=\n78|=\n79|=\n80|=\n81|\u4e8e\u662f\uff0c\u5728 $(T,V)$ \u4e3a $F$ \u7684\u81ea\u7136\u53d8\u91cf\u3001$(T,P)$ \u4e3a $G$ \u7684\u81ea\u7136\u53d8\u91cf\u65f6\uff0c\n82|=\n83|=\n84|=\n85|=\n86|=\n87|=\n88|\u5e76\u7531\uff08\u5409\u5e03\u65af--\u4ea5\u59c6\u970d\u5179\uff09\u5173\u7cfb\u5f97 $U = F - T(\\partial F/\\partial T)_V =\n89|-T^2\\,\\partial(F/T)/\\partial T$\uff0c$H = -T^2\\,\\partial(G/T)/\\partial T$\u3002\n90|\u53ea\u8981\u77e5\u9053 $F(T,V)$ \u6216 $G(T,P)$\uff0c\u4fbf\u638c\u63e1\u4e86\u4e00\u5207\uff1a\u72b6\u6001\n91|\u65b9\u7a0b\u3001\u71b5\u3001\u80fd\u91cf\u4e0e\u70ed\u5bb9\u3002\n92|=\n93|=\n94|=\n95|$\\dd F = \\dd U - T\\dd S - S\\dd T = -S\\dd T - P\\dd V$\uff1b\u5bf9 $G$ \u540c\u7406\uff0c\n96|\u7531 $\\dd H$ \u51fa\u53d1\u3002\u8bfb\u51fa\u504f\u5bfc\u6570\uff1b\u5bf9\u4e8e\u5409\u5e03\u65af--\u4ea5\u59c6\u970d\u5179\u5173\u7cfb\uff0c\n97|$F - T\\,\\partial_TF = F + TS = U$\uff0c\u4e14 $\\partial_T(F/T) = (T\\partial_TF -\n98|F)/T^2 = -U/T^2$\u3002\n99|=\n100|=\n101|\\begin{example}[\u7406\u60f3\u6c14\u4f53]\\label{ex:b2:thermodynamic-potentials:perfect}\n102|\u5bf9 $n$ \u6469\u5c14\uff0c$U = nc_{V}T + U_0$ \u4e0e $S = nc_V\\ln T + nR\\ln V + S_0$\n103|\u7ed9\u51fa $F(T,V) = -nRT\\ln V + f(T)$\uff1a\u4e8e\u662f $P = -\\partial_VF = nRT/V$\n104|--- \u72b6\u6001\u65b9\u7a0b\u7531 $F$ \u5bfc\u51fa --- \u800c $S = -\\partial_TF$\n105|\u5373\u5f97\u71b5\u3002\u5728\u53d8\u91cf $(T,P)$ \u4e0b\uff0c$G(T,P) = nRT\\ln P +\n106|g(T)$\uff0c\u4e8e\u662f $V = \\partial_PG = nRT/P$\uff0c\u5e76\u4e14\\emph{\u6469\u5c14}\u81ea\u7531\u7113\n107|$\\mu(T,P) = \\mu^\\circ(T) + RT\\ln(P/P^\\circ)$ --- \u5373\\emph{\u5316\u5b66\n108|\u52bf}\\index{\u5316\u5b66\u52bf}\uff0c\u5b83\u968f\n109|\u538b\u5f3a\u589e\u5927\uff1a\u6c14\u4f53\u7531\u9ad8 $\\mu$ \u6d41\u5411\u4f4e $\\mu$\uff0c\u6b64\u5904\u5373\u7531\u9ad8\u538b\u6d41\u5411\u4f4e\n110|\u538b\u5f3a\u3002\n111|=\n112|=",
