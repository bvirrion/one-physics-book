u5e94\u53d6\u81ea\u65a9\u6ce2\u5668\u3002\n|=\n\\textbf{20.} \u5e26\u5bbd $1/2\\pi\\tau = \\qty{0.16}{Hz}$\uff1a\u91c7\u6837\u7387\u5e94\u9ad8\u4e8e \\qty{0.32}{S/s}\uff1b\u53d6 \\qty{10}{S/s} \u8f83\u4e3a\u5408\u9002\u3002\n|=\n\\textbf{21.} \u81f3\u5c11 \\qty{2}{kS/s}\uff1b\u5fc5\u987b\u52a0\u6297\u6df7\u53e0\u6ee4\u6ce2\u5668\uff1b\u5728 \\qty{5}{kHz} \u5904\u91c7\u7528\u56db\u9636\u6ee4\u6ce2\u5668\uff1a\u5728 \\qty{100}{kHz} \u5904\u8870\u51cf $80\\log_{10}(100/5) = \\qty{104}{dB}$\uff08\u5728 \\qty{19}{kHz} \u5904\u4e3a \\qty{46}{dB}\uff0c\u8fd9\u662f\u4f1a\u6df7\u53e0\u5230 \\qty{1}{kHz} \u7684\u566a\u58f0\uff09\u3002\n|=\n\\textbf{22.} \u53f0\u9636\u4e3a \\qty{30.5}{\\micro V}\uff1b\\qty{10}{mV} \u76f8\u5f53\u4e8e $330$ \u4e2a\u53f0\u9636\uff1b\u653e\u5927\u540e\u7684\u566a\u58f0\uff08\\qty{16}{mV} \u65b9\u5747\u6839\uff09\u8de8\u8d8a\u8bb8\u591a\u53f0\u9636\uff0c\u7ecf\u5e73\u5747\u540e\uff0c\u5747\u503c\u53ef\u5206\u8fa8\u5230\u8fdc\u5c0f\u4e8e\u4e00\u4e2a\u53f0\u9636\u7684\u7cbe\u5ea6\uff1a\u8fd9\u662f\u6709\u76ca\u7684\u3002\n|=\n\\textbf{23.} $N = 20000$\uff1b\u767d\u566a\u58f0\u964d\u4e3a $1/\\sqrt N = 140$\uff1b\\qty{1}{s} \u77e9\u5f62\u7a97\u7684\u566a\u58f0\u5e26\u5bbd\u4e3a $1/2T = \\qty{0.5}{Hz}$ --- \u662f\u6a21\u62df $RC$ \u6ee4\u6ce2\u5668\u7684\u4e24\u500d\uff0c\u4e24\u8005\u76f8\u5f53\u3002\n|=\n\\textbf{24.} \u91c7\u6837\u70b9\u7f13\u6162\u5730\u6cbf\u6b63\u5f26\u66f2\u7ebf\u79fb\u52a8\uff1a\u4ea7\u751f\u4e00\u4e2a \\qty{1}{Hz} \u7684\u6df7\u53e0\u3002\u9501\u76f8\u653e\u5927\u5668\u6709\u610f\u505a\u540c\u6837\u7684\u4e8b\uff1a\u5728\u53c2\u8003\u76f8\u4f4d\u5904\u91c7\u6837\uff0c\u5373\u7b49\u540c\u4e8e\u4e0e\u53c2\u8003\u4fe1\u53f7\u76f8\u4e58\u3002\n|=\n\\textbf{25.} \u65a9\u6ce2\u5668\uff1a\u4fe1\u53f7\u88ab\u79fb\u81f3 \\qty{1}{kHz}\uff0c\u566a\u58f0\u4e0d\u53d8\uff08\u4f46\u907f\u5f00\u4e86 $1/f$ \u90e8\u5206\uff09\u3002\u653e\u5927\u5668\uff1a\u4fe1\u53f7\u4e0e\u566a\u58f0\u90fd\u4e58\u4ee5\u589e\u76ca\u3002\u4e58\u6cd5\u5668\uff1a\u