s}$ \u65f6\u7684\u6700\u4f4e\u91c7\u6837\u7387\uff08\u8f93\u51fa\u5e26\u5bbd\u53d6 $1/2\\pi\\tau$\uff09\uff1b\u5e76\n607|         \u7ed9\u51fa\u4e00\u4e2a\u5408\u9002\u7684\u53d6\u503c\u3002\n608|   \\item \u53e6\u4e00\u79cd\u505a\u6cd5\u662f\u5c06\u539f\u59cb \\qty{1}{kHz} \u4fe1\u53f7\u76f4\u63a5\u6570\u5b57\u5316\uff0c\u68c0\u6d4b\u5728\u8f6f\u4ef6\u4e2d\u5b8c\u6210\uff1a\n609|         \u6c42\u6700\u4f4e\u91c7\u6837\u7387\uff1b\u566a\u58f0\u5ef6\u4f38\u81f3 \\qty{100}{kHz}\u2014\u2014\n610|         \u91c7\u6837\u524d\u987b\u505a\u4f55\u5904\u7406\uff0c\n611|         \u4ee5\u53ca\u5728 \\qty{100}{kHz} \u5904\uff0c\n612|         \u91c7\u6837\u7387\u4e3a \\qty{20}{kS/s}\u3001\u622a\u6b62\u9891\u7387\u4e3a \\qty{5}{kHz} \u7684\u56db\u9636\u6ee4\u6ce2\u5668\u80fd\u7ed9\u51fa\u591a\u5927\u8870\u51cf\n613|         \uff08\u6bcf\u5341\u500d\u9891\u7a0b \\qty{80}{dB}\uff09\uff1f\n614|   \\item \u91cf\u7a0b\u4e3a $\\pm\\qty{1}{V}$ \u7684 $16$ \u4f4d\u8f6c\u6362\u5668\uff1a\u6c42\u91cf\u5316\u6b65\u957f\uff1b\\qty{10}{\\micro V}\n615|         \u4fe1\u53f7\u7ecf $1000$ \u500d\u653e\u5927\u540e\u5360\u591a\u5c11\u4e2a\u53f0\u9636\uff0c\u566a\u58f0\n616|         \u6709\u76ca\u8fd8\u662f\u6709\u5bb3\uff1f\n617|   \\item \u6570\u5b57\u9501\u76f8\uff1a\u8ba1\u7b97\u673a\u5c06\u6bcf\u4e2a\u91c7\u6837\u503c\u4e58\u4ee5\n618|         $\\cos(2\\pi f_0nT_s)$\uff0c\u5e76\u5bf9 $N$ \u4e2a\u91c7\u6837\u503c\u53d6\u5e73\u5747\u3002\u91c7\u6837\u7387\u4e3a \\qty{20}{kS/s} \u65f6\uff0c\n619|         \u6c42 \\qty{1}{s} \u5e73\u5747\u6240\u9700\u7684 $N$\uff1b\u767d\u566a\u58f0\u964d\u4f4e\u4e86\u591a\u5c11\u500d\uff0c\n620|         \u4e0e\u6a21\u62df\u6ee4\u6ce2\u5668\u7684\u60c5\u5f62\u662f\u5426\u76f8\u540c\uff1f\n621|   \\item \u4ee5 \\qty{999}{S/s} \u5bf9 \\qty{1}{kHz} \u4fe1\u53f7\u91c7\u6837\uff1a\u8ba1\u7b97\u673a\u770b\u5230\u7684\n622|         \u662f\u4ec0\u4e48\uff1f\u8fd9\u4e0e\u9501\u76f8\u653e\u5927\u5668\u81ea\u8eab\u7684\n623|         \u539f\u7406\u6709\u4f55\u5173\u7cfb\uff1f\