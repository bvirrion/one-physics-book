igma$ \u5185\u7684\u573a\u4e0d\u968f\u65f6\u95f4\u53d8\u5316\uff0c\u5219\u79f0\u6d41\u52a8\u662f\\emph{\u7a33\u5b9a\u7684}\\index{\u7a33\u5b9a\u6d41\u52a8}\uff1a\n40| \u6b64\u65f6 $\\Sigma$ \u5185\u6240\u542b\u7684\u8d28\u91cf\u3001\u80fd\u91cf\u548c\u71b5\u5747\u4e3a\u5e38\u91cf\u3002\n41| \n42| \n43| \\end{definition}\n44|=\n45| \\begin{proposition}[\u8d28\u91cf\u5e73\u8861]\\label{prop:b2:open-systems:mass}\n46| \u8bbe\u5bc6\u5ea6\u4e3a $\\rho$ \u7684\u6d41\u4f53\u4ee5\u5e73\u5747\u901f\u7387 $c$ \u5782\u76f4\u7a7f\u8fc7\u9762\u79ef\u4e3a $S$ \u7684\u622a\u9762\uff0c\n47| \u5219\u901a\u8fc7\u8be5\u622a\u9762\u7684\\emph{\u8d28\u91cf\u6d41\u91cf}\\index{\u8d28\u91cf\u6d41\u91cf} $\\dot m = \\rho c S$\uff08\u5355\u4f4d\u4e3a \\unit{kg/s}\uff09\u3002\n48| \u5728\u7a33\u5b9a\u6d41\u52a8\u4e2d\uff0c\u6d41\u5165\u7684\u91cf\u7b49\u4e8e\u6d41\u51fa\u7684\u91cf\uff1a$\\sum_{\\text{in}}\\dot m = \\sum_{\\text{out}}\n49| \\dot m$\uff1b\u5bf9\u4e8e\u5355\u4e00\u80a1\u6d41\uff0c$\\dot m$ \u5728\u8fdb\u53e3\u4e0e\u51fa\u53e3\u5904\u76f8\u540c\uff0c\n50| $\\rho_1c_1S_1 = \\rho_2c_2S_2$\u2014\u2014\u5373\u5728\u622a\u9762\u4e0a\u5bf9 \\cref{ch:b2:fluid-kinematics} \u4e2d\u7684\u8fde\u7eed\u6027\u65b9\u7a0b\u79ef\u5206\u6240\u5f97\u3002\n51| \n52| \n53| \\end{proposition}\n54|=\n55| \\begin{proof}\n56| $\\Sigma$ \u5185\u7684\u8d28\u91cf\u4e0d\u53d8\uff0c\u6545\u901a\u91cf\u76f8\u4e92\u5e73\u8861\u3002\n57| \\end{proof}\n58|=\n59| \\section{\u5f00\u53e3\u7cfb\u7edf\u7684\u7b2c\u4e00\u5b9a\u5f8b}\n60|=\n61| \\begin{theorem}[\u5355\u80a1\u7a33\u5b9a\u6d41\u52a8\u7684\u80fd\u91cf\u5e73\u8861]\\label{thm:b2:open-systems:firstlaw}\n62| \u5bf9\u8d28\u91cf\u6d41\u91cf\u4e3a $\\dot m$ \u7684\u7a33\u5b9a\u6d41\u52a8\uff0c\u6d41\u4f53\u5728\u72b6\u6001 1 \u8fdb\u5165\u3001\u5728\u72b6\u6001 2 \u79bb\u5f00\uff0c\n63| \u5e76\u63a5\u6536\u6709\u7528\uff08\u8f74\uff09\u529f\u7387 $P_{\\text{u}}$ \u4e0e\u70ed\u529f\u7387 $P_{\\text{th}}$\uff0c\u5219\n64| \u6709\n65|=\n66| \\dot m\\,\\Big[(h_2 - h_1) + \\tfrac12(c_2^2 - c_1^2) + g(z_2 - z_1)\\Big]\n67| = P_{\\text{u}} + P_{\\text{th}} ,\n68|=\n69| \u6216\u8005\uff0c\u5bf9\u6bcf\u5355\u4f4d\u8d28\u91cf\u7a7f\u8fc7\u7cfb\u7edf\u7684\u6d41\u4f53\uff0c\n70|=\n71| \\Delta h + \\Delta\\big(\\tfrac12c^2\\big) + g\\,\\Delta z = w_{\\text{u}} + q .\n72|=\n73| \\emph{\u7113}\\index{\u7113\uff08\u6d41\u52a8\u4e2d\uff09} $h = u + Pv$ \u4ee3\u66ff\u5185\u80fd\uff1a$Pv$ \u662f\\emph{\u6d41\u52a8\u529f}\uff0c\n74| \u5373\u4e0a\u6e38\u6d41\u4f53\u628a\u5355\u4f4d\u8d28\u91cf\u63a8\u5165\u7cfb\u7edf\u6240\u505a\u7684\u529f\uff0c\u51cf\u53bb\u628a\u5b83\u63a8\u51fa\u7cfb\u7edf\u6240\u505a\u7684\u529f\u3002\n75|=\n76|=\n77| \\end{theorem}\n78|=\n79| \\begin{proof}\n80| \u8003\u8651\u7531 $t$ \u65f6\u523b $\\Sigma$ \u5185\u7684\u6d41\u4f53\u52a0\u4e0a\u5373\u5c06\u8fdb\u5165\u7684\u5fae\u5143 $\\dd m = \\dot m\\,\\dd t$ \u6240\u7ec4\u6210\u7684\u5c01\u95ed\u7cfb\u7edf\uff1b\n81| \u5728 $t + \\dd t$ \u65f6\u523b\uff0c\u5b83\u7531 $\\Sigma$ \u5185\u7684\u6d41\u4f53\uff08\u72b6\u6001\u4e0d\u53d8\uff0c\u7a33\u5b9a\uff09\u52a0\u4e0a\u5df2\u79bb\u5f00\u7684\u5fae\u5143 $\\dd m$ \u7ec4\u6210\u3002\n82| \u5176\u80fd\u91cf\u7684\u53d8\u5316\u4e3a $\\dd m\\,[(u_2 + \\tfrac12c_2^2 + gz_2) - (u_1 + \\tfrac12c_1^2 + gz_1)]$\u3002\n83| \u8be5\u7cfb\u7edf\u63a5\u6536\u4e86 $P_{\\text{u}}\\dd t + P_{\\text{th}}\\dd t$\uff0c\n84| \u4ee5\u53ca\u8fdb\u53e3\u5904\u538b\u529b\u6240\u505a\u7684\u529f $P_1S_1 \\times c_1\\dd t = P_1v_1\\,\\dd m$\uff08\u5c06\u5fae\u5143\u63a8\u5165\uff09\uff0c\n85| \u51cf\u53bb\u51fa\u53e3\u5904\u7684\u529f $P_2v_2\\,\\dd m$\u3002\n86| \u5bf9\u8be5\u5c01\u95ed\u7cfb\u7edf\u5e94\u7528\u7b2c\u4e00\u5b9a\u5f8b\uff0c\u5e76\u5229\u7528 $u + Pv = h$\uff0c\u5373\u5f97\u7ed3\u8bba\u3002\n87| \n88| \n89| \\end{proof}\n90|=\n91|=\n92|=\n93|=\n94|=\n95|=\n96|=\n97|=\n98|=\n99|=\n100|=\n101|=\n102|=\n103|=\n104|=\n105|=\n106|=\n107|=\n108|=\n109|=\n110|=\n111|=\n112|=\n113|=\n114|=",
