99\u516c\u5f0f\u3002\n20|=\n21|=\n22|=\n23|=\n24|{\\small \u9ece\u660e\u65f6\u5206\uff0c\u6e56\u9762\u4e0a\u51b0\u4e0e\u6c34\u5171\u5b58\uff1a\u5728\u7194\u70b9\u5904\uff0c\n25|\u4e24\u76f8\u6bcf\u5343\u514b\u7684\u81ea\u7531\u7113\u76f8\u7b49\uff0c\u4e00\u4e2a\u5fae\u5c0f\u7684\u538b\u5f3a\u6216\u6e29\u5ea6\u53d8\u5316\n26|\u5373\u53ef\u6253\u7834\u5e73\u8861\u2014\u2014\n27|\u514b\u62c9\u4f69\u9f99\u659c\u7387\u7ed9\u51fa\u53d8\u5316\u7684\u5e45\u5ea6\u3002}\n28|=\n29|=\n30|\\section{\u57fa\u672c\u6052\u7b49\u5f0f\u53ca\u5176\u53d8\u91cf}\n31|=\n32|\\begin{proposition}[\u57fa\u672c\u6052\u7b49\u5f0f]\\label{prop:b2:thermodynamic-potentials:identity}\n33|\u5bf9\u7ec4\u6210\u56fa\u5b9a\u7684\u5c01\u95ed\u7cfb\u7edf\uff0c\u5185\u80fd\n34|\u89c6\u4e3a\u71b5\u4e0e\u4f53\u79ef\u7684\u51fd\u6570\uff0c\u6ee1\u8db3\n35|=\n36|=\n37|=\n38|=\n39|=\n40|\u4e14\u7113 $H = U + PV$ \u6ee1\u8db3 $\\dd H = T\\,\\dd S + V\\,\\dd P$\u3002\n41|\u6bcf\u4e2a\u51fd\u6570\u5728\u5176\\emph{\u81ea\u7136\u53d8\u91cf}\\index{\u81ea\u7136\n42|\u53d8\u91cf}\uff08$(S,V)$ \u5bf9\u5e94 $U$\uff0c$(S,P)$ \u5bf9\u5e94 $H$\uff09\uff0c\u5305\u542b\n43|\u7cfb\u7edf\u7684\u5168\u90e8\u70ed\u529b\u5b66\u4fe1\u606f\uff1a\u5176\u504f\u5bfc\u6570\u7ed9\u51fa\u5176\u4f59\n44|\u72b6\u6001\u53c2\u91cf\u3002\u7b2c\u4e8c\u5b9a\u5f8b\u9009\u51fa\u5b64\u7acb\u7cfb\u7edf\uff08\u56fa\u5b9a $U$\uff0c$V$\uff09\u7684\u5e73\u8861\u6001\uff0c\n45|\u5373 $S$ \u6700\u5927\u7684\u72b6\u6001\u3002\n46|=\n47|=\n48|=\n49|\u5bf9\u53ef\u9006\u8fc7\u7a0b\uff0c\u70ed\u529b\u5b66\u7b2c\u4e00\u5b9a\u5f8b $\\dd U = \\delta Q_{\\text{rev}}\n50|+ \\delta W_{\\text{rev}} = T\\,\\dd S - P\\,\\dd V$\uff0c\u4ec5\u6d89\u53ca\u72b6\u6001\u51fd\u6570\uff0c\n51|\u56e0\u800c\u5bf9\u5e73\u8861\u6001\u4e4b\u95f4\u7684\u4efb\u610f\u65e0\u7a77\u5c0f\u53d8\u5316\u5747\u6210\u7acb\u3002\n52|\u5bf9 $H$ \u52a0\u4e0a $\\dd(PV)$\u3002\n53|=\n54|=\n55|\\begin{remark}[\u4e3a\u4f55\u9700\u8981\u65b0\u51fd\u6570]\\label{rem:b2:thermodynamic-potentials:why}\n56|\u5b9e\u9a8c\u901a\u5e38\u5e76\u975e\u5728\u56fa\u5b9a\u71b5\u4e0b\u8fdb\u884c\u3002\u5316\u5b66\u5bb6\u7684\u70e7\u74f6\u5904\u4e8e\n57|\u5ba4\u6e29\u548c\u5927\u6c14\u538b\u5f3a\u4e4b\u4e0b\uff1b\u4e00\u4e2a\n58|\u7f6e\u4e8e\u70ed\u6e90\u4e2d\u7684\u6d3b\u585e\u5728\u56fa\u5b9a $T$ \u4e0b\u5de5\u4f5c\u3002\u4eba\u4eec\u9700\u8981\u8fd9\u6837\u7684\u51fd\u6570\uff0c\u5176\n59|\u81ea\u7136\u53d8\u91cf\u4e3a $(T,V)$ \u4e0e $(T,P)$\uff0c\u5e76\u4e14\u5728\u8fd9\u4e9b\u6761\u4ef6\u4e0b\u5b83\u4eec\u6240\u8d77\u7684\n60|\u4f5c\u7528\uff0c\u6070\u5982 $S$ \u5728\u5b64\u7acb\u7cfb\u7edf\u4e2d\u6240\u8d77\u7684\u4f5c\u7528\uff1a\u5224\u65ad\n61|\u7cfb\u7edf\u5411\u4f55\u65b9\u6f14\u5316\uff0c\u4ee5\u53ca\u5b83\u80fd\u8f93\u51fa\u591a\u5c11\u529f\u3002\u4e00\u79cd\n62|\\emph{\u52d2\u8ba9\u5fb7\u53d8\u6362}\u2014\u2014\u51cf\u53bb $TS$\uff0c\u5c06 $S$ \u6362\u4e3a $T$ \u4f5c\u4e3a\n63|\u81ea\u53d8\u91cf\u2014\u2014\u7531\u6b64\u6784\u9020\u4e86\u5b83\u4eec\u3002\n64|=\n65|=\n66|\\section{\u81ea\u7531\u80fd\u4e0e\u81ea\u7531\u7113}\n67|=\n68|\\begin{definition}[\u4ea5\u59c6\u970d\u5179\u81ea\u7531\u80fd\uff0c\u5409\u5e03\u65af\u81ea\u7531\u7113]\\label{def:b2:thermodynamic-potentials:FG}\n69|=\n70|F = U - TS \\quad\\text{(\\emph{\u81ea\u7531\u80fd}\\index{\u81ea\u7531\u80fd})}, \\qquad\n71|G = H - TS = U + PV - TS \\quad\\text{(\\emph{\u81ea\u7531\u7113}\\index{\u81ea\u7531\u7113})}.\n72|=\n73|\u4e8c\u8005\u5747\u4e3a\u72b6\u6001\u51fd\u6570\uff0c\u5c5e\u4e8e\u5e7f\u5ef6\u91cf\uff0c\u5355\u4f4d\u4e3a\u7126\u8033\u3002\n74|=\n75|=\n76|\\begin{theorem}[\u5fae\u5206\u4e0e\u5bfc\u51fa\u91cf]\\label{thm:b2:thermodynamic-potentials:dFdG}\n77|=\n78|=\n79|=\n80|=\n81|\u56e0\u6b64\uff0c\u5728 $(T,V)$ \u4e3a $F$ \u7684\u81ea\u7136\u53d8\u91cf\u3001$(T,P)$ \u4e3a $G$ \u7684\u81ea\u7136\u53d8\u91cf\u65f6\uff0c\n82|=\n83|=\n84|=\n85|=\n86|=\n87|=\n88|\u5e76\u7531\u5409\u5e03\u65af\u2013\u4ea5\u59c6\u970d\u5179\u5173\u7cfb\u5f97 $U = F - T(\\partial F/\\partial T)_V =\n89|-T^2\\,\\partial(F/T)/\\partial T$\uff0c$H = -T^2\\,\\partial(G/T)/\\partial T$\u3002\n90|\u53ea\u8981\u77e5\u9053 $F(T,V)$ \u6216 $G(T,P)$\uff0c\u5c31\u638c\u63e1\u4e86\u4e00\u5207\uff1a\u72b6\u6001\u65b9\u7a0b\u3001\n91|\u71b5\u3001\u5185\u80fd\u4e0e\u70ed\u5bb9\u3002\n92|=\n93|=\n94|=\n95|$\\dd F = \\dd U - T\\dd S - S\\dd T = -S\\dd T - P\\dd V$\uff1b\u5bf9 $G$\n96|\u540c\u7406\uff08\u7531 $\\dd H$ \u51fa\u53d1\uff09\u3002\u8bfb\u51fa\u504f\u5bfc\u6570\uff1b\u5bf9\u5409\u5e03\u65af\u2013\u4ea5\u59c6\u970d\u5179\u5173\u7cfb\uff0c\n97|$F - T\\,\\partial_TF = F + TS = U$ \u4e14 $\\partial_T(F/T) = (T\\partial_TF -\n98|F)/T^2 = -U/T^2$\u3002\n99|=\n100|=\n101|\\begin{example}[\u7406\u60f3\u6c14\u4f53]\\label{ex:b2:thermodynamic-potentials:perfect}\n102|\u5bf9 $n$ \u6469\u5c14\uff0c$U = nc_{V}T + U_0$ \u4e0e $S = nc_V\\ln T + nR\\ln V + S_0$\n103|\u7ed9\u51fa $F(T,V) = -nRT\\ln V + f(T)$\uff1a\u4e8e\u662f $P = -\\partial_VF = nRT/V$\n104|\u2014\u2014\u72b6\u6001\u65b9\u7a0b\u7531 $F$ \u5bfc\u51fa\u2014\u2014\u800c $S = -\\partial_TF$\n105|\u518d\u7ed9\u51fa\u71b5\u3002\u5728\u53d8\u91cf $(T,P)$ \u4e0b\uff0c$G(T,P) = nRT\\ln P +\n106|g(T)$\uff0c\u6545 $V = \\partial_PG = nRT/P$\uff0c\u800c\\emph{\u6469\u5c14}\u81ea\u7531\u7113\n107|$\\mu(T,P) = \\mu^\\circ(T) + RT\\ln(P/P^\\circ)$\u2014\u2014\u5373\\emph{\u5316\u5b66\n108|\u52bf}\\index{\u5316\u5b66\u52bf}\u2014\u2014\u6c14\u4f53\u7684\u5316\u5b66\u52bf\u968f\u538b\u5f3a\u589e\u5927\u800c\u589e\u5927\uff1a\n109|\u6c14\u4f53\u7531\u9ad8 $\\mu$ \u6d41\u5411\u4f4e $\\mu$\uff0c\u6b64\u5904\u5373\u7531\u9ad8\n110|\u538b\u6d41\u5411\u4f4e\u538b\u3002\n111|=\n112|=",
