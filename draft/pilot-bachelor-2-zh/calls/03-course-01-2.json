 "result": "1| \\chapter{\u7406\u60f3\u6d41\u4f53\uff1a\u6b27\u62c9\u4e0e\u4f2f\u52aa\u5229}\\label{ch:b2:euler-bernoulli}\n2|=\n3| \u628a\u4e00\u5f20\u7eb8\u7684\u8fb9\u7f18\u62ff\u5728\u624b\u91cc\uff0c\u5bf9\u7740\u7eb8\u9762\u4e0a\u65b9\u5439\u6c14\uff0c\u7eb8\u4f1a\u5411\u4e0a\u626c\u8d77\u3002\n4| \u6253\u5f00\u6dcb\u6d74\u7684\u6c34\u9f99\u5934\uff0c\u6d74\u5e18\u4f1a\u5411\u5185\u98d8\u3002\u4e00\u53ea\u673a\u7ffc\u80fd\u6258\u8d77\u4e09\u767e\u5428\uff0c\n5| \u662f\u56e0\u4e3a\u6c14\u6d41\u7ecf\u8fc7\u4e0a\u8868\u9762\u65f6\u6bd4\u7ecf\u8fc7\u4e0b\u8868\u9762\u65f6\u6d41\u52a8\u5f97\u66f4\u5feb\u3002\n6| \u8fd9\u4e09\u79cd\u73b0\u8c61\u8bf4\u7684\u662f\u540c\u4e00\u4ef6\u4e8b\uff1a\\emph{\u6d41\u4f53\u6d41\u52a8\u8d8a\u5feb\u7684\u5730\u65b9\uff0c\u538b\u5f3a\u8d8a\u4f4e}\u3002\u672c\u7ae0\n7| \u5728\u6700\u7b80\u5355\u7684\u6a21\u578b\u4e2d\u5199\u51fa\u6d41\u4f53\u5fae\u56e2\u7684\u725b\u987f\u7b2c\u4e8c\u5b9a\u5f8b\uff0c\u6240\u7528\u6a21\u578b\u4e3a\n8| \\emph{\u7406\u60f3}\u6d41\u4f53\uff08\u53ea\u53d7\u538b\u5f3a\u4f5c\u7528\uff0c\u6ca1\u6709\u6469\u64e6\uff09\uff0c\u5e76\u7531\u6b64\u63a8\u51fa\n9| \u4f2f\u52aa\u5229\u5b9a\u7406\uff0c\u5373\u6d41\u7ebf\u4e0a\u7684\u80fd\u91cf\u5e73\u8861\u5173\u7cfb\uff0c\u5176\u5e94\u7528\n10| \u8303\u56f4\u5e7f\u6cdb\uff0c\n11| \u4ece\u7ba1\u9053\u4e2d\u7684\u6d41\u91cf\u8ba1\uff0c\n12| \u76f4\u5230\u98de\u673a\u7684\u7a7a\u901f\u6307\u793a\u5668\u3002\n13|=\n14| \\section{\u6b27\u62c9\u65b9\u7a0b}\n15|=\n16| \\begin{proposition}[\u6d41\u4f53\u5fae\u56e2\u6240\u53d7\u7684\u538b\u5f3a\u529b]\\label{prop:b2:euler-bernoulli:pressure}\n17| \\index{\u538b\u5f3a\u529b\uff08\u4f53\u79ef\u5bc6\u5ea6\uff09}\n18| \u5468\u56f4\u6d41\u4f53\u4f5c\u7528\u5728\u4f53\u79ef\u4e3a\n19| $\\dd\\tau$ \u7684\u5fae\u56e2\u4e0a\u7684\u538b\u5f3a\u529b\u5408\u529b\u4e3a\n20|=\n21|=\n22|=\n23| \u538b\u5f3a\u4f5c\u4e3a\u4e00\u79cd\u4f53\u79ef\u529b\u8d77\u4f5c\u7528\uff0c\u5176\u5bc6\u5ea6\u4e3a $-\\operatorname{\\vect{grad}}P$\uff0c\n24| \u65b9\u5411\u7531\u9ad8\u538b\u6307\u5411\u4f4e\u538b\u3002\n25| \\end{proposition}\n26|=\n27| \\begin{proof}\n28| \u5728\\cref{thm:b2:fluid-kinematics:continuity}\u6240\u7528\u7684\u5c0f\u76d2\u5b50\u4e0a\uff0c\u4f4d\u4e8e\n29| $x$ \u548c $x + \\dd x$ \u5904\u7684\u4e24\u4e2a\u9762\u6cbf $x$ \u65b9\u5411\u5206\u522b\u53d7\u5230 $+P(x)\\dd y\\dd z$ \u548c $-P(x + \\dd x)\\dd y\\dd z$\uff0c\n30| \u5408\u529b\u4e3a $-\\partial_xP\\,\\dd x\\dd y\\dd z$\uff1b\u5bf9 $y$ \u548c $z$ \u65b9\u5411\u540c\u7406\u3002\n31| \\end{proof}\n32|=\n33| \\begin{definition}[\u7406\u60f3\u6d41\u4f53]\\label{def:b2:euler-bernoulli:perfect}\n34| \\index{\u7406\u60f3\u6d41\u4f53}\n35| \u82e5\u76f8\u90bb\u5fae\u56e2\u4e4b\u95f4\u552f\u4e00\u7684\u63a5\u89e6\u529b\u662f\u538b\u5f3a\uff0c\u5219\u79f0\u8be5\u6d41\u4f53\u4e3a\n36| \\emph{\u7406\u60f3\u6d41\u4f53}\uff0c\u538b\u5f3a\u603b\u662f\u6cd5\u5411\u4f5c\u7528\u4e8e\u6bcf\u4e2a\u9762\uff0c\n37| \u4e0d\u5b58\u5728\u5207\u5411\uff08\u7c98\u6027\uff09\u5e94\u529b\u3002\u8fd9\u4e00\u6a21\u578b\u662f\u7406\u60f3\u5316\u7684\uff0c\n38| \u5982\u4e0b\u4e00\u7ae0\u6240\u89e3\u91ca\uff0c\u5b83\u5728\u8fdc\u79bb\u58c1\u9762\u4e14\u96f7\u8bfa\u6570\u8f83\u5927\u65f6\u6210\u7acb\uff1a\n39| \u7ba1\u9053\u4e2d\u8fdc\u79bb\u7ba1\u58c1\u7684\u6c34\u3001\u8584\u8fb9\u754c\u5c42\u4e4b\u5916\u673a\u7ffc\u5468\u56f4\u7684\u7a7a\u6c14\u3001\n40| \u6d77\u9762\u4e0a\u7684\u6ce2\u6d6a\u3002\n41| \\end{definition}\n42|=\n43| \\begin{theorem}[\u6b27\u62c9\u65b9\u7a0b]\\label{thm:b2:euler-bernoulli:euler}\n44| \\index{\u6b27\u62c9\u65b9\u7a0b}\n45| \u5728\u4f3d\u5229\u7565\u53c2\u8003\u7cfb\u4e2d\uff0c\u5bc6\u5ea6\u4e3a $\\rho$ \u7684\u7406\u60f3\u6d41\u4f53\uff0c\u53d7\u91cd\u529b\u4f5c\u7528\uff0c\n46| \u5728\u6bcf\u4e00\u70b9\u6ee1\u8db3\n47| \\[\n48| \\rho\\Bigl(\\frac{\\partial\\vect v}{\\partial t} + (\\vect v\\cdot\\operatorname{\\vect{grad}})\n49| \\vect v\\Bigr) = -\\operatorname{\\vect{grad}}P + \\rho\\vect g ,\n50| \\]\n51| \u53f3\u7aef\u8fd8\u5e94\u52a0\u4e0a\u5176\u4ed6\u4efb\u4f55\u4f53\u79ef\u529b\u5bc6\u5ea6 $\\vect f_v$\uff08\u7535\u573a\u529b\u3001\n52| \u975e\u4f3d\u5229\u7565\u53c2\u8003\u7cfb\u4e2d\u7684\u60ef\u6027\u529b\uff09\u3002\u9759\u6b62\u65f6\uff0c\u5b83\u5316\u4e3a\n53| \u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\u4e2d\u7684\u9759\u529b\u5b66\u5b9a\u5f8b\n54| $\\operatorname{\\vect{grad}}P = \\rho\\vect g$\u3002\n55| \\end{theorem}\n56|=\n57| \\begin{proof}\n58| \u5bf9\u8d28\u91cf\u4e3a $\\rho\\,\\dd\\tau$ \u7684\u5fae\u56e2\u5e94\u7528\u725b\u987f\u7b2c\u4e8c\u5b9a\u5f8b\uff1a\u5176\n59| \u52a0\u901f\u5ea6\u4e3a\u968f\u4f53\u5bfc\u6570\n60| \uff08\\cref{thm:b2:fluid-kinematics:material}\uff09\uff0c\u6240\u53d7\u7684\u529b\u4e3a\u538b\u5f3a\u5408\u529b\n61| \u4e0e\u91cd\u529b $\\rho\\vect g\\,\\dd\\tau$\uff1b\u4e24\u8fb9\u540c\u9664\u4ee5 $\\dd\\tau$ \u5373\u53ef\u3002\n62| \\end{proof}\n63|=\n64| \\begin{example}[\u52a0\u901f\u8fd0\u52a8\u7684\u6c34\u7bb1]\\label{ex:b2:euler-bernoulli:tank}\n65| \u88c5\u6c34\u7684\u6c34\u7bb1\u653e\u5728\u4ee5\u52a0\u901f\u5ea6 $\\vect a$ \u884c\u9a76\u7684\u5361\u8f66\u4e0a\uff0c\n66| \u6c34\u5728\u5361\u8f66\u53c2\u8003\u7cfb\u4e2d\u5904\u4e8e\u9759\u6b62\u3002\u5728\u8be5\u53c2\u8003\u7cfb\u4e2d\uff0c\u53d6\u60ef\u6027\u529b $-\\rho\\vect a$ \u4ee3\u5165\u6b27\u62c9\u65b9\u7a0b\uff0c\n67| \u5f97 $\\operatorname{\\vect{grad}}P = \\rho(\\vect g - \\vect a)$\uff1a\u538b\u5f3a\n68| \u6cbf\u201c\u6709\u6548\u91cd\u529b\u201d $\\vect g - \\vect a$ \u7684\u65b9\u5411\u589e\u5927\uff0c\u81ea\u7531\u9762\n69| \uff08\u7b49\u538b\u9762\uff09\u4e0e\u4e4b\u5782\u76f4\uff0c\u5411\u540e\u503e\u659c\u7684\u89d2\u5ea6\u4e3a\n70| $\\arctan(a/g)$ --- \u5f53 $a = \\qty{2}{m/s^2}$ \u65f6\u4e3a \\qty{11}{\\degree}\u3002\u5728\n71| \u4ee5 $\\Omega$ \u65cb\u8f6c\u7684\u6c34\u6876\u4e2d\uff0c\u79bb\u5fc3\u529b $\\rho\\Omega^2r\\,\\vect e_r$\n72| \u7ed9\u51fa $P = P_0 + \\tfrac12\\rho\\Omega^2r^2 - \\rho gz$\uff0c\u81ea\u7531\u9762\u4e3a\n73| \u65cb\u8f6c\u629b\u7269\u9762 $z = \\Omega^2r^2/2g$\u3002\n74| \\end{example}\n75|=\n76|=\n77|=\n78|=\n79|=\n80|=\n81|=\n82|=\n83|=\n84|=\n85|=\n86|=\n87|=\n88|=\n89|=\n90|=\n91|=\n92|     \\node[font=\\footnotesize] at (0,-1.4) {\u52a0\u901f\u6c34\u7bb1\uff1a\u6db2\u9762 $\\perp \\vect g - \\vect a$};\n93|=\n94|=\n95|=\n96|=\n97|=\n98|=\n99|     \\node[font=\\footnotesize] at (0,-1.4) {\u65cb\u8f6c\u6c34\u6876\uff1a$z = \\Omega^2r^2/2g$};\n100|=\n101|=\n102|=\n103| {\\small \u5de6\uff1a\u6d41\u4f53\u76d2\u5b50\u5404\u9762\u4e0a\u7684\u538b\u5f3a\u529b\uff0c\n104| \u5f53 $P$ \u53d8\u5316\u65f6\u4e0d\u80fd\u76f8\u4e92\u62b5\u6d88\uff0c\u5176\u5408\u529b\u4e3a\u5355\u4f4d\u4f53\u79ef\n105| $-\\operatorname{\\vect{grad}}P$\u3002\u4e2d\u3001\u53f3\uff1a\u4e24\u79cd\u5728\u52a0\u901f\u53c2\u8003\u7cfb\u4e2d\u9759\u6b62\u7684\u6d41\u4f53\uff1b\n106| \u81ea\u7531\u9762\u5904\u5904\u4e0e\n107| \u6709\u6548\u91cd\u529b\u5782\u76f4\u3002}\n108|=\n109|=\n110| \\section{\u4f2f\u52aa\u5229\u5b9a\u7406}\n111|=",
