5\u5904\u6709\u901a\u7535\u5bfc\u7ebf\u3002\u504f\u8f6c\u8d8a\u660e\u663e\uff0c\n67| \u8bf4\u660e\u7535\u6d41\u8d8a\u8fd1\u6216\u8d8a\u5f3a\u3002\n68| \u9700\u8981\u6ce8\u610f\u7684\u662f\uff1a\u94c1\u8d28\u6c34\u7ba1\u3001\u78c1\u94c1\u4e43\u81f3\u5730\u78c1\u672c\u8eab\u90fd\u4f1a\u4f7f\u78c1\u9488\u504f\u8f6c\u2014\u2014\u56e0\u6b64\u53ea\u6709\n69| \u504f\u8f6c\u968f\u5f00\u5173\u7684\u901a\u65ad\u540c\u6b65\u53d8\u5316\uff0c\u624d\u80fd\u8bc1\u660e\u5b58\u5728\u7535\u6d41\u3002\n70| \\end{solution}\n71|=\n72| \\begin{solution}{exo:g8:electric-current-effects:12}\n73| \u7535\u6d41\u4f7f\u7ebf\u5708\u53d8\u6210\u78c1\u94c1\uff1b\u7ebf\u5708\u4e0e\u6846\u67b6\u5f02\u540d\u78c1\u6781\u76f8\u4e92\u5438\u5f15\uff0c\u540c\u540d\u78c1\u6781\u76f8\u4e92\u6392\u65a5\uff0c\n74| \u7ebf\u5708\u4fbf\u5411\u5bf9\u9f50\u7684\u4f4d\u7f6e\u8f6c\u52a8\u3002\u82e5\u4e0d\u6539\u53d8\u7535\u6d41\u65b9\u5411\uff0c\u7ebf\u5708\u8f6c\u5230\u5bf9\u9f50\u4f4d\u7f6e\u4fbf\u4f1a\u505c\u4e0b\u2014\u2014\n75| \u8f6c\u8fc7\u534a\u5708\u540e\u5373\u6296\u52a8\u5e76\u9759\u6b62\uff0c\u8fd9\u53ea\u662f\u4e00\u4e2a\u95e8\u95ed\u5408\u5668\uff0c\u800c\u4e0d\u662f\u7535\u52a8\u673a\u3002\n76| \u5728\u7ebf\u5708\u6070\u597d\u5bf9\u9f50\u65f6\u6539\u53d8\u7535\u6d41\u65b9\u5411\uff0c\u7ebf\u5708\u7684\u4e24\u6781\u968f\u4e4b\u5bf9\u8c03\uff1a\u539f\u5148\u7684\u5438\u5f15\u53d8\u4e3a\u6392\u65a5\uff0c\n77| \u5bf9\u9f50\u4f4d\u7f6e\u53cd\u800c\u6210\u4e86\u6700\u4e0d\u5229\u7684\u4f4d\u7f6e\uff0c\u7ebf\u5708\u4fbf\u4e0d\u65ad\u8ffd\u9010\u4e00\u4e2a\u6bcf\u8f6c\u8fc7\u534a\u5708\u5c31\u8eb2\u5f00\u7684\u76ee\u6807\u2014\u2014\n78| \u8fd9\u79cd\u6c38\u4e0d\u505c\u6b47\u7684\u8ffd\u9010\uff0c\u4e5f\u5c31\u662f\u8f6c\u52a8\u3002\n79| \\end{solution}\n80|=\n81| \\begin{solution}{pb:g8:electric-current-effects:1}\n82| \\textbf{1.} \u4e09\u4e2a\u6f14\u793a\u5b9e\u9a8c\\emph{\u4e32\u8054}\u5728\u540c\u4e00\u4e2a\u5e26\u5f00\u5173\u7684\u56de\u8def\u4e2d\uff1a\u540c\u4e00\u80a1\u7535\u6d41\u4f9d\u6b21\u6d41\u7ecf\n83| \u52a0\u70ed\u7684\u5bfc\u7ebf\u3001\u5c0f\u78c1\u9488\u9644\u8fd1\u7684\u5bfc\u7ebf\u548c\u7535\u89e3\u6db2\u2014\u2014\u4e00\u4e2a\u5f00\u5173\uff0c\u4e09\u79cd\u6548\u5e94\u3002\n84| \\textbf{2.} \u4e32\u8054\u7535\u8def\u7684\u89c4\u5f8b\uff1a\u540c\u4e00\u7535\u6d41\u6d41\u7ecf\u7c97\u5bfc\u7ebf\u548c\u7ec6\u5bfc\u7ebf\u65f6\u5927\u5c0f\u76f8\u540c\u3002\u4e0d\u540c\u7684\u53ea\u662f\n85| \u8def\u5f84\u2014\u2014\u7ec6\u5bfc\u7ebf\u53d7\u5230\u7684\u7535\u6d41\u963b\u788d\u66f4\u5927\uff0c\u56e0\u800c\u53d1\u70ed\u66f4\u660e\u663e\uff1a\u7535\u6d41\u76f8\u540c\uff0c\u53d7\u70ed\u4e0d\u540c\u3002\n86| \\textbf{3.} \u540c\u65f6\u5bf9\u8c03\u7535\u6c60\u7684\u6b63\u8d1f\u6781\\emph{\u5e76}\u5c06\u5bfc\u7ebf\u79fb\u5230\u6307\u5357\u9488\u7684\u53e6\u4e00\u4fa7\uff08\u6216\u628a\u6307\u5357\u9488\u8c03\u8f6c\uff09\uff1a\n87| \u4e24\u6b21\u53cd\u8f6c\u76f8\u4e92\u62b5\u6d88\uff0c\u78c1\u9488\u7684\u504f\u8f6c\u65b9\u5411\u4ecd\u6307\u5411\u4e1c\u3002\n88| \\textbf{4.} \u6c34\u4e2d\u7684\u4e24\u79cd\u5143\u7d20\u4ee5\u4e8c\u6bd4\u4e00\u7684\u6bd4\u4f8b\u5b58\u5728\u2014\u2014\u4ece\u4e00\u4e2a\u7535\u6781\u5f97\u5230\u7684\u6c14\u4f53\u4f53\u79ef\n89| \u662f\u53e6\u4e00\u4e2a\u7535\u6781\u7684\u4e24\u500d\u3002\n90| \\textbf{5.} \u53bb\u6389\u81ea\u884c\u65ad\u5f00\u7684\u89e6\u70b9\uff08\u5373\u9524\u5b50\u6446\u52a8\u65f6\u65ad\u5f00\u7684\u90a3\u90e8\u5206\uff09\uff1a\u7535\u78c1\u94c1\u4fbf\u4f1a\u5c06\n91| \u6be1\u5236\u7684\u9524\u5b50\u6301\u7eed\u5438\u4f4f\uff0c\u8d34\u5728\u94c3\u4e0a\u800c\u4e0d\u53d1\u58f0\u2014\u2014\u53c2\u89c2\u8005\u53ea\u80fd\u542c\u5230\u4e00\u58f0\u8f7b\u5fae\u7684\u201c\u549a\u201d\uff0c\n92| \u6b64\u540e\u4fbf\u518d\u65e0\u58f0\u54cd\u3002\n93| \\textbf{6.} \u5728\u5e9f\u6599\u7bb1\u65c1\uff0c\u64cd\u4f5c\u5458\u65ad\u5f00\u7ebf\u5708\u7684\u5f00\u5173\uff1a\u78c1\u6027\u6d88\u5931\uff0c\u94c1\u5757\u843d\u4e0b\u3002\u94dd\u5757\u4ecd\u7559\u5728\n94| \u539f\u5904\uff0c\u56e0\u4e3a\u65e0\u8bba\u662f\u5929\u7136\u78c1\u94c1\u8fd8\u662f\u7535\u6d41\u4ea7\u751f\u7684\u78c1\u94c1\uff0c\u90fd\u53ea\u80fd\u5438\u5f15\u94c1\u7c7b\u7269\u8d28\uff0c\u800c\u94dd\u4ece\u6765\n95| \u4e0d\u53d7\u5b83\u4eec\u7684\u5438\u5f15\u3002\n96| \\textbf{7.} \u7535\u6d41\u4ea7\u751f\u7684\u78c1\u4f53\uff0c\u5176\u78c1\u6781\u65b9\u5411\u968f\u7535\u6d41\u65b9\u5411\u800c\u5b9a\uff1a\u6539\u53d8\u5176\u4e2d\u4e00\u4e2a\uff0c\u53e6\u4e00\u4e2a\u4e5f\u968f\u4e4b\u6539\u53d8\u3002\n97| \\textbf{8.} \u7535\u6c60\u901a\u8fc7\\emph{\u6d88\u8017}\u81ea\u8eab\u50a8\u5b58\u7684\u5316\u5b66\u80fd\u6765\u9a71\u52a8\u7535\u9540\uff1b\u8981\u91cd\u65b0\u50a8\u5b58\u5316\u5b66\u80fd\uff0c\n98| \u5fc5\u987b\u4ece\u5916\u90e8\u8f93\u5165\u80fd\u91cf\u3002\u82e5\u7535\u6c60\u80fd\u9760\u5b83\u81ea\u5df1\u6240\u505a\u7684\u529f\u6765\u8865\u5145\u81ea\u8eab\u7684\u80fd\u91cf\uff0c\u90a3\u5c31\u53c8\u56de\u5230\u4e86\n99| \u6c38\u52a8\u673a\u2014\u2014\u80fd\u91cf\u7684\u6536\u652f\u65e0\u6cd5\u81ea\u5df1\u5e73\u8861\u81ea\u5df1\u3002\n100| \\textbf{9.} \u6293\u53d6\uff1a\u5f00\u5173\u95ed\u5408\uff0c\u7ebf\u5708\u78c1\u5316\uff0c\u5939\u4f4f\u5c0f\u73a9\u5177\u3002\u6446\u52a8\uff1a\u7535\u6d41\u4fdd\u6301\uff0c\u6293\u529b\u4fdd\u6301\u2014\u2014\n101| \u78c1\u6548\u5e94\u6b63\u5728\u5de5\u4f5c\u3002\u677e\u5f00\uff1a\u5f00\u5173\u5728\u6ed1\u69fd\u4e0a\u65b9\u65ad\u5f00\uff0c\u78c1\u6027\u6d88\u5931\uff0c\u5956\u54c1\u843d\u4e0b\u3002\n102| \\textbf{10.} \u7535\u78c1\u94c1\u4f9d\u8d56\u7535\u6d41\u800c\u5b58\u5728\uff1a\u7535\u6c60\u7535\u91cf\u4e0b\u964d\uff0c\u7535\u6d41\u51cf\u5f31\uff0c\u78c1\u529b\u968f\u4e4b\u51cf\u5f31\uff0c\u6293\u529b\u4e5f\u968f\u4e4b\u51cf\u5f31\u2014\u2014\n103| \u53ef\u4ee5\u968f\u65f6\u901a\u65ad\uff0c\u4ee3\u4ef7\u4fbf\u662f\u5bf9\u7535\u6d41\u7684\u4f9d\u8d56\u3002\uff08\u6c38\u4e45\u78c1\u94c1\u4ece\u4e0d\u4f1a\u51cf\u5f31\uff0c\u4e5f\u4ece\u4e0d\u4f1a\u677e\u5f00\u3002\uff09\n104| \\textbf{11.} \u5728\u7535\u6d41\u76f8\u540c\u7684\u60c5\u51b5\u4e0b\uff0c\u531d\u6570\u8d8a\u591a\uff0c\u78c1\u94c1\u8d8a\u5f3a\uff0c\u6293\u529b\u8d8a\u7262\u3002\u53e6\u4e00\u79cd\u8c03\u8282\u65b9\u5f0f\u662f\n105| \u6539\u53d8\u7535\u6d41\u672c\u8eab\u7684\u5f3a\u5f31\u2014\u2014\u5373\\emph{\u7535\u6d41\u5f3a\u5ea6}\uff0c\u5c06\u5728\u4e0b\u4e00\u7ae0\u4e2d\u6d4b\u91cf\u3002\n106| \\textbf{12.} \u4f8b\u5982\uff1a\u201c\u70ed\u6548\u5e94\uff1a\u4fdd\u9669\u4e1d\uff0c\u4f1a\u9996\u5148\u6309\u8981\u6c42\u7194\u65ad\u3002\u78c1\u6548\u5e94\uff1a\u6293\u5a03\u5a03\u673a\uff0c\u542c\u4ece\u6307\u4ee4\u6293\u53d6\u4e0e\u91ca\u653e\u3002\n107| \u5316\u5b66\u6548\u5e94\uff1a\u7535\u9540\u69fd\uff0c\u7528\u7535\u6c60\u7684\u8010\u5fc3\u628a\u52fa\u5b50\u9540\u4e0a\u94f6\u3002\u201d\n108|=\n109| \\end{solution}\n110|=",
