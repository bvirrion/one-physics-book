 "result": "\\begin{remark}[\u4e09\u89d2\u8f85\u52a9\u8bb0\u6cd5]\\label{rem:g8:ohms-law:triangle}\n\u6709\u4e9b\u5b66\u4e60\u8005\u4f1a\u5728\u4e00\u4e2a\u5c0f\u4e09\u89d2\u5f62\u4e2d\u6807\u51fa $U$\u3001$R$ \u548c $I$\uff0c\u906e\u4f4f\u6240\u6c42\u5b57\u6bcd\u5373\u53ef\u8bfb\u51fa\u516c\u5f0f\u3002\n\u4f5c\u4e3a\u62d0\u6756\uff0c\u8fd9\u6ca1\u6709\u5bb3\u5904\u2014\u2014\u4f46\u4f60\u7684\u4ee3\u6570\u8fd0\u7b97\u73b0\u5728\u80fd\u5728\u4e00\u884c\u4e4b\u5185\u8bda\u5b9e\u5730\u628a $U = R I$ \u53d8\u5f62\uff0c\u800c\u8fd9\u79cd\u8bda\u5b9e\u7684\u505a\u6cd5\u9002\u7528\u4e8e\u4f60\u5c06\u9047\u5230\u7684\u6bcf\u4e00\u4e2a\u516c\u5f0f\uff0c\u65e0\u8bba\u662f\u5426\u6709\u4e09\u89d2\u5f62\u3002\u4eca\u5e74\u53ef\u4ee5\u4f9d\u9760\u8fd9\u6839\u62d0\u6756\uff1b\u4f46\u8981\u8ba1\u5212\u7740\u5b66\u4f1a\u72ec\u7acb\u884c\u8d70\u3002\n\\end{remark}\n\n\\section{\u7535\u963b\u89e3\u91ca\u4e86\u4ec0\u4e48}\n\n\\begin{example}[\u65e7\u8c1c\u9898\uff0c\u4e00\u4efd\u8d26\u5355\u5168\u89e3\u51b3]\\label{ex:g8:ohms-law:mysteries}\n\u5206\u538b\u4e4b\u8c1c\uff1a\u4e32\u8054\u706f\u6ce1\u5171\u7528\u540c\u4e00\u7535\u6d41 $I$\uff0c\u7531 $U = R I$ \u53ef\u77e5\uff0c\u7535\u963b\u8d8a\u5927\uff0c\u5206\u5f97\u7684\u7535\u538b\u8d8a\u5927\u2014\u2014\u90a3\u4e2a\u51fa\u529b\u66f4\u591a\u8005\u7684\u8f83\u5927\u7535\u538b\u964d\uff0c\u5982\u4eca\u53ef\u4ee5\u7b97\u51fa\u4e86\u3002\n\u5e76\u8054\u4e00\u7ae0\u4e2d\u7684\u88ab\u8282\u6d41\u652f\u8def\uff1a\u90a3\u6839\u7ec6\u957f\u5bfc\u7ebf\u589e\u52a0\u4e86\u7535\u963b\uff0c\u800c $I = U/R$ \u4f7f\u8be5\u652f\u8def\u7684\u5206\u6d41\u51cf\u5c0f\u3002\n\u77ed\u8def\uff1a\u65c1\u8def\u7684\u7535\u963b\u51e0\u4e4e\u4e3a\u96f6\uff0c\u6545 $I = U/R$ \u731b\u589e\u2014\u2014\u90a3\u573a\u201c\u66b4\u51b2\u201d\u539f\u6765\u4e00\u76f4\u662f\u9664\u4ee5\u8fd1\u4e4e\u96f6\u7684\u6570\u3002\n\u56db\u5e74\u5b9a\u6027\u7684\u7535\u8def\u77e5\u8bc6\uff0c\u4e00\u6761\u5b9a\u5f8b\u5168\u90e8\u7ed3\u7b97\u3002\n\\end{example}\n\n\\begin{example}[\u5bfc\u7ebf\u7684\u7535\u963b\uff0c\u4ee5\u7c73\u8ba1]\\label{ex:g8:ohms-law:wires}\n\u5bfc\u7ebf\u7684\u7535\u963b\u968f\u957f\u5ea6\u589e\u52a0\u800c\u589e\u5927\uff0c\u968f\u7c97\u7ec6\u589e\u52a0\u800c\u51cf\u5c0f\u2014\u2014\u7ec6\u957f\u7684\u5bfc\u7ebf\u597d\u6bd4\u5d0e\u5c96\u7684\u5c71\u8def\uff0c\u77ed\u7c97\u7684\u5bfc\u7ebf\u5219\u50cf\u4e00\u6761\u9ad8\u901f\u516c\u8def\u3002\u56e0\u6b64\uff0c\u7535\u5de5\u4e3a\u8017\u7535\u5927\u7684\u7528\u7535\u5668\u914d\u7c97\u7535\u7f06\uff0c\u52a0\u70ed\u7ebf\u5708\u5219\u523b\u610f\u91c7\u7528\u53c8\u957f\u53c8\u7ec6\u7684\u7535\u963b\u5408\u91d1\u2014\u2014\u540c\u4e00\u6761\u5b9a\u5f8b\u65e2\u80fd\u4f7f\u706f\u6ce1\u53d1\u5149\uff0c\u4e5f\u80fd\u4f7f\u70e4\u9762\u5305\u673a\u53d1\u70ed\uff0c\u539f\u56e0\u5c31\u5728\u4e8e\uff1a\u7535\u963b\u662f\u63a8\u52a8\u529b\u8017\u8d39\u4e4b\u5904\uff0c\u800c\u8017\u8d39\u6389\u7684\u63a8\u52a8\u529b\uff0c\u6b63\u5982\u80fd\u91cf\u4e00\u7ae0\u660e\u5e74\u5c06\u8bc1\u5b9e\u7684\u90a3\u6837\uff0c\u5316\u4e3a\u70ed\u91cf\u3002\n\\end{example}\n\n\\begin{remark}[\u5b9a\u5f8b\u7684\u9002\u7528\u8303\u56f4]\\label{rem:g8:ohms-law:limits}\n\u6b27\u59c6\u5b9a\u5f8b\u662f\u7535\u963b\u5668\u7684\u5b9a\u5f8b\uff0c\u800c\u975e\u666e\u904d\u9002\u7528\u7684\u89c4\u5f8b\u3002\u6d4b\u91cf\\emph{\u767d\u70bd\u706f\u6ce1}\u7684\u4f0f\u5b89\u7279\u6027\u66f2\u7ebf\uff0c\u5404\u70b9\u4f1a\u504f\u79bb\u76f4\u7ebf\uff1a\u706f\u4e1d\u968f\u7535\u6d41\u589e\u5927\u800c\u53d1\u70ed\uff0c\u800c\u70bd\u70ed\u7684\u91d1\u5c5e\u7535\u963b\u66f4\u5927\u2014\u2014$R$ \u5e76\u4e0d\u4fdd\u6301\u4e0d\u53d8\u3002\u4e8c\u6781\u7ba1\u3001\u7535\u52a8\u673a\u548c\u6d3b\u4f53\u76ae\u80a4\u7684\u7279\u6027\u66f2\u7ebf\u4e5f\u4f1a\u5f2f\u66f2\uff0c\u5404\u6709\u5176\u539f\u56e0\u3002\u8fc7\u539f\u70b9\u7684\u76f4\u7ebf\u662f\u7535\u963b\u5668\u7684\u7279\u5f81\uff0c\u800c\u975e\u7269\u8d28\u7684\u666e\u904d\u7279\u5f81\u2014\u2014\u5728\u7528\u5b9a\u5f8b\u4e4b\u524d\uff0c\u52a1\u5fc5\u5148\u67e5\u770b\u5143\u4ef6\u7684\u7279\u6027\u66f2\u7ebf\u3002\n\\end{remark}\n\n\\section{\u7ec3\u4e60}\n\n\\begin{exercise}[$\\star$]\\label{exo:g8:ohms-law:1}\n\u7535\u963b\u6d4b\u91cf\u7684\u662f\u4ec0\u4e48\uff1f\u5199\u51fa\u5b83\u7684\u5355\u4f4d\u548c\u7b26\u53f7\uff0c\u5e76\u5199\u51fa\u6b27\u59c6\u5b9a\u5f8b\u53ca\u5176\u4e09\u79cd\u53d8\u5f62\u3002\n\\end{exercise}\n\n\\begin{exercise}[$\\star$]\\label{exo:g8:ohms-law:2}\n\u5bf9\u4e8e\u4e00\u4e2a $30\\,\\Omega$ \u7684\u7535\u963b\u5668\uff0c\u5206\u522b\u5b8c\u6210\u4ee5\u4e0b\u4e24\u7ec4\u8ba1\u7b97\uff1a$U =\n\\qty{6}{V}$\uff0c\u6c42 $I = {?}$\uff1b\\ $I = \\qty{0.5}{A}$\uff0c\u6c42 $U = {?}$\u3002\n\\end{exercise}\n\n\\begin{exercise}[$\\star$]\\label{exo:g8:ohms-law:3}\n\u67d0\u5143\u4ef6\u5728 $I = \\qty{0.09}{A}$ \u65f6\uff0c\u5176\u4e24\u7aef\u7535\u538b $U = \\qty{4.5}{V}$\u3002\u6c42\u5b83\u7684\u7535\u963b\u3002\n\\end{exercise}\n\n\\begin{exercise}[$\\star$]\\label{exo:g8:ohms-law:4}\n\u5728\u7279\u6027\u66f2\u7ebf\u5b9e\u9a8c\u4e2d\uff0c\u771f\u6b63\u7684\u7535\u963b\u5668\u7684\u5404\u70b9\u63cf\u7ed8\u51fa\u4ec0\u4e48\u5f62\u72b6\uff1f\u8f83\u9661\u7684\u76f4\u7ebf\u8868\u793a\u4ec0\u4e48\uff1f\n\\end{exercise}\n\n\\begin{exercise}[$\\star$]\\label{exo:g8:ohms-law:5}\n\u7531\u672c\u7ae0\u7684\u8868\u683c\uff0c\u7528\u7b2c\u4e8c\u884c\u548c\u7b2c\u56db\u884c\u9a8c\u8bc1 $R$\u3002\u4e3a\u4ec0\u4e48\u4e24\u6b21\u5f97\u5230\u76f8\u540c\u7684\u6570\u503c\u662f\u5173\u952e\u6240\u5728\uff1f\n\\end{exercise}\n\n\\begin{exercise}[$\\star$]\\label{exo:g8:ohms-law:6}\n\u7535\u6c34\u58f6\u7684\u52a0\u70ed\u7ebf\u5708\u7535\u963b\u4e3a $25\\,\\Omega$\uff1b\u53e6\u4e00\u4e2a\u7535\u6c34\u58f6\u7684\u7535\u963b\u4e3a $35\\,\\Omega$\u3002\u63a5\u5728\u540c\u4e00\u5e02\u7535\u4e0a\uff0c\u54ea\u4e00\u4e2a\u901a\u8fc7\u7684\u7535\u6d41\u66f4\u5927\uff1f\u4e8c\u8005\u5404\u901a\u8fc7\u591a\u5927\u7535\u6d41\uff08\u4fdd\u7559\u4e00\u4f4d\u5c0f\u6570\uff09\uff1f\n\\end{exercise}\n\n\\begin{exercise}[$\\star$]\\label{exo:g8:ohms-law:7}\n\u5229\u7528 $U = R I$ \u89e3\u91ca\uff1a\u4e24\u4e2a\u4e32\u8054\u706f\u6ce1\u5171\u7528\u540c\u4e00\u7535\u6d41\uff0c\u7535\u963b\u8f83\u5927\u7684\u706f\u6ce1\u4e3a\u4f55\u5206\u5f97\u8f83\u5927\u7684\u7535\u538b\uff1f\n\\end{exercise}\n\n\\begin{exercise}[$\\star$]\\label{exo:g8:ohms-law:8}\n\u7528\u7535\u963b\u7684\u8bed\u8a00\u63cf\u8ff0\uff1a\u77ed\u8def\u65f6\u7684\u7535\u6d41\u66b4\u589e\uff1b\u65ad\u8def\u5f00\u5173\u65f6\u7684\u603b\u963b\u65ad\u3002\n\\end{exercise}\n\n\\begin{exercise}[$\\star\\star$]\\label{exo:g8:ohms-law:9}\n\u4e00\u4e2a\u7cbe\u5bc6\u6307\u793a\u706f\u5141\u8bb8\u901a\u8fc7\u7684\u7535\u6d41\u4e3a \\qty{20}{mA}\u3002\u82e5\u7535\u6e90\u4e3a \\qty{9}{V} \u7535\u6c60\uff0c\u706f\u6ce1\u672c\u8eab\u7ea6\u5206\u5f97 \\qty{2}{V} \u7535\u538b\uff0c\u5219\u5e94\u4e32\u8054\u591a\u5927\u7684\u7535\u963b\u5668\u6765\u4fdd\u62a4\u5b83\uff1f\uff08\u5148\u6c42\u7535\u963b\u5668\u5206\u5f97\u7684\u7535\u538b\uff0c\u518d\u6c42 $R$\u3002\uff09\n\\end{exercise}\n\n\\begin{exercise}[$\\star\\star$]\\label{exo:g8:ohms-law:10}\n\u5b9e\u6d4b\u67d0\u767d\u70bd\u706f\u6ce1\u7684\u4f0f\u5b89\u7279\u6027\uff1a\uff08\\qty{1}{V}\uff0c\\qty{0.25}{A}\uff09\uff0c\uff08\\qty{4}{V}\uff0c\\qty{0.5}{A}\uff09\u3002\u8bc1\u660e\u4e0d\u5b58\u5728\u540c\u4e00\u4e2a $R$ \u80fd\u540c\u65f6\u7b26\u5408\u8fd9\u4e24\u4e2a\u70b9\uff0c\u5e76\u8bf4\u660e\u66f2\u7ebf\u5f2f\u66f2\u80cc\u540e\u7684\u7269\u7406\u8fc7\u7a0b\u3002\n\\end{exercise}\n\n\\begin{exercise}[$\\star\\star$]\\label{exo:g8:ohms-law:11}\n\u4e24\u4e2a\u7535\u963b\u5668 $10\\,\\Omega$ \u548c $20\\,\\Omega$ \u4e32\u8054\u63a5\u5728 \\qty{6}{V} \u7535\u6e90\u4e0a\u3002\u5229\u7528\u4e32\u8054\u89c4\u5f8b\u53ca\u5404\u7535\u963b\u4e0a\u7684\u6b27\u59c6\u5b9a\u5f8b\uff0c\u6c42\u56de\u8def\u7535\u6d41\u4ee5\u53ca\u6bcf\u4e2a\u7535\u963b\u4e24\u7aef\u7684\u7535\u538b\u3002\uff08\u63d0\u793a\uff1a\u7535\u6d41 $I$ \u6ee1\u8db3 $6 = 10 I + 20 I$\u3002\uff09\n\\end{exercise}\n\n\\begin{exercise}[$\\star\\star\\star$]\\label{exo:g8:ohms-law:12}\n\u540c\u6837\u4e24\u4e2a\u7535\u963b\u5668\uff0c\u73b0\u6539\u4e3a\u5e76\u8054\u63a5\u5728 \\qty{6}{V} \u7535\u6e90\u4e0a\u3002\u6c42\u5404\u652f\u8def\u7535\u6d41\u53ca\u7535\u6c60\u7684\u603b\u7535\u6d41\uff1b\u518d\u6c42\u80fd\u4ece \\qty{6}{V} \u7535\u6e90\u83b7\u5f97\u540c\u6837\u603b\u7535\u6d41\u7684\u5355\u4e2a\u7b49\u6548\u7535\u963b $R$\u3002\u5c06 $R$ \u4e0e\u4e24\u4e2a\u7535\u963b\u5668\u5206\u522b\u6bd4\u8f83\uff0c\u5e76\u7528\u9053\u8def\u7684\u6bd4\u55bb\u8bf4\u660e\uff1a\u4e3a\u4ec0\u4e48\u5e76\u8054\u7684\u4e24\u4e2a\u7535\u963b\u5408\u8d77\u6765\u7684\u7535\u963b\u6bd4\u5176\u4e2d\u4efb\u4f55\u4e00\u4e2a\u90fd\u5c0f\u3002\n\\end{exercise}",
