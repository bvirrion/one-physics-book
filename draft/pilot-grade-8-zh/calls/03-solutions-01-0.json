 "result": "\\section*{\u7b2c \\ref{ch:g8:voltage-voltmeter} \u7ae0 --- \u7535\u538b\u4e0e\u7535\u538b\u8868}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:1}\n\u7535\u8def\u4e2d\u4e24\u70b9\u4e4b\u95f4\u7684\u201c\u7535\u529b\u63a8\u52a8\u529b\u201d\u2014\u2014\u597d\u6bd4\u7011\u5e03\u4e0a\u4e0b\u4e24\u7aef\u7684\u843d\u5dee\u63a8\u52a8\u6c34\u8f66\u3002\u5b83\u662f\u4e00\u4e2a\u5dee\u503c\uff0c\u56e0\u6b64\u9700\u8981\u4e24\u4e2a\u70b9\uff1b\u5176\u5355\u4f4d\u662f\u4f0f\u7279\uff0c\\unit{V}\u3002\n\\end{solution}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:2}\n\\qty{1.5}{V}\uff1b\\qty{4.5}{V}\uff1b\\qty{9}{V}\uff1b\\qty{12}{V}\uff1b\n\\qty{230}{V}\u3002\n\\end{solution}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:3}\n\u5b8c\u5168\u6ca1\u6709\u7535\u6d41\u2014\u2014\u6ca1\u6709\u95ed\u5408\u56de\u8def\u3002\u7535\u538b\u8868\u8bfb\u6570\u4e3a\u6ee1\u91cf\u7a0b\u7684\\qty{1.5}{V}\uff1a\u6709\u7535\u538b\u800c\u65e0\u7535\u6d41\u2014\u2014\u63a8\u52a8\u529b\u53ef\u4ee5\u7b49\u5f85\uff1b\u6ca1\u6709\u5b83\uff0c\u7535\u6d41\u5c31\u65e0\u6cd5\u5f00\u59cb\u6d41\u52a8\u3002\n\\end{solution}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:4}\n\u7535\u6d41\u8868\uff1a\u4e32\u8054\uff0c\u76f8\u5f53\u4e8e\u5728\u9053\u8def\u4e2d\u65ad\u5f00\u5904\u63a5\u5165\uff0c\u5bf9\u7535\u6d41\u51e0\u4e4e\u6ca1\u6709\u963b\u788d\u3002\u7535\u538b\u8868\uff1a\u5e76\u8054\uff0c\u4e0d\u5207\u65ad\u7535\u8def\uff0c\u963b\u788d\u51e0\u4e4e\u4e3a\u65e0\u7a77\u5927\u3002\u5e38\u89c1\u7684\u9519\u8bef\uff1a\u628a\u7535\u6d41\u8868\u63a5\u5728\u4e24\u7aef\u2014\u2014\u5e76\u8054\u2014\u2014\u5c31\u6210\u4e86\u5e26\u8868\u76d8\u7684\u77ed\u8def\u3002\n\\end{solution}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:5}\n\u5668\u4ef6\u8bbe\u8ba1\u6240\u9700\u7684\u63a8\u52a8\u529b\u3002\u5728\\qty{1.5}{V}\u4e0b\uff1a\u5fae\u5f31\u7684\u95ea\u70c1\u3002\u5728\\qty{6}{V}\u4e0b\uff1a\u8bbe\u8ba1\u7684\u4eae\u5ea6\u4e0e\u5bff\u547d\u3002\u5728\\qty{12}{V}\u4e0b\uff1a\u77ac\u95f4\u7684\u5f3a\u5149\uff0c\u968f\u540e\u706f\u4e1d\u70e7\u65ad\u3002\n\\end{solution}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:6}\n\u7535\u6c60\uff1a\\qty{4.5}{V}\uff1b\u706f\u6ce1\uff1a\\qty{4.5}{V}\uff1b\u5bfc\u7ebf\uff1a\u7ea6\u4e3a\\qty{0}{V}\u3002\u63a8\u52a8\u529b\u4f5c\u7528\u4e8e\u7528\u7535\u5668\u4e24\u7aef\u2014\u2014\u5bfc\u7ebf\u662f\u4e00\u6761\u5e73\u5766\u7684\u9053\u8def\u3002\n\\end{solution}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:7}\n\u7184\u706d\u7684\u706f\u6ce1\uff1a\\qty{0}{V}\uff1b\u65ad\u5f00\u7684\u5f00\u5173\uff1a\u5168\u90e8\\qty{4.5}{V}\uff0c\u7b49\u5f85\u4e8e\u7f3a\u53e3\u4e24\u7aef\u3002\u5728\u5f00\u5173\u95ed\u5408\u7684\u77ac\u95f4\uff0c\u4e8c\u8005\u4e92\u6362\u4f4d\u7f6e\uff1a\u95ed\u5408\u7684\u5f00\u5173\u4e24\u7aef\u964d\u81f3\u7ea6\u4e3a\u96f6\uff0c\u53d1\u5149\u7684\u706f\u6ce1\u627f\u62c5\u5168\u90e8\\qty{4.5}{V}\u3002\n\\end{solution}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:8}\n\u5b83\u62d2\u7edd\u8ba9\u7535\u6d41\u901a\u8fc7\uff1a\u963b\u788d\u51e0\u4e4e\u5b8c\u5168\uff0c\u81ea\u8eab\u51e0\u4e4e\u4e0d\u5206\u5f97\u7535\u6d41\uff0c\u56e0\u6b64\u706f\u6ce1\u4e2d\u7684\u7535\u6d41\u4e0e\u53d1\u5149\u90fd\u7167\u5e38\u8fdb\u884c\uff0c\u4eff\u4f5b\u672a\u88ab\u5bdf\u89c9\u3002\n\\end{solution}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:9}\n\u4e09\u8282\u7535\u6c60\u9996\u5c3e\u76f8\u63a5\uff1a$1.5 + 1.5 + 1.5 = \\qty{4.5}{V}$\u3002\u82e5\u5176\u4e2d\u4e00\u8282\u53cd\u63a5\uff0c\u5219\u4e0e\u53e6\u5916\u4e24\u8282\u76f8\u4e92\u62b5\u6d88\uff1a$1.5 + 1.5 - 1.5 = \\qty{1.5}{V}$\u2014\u2014\u8fd9\u6b63\u662f\u591a\u5e74\u524d\u624b\u7535\u7b52\u7684\u7591\u95ee\uff0c\u5982\u4eca\u7528\u4f0f\u7279\u6765\u89e3\u91ca\u3002\n\\end{solution}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:10}\n\u65b0\u7535\u6c60\uff1a\u7565\u9ad8\u4e8e\u989d\u5b9a\u503c\u2014\u2014\u4eae\u5ea6\u9971\u6ee1\u3002\u968f\u7740\u4f7f\u7528\u65f6\u95f4\u589e\u957f\uff0c\u7535\u6c60\u7535\u538b\u964d\u81f3\\qty{11.2}{V}\uff0c\u706f\u6ce1\u4eae\u5ea6\u8f7b\u5fae\u4f4e\u4e8e\u8bbe\u8ba1\u7684\u4eae\u5ea6\u3002\u6ca1\u6709\u635f\u574f\uff1a\u7535\u538b\u53ea\u4f1a\u4f4e\u4e8e\u989d\u5b9a\u503c\uff1b\u8fd9\u4e00\u7ea6\u5b9a\u60e9\u7f5a\u7684\u662f\u8d85\u51fa\uff0c\u800c\u975e\u4e0d\u8db3\u3002\n\\end{solution}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:11}\n\u7535\u538b\u8868\u4e32\u5728\u9053\u8def\u4e2d\uff0c\u51e0\u4e4e\u5b8c\u5168\u963b\u788d\u7535\u6d41\uff1a\u7535\u6d41\u51e0\u4e4e\u505c\u6b62\uff0c\u706f\u6ce1\u4e0d\u4eae\u3002\u7535\u538b\u8868\u8ba9\u56de\u8def\u4e2d\u552f\u4e00\u7684\u63a8\u52a8\u529b\u4f5c\u7528\u4e8e\u5176\u81ea\u8eab\uff0c\u8bfb\u6570\u63a5\u8fd1\u7535\u6c60\u7684\u5168\u90e8\u7535\u538b\u2014\u2014\u5bf9\u4e8e\u4e00\u4e2a\u63a5\u9519\u7684\u7535\u8def\uff0c\u8fd9\u662f\u4e00\u4e2a\u6b63\u786e\u7684\u6570\u503c\uff1a\u6709\u542f\u53d1\u610f\u4e49\uff0c\u4f46\u4e0d\u4f1a\u8d77\u706b\u3002\n\\end{solution}\n\n\\begin{solution}{exo:g8:voltage-voltmeter:12}\n\u5e76\u8054\u65f6\uff0c\u6bcf\u53ea\u706f\u6ce1\u76f4\u63a5\u8de8\u63a5\u5728\u7535\u6c60\u4e24\u7aef\uff1a\u6bcf\u53ea\u5747\u4e3a\\qty{4.5}{V}\u2014\u2014\u6ee1\u989d\u5b9a\u63a8\u52a8\u529b\uff0c\u6ee1\u4eae\u5ea6\uff0c\u6b63\u5982\u65e7\u7684\u5e76\u8054\u89c4\u5219\u6240\u9884\u8a00\u7684\u90a3\u6837\u3002\u4e32\u8054\u65f6\uff0c\u4e24\u53ea\u706f\u6ce1\\emph{\u5206\u4eab}\\qty{4.5}{V}\u2014\u2014\u6bcf\u53ea\u7ea6\u4e3a\\qty{2.25}{V}\uff0c\u4e24\u53ea\u706f\u6ce1\u90fd\u5206\u5230\u7684\u7535\u538b\u4e0d\u8db3\uff0c\u53d1\u5149\u6697\u6de1\uff0c\u6b63\u5982\u65e7\u7684\u4e32\u8054\u89c4\u5219\u6240\u89c2\u5bdf\u5230\u7684\u90a3\u6837\u3002\u4e0b\u4e00\u7ae0\u4e4b\u540e\u7684\u7ae0\u8282\u5c06\u628a\u8fd9\u79cd\u5206\u914d\u5199\u6210\u7535\u538b\u7684\u89c4\u5f8b\u3002\n\\end{solution}\n\n\\begin{solution}{pb:g8:voltage-voltmeter:1}\n\\textbf{1.} \u5c06\u7535\u538b\u8868\u7684\u4e24\u6839\u8868\u7b14\u5206\u522b\u63a5\u5230\u7535\u6c60\u7684\u4e24\u4e2a\u63a5\u7ebf\u67f1\u4e0a\u2014\u2014\u8de8\u63a5\uff0c\u5373\u5e76\u8054\uff1b\u7535\u538