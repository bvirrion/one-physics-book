u3001\u8fc7\u4eae\u7684\u591c\u665a\uff0c\u6700\u53ef\u80fd\u7684\u7ed3\u679c\u662f\u706f\u6ce1\u5f88\u5feb\u70e7\u6bc1\u3002\u8fd9\u4e00\u7ea6\u5b9a\u60e9\u7f5a\u7684\u662f\u8d85\u51fa\u3002\n\\textbf{8.} \u7f13\u6162\u7684\u635f\u4f24\uff0c\u6e29\u548c\u5374\u771f\u5b9e\uff1a\\qty{8}{V}\u7684\u5668\u4ef6\u63a5\u4e0a\\qty{9}{V}\uff0c\u5c31\u662f\u6301\u7eed\u7684\u8fc7\u538b\u2014\u2014\u5b83\u80fd\u5de5\u4f5c\uff0c\u4f46\u4f1a\u53d1\u70ed\uff0c\u5e76\u4e14\u8fc5\u901f\u8001\u5316\u3002\u989d\u5b9a\u503c\u5c31\u662f\u989d\u5b9a\u503c\uff1b\u201c\u5dee\u4e0d\u591a\u201d\u6b63\u662f\u706f\u4e1d\u65e9\u592d\u7684\u539f\u56e0\u3002\n\\textbf{9.} \u7535\u6c60\u7684\u63a8\u52a8\u529b\u5b8c\u6574\u5730\u7b49\u5f85\u4e8e\u552f\u4e00\u7684\u771f\u5b9e\u7f3a\u53e3\u2014\u2014\u65ad\u5f00\u7684\u5f00\u5173\u4e24\u7aef\uff1b\u7a7a\u8f7d\u7684\u706f\u6ce1\u4e0d\u901a\u8fc7\u7535\u6d41\uff0c\u56e0\u6b64\u4e24\u7aef\u65e0\u7535\u538b\u3002\u5f00\u5173\u95ed\u5408\u540e\uff1a\u5f00\u5173\u4e24\u7aef\u63a5\u8fd1\\qty{0}{V}\uff0c\u706f\u6ce1\u4e24\u7aef\u63a5\u8fd1\\qty{3.1}{V}\u2014\u2014\u63a8\u52a8\u529b\u4ece\u7f3a\u53e3\u8f6c\u79fb\u5230\u4e86\u7528\u7535\u5668\u4e0a\u3002\n\\textbf{10.} \u8fd9\u6839\u826f\u597d\u7684\u5bfc\u7ebf\u662f\u4e00\u6761\u5e73\u5766\u7684\u9053\u8def\uff1a\u5b83\u8f93\u9001\u7535\u6d41\u800c\u4e0d\u6d88\u8017\u63a8\u52a8\u529b\u2014\u2014\u6240\u6709\u7535\u538b\u90fd\u7559\u7ed9\u7528\u7535\u5668\u3002\n\\textbf{11.} \u201c\u63d2\u5ea7\u7535\u538b\u4e3a\\qty{230}{V}\u2014\u2014\u662f\u8fd9\u4e2a\u62bd\u5c49\u91cc\u6700\u5f3a\u7535\u6c60\u7684\u4e94\u5341\u500d\uff1b\u63a8\u52a8\u529b\u653e\u5927\u4e94\u5341\u500d\uff0c\u5c31\u4f1a\u8ba9\u540c\u6837\u6f6e\u6e7f\u7684\u53cc\u624b\u4e2d\u6d41\u8fc7\u4e94\u5341\u500d\u7684\u7535\u6d41\uff0c\u5fc3\u810f\u4f1a\u5728\u767e\u5206\u4e4b\u51e0\u5b89\u57f9\u65f6\u505c\u6b62\u8df3\u52a8\u3002\u4e8b\u6545\u5c31\u5230\u6b64\u4e3a\u6b62\uff0c\u5c31\u5728\u8fd9\u4e2a\u62bd\u5c49\u91cc\u3002\u201d\n\\textbf{12.} \u4f