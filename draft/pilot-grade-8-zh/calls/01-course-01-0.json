 "result": "\\chapter{\u7535\u6d41\u53ca\u5176\u6548\u5e94}\\label{ch:g8:electric-current-effects}\n=\n\u7535\u6d41\u5728\u4e94\u5e74\u7684\u7535\u8def\u5b66\u4e60\u4e2d\u9ed8\u9ed8\u5730\u53d1\u6325\u7740\u4f5c\u7528\uff1a\u7167\u4eae\u706f\u4e1d\u3001\u5e26\u52a8\u7535\u52a8\u673a\u3001\u53d1\u51fa\u8702\u9e23\u58f0\u3002\n\u672c\u5e74\u6211\u4eec\u5f00\u59cb\u8fdb\u884c\u5b9a\u91cf\u7814\u7a76\u2014\u2014\u6d4b\u91cf\u3001\u5355\u4f4d\u548c\u5b9a\u5f8b\u2014\u2014\u9996\u5148\u6765\u76d8\u70b9\u4e00\u4e0b\uff1a\u7535\u6d41\u7a76\u7adf\u80fd\\emph{\u505a}\u4ec0\u4e48\uff1f\n\u4e8b\u5b9e\u8bc1\u660e\uff0c\u6709\u4e09\u79cd\u6548\u5e94\uff0c\u6574\u4e2a\u7535\u5b66\u4e16\u754c\u6b63\u662f\u7531\u5b83\u4eec\u6784\u5efa\u8d77\u6765\u7684\u3002\n=\n\n=\n\\section{\u4e09\u79cd\u6548\u5e94}\n=\n\n\\begin{proposition}[\u7535\u6d41\u7684\u6548\u5e94]\\label{prop:g8:electric-current-effects:three}\n\u7535\u6d41\u901a\u8fc7\u7269\u8d28\u65f6\uff0c\u4f1a\u8868\u73b0\u51fa\u4e09\u79cd\u6548\u5e94\uff1a\n\\begin{enumerate}\n  \\item \\emph{\u70ed\u6548\u5e94}\\index{\u70ed\u6548\u5e94}\uff1a\u6bcf\u4e00\u4e2a\u7535\u6d41\u90fd\u4f1a\u4f7f\u5b83\u6d41\u7ecf\u7684\u5bfc\u4f53\u53d1\u70ed\u2014\u2014\u5728\u826f\u597d\u7684\u5bfc\u7ebf\u4e2d\u6e29\u548c\uff0c\u5728\u7ec6\u5bfc\u7ebf\u6216\u8fc7\u8f7d\u7684\u5bfc\u7ebf\u4e2d\u5267\u70c8\uff0c\u800c\u5728\u706f\u4e1d\u548c\u70e4\u9762\u5305\u673a\u4e2d\u5219\u88ab\u6709\u610f\u5730\u52a0\u70ed\u81f3\u767d\u70ed\uff1b\n  \\item \\emph{\u78c1\u6548\u5e94}\\index{\u78c1\u6548\u5e94}\uff1a\u7535\u6d41\u4f7f\u5176\u5468\u56f4\u4ea7\u751f\u78c1\u6027\u2014\u2014\u5bfc\u7ebf\u80fd\u4f7f\u9644\u8fd1\u7684\u6307\u5357\u9488\u6307\u9488\u504f\u8f6c\uff0c\u800c\u7ed5\u6210\u7ebf\u5708\u7684\u5bfc\u7ebf\u5219\u6210\u4e3a\u771f\u6b63\u5177\u6709\u78c1\u6781\u7684\u78c1\u4f53\uff0c\u4e14\u53ef\u968f\u610f\u5f00\u5173\uff1b\n  \\item \\emph{\u5316\u5b66\u6548\u5e94}\\index{\u5316\u5b66\u6548\u5e94}\uff1a\u7535\u6d41\u901a\u8fc7\u67d0\u4e9b\u6db2\u4f53\u65f6\uff0c\u4f1a\u5f15\u8d77\u5316\u5b66\u53d8\u5316\u2014\u2014\u4f8b\u5982\u5c06\u6c34\u5206\u89e3\u4e3a\u4e24\u79cd\u6c14\u4f53\uff0c\u7ed9\u6c64\u5319\u9540\u94f6\uff0c\u4ee5\u53ca\u4e3a\u6bcf\u4e00\u8282\u7535\u6c60\u5145\u7535\u548c\u653e\u7535\u3002\n\\end{enumerate}\n\\end{proposition}\n\n\\begin{example}[\u70ed\u6548\u5e94\u7684\u5e94\u7528]\\label{ex:g8:electric-current-effects:heating}\n\u6709\u610f\u5229\u7528\u7684\u4f8b\u5b50\uff1a\u70e4\u9762\u5305\u673a\u53d1\u7ea2\u7684\u52a0\u70ed\u4e1d\u3001\u6c34\u58f6\u5185\u9690\u85cf\u7684\u7ebf\u5708\u3001\u8001\u5f0f\u706f\u6ce1\u767d\u70ed\u7684\u706f\u4e1d\uff0c\u4ee5\u53ca\u88ab\u8bbe\u8ba1\u4e3a\u4f1a\u5148\u7194\u65ad\u7684\u4fdd\u9669\u4e1d\u3002\n\u4e0d\u5e0c\u671b\u51fa\u73b0\u7684\u60c5\u51b5\uff1a\u624b\u673a\u5145\u7535\u5668\u53d1\u70ed\uff0c\u7b14\u8bb0\u672c\u7535\u8111\u5e95\u90e8\u53d1\u70eb\u2014\u2014\u8fd8\u6709\u77ed\u8def\u7684\u5371\u5bb3\uff0c\u4f60\u5728\u524d\u9762\u5df2\u5c06\u5b83\u5f53\u4f5c\u574f\u4eba\u7684\u6807\u5fd7\u6765\u7814\u7a76\u3002\n\u540c\u4e00\u79cd\u6548\u5e94\uff0c\u65e2\u662f\u4ec6\u4eba\u4e5f\u662f\u5371\u9669\uff0c\u5176\u5f3a\u5f31\u53d6\u51b3\u4e8e\u7535\u6d41\u6709\u591a\u5927\u2014\u2014\u8fd9\u4e00\u201c\u5242\u91cf\u201d\uff0c\u6211\u4eec\u5c06\u5728\u4e0b\u4e00\u7ae0\u5b66\u4e60\\emph{\u6d4b\u91cf}\u3002\n\\end{example}\n\n\\begin{omfigure}\n\\includegraphics[width=0.5\\linewidth]{images/book1/ai/g8-current-heating-coil.jpg}\n\n{\\small \u70ed\u6548\u5e94\u7684\u53d1\u5149\u73b0\u8c61\uff1a\u7535\u6d41\u901a\u8fc7\u70e4\u9762\u5305\u673a\u7684\u7535\u963b\u4e1d\uff0c\u4f7f\u5176\u52a0\u70ed\u81f3\u53d1\u7ea2\u3002}\n\\end{omfigure}\n\n\\section{\u7535\u6d41\u4ea7\u751f\u78c1\u6027}\n\n\\begin{example}[\u6307\u5357\u9488\u63ed\u793a\u5bfc\u7ebf\u7684\u79d8\u5bc6]\\label{ex:g8:electric-current-effects:oersted}\n\u4e24\u4e2a\u4e16\u7eaa\u524d\uff0c\u4e00\u4f4d\u7269\u7406\u5b66\u5bb6\u5728\u8bfe\u5802\u4e0a\u6ce8\u610f\u5230\uff0c\u6bcf\u5f53\u4ed6\u5728\u65c1\u8fb9\u7684\u5b9e\u9a8c\u53f0\u4e0a\u63a5\u901a\u7535\u8def\u65f6\uff0c\u6307\u5357\u9488\u7684\u6307\u9488\u90fd\u4f1a\u5fae\u5fae\u6296\u52a8\u3002\n\u8fd9\u79cd\u6296\u52a8\u2014\u2014\u51e0\u4e4e\u53ea\u662f\u6307\u9488\u7684\u4e00\u70b9\u98a4\u52a8\u2014\u2014\u662f\u4eba\u4eec\u9996\u6b21\u770b\u5230\u7535\u4e0e\u78c1\u4e4b\u95f4\u7684\u8054\u7cfb\uff0c\u800c\u5728\u6b64\u4e4b\u524d\uff0c\u8fd9\u4e24\u95e8\u5b66\u79d1\u5c31\u50cf\u5929\u6c14\u4e0e\u97f3\u4e50\u4e00\u6837\u6beb\u4e0d\u76f8\u5e72\u3002\n\u628a\u6307\u5357\u9488\u653e\u5728\u5bfc\u7ebf\u65c1\u8fb9\u5e76\u63a5\u901a\u7535\u6d41\uff1a\u6307\u9488\u4f1a\u5411\u4e00\u4fa7\u504f\u8f6c\uff1b\u5c06\u7535\u6d41\u53cd\u5411\uff0c\u6307\u9488\u5219\u5411\u53e6\u4e00\u4fa7\u504f\u8f6c\u3002\n\u7535\u6d41\u4f1a\u5728\u81ea\u8eab\u5468\u56f4\u4ea7\u751f\u78c1\u6027\uff0c\u4e14\u78c1\u6027\u5177\u6709\u65b9\u5411\u3002\n\\end{example}\n\n\\begin{definition}[\u7535\u78c1\u94c1]\\label{def:g8:electric-current-effects:electromagnet}\n\\emph{\u7535\u78c1\u94c1}\\index{\u7535\u78c1\u94c1}\u662f\u7531\u7edd\u7f18\u5bfc\u7ebf\u7ed5\u6210\u7684\u7ebf\u5708\u2014\u2014\u901a\u5e38\u7ed5\u5728\u94c1\u82af\u4e0a\u2014\u2014\u5728\u6709\u7535\u6d41\u901a\u8fc7\u65f6\u5177\u6709\u78c1\u6027\u7684\u88c5\u7f6e\uff1a\u5b83\u5177\u6709\u5317\u6781\u548c\u5357\u6781\uff0c\u5e76\u80fd\u5438\u5f15\u94c1\u8d28\u7269\u4f53\u3002\n\u4e0e\u4efb\u4f55\u5929\u7136\u78c1\u77f3\u4e0d\u540c\uff0c\u5b83\u53d7\u5f00\u5173\u63a7\u5236\uff1a\u7535\u6d41\u63a5\u901a\uff0c\u78c1\u6027\u5373\u6709\uff1b\u7535\u6d41\u65ad\u5f00\uff0c\u78c1\u6027\u5373\u6d88\u5931\uff1b\u7535\u6d41\u53cd\u5411\uff0c\u78c1\u6781\u968f\u4e4b\u5bf9\u8c03\u3002\n\\end{definition}\n\n\\begin{omfigure}\n\\begin{tikzpicture}[scale=0.85]\n  \\draw[thick, fill=omExo, fill opacity=0.3]\n    (1.2,1.0) rectangle (5.4,1.9);\n  \\foreach \\x in {1.5,2.1,...,5.1} {\n    \\draw[very thick, omDef] (\\x,0.82) arc (200:340:0.35 and 0.5);\n  }\n  \\draw[thick, omDef] (1.3,0.95) -- (0.4,0.4);\n  \\draw[thick, omDef] (5.3,0.95) -- (6.2,0.4);\n  \\node[below, font=\\small] at (0.5,0.3) {\u63a5\u7535\u6c60};\n  \\node[above, font=\\small] at (3.3,2.05) {\u7ebf\u5708\u4e2d\u7684\u94c1\u82af};\n  \\draw[thick] (7.4,1.05) ellipse (0.32 and 0.14);\n  \\draw[thick] (8.15,1.3) ellipse (0.32 and 0.14);\n  \\draw[thick] (7.5,1.6) ellipse (0.32 and 0.14);\n  \\node[right, font=\\small] at (8.7,1.3)\n    {\u56de\u5f62\u9488\uff1a\u5f00\u5173\u95ed\u5408\u65f6\u88ab\u5438\u4f4f};\n\\end{tikzpicture}\n\n{\\small \u7535\u78c1\u94c1\uff1a\u7ebf\u5708\u4e0e\u7535\u6d41\u4ea7\u751f\u78c1\u6027\uff0c\u5f00\u5173\u53ef\u4ee5\u4f7f\u5176\u4ea7\u751f\u3001\u6d88\u5931\u6216\u7ffb\u8f6c\u3002}\n\\end{omfigure}\n\n\\begin{example}[\u53ef\u5f00\u5173\u7684\u78c1\u6027\u65e0\u5904\u4e0d\u5728]\\label{ex:g8:electric-current-effects:uses}\n\u5e9f\u65e7\u6c7d\u8f66\u573a\u4e2d\u7684\u8d77\u91cd\u673a\u7528\u7535\u78c1\u94c1\u5438\u8d77\u6c7d\u8f66\uff0c\u518d\u65ad\u5f00\u5f00\u5173\u5c06\u5176\u653e\u4e0b\u2014\u2014\u7528\u5929\u7136\u78c1\u77f3\u8bd5\u8bd5\u770b\u5c31\u77e5\u9053\u96be\u5904\u4e86\u3002\n\u7535\u52a8\u95e8\u9501\u3001\u7ee7\u7535\u5668\u7684\u5494\u55d2\u58f0\u3001\u95e8\u94c3\u7684\u9524\u5b50\uff08\u7535\u78c1\u94c1\u5c06\u9524\u5b50\u5438\u5411\u94c3\u8eab\uff0c\u5207\u65ad\u81ea\u8eab\u7535\u6d41\u540e\u53c8\u5f39\u56de\uff1a\u8fd9\u79cd\u55d2\u55d2\u58f0\u5c31\u662f\u78c1\u6027\u7684\u89c4\u5f8b\u4f53\u73b0\uff09\u3001\u8001\u5f0f\u7535\u8bdd\u7684\u542c\u7b52\uff0c\u4ee5\u53ca\u6700\u91cd\u8981\u7684\u2014\u2014\u6bcf\u4e00\u53f0\u7535\u52a8\u673a\uff1a\u7535\u6d41\u4ea7\u751f\u7684\u78c1\u6027\u6bcf\u79d2\u949f\u63a8\u65a5\u6c38\u78c1\u4f53\u6210\u5343\u4e0a\u4e07\u6b21\u3002\n\u78c1\u6548\u5e94\u662f\u7535\u6c14\u65f6\u4ee3\u7684\u201c\u808c\u8089\u201d\u3002\n\\end{example}\n\n\\begin{method}[\u7ed5\u5236\u7535\u78c1\u94c1]\\label{met:g8:electric-current-effects:wind}\n\\begin{enumerate}\n  \\item \u5c06\u4e00\u5230\u4e24\u7c73\u957f\u7684\u7ec6\u7edd\u7f18\u5bfc\u7ebf\u7d27\u5bc6\u3001\u6574\u9f50\u5730\u7ed5\u5728\u4e00\u6839\u5927\u94c1\u9489\u6216\u87ba\u6813\u4e0a\uff0c\u4fdd\u7559\u4e24\u7aef\u4e3a\u81ea\u7531\u7aef\uff1b\n  \\item \u901a\u8fc7\u5f00\u5173\u5c06\u4e24\u7aef\u8fde\u63a5\u5230\u7535\u6c60\u4e0a\uff08\u4e0d\u8981\u957f\u65f6\u95f4\u76f4\u63a5\u8fde\u63a5\u2014\u2014\u7ebf\u5708\u51e0\u4e4e\u76f8\u5f53\u4e8e\u77ed\u8def\uff0c\u4f1a\u53d1\u70ed\uff1a\u70ed\u6548\u5e94\u5728\u5b9e\u9a8c\u4e2d\u8d77\u7740\u4fdd\u62a4\u4f5c\u7528\uff09\uff1b\n  \\item \u77ed\u6682\u95ed\u5408\u5f00\u5173\uff1a\u9489\u5e3d\u5438\u4f4f\u56de\u5f62\u9488\uff1b\u65ad\u5f00\u5f00\u5173\uff1a\u56de\u5f62\u9488\u843d\u4e0b\uff1b\n  \\item \u7528\u6307\u5357\u9488\u68c0\u9a8c\uff1a\u7ebf\u5708\u7684\u4e24\u7aef\u8868\u73b0\u4e3a\u5317\u6781\u548c\u5357\u6781\uff0c\u5e76\u4e14\u5728\u7535\u6c60\u53cd\u63a5\u65f6\u5bf9\u8c03\u3002\n\\end{enumerate}\n\u531d\u6570\u8d8a\u591a\uff0c\u5438\u529b\u8d8a\u5f3a\uff1a\u901a\u8fc7\u7ed5\u7ebf\u6765\u8c03\u8282\u78c1\u6027\u7684\u201c\u5242\u91cf\u201d\u3002\n\\end{method}\n=",
