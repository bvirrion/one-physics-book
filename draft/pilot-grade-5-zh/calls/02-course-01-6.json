 "result": "1| \\chapter{\u4e32\u8054\u548c\u5e76\u8054\u7535\u8def}\\label{ch:g5:series-parallel-circuits}\n2|=\n3| \u6709\u4e00\u53ea\u706f\u6ce1\u574f\u4e86\uff0c\u6574\u4e32\u5f69\u706f\u90fd\u7184\u706d\u4e86\u2014\u2014\u8fd9\u5c31\u662f\u5355\u56de\u8def\u7684\u201c\u9b54\u5492\u201d\u3002\u53ef\u662f\u4f60\u5bb6\u53a8\u623f\u7684\u706f\u6ce1\u70e7\u574f\u65f6\uff0c\u5c4b\u91cc\u5176\u4ed6\u7684\u706f\u4f9d\u7136\u4eae\u7740\u3002\u6709\u4eba\u628a\u4f60\u5bb6\u7684\u7535\u8def\u63a5\u6210\u4e86\u66f4\u5de7\u5999\u7684\u65b9\u5f0f\u3002\u4eca\u5929\u6211\u4eec\u5c31\u6765\u5b66\u4e60\u5b83\uff1a\u652f\u8def\u63a5\u6cd5\u3002\n4| \n5| \n6| \n7|=\n8| \\section{\u4e24\u79cd\u63a5\u6cd5}\n9|=\n10| \u4f60\u5df2\u7ecf\u8ba4\u8bc6\u4e86\u7b2c\u4e00\u79cd\u63a5\u6cd5\uff1a\\emph{\u4e32\u8054}\\index{\u4e32\u8054}\uff0c\u6240\u6709\u5143\u4ef6\u4f9d\u6b21\u63a5\u5728\u540c\u4e00\u4e2a\u56de\u8def\u4e0a\uff0c\u597d\u50cf\u4e00\u4e32\u9879\u94fe\u4e0a\u7684\u73e0\u5b50\u3002\u4e0b\u9762\u4ecb\u7ecd\u7b2c\u4e8c\u79cd\u3002\n11| \n12| \\begin{definition}[\u5e76\u8054]\\label{def:g5:series-parallel-circuits:parallel}\n13| \u5f53\u7535\u8def\u5206\u6210\u82e5\u5e72\u6761\u72ec\u7acb\u7684\\emph{\u652f\u8def}\\index{\u652f\u8def}\u2014\u2014\u6bcf\u6761\u652f\u8def\u4e0a\u63a5\u4e00\u4e2a\u5143\u4ef6\u2014\u2014\u7136\u540e\u5206\u5f00\u53c8\u91cd\u65b0\u6c47\u5408\u65f6\uff0c\u79f0\u8fd9\u4e9b\u5143\u4ef6\u4e3a\\emph{\u5e76\u8054}\\index{\u5e76\u8054\u7535\u8def}\u3002\u9053\u8def\u5206\u5f00\u6216\u6c47\u5408\u7684\u5730\u65b9\u79f0\u4e3a\\emph{\u8282\u70b9}\\index{\u8282\u70b9}\u3002\u6bcf\u6761\u652f\u8def\u90fd\u662f\u4ece\u7535\u6c60\u7684\u4e00\u4e2a\u63a5\u7ebf\u67f1\u5230\u53e6\u4e00\u4e2a\u63a5\u7ebf\u67f1\u7684\u5b8c\u6574\u901a\u8def\u3002\n14| \\end{definition}\n15| \n16| \\begin{omfigure}\n17| \\begin{tikzpicture}[scale=0.8]\n18|   \\draw (0,0) to[battery1, l=battery] (0,3.2)\n19|     to[short] (2.2,3.2);\n20|   \\draw (2.2,3.2) to[short] (2.2,2.4)\n21|     to[lamp, l=bulb 1] (5.4,2.4) to[short] (5.4,3.2);\n22|   \\draw (2.2,3.2) to[short] (2.2,4.0)\n23|     to[lamp, l=bulb 2] (5.4,4.0) to[short] (5.4,3.2);\n24|   \\draw (5.4,3.2) to[short] (7.0,3.2) to[short] (7.0,0)\n25|     to[short] (0,0);\n26|   \\fill (2.2,3.2) circle (2pt);\n27|   \\fill (5.4,3.2) circle (2pt);\n28|   \\node[above, font=\\small] at (3.6,4.95) {\u4e24\u6761\u652f\u8def};\n29| \\end{tikzpicture}\n30| \n31| {\\small \u4e24\u53ea\u706f\u6ce1\u5e76\u8054\uff1a\u901a\u8def\u5728\u4e00\u4e2a\u8282\u70b9\u5904\u5206\u5f00\uff0c\u6bcf\u53ea\u706f\u6ce1\u5404\u8d70\u4e00\u6761\u652f\u8def\uff0c\u4e24\u6761\u652f\u8def\u5728\u56de\u5230\u7535\u6c60\u4e4b\u524d\u6c47\u5408\u3002}\n32| \\end{omfigure}\n33| \n34| \\begin{method}[\u8fde\u63a5\u65b9\u6cd5]\\label{met:g5:series-parallel-circuits:build}\n35| \u7528\u4e00\u8282\u7535\u6c60\u3001\u4e24\u53ea\u706f\u6ce1\u548c\u5bfc\u7ebf\u8fde\u63a5\uff1a\n36| \\begin{enumerate}\n37|   \\item \u5148\u628a\u7b2c\u4e00\u53ea\u706f\u6ce1\u5355\u72ec\u4e0e\u7535\u6c60\u8fde\u6210\u4e00\u4e2a\u7b80\u5355\u56de\u8def\u2014\u2014\u8fd9\u662f\u7b2c\u4e00\u6761\u652f\u8def\uff1b\n38|   \\item \u518d\u628a\u7b2c\u4e8c\u53ea\u706f\u6ce1\\emph{\u76f4\u63a5\u5e76\u6392\u63a5\u5728}\u7b2c\u4e00\u53ea\u706f\u6ce1\u4e0a\uff1a\u4ece\u706f\u6ce1 1 \u7684\u4e24\u4fa7\u5404\u5f15\u4e00\u6839\u5bfc\u7ebf\uff0c\u5206\u522b\u63a5\u5230\u706f\u6ce1 2 \u5bf9\u5e94\u7684\u4e24\u4fa7\u2014\u2014\u8fd9\u662f\u7b2c\u4e8c\u6761\u652f\u8def\uff1b\n39|   \\item \u7528\u624b\u6307\u6cbf\u6bcf\u6761\u652f\u8def\u63cf\u4e00\u904d\uff1a\u4ece $+$ \u51fa\u53d1\uff0c\u6bcf\u6761\u901a\u8def\u90fd\u5e94\u6070\u597d\u7ecf\u8fc7\u4e00\u53ea\u706f\u6ce1\uff0c\u7136\u540e\u5230\u8fbe $-$\u3002\n40| \\end{enumerate}\n41| \u4e24\u53ea\u706f\u6ce1\u90fd\u4f1a\u4eae\uff0c\u800c\u4e14\u90fd\u548c\u5355\u72ec\u4e00\u53ea\u706f\u6ce1\u65f6\u4e00\u6837\u4eae\u3002\n42| \\end{method}\n43| \n44| \\section{\u652f\u8def\u7684\u89c4\u5f8b}\n45| \n46| \\begin{proposition}[\u5e76\u8054\u7535\u8def\u7684\u89c4\u5f8b]\\label{prop:g5:series-parallel-circuits:rules}\n47| \u6bcf\u4e2a\u5143\u4ef6\u5404\u5360\u4e00\u6761\u652f\u8def\u65f6\uff0c\u6709\u4ee5\u4e0b\u51e0\u70b9\uff1a\n48| \\begin{enumerate}\n49|   \\item \\emph{\u72ec\u7acb\u6027}\uff1a\u67d0\u4e00\u6761\u652f\u8def\u65ad\u5f00\uff0c\u53ea\u5f71\u54cd\u90a3\u4e00\u6761\u652f\u8def\u2014\u2014\u62e7\u4e0b\u4e00\u53ea\u706f\u6ce1\uff0c\u53e6\u4e00\u53ea\u4ecd\u7136\u4eae\u7740\uff1b\n50|   \\item \\emph{\u4eae\u5ea6\u4e0d\u53d8}\uff1a\u6bcf\u53ea\u706f\u6ce1\u90fd\u548c\u5355\u72ec\u63a5\u5728\u7535\u8def\u4e2d\u65f6\u4e00\u6837\u4eae\u2014\u2014\u7535\u6c60\u7684\u201c\u63a8\u529b\u201d\u4e0d\u4f1a\u5728\u5404\u6761\u652f\u8def\u4e4b\u95f4\u5206\u644a\uff1b\n51|   \\item \\emph{\u63a7\u5236\u70b9}\uff1a\u652f\u8def\u4e2d\u7684\u5f00\u5173\u53ea\u63a7\u5236\u5b83\u6240\u5728\u7684\u90a3\u6761\u652f\u8def\uff1b\u4f4d\u4e8e\u5206\u5c94\u4e4b\u524d\u516c\u5171\u9053\u8def\u4e0a\u7684\u5f00\u5173\uff0c\u5219\u63a7\u5236\u6240\u6709\u652f\u8def\u3002\uff08\u4ee3\u4ef7\u662f\uff1a\u7535\u6c60\u540c\u65f6\u7ed9\u6bcf\u6761\u652f\u8def\u4f9b\u7535\uff0c\u56e0\u6b64\u8017\u7535\u66f4\u5feb\u3002\uff09\n52| \\end{enumerate}\n53| \\end{proposition}\n54| \n55| \\begin{example}[\u62e7\u706f\u6ce1\u5b9e\u9a8c\u518d\u505a\u4e00\u6b21]\\label{ex:g5:series-parallel-circuits:test}\n56| \u5bf9\u5e76\u8054\u7684\u8fd9\u4e24\u53ea\u706f\u6ce1\u505a\u4e0e\u524d\u9762\u4e32\u8054\u65f6\u540c\u6837\u7684\u5b9e\u9a8c\uff1a\u62e7\u4e0b\u706f\u6ce1 2\u3002\u706f\u6ce1 1 \u751a\u81f3\u4e0d\u95ea\u4e00\u4e0b\u2014\u2014\u5b83\u81ea\u5df1\u7684\u652f\u8def\u3001\u81ea\u5df1\u7684\u5b8c\u6574\u901a\u8def\u6ca1\u6709\u53d7\u5230\u5f71\u54cd\u3002\u628a\u706f\u6ce1 2 \u62e7\u56de\u53bb\uff0c\u518d\u62e7\u4e0b\u706f\u6ce1 1\uff1a\u706f\u6ce1 2 \u4f9d\u7136\u5e73\u9759\u5730\u4eae\u7740\u3002\u5355\u56de\u8def\u7684\u201c\u9b54\u5492\u201d\u88ab\u6253\u7834\u4e86\uff1a\u5728\u5e76\u8054\u7535\u8def\u4e2d\uff0c\u6bcf\u4e2a\u5143\u4ef6\u90fd\u53ea\u7ba1\u81ea\u5df1\u7684\u652f\u8def\u3002\n56| \\end{example}\n57| \n58| \\begin{omfigure}\n59| \\begin{tikzpicture}[scale=0.8]\n60|   \\draw (0,0) to[battery1] (0,3.2)\n61|     to[cspst, l=main switch] (2.6,3.2);\n62|   \\draw (2.6,3.2) to[short] (2.6,2.4)\n63|     to[lamp, l=bulb 1] (5.8,2.4) to[short] (5.8,3.2);\n64|   \\draw (2.6,3.2) to[short] (2.6,4.0)\n65|     to[spst, l=branch switch] (4.2,4.0)\n66|     to[lamp] (5.8,4.0) to[short] (5.8,3.2);\n67|   \\draw (5.8,3.2) to[short] (7.4,3.2) to[short] (7.4,0)\n68|     to[short] (0,0);\n69|   \\fill (2.6,3.2) circle (2pt);\n70|   \\fill (5.8,3.2) circle (2pt);\n71| \\end{tikzpicture}\n72| \n73| {\\small \u63a7\u5236\u70b9\uff1a\u603b\u5f00\u5173\u4f4d\u4e8e\u5206\u5c94\u4e4b\u524d\uff0c\u540c\u65f6\u63a7\u5236\u4e24\u6761\u652f\u8def\uff1b\u652f\u8def\u5f00\u5173\u53ea\u63a7\u5236\u81ea\u5df1\u7684\u706f\u6ce1\u2014\u2014\u6b64\u65f6\u5b83\u662f\u65ad\u5f00\u7684\uff0c\u6240\u4ee5\u706f\u6ce1 1 \u5355\u72ec\u53d1\u4eae\u3002}\n74| \\end{omfigure}\n75| \n76| \\begin{example}[\u4f60\u5bb6\u5c31\u662f\u4e00\u4e2a\u5e76\u8054\u7535\u8def]\\label{ex:g5:series-parallel-circuits:house}\n77| \u4f60\u5bb6\u91cc\u7684\u6bcf\u76cf\u706f\u3001\u6bcf\u4e2a\u63d2\u5ea7\u548c\u6bcf\u53f0\u7535\u5668\uff0c\u90fd\u8d70\u5728\u4e00\u4e2a\u5927\u5e76\u8054\u7535\u8def\u7684\u5404\u81ea\u652f\u8def\u4e0a\u3002\u6b63\u56e0\u5982\u6b64\uff0c\u53a8\u623f\u7684\u706f\u6ce1\u70e7\u574f\u65f6\uff0c\u5ba2\u5385\u7684\u706f\u4f9d\u7136\u7167\u5e38\u4eae\u7740\uff1b\u6bcf\u4e2a\u623f\u95f4\u7684\u5f00\u5173\u53ea\u63a7\u5236\u81ea\u5df1\u623f\u95f4\u7684\u706f\uff1b\u800c\u7535\u8868\u65c1\u7684\u4fdd\u9669\u4e1d\u76d2\u91cc\u7684\u603b\u5f00\u5173\uff0c\u53ef\u4ee5\u5728\u68c0\u4fee\u65f6\u4e00\u6b21\u5207\u65ad\u5168\u5c4b\u7684\u7535\u8def\u3002\u73b0\u4ee3\u7684\u5f69\u706f\u4e5f\u52a0\u5165\u4e86\u8fd9\u4e2a\u201c\u4ff1\u4e50\u90e8\u201d\uff1a\u5b83\u4eec\u7684\u706f\u6ce1\u91c7\u7528\u8fd9\u6837\u7684\u63a