istance-time:journeys}\n94| \u6b65\u884c\u8005\u6bcf\u5c0f\u65f6\u8d70 $4$ \u5343\u7c73\uff0c\u8d70\u4e86 $2$ \u5c0f\u65f6\uff1a\n95| $4 \\times 2 = \\qty{8}{km}$\u3002\u9a91\u8f66\u8005\u6bcf\u5c0f\u65f6\u9a91 $15$ \u5343\u7c73\uff0c\n96| \u9a91\u4e86 $4$ \u5c0f\u65f6\uff1a$15 \\times 4 = \\qty{60}{km}$\u3002\u5ba2\u673a\n97| \u6bcf\u5c0f\u65f6\u98de\u884c $900$ \u5343\u7c73\uff0c\u98de\u4e86 $5$ \u5c0f\u65f6\uff1a$900 \\times 5 =\n98| \\qty{4500}{km}$ --- \u4e24\u987f\u996d\u4e4b\u95f4\u5c31\u80fd\u6a2a\u7a7f\u4e00\u4e2a\u5927\u6d32\u3002\n99|=\n100|=\n101|=\n102|=\n103|=\n104|     xlabel={\u884c\u9a76\u65f6\u95f4\uff08\u5c0f\u65f6\uff09}, ylabel={\u6240\u8d70\u8def\u7a0b\uff08\u5343\u7c73\uff09},\n105|=\n106|=\n107|=\n108|=\n109|=\n110|=\n111|=\n112|     {\u9a91\u8f66\u8005\uff1a\u6bcf\u5c0f\u65f6 $15$ \u5343\u7c73};\n113|=\n114|     {\u6b65\u884c\u8005\uff1a\u6bcf\u5c0f\u65f6 $4$ \u5343\u7c73};\n115|=\n116|=\n117|=",
