209|\\section{\u6717\u9053\u7684\u89c2\u70b9\u4e0e\u666e\u9002\u6027}\n210|=\n211|\\begin{proposition}[\u6717\u9053\u7406\u8bba]\\label{prop:b3:phase-transitions:landau}\n212|\\index{\u6717\u9053\u7406\u8bba}\\index{\u4e34\u754c\u6307\u6570}\\index{\u666e\u9002\u6027}\n213| \u5728\u8fde\u7eed\u76f8\u53d8\u9644\u8fd1\uff0c\u5c06\u81ea\u7531\u80fd\u6309\u5c0f\u5e8f\u53c2\u91cf\u5c55\u5f00\uff0c\n214| \u53ea\u4fdd\u7559\u5bf9\u79f0\u6027\u5141\u8bb8\u7684\u9879\uff08\u6b64\u5904\n215| $m \\to -m$\uff09\uff1a\n216|=\n217|=\n218|=\n219| \u5728 $T_{\\text{c}}$ \u4ee5\u4e0a\uff1a$m = 0$ \u5904\u4e3a\u5355\u4e00\u52bf\u9631\u3002\u5728\u5176\u4ee5\u4e0b\uff0c\n220| \u539f\u70b9\u53d8\u4e3a\u5cf0\u9876\uff0c\u5e76\u5728 $m = \\pm\n221| \\sqrt{a(T_{\\text{c}} - T)/2b}$ \u5904\u51fa\u73b0\u4e24\u4e2a\u5bf9\u79f0\u52bf\u9631\u2014\u2014\u4e0e\u5e73\u5747\u573a\n222| \u76f8\u540c\u7684\u5e73\u65b9\u6839\uff0c\u53ea\u662f\u6b64\u65f6\u4ec5\u7531\u5bf9\u79f0\u6027\u5373\u53ef\u5f97\u51fa\u3002\u8fd9\u5c31\u662f\u4e3a\u4f55\u622a\u7136\u4e0d\u540c\u7684\n223| \u4f53\u7cfb\u5728\u4e34\u754c\u70b9\u9644\u8fd1\u8868\u73b0\u5b8c\u5168\u4e00\u81f4\uff1a\n224| \\emph{\u666e\u9002\u6027}\u3002\u5b9e\u6d4b\u6307\u6570\uff08\u4f8b\u5982 $m \\propto |T -\n225| T_{\\text{c}}|^\\beta$\uff0c$\\beta \\approx 0.33$\uff0c\u5bf9\u6d41\u4f53\n226| \\emph{\u4e0e}\u5355\u8f74\u78c1\u94c1\u5747\u6210\u7acb\uff09\uff0c\u4e0e\u5e73\u5747\u573a\u7684 $1/2$ \u4e0d\u540c\uff0c\n227| \u56e0\u4e3a\u5728 $T_{\\text{c}}$ \u9644\u8fd1\uff0c\u6da8\u843d\u5728\u6240\u6709\u5c3a\u5ea6\u4e0a\u5267\u70c8\u8d77\u4f0f\u2014\u2014\n228| \u5bf9\u5176\u52a0\u4ee5\u9a6f\u670d\u7684\u91cd\u6574\u5316\u7fa4\uff08\u5a01\u5c14\u900a\uff0c1982 \u5e74\u8bfa\u8d1d\u5c14\u5956\uff09\n229| \u8868\u660e\uff0c\u51b3\u5b9a\u6307\u6570\u7684\u53ea\u6709\u7ef4\u6570\u4e0e\u5bf9\u79f0\u6027\uff0c\n230| \u4ece\u6765\u4e0d\u662f\u5fae\u89c2\u7ec6\u8282\u3002\u53cc\u52bf\u9631\u56fe\u50cf\u672c\u8eab\n231| \u5728\u78c1\u94c1\u4e4b\u5916\u4e