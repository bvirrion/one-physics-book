 "result": "117| \\begin{example}[\u4e24\u80fd\u7ea7\u53ef\u89c2\u6d4b\u91cf]\\label{ex:b3:quantum-formalism:twolevel}\n118| \u5728\u504f\u632f\u6001\u7a7a\u95f4\u4e2d\uff0c\u53d6\u57fa $(\\ket H, \\ket V)$\uff0c\u8003\u8651\n119|=\n120|=\n121|=\n122| \u8be5\u7b97\u7b26\u5384\u7c73\uff1b\u672c\u5f81\u503c\u4e3a $\\pm1$\uff1b\u672c\u5f81\u77e2\u4e3a $(\\ket H \\pm\n123| \\ket V)/\\sqrt2$ --- \u5373 $\\pm45^\\circ$ \u65b9\u5411\u7684\u504f\u632f\u6001\u3002\u6d4b\u91cf\n124| $\\hat A$ \\emph{\u610f\u5473\u7740}\u63d0\u95ee\u201c\u5bf9\u89d2\u8fd8\u662f\u53cd\u5bf9\u89d2\uff1f\u201d\uff0c\u800c\n125| \u672c\u5f81\u57fa\u5373\u8fd9\u4e24\u4e2a\u95ee\u9898\u7684\u7b54\u6848\u3002\u5f00\u7bc7\u5b9e\u9a8c\u4e2d\u6bcf\u4e00\u4e2a $45^\\circ$\n126| \u8d77\u504f\u5668\u90fd\u662f\u73bb\u7483\u4e2d\u7684\u8fd9\u4e00\u77e9\u9635\u3002\n127|=\n128|=\n129| \\section{\u57fa\u672c\u5047\u8bbe}\n130|=\n131| \\begin{theorem}[\u91cf\u5b50\u529b\u5b66\u7684\u89c4\u5219]\\label{thm:b3:quantum-formalism:postulates}\n132| \\index{\u91cf\u5b50\u529b\u5b66\u7684\u57fa\u672c\u5047\u8bbe}\\index{\u73bb\u6069\u5b9a\u5219}\\index{\u574d\u7f29}\n133| \\emph{(P1)} \u4f53\u7cfb\u7684\u6001\u662f\u5176\u5e0c\u5c14\u4f2f\u7279\u7a7a\u95f4\u4e2d\u7684\n134| \u5f52\u4e00\u5316\u53f3\u77e2 $\\ket\\psi$\u3002\n135| \\emph{(P2)} \u6bcf\u4e2a\u53ef\u6d4b\u91cf\u90fd\u5bf9\u5e94\u4e00\u4e2a\u5384\u7c73\u7b97\u7b26\n136| $\\hat A$\u3002\n137| \\emph{(P3)} \u6d4b\u91cf $\\hat A$ \u7684\u552f\u4e00\u53ef\u80fd\u7ed3\u679c\u662f\u5176\n138| \u672c\u5f81\u503c\u3002\n139| \\emph{(P4)} \u5728\u6001 $\\ket\\psi$ \u4e0a\uff0c\u7ed3\u679c $a$ \u51fa\u73b0\u7684\n140| \u6982\u7387\u4e3a $\\mathcal P(a) = |\\braket a\\psi|^2$\uff08\u73bb\u6069\u5b9a\u5219\uff1b\u5bf9\u4e8e\n141| \u7b80\u5e76\u672c\u5f81\u503c\uff0c\u5bf9\u5176\n142| \u672c\u5f81\u5b50\u7a7a\u95f4\u5185\u5404\u5206\u91cf\u7684\u6a21\u65b9\u6c42\u548c\uff09\u3002\u591a\u6b21\u8bd5\u9a8c\u7684\u5e73\u5747\u503c\u4e3a $\\langle\\hat A\\rangle =\n143| \\bra\\psi\\hat A\\ket\\psi$\u3002\n144| \\emph{(P5)} \u5f97\u5230\u7ed3\u679c $a$ \u7684\u6d4b\u91cf\u4e4b\u540e\uff0c\u6001\u5373\n145| \u4e3a $\\ket\\psi$ \u5728 $a$ \u672c\u5f81\u5b50\u7a7a\u95f4\u4e0a\u7684\uff08\u5f52\u4e00\u5316\uff09\u6295\u5f71\n146| --- \u5373\\emph{\u574d\u7f29}\uff1a\u6d4b\u91cf\u662f\u4e00\u79cd\u76f8\u4e92\u4f5c\u7528\uff0c\u5b83\u4f7f\n147| \u4f53\u7cfb\u5904\u4e8e\u4e0e\u5176\u81ea\u8eab\u7ed3\u679c\u76f8\u5339\u914d\u7684\u6001\u3002\n148| \\emph{(P6)} \u4e24\u6b21\u6d4b\u91cf\u4e4b\u95f4\uff0c\u6001\u6309\n149| \u859b\u5b9a\u8c14\u65b9\u7a0b\u4f5c\u5e7a\u6b63\u6f14\u5316\n150| $\\iu\\hbar\\,\\dfrac{\\dd}{\\dd t}\\ket{\\psi(t)} = \\hat H\\ket{\\psi(t)}$\u3002\n151| \\end{theorem}\n152| \\admitted\n153|=\n154| \\begin{example}[\u4e09\u4e2a\u8d77\u504f\u5668\u7684\u8ba1\u7b97]\\label{ex:b3:quantum-formalism:threepolarizers}\n155| \u7ad6\u76f4\u504f\u632f\u5149\u5c04\u5165\u504f\u632f\u65b9\u5411\u76f8\u5dee $90^\\circ$ \u7684\u68c0\u504f\u5668\uff1a$|\\braket\n156| HV|^2 = 0$ --- \u6d88\u5149\u3002\u63d2\u5165\u4e00\u4e2a $45^\\circ$ \u8d77\u504f\u5668\uff1a\n157| \u6001 $\\ket V$ \u4ee5\u6982\u7387 $|\\braket{45^\\circ}{V}|^2 =\n158| \\tfrac12$ \u901a\u8fc7\uff0c\u5e76\\emph{\u574d\u7f29}\u4e3a $\\ket{45^\\circ}$\uff08P5\uff09\uff1b\u8be5\u6001\n159| \u518d\u4ee5\u6982\u7387\n160| $|\\braket{H}{45^\\circ}|^2 = \\tfrac12$ \u901a\u8fc7\u6c34\u5e73\u68c0\u504f\u5668\u3002\u51c0\u900f\u5c04\u7387\u4e3a $\\tfrac14$\uff0c\n161| \u800c\u975e\u96f6\uff1a\u4e2d\u95f4\u7684\u6ee4\u5149\u7247\u5e76\u4e0d\u662f\u201c\u6253\u5f00\u4e86\u4e00\u4e2a\u5b54\u201d --- \u5b83\n162| \u8fdb\u884c\u4e86\u4e00\u6b21\u6d4b\u91cf\uff0c\u574d\u7f29\u4f7f\u5149\u5b50\u91cd\u65b0\u5236\u5907\u3002\u6ca1\u6709\n163| \u4efb\u4f55\u7ecf\u5178\u7b5b\u5b50\u80fd\u505a\u5230\u8fd9\u4e00\u70b9\uff1b\u800c\u6295\u5f71\u53ea\u505a\u8fd9\u4e00\u4ef6\u4e8b\u3002\n164| \\end{example}\n165|=\n166|=\n167|=\n168|=\n169|=\n170|=\n171|=\n172|=\n173|=\n174|=\n175|=\n176|=\n177|=\n178|=\n179|=\n180|=\n181|=\n182|=\n183|     {\u6bcf\u4e2a\u8d77\u504f\u5668\u90fd\u5c06\u6001\u6295\u5f71\u5230\u5176\u8f74\u4e0a\uff1a\\\\\n184|      \u79fb\u53bb\u4e2d\u95f4\u7684\u8d77\u504f\u5668\uff0c\u8f93\u51fa\u4e3a\u96f6};\n185|=\n186|=\n187| {\\small \u4e09\u8d77\u504f\u5668\u5b9e\u9a8c\uff0c\u5373\u4e09\u6b21\u8fde\u7eed\u7684\n188| \u6d4b\u91cf\uff1a\u6295\u5f71\u3001\u574d\u7f29\u3001\u518d\u6295\u5f71\u3002\u589e\u52a0\u4e00\u4e2a\u6ee4\u5149\u7247\n189| \\emph{\u589e\u5927}\u900f\u5c04\u5149\u5f3a --- \u5bf9\u7b5b\u5b50\u4e0d\u53ef\u80fd\uff0c\n190| \u5bf9\u6295\u5f71\u5219\u662f\u81ea\u52a8\u53d1\u751f\u7684\u3002}\n191|=\n192|=\n193| \\begin{remark}[\u574d\u7f29\u4e0d\u5141\u8bb8\u7684\u4e8b\u60c5]\\label{rem:b3:quantum-formalism:nosignal}\n194| \u5728\u5f62\u5f0f\u4f53\u7cfb\u4e2d\uff0c\u574d\u7f29\u662f\u77ac\u65f6\u7684\uff0c\u8fdc\u8ddd\u79bb\u7c92\u5b50\u95f4\u7684\u91cf\u5b50\u5173\u8054\n195| \u662f\u771f\u5b9e\u5b58\u5728\u4e14\u53ef\u6d4b\u91cf\u7684 --- \u4f46\u6ca1\u6709\n196| \\emph{\u4fe1\u606f}\u4f9d\u6258\u5b83\u4eec\u4f20\u9012\uff1a\u4e00\u4e2a\u63a2\u6d4b\u5668\u4e0a\u7684\u7ed3\u679c\uff0c\n197| \u5355\u72ec\u770b\u65f6\uff0c\u65e0\u8bba\u8fdc\u5904\u505a\u4ec0\u4e48\uff0c\n198| \u5b83\u4eec\u90fd\u4e0e\u629b\u786c\u5e01\u65e0\u5f02\u3002\u91cf\u5b50\u968f\u673a\u6027\u540c\u6837\u4e0d\u53ef\u7ea6\uff1a\n199| \u5373\u4fbf\u6001\u5df2\u88ab\\emph{\u5b8c\u5168}\u77e5\u9053\uff0c\u73bb\u6069\u5b9a\u5219\u4ecd\u7ed9\u51fa\u6982\u7387 ---\n200| \u518d\u65e0\u66f4\u591a\u53ef\u77e5\u4e4b\u7269\u3002\u8fd9\u4e24\u70b9\u90fd\u662f\u5f62\u5f0f\u4f53\u7cfb\u7684\u5b9a\u7406\uff0c\n201| \u5df2\u5728\u6781\u9ad8\u7cbe\u5ea6\u4e0b\u5f97\u5230\u68c0\u9a8c\uff1b\u5bf9\u5b83\u4eec\u7684\u4e0d\u5b89\n202| \u662f\u53ef\u4ee5\u7406\u89e3\u7684\uff0c\u5e76\u63a8\u52a8\u4e86\u4e00\u4e2a\u4e16\u7eaa\u7684\u5b9e\u9a8c\uff0c\u5176\u4e2d\u6bcf\u4e00\u9879\n203| \u90fd\u4ee5\u91cf\u5b50\u529b\u5b66\u7684\u80dc\u5229\u544a\u7ec8\u3002\n204| \\end{remark}\n205|=\n206| \\section{\u5bf9\u6613\u5b50\u4e0e\u4e0d\u786e\u5b9a\u6027}\n207|=\n208| \\begin{definition}[\u5bf9\u6613\u5b50\uff1b\u76f8\u5bb9\u53ef\u89c2\u6d4b\u91cf]\\label{def:b3:quantum-formalism:commutator}\n209| \\index{\u5bf9\u6613\u5b50}\\index{\u76f8\u5bb9\u53ef\u89c2\u6d4b\u91cf}\n210| \u4e24\u4e2a\u7b97\u7b26\u7684\\emph{\u5bf9\u6613\u5b50}\u4e3a $[\\hat A, \\hat B] = \\hat\n211| A\\hat B - \\hat B\\hat A$\u3002\u5960\u57fa\u6027\u7684\u4f8b\u5b50\u53d6\u81ea $\\hat p =\n212| -\\iu\\hbar\\,\\dd/\\dd x$\uff1a\n213|=\n214|=\n215|=\n216| \u82e5 $[\\hat A, \\hat B] = 0$\uff0c\u5219\u79f0\u4e24\u4e2a\u53ef\u89c2\u6d4b\u91cf\\emph{\u76f8\u5bb9}\uff1a\n217| \u5b83\u4eec\u6b64\u65f6\u5b58\u5728\u516c\u5171\u672c\u5f81\u57fa\uff0c\u53ef\u4ee5\u540c\u65f6\u786e\u5b9a\uff1b\n218| \u6d4b\u91cf\u5176\u4e2d\u4e00\u4e2a\u4e0d\u4f1a\u6270\u52a8\u5728\u53e6\u4e00\u4e2a\u91cf\u4e0a\u5177\u6709\u786e\u5b9a\u503c\u7684\u6001\u3002\u4e00\u7ec4\n219| \u5bf9\u6613\u7684\u53ef\u89c2\u6d4b\u91cf\uff0c\u82e5\u5176\u516c\u5171\u672c\u5f81\u57fa\u552f\u4e00\uff08\u5373\n220| \\emph{CSCO}\uff09\uff0c\u5219\u5b83\u6b63\u662f\u201c\u5b8c\u5168\u6807\u8bb0\u4e00\u4e2a\u6001\u201d\u7684\u542b\u4e49 --- \u76d2\u5b50\u7684\n221| \u6807\u8bb0 $(n_1, n_2, n_3)$ \u6070\u597d\u5c31\u662f\u8fd9\u6837\u3002\n222| \\end{definition}\n223|=\n224| \\begin{theorem}[\u4e00\u822c\u7684\u4e0d\u786e\u5b9a\u6027\u5173\u7cfb]\\label{thm:b3:quantum-formalism:uncertainty}\n225| \\index{\u4e0d\u786e\u5b9a\u6027\u5173\u7cfb}\n226| \u5728\u4efb\u610f\u6001\u4e2d\uff0c\u4e24\u4e2a\u53ef\u89c2\u6d4b\u91cf\u7684\u6807\u51c6\u5dee\u6ee1\u8db3\n227|=\n228|=\n229|=\n230|=\n231| \u5bf9\u4e8e $\\hat x$ \u4e0e $\\hat p$\uff1a$\\Delta x\\,\\Delta p \\ge \\hbar/2$ ---\n232| \u5373\u6d77\u68ee\u5821\u5173\u7cfb\uff0c\u5b83\u5982\u4eca\u662f\u7ebf\u6027\u4ee3\u6570\u7684\u4e00\u4e2a\u5b9a\u7406\uff0c\u800c\u975e\n233| \u542f\u53d1\u5f0f\u7684\u8bba\u65ad\u3002\u4e0d\u76f8\u5bb9\u6027\u662f\u53ef\u4ee5\u5b9a\u91cf\u523b\u753b\u