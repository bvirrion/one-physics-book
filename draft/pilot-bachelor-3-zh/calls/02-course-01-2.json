\u7ae0\u662f\u8fde\u63a5\u7269\u4f53\u529b\u5b66\u4e0e\n18|\u4e8c\u5341\u4e16\u7eaa\u7269\u7406\u5b66\u7684\u67a2\u7ebd\u3002\n19|=\n20|\\section{\u4ece\u62c9\u683c\u6717\u65e5\u5230\u54c8\u5bc6\u987f}\n21|=\n22|\\begin{definition}[\u54c8\u5bc6\u987f\u91cf\u4e0e\u6b63\u5219\u65b9\u7a0b]\\label{def:b3:hamiltonian-mechanics:hamiltonian}\n23|\\index{\u54c8\u5bc6\u987f\u91cf}\\index{\u6b63\u5219\u65b9\u7a0b}\\index{\u76f8\u7a7a\u95f4}\n24|\u5bf9\u62c9\u683c\u6717\u65e5\u91cf\u4e3a $L(q, \\dot q, t)$ \u7684\u7cfb\u7edf\uff0c\n25|\u5c06\u901f\u5ea6\u4ee5\u52a8\u91cf $p_i = \\partial L/\\partial\\dot q_i$ \u8868\u793a\uff0c\u5e76\u5b9a\u4e49\n26|\\emph{\u54c8\u5bc6\u987f\u91cf}\u4e3a\u52d2\u8ba9\u5fb7\u53d8\u6362\n27|=\n28|=\n29|=\n30|\u5b83\u662f\u5750\u6807\u4e0e\\emph{\u52a8\u91cf}\u7684\u51fd\u6570\u3002\n31|$2n$ \u7ef4\u7a7a\u95f4\u5373 $(q_1, \\dots, q_n, p_1, \\dots, p_n)$ \u6240\u6784\u6210\u7684\u7a7a\u95f4\uff0c\n32|\\emph{\u76f8\u7a7a\u95f4}\uff1b\u5176\u4e2d\u7684\u4e00\u70b9\uff0c\u5373\u4e00\u4e2a\\emph{\u72b6\u6001}\uff0c\n33|\u7531\u6b64\u786e\u5b9a\u7cfb\u7edf\u7684\u5168\u90e8\u8fc7\u53bb\u4e0e\u672a\u6765\uff0c\n34|\u501f\u52a9\\emph{\u6b63\u5219\u65b9\u7a0b}\n35|\uff08\u89c1\\cref{thm:b3:hamiltonian-mechanics:canonical}\uff09\u3002\n36|=\n37|=\n38|\\begin{theorem}[\u6b63\u5219\u65b9\u7a0b]\\label{thm:b3:hamiltonian-mechanics:canonical}\n39|\u6b27\u62c9\u2013\u62c9\u683c\u6717\u65e5\u65b9\u7a0b\u7b49\u4ef7\u4e8e $2n$ \u4e2a\u4e00\u9636\n40|\u65b9\u7a0b\uff1a\n41|=\n42|=\n43|=\n44|=\n45|=\n46|=\n47|=\n48|\u5c06 $H = \\sum p_i\\dot q_i - L$ \u89c6\u4e3a $(q, p, t)$ \u7684\u51fd\u6570\u5e76\u6c42\u5fae\u5206\uff1a\n49|=\n50|=\n51|\\partial_tL\\,\\dd t$\u3002$\\dd\\dot q_i$ \u9879\u7531\n52|$p_i$ \u7684\u5b9a\u4e49\u76f8\u6d88\u2014\u2014\u8fd9\u6b63\u662f\u52d2\u8ba9\u5fb7\u53d8\u6362\u7684\u5173\u952e\u2014\u2014\u4e8e\u662f\u53ea\u5269\n53|=\n54|\\partial_tL\\,\\dd t$\u3002\u7531\u504f\u5bfc\u6570\u76f4\u63a5\u8bfb\u51fa\uff1a\n55|$\\partial H/\\partial p_i = \\dot q_i$ \u4e0e $\\partial H/\\partial q_i =\n56|-\\partial L/\\partial q_i$\uff0c\u7531\u6b27\u62c9\u2013\u62c9\u683c\u6717\u65e5\u65b9\u7a0b\uff0c\u5b83\u7b49\u4e8e $-\\dot p_i$\u3002\n57|\uff08\u6b64\u5916 $\\partial_tH = -\\partial_tL$\u3002\uff09\n58|=\n59|=\n60|\\begin{proposition}[$H$ \u7684\u610f\u4e49]\\label{prop:b3:hamiltonian-mechanics:energy}\n61|$H$ \u4e0e\u4e0a\u4e00\u7ae0\u4e2d\u7684\u80fd\u91cf\u51fd\u6570 $h$ \u4e00\u81f4\uff1a\n62|\u6cbf\u4efb\u4e00\u8fd0\u52a8\u6709 $\\dd H/\\dd t = \\partial H/\\partial t$\uff0c\u6545 $H$\n63|\u53ea\u8981\u5176\u4e0d\u663e\u542b\u65f6\u95f4\u5373\u5b88\u6052\uff1b\u5f53\n64|\u52a8\u80fd\u4e3a\u901f\u5ea6\u7684\u4e8c\u6b21\u51fd\u6570\u3001\u7ea6\u675f\u4e0e\u65f6\u95f4\u65e0\u5173\u65f6\uff0c\n65|$H = E_k + E_p$\uff0c\u5373\u673a\u68b0\u80fd\uff0c\n66|\u53ea\u662f\u6539\u7528\u53d8\u91cf $(q, p)$ \u8868\u793a\u3002\n67|=\n68|=\n69|=\n70|=\n71|=\n72|\\partial_{p_i}H\\,\\partial_{q_i}H) + \\partial_tH = \\partial_tH$\uff1a\n73|\u6b63\u5219\u65b9\u7a0b\u7684\u5bf9\u79f0\u6027\u4f7f\u6c42\u548c\u9879\u6052\u7b49\u76f8\u6d88\u3002\n74|\u4e0e $E_k + E_p$ \u7684\u7b49\u540c\n75|\u7531\\cref{prop:b3:lagrangian-mechanics:energy}\u53ef\u77e5\u3002\n76|=\n77|=\n78|\\begin{example}[\u4e24\u4e2a\u54c8\u5bc6\u987f\u91cf]\\label{ex:b3:hamiltonian-mechanics:examples}\n79|\u5f39\u7c27\u4e0a\u7684\u8d28\u70b9\uff1a$p = m\\dot x$\uff0c\u4e8e\u662f\n80|=\n81|=\n82|=\n83|\u6b63\u5219\u65b9\u7a0b $\\dot x = p/m$\u3001$\\dot p = -kx$ \u5373\u4e3a\u719f\u6089\u7684\n84|\u8fd9\u4e00\u5bf9\u65b9\u7a0b\u3002\u5355\u6446\uff1a$p = m\\ell^2\\dot\\theta$\uff0c\u5176\u54c8\u5bc6\u987f\u91cf\u4e3a\n85|=\n86|=\n87|=\n88|\u4e24\u79cd\u60c5\u5f62\u4e2d $H$ \u90fd\u662f\u80fd\u91cf\uff0c\u5728\u6bcf\u4e00\u8fd0\u52a8\u4e2d\u4fdd\u6301\u5e38\u6570\uff1a\n89|\u8fd0\u52a8\\emph{\u5373}\u4e3a $H$ \u5728 $(q,p)$ \u5e73\u9762\u4e2d\u7684\u7b49\u503c\u7ebf\u3002\n90|=\n91|=\n92|\\begin{method}[\u54c8\u5bc6\u987f\u65b9\u6cd5]\\label{met:b3:hamiltonian-mechanics:recipe}\n93|\uff081\uff09\u7531 $L$ \u6c42\u51fa\u52a8\u91cf $p_i = \\partial L/\\partial\\dot q_i$\uff0c\n94|\u5e76\u89e3\u51fa $\\dot q_i$\u3002\uff082\uff09\u5199\u51fa $H = \\sum p_i\\dot q_i - L$\uff0c\n95|\u4ec5\u7528 $(q, p)$ \u8868\u793a\u2014\u2014\u5bf9\u81ea\u7136\u7cfb\u7edf\u800c\u8a00\uff0c\u5373 $E_k + E_p$\uff0c\n96|\u5176\u4e2d $E_k$ \u6539\u7528\u52a8\u91cf\u8868\u793a\u3002\uff083\uff09\u5199\u51fa\n97|\u6b63\u5219\u65b9\u7a0b\u3002\uff084\uff09\u4f5c\u51fa $H$ \u7684\u7b49\u503c\u7ebf\uff1a\u5bf9\u4e8e\u4e00\u4e2a\u81ea\u7531\u5ea6\uff0c\n98|\u5b83\u4eec\u5373\u4e3a\u8f68\u8ff9\uff0c\u6574\u4e2a\u5b9a\u6027\u8fd0\u52a8\n99|\u2014\u2014\u632f\u52a8\u3001\u8f6c\u52a8\u3001\u5e73\u8861\u6001\u3001\u5206\u754c\u7ebf\u2014\u2014\u5747\u53ef\u76f4\u63a5\u8bfb\u51fa\uff0c\n100|\u65e0\u9700\u6c42\u89e3\u4efb\u4f55\u65b9\u7a0b\u3002\n101|=\n102|=\n103|\\section{\u76f8\u7a7a\u95f4}\n104|=\n105|\\begin{definition}[\u76f8\u56fe\u3001\u4e0d\u52a8\u70b9\u4e0e\u5206\u754c\u7ebf]\\label{def:b3:hamiltonian-mechanics:portrait}\n106|\\index{\u76f8\u56fe}\\index{\u4e0d\u52a8\u70b9}\\index{\u5206\u754c\u7ebf}\n107|\u7cfb\u7edf\u7684\\emph{\u76f8\u56fe}\u662f\u5176\u5728\u76f8\u7a7a\u95f4\u4e2d\u7684\n108|\u8f68\u8ff9\u65cf\u3002\\emph{\u4e0d\u52a8\u70b9}\u662f\u6307\u8fd9\u6837\u4e00\u79cd\u72b6\u6001\uff1a\n109|\u4e24\u4e2a\u6b63\u5219\u65b9\u7a0b\u540c\u65f6\u4e3a\u96f6\u2014\u2014\u5373\u5e73\u8861\u6001\uff1a\u52bf\u80fd\u7684\n110|\u6781\u5c0f\u503c\u8868\u73b0\u4e3a\u88ab\u95ed\u5408\u66f2\u7ebf\u73af\u7ed5\u7684\\emph{\u4e2d\u5fc3}\uff0c\u6781\u5927\u503c\n111|\u8868\u73b0\u4e3a\\emph{\u978d\u70b9}\uff0c\u7a7f\u8fc7\u5b83\u7684\u662f\u4e00\u6761\\emph{\u5206\u754c\u7ebf}\uff0c\n112|\u5373\u8fd9\u6837\u4e00\u6761\u8f68\u8ff9\uff1a\u5b83\u628a\u76f8\u7a7a\u95f4\u5212\u5206\u4e3a\n113|\u8fd0\u52a8\u6027\u8d28\u5404\u5f02\u7684\u533a\u57df\u3002\n114|=\n115|=",
