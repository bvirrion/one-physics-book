n156|=\n157|=\n158| \\begin{remark}[\u201c\u8f6c\u5316\u201d\u7684\u542b\u4e49]\\label{rem:b3:relativistic-dynamics:conversion}\n159| \u5e76\u975e\u4efb\u4f55\u5b9e\u7269\u201c\u53d8\u6210\u201d\u80fd\u91cf\uff1a\u603b\u80fd\u91cf\u4e00\u76f4\n160| \u59cb\u7ec8\u5b88\u6052\u3002\u53d8\u5316\u7684\u662f\u5176\\emph{\u9a7b\u7559} --- \u7531\u9759\u80fd\n161| \uff08\u53ef\u79f0\u91cd\uff09\u53d8\u4e3a\u52a8\u80fd\u4e0e\u8f90\u5c04\uff08\u53ef\u98de\u884c\uff09\u3002\n162| $E = mc^2$ \u7684\u6df1\u523b\u4e4b\u5904\u5728\u4e8e\uff1a\u60ef\u6027\u672c\u8eab\u5c31\u662f\n163| \u4e00\u79cd\u80fd\u91cf\u542b\u91cf\uff1a\u4e00\u7bb1\u70ed\u6c14\u4f53\u6bd4\u540c\u4e00\u7bb1\u51b7\u6c14\u4f53\u66f4\u6297\u62d2\u52a0\u901f\u3002\n164|=\n165|=\n166| \\section{\u78b0\u649e\u4e0e\u8870\u53d8}\n167|=\n168| \\begin{definition}[\u56db\u7ef4\u52a8\u91cf\u4e0e\u4e0d\u53d8\u8d28\u91cf]\\label{def:b3:relativistic-dynamics:four-momentum}\n169| \\index{\u56db\u7ef4\u52a8\u91cf}\\index{\u4e0d\u53d8\u8d28\u91cf}\n170| \u5c06\u7c92\u5b50\u7684\u80fd\u91cf\u4e0e\u52a8\u91cf\u5408\u5e76\u4e3a\u5176\\emph{\u56db\u7ef4\u52a8\u91cf}\n171| $P = (E/c, \\vect p)$\u3002\u5bf9\u7c92\u5b50\u7cfb\u7edf\uff0c\u6309\u5206\u91cf\u6c42\u548c\uff1a\n172|=\n173| \u7cfb\u7edf\u7684\\emph{\u4e0d\u53d8\u8d28\u91cf} $M$ \u7531\u4e0b\u5f0f\u5b9a\u4e49\uff1a\n174|=\n175|=\n176|=\n177| \u5b83\u5728\u6bcf\u4e2a\u53c2\u8003\u7cfb\u4e2d\u90fd\u662f\u540c\u4e00\u6570\u503c\uff0c\u7b49\u4e8e\u603b\u80fd\u91cf\uff08\u9664\u4ee5\n178| $c^2$\uff09\u5728\\emph{\u8d28\u5fc3\u7cfb}\u4e2d\u7684\u503c\uff0c\u6b64\u65f6\n179| $\\vect p_{\\text{tot}} = \\vect 0$\u3002\u6ce8\u610f\uff0c\n180| \u53ea\u8981\u5404\u90e8\u5206\u5f7c\u6b64\u76f8\u5bf9\u8fd0\u52a8\uff0c$M$ \u4fbf\u8d85\u8fc7\u5404\u90e8\u5206\u8d28\u91cf\u4e4b\u548c --- \u4e24\u4e2a\n181| \u5149\u5b50\u76f8\u80cc\u98de\u79bb\u65f6 $M > 0$\uff0c\u5c3d\u7ba1\u6bcf\u4e2a\u5149\u5b50\u7684\u8d28\u91cf\u5747\u4e3a\u96f6\u3002\n182|=\n183|=\n184| \\begin{method}[\u6c42\u89e3\u7