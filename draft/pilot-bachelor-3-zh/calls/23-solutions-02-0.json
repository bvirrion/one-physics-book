 "result": "116| \\begin{solution}{exo:b3:crystalline-solids:11}\n117| \uff08a\uff09\u5728\u5149\u5b66\u652f\u4e2d\uff0c$+$ \u4e0e $-$ \u4e24\u4e2a\u5b50\u6676\u683c\u8fd0\u52a8\u65b9\u5411\u76f8\u53cd\uff1a\u8fd9\u662f\u4e00\u4e2a\u632f\u8361\u7684\u7535\u5076\u6781\u5b50\uff0c\u6b63\u662f\u5149\u6ce2\u6240\u4f5c\u7528\u7684\u5bf9\u8c61\u3002\uff08b\uff09$\\omega \\approx \\sqrt{2K/\\mu}$\uff0c\u5176\u4e2d $\\mu =\n118| \\qty{2.3e-26}{kg}$\uff1a$\\omega \\approx \\qty{4.7e13}{rad/s}$\uff0c\n119| $\\lambda = 2\\pi c/\\omega \\approx \\qty{40}{\\micro m}$ --- \u5c5e\u4e8e\u8fdc\u7ea2\u5916\u6ce2\u6bb5\uff08\u98df\u76d0\u5b9e\u6d4b\u7684\u5269\u4f59\u5c04\u7ebf\u5e26\u4f4d\u4e8e $\\qty{61}{\\micro m}$\uff1a\u53cc\u5f39\u7c27\u6a21\u578b\u7ed9\u51fa\u7684\u91cf\u7ea7\u6b63\u786e\uff09\u3002\uff08c\uff09\n120| \u5728\u8be5\u6ce2\u6bb5\uff0c\u6676\u4f53\u81ea\u8eab\u7684\u5171\u632f\u5438\u6536\u5e76\u518d\u6b21\u53cd\u5c04\u8be5\u6ce2\uff1a\u900f\u660e\u7684\u98df\u76d0\u8f6c\u53d8\u4e3a\u955c\u9762\u5f0f\u4e0d\u900f\u660e\u3002\uff08d\uff09\u6bcf\u4e2a\u6676\u80de\u53ea\u542b\u4e00\u4e2a\u539f\u5b50\uff0c\u56e0\u6b64\u6ca1\u6709\u7b2c\u4e8c\u4e2a\u5b50\u6676\u683c\u4e0e\u4e4b\u76f8\u4e92\u62cd\u9891\uff1a\u53ea\u6709\u5355\u652f\uff0c\u6ca1\u6709\u80fd\u9699\u3002\n121| \\end{solution}\n122| \n123| \\begin{solution}{exo:b3:crystalline-solids:12}\n124| \uff08a\uff09$N$ \u4e2a\u539f\u5b50 $\\times$ 3 \u4e2a\u4f4d\u79fb\u65b9\u5411 = $3N$\n125| \u4e2a\u632f\u5b50\uff0c\u56e0\u6b64\u7ebf\u6027\u8c31\u5728\u8ba1\u5165 $3N$ \u4e2a\u6a21\u5f0f\u540e\u622a\u6b62\uff1a\u7531\u6b64\u5b9a\u4e49 $k_{\\text{D}}$\u3002\uff08b\uff09\n126| $k_{\\text{D}} = (6\\pi^2n)^{1/3} = \\qty{1.7e10}{m^{-1}}$\uff0c\n127| $\\Theta_{\\text{D}} = \\hbar vk_{\\text{D}}/k_{\\text{B}} \\approx\n128| \\qty{350}{K}$ --- \u4e0e\u7531\u58f0\u901f\u548c\u5bc6\u5ea6\u5f97\u5230\u7684\u91cf\u70ed\u6d4b\u91cf\u503c \\qty{343}{K} \u76f8\u7b26\u3002\uff08c\uff09\u76f4\u7ebf\u5728\u5e03\u91cc\u6e0a\u533a\u8fb9\u754c\u5904\u9057\u6f0f\u4e86\u5e73\u5766\u5316\uff1a\u5fb7\u62dc\u6a21\u578b\u9ad8\u4f30\u4e86\u9ad8\u9891\u6a21\u5f0f\u6570\uff0c\u56e0\u6b64\u5728\u4e2d\u95f4\u6e29\u5ea6\u4e0b\u62df\u5408\u6709\u504f\u5dee\uff1b$T^3$ \u5b9a\u5f8b\uff08\u4ec5\u9002\u7528\u4e8e\u957f\u6ce2\uff09\u662f\u53ef\u9760\u7684\u3002\uff08d\uff09\u4e24\u8005\u90fd\u8868\u660e\uff0c\u5f53\u6ce2\u957f\u8fbe\u5230\u539f\u5b50\u95f4\u8ddd\u65f6\u8c31\u5373\u7ed3\u675f --- \u6bcf\u4e2a\u539f\u5b50\u5bf9\u5e94\u4e00\u4e2a\u6a21\u5f0f\uff0c\u65e0\u8bba\u4ee5\u622a\u6b62\u6ce2\u77e2\u8fd8\u662f\u622a\u6b62\u6e29\u5ea6\u7684\u5f62\u5f0f\u4f53\u73b0\u3002\n129| \\end{solution}\n130| \n131| \\begin{solution}{pb:b3:crystalline-solids:1}\n132| \\textbf{1.} $2d\\sin\\theta = n\\lambda$\u3002\u5355\u8272\uff1a\u4e00\u4e2a $\\lambda$ \u4f7f\u6bcf\u4e2a\u73af\u7684\u89d2\u5ea6\u5bf9\u5e94\u552f\u4e00\u7684\u9762\u95f4\u8ddd\u3002\u7c89\u672b\uff1a\u5728\u968f\u673a\u53d6\u5411\u7684\u6676\u7c92\u4e2d\uff0c\u603b\u6709\u4e00\u4e9b\u6070\u597d\u53d6\u5411\u4f7f\u5176\u53d1\u751f\u53cd\u5c04 --- \u6bcf\u4e00\u65cf\u6676\u9762\u90fd\u540c\u65f6\u7ed9\u51fa\u4fe1\u53f7\u3002\n133| \\textbf{2.} $\\theta = 19.05^\\circ, 22.15^\\circ, 32.2^\\circ,\n134| 38.75^\\circ$\uff1b$\\sin^2\\theta = 0.107, 0.142, 0.284, 0.392$\u3002\n135| \\textbf{3.} \u5c06 $d = a/\\sqrt{h^2+k^2+l^2}$ \u4ee3\u5165\u5e03\u62c9\u683c\u516c\u5f0f\uff08$n = 1$\uff09\uff1a$\\sin^2\\theta = (\\lambda^2/4a^2)(h^2+k^2+l^2)$\u3002\n136| \\textbf{4.} \u6bd4\u503c\u4e3a $1 : 1.33 : 2.67 : 3.68$\uff1b\u4e58\u4ee5 3 \u5f97 $3.0 : 4.0 : 8.0 : 11.0$\u3002\n137| \\textbf{5.} \u5168\u5947\u6570 $(111)$ \u4ee5\u53ca\u5168\u5076\u6570 $(200)$\u3001$(220)$\u3001$(311)$ \u6070\u597d\u7ed9\u51fa 3\u30014\u30018\u300111\uff1b\u7f3a\u5931\u7684 1\u30012\u30015\u30016\u30017 \u6392\u9664\u4e86\u7b80\u5355\u7acb\u65b9\uff0c\u56e0\u4e3a\u5176\u56fe\u6837\u4e2d\u5e94\u51fa\u73b0\u8fd9\u4e9b\u5cf0\u3002\n138| \\textbf{6.} \u4f53\u5fc3\u7acb\u65b9\u5141\u8bb8\u7684\u5076\u6570\u548c\u7ed9\u51fa\u6bd4\u503c $1:2:3:4$ --- \u8282\u5f8b\u4e0d\u540c\u3002\u6bd4\u503c\u4e0d\u4f9d\u8d56\u4e8e $a$ \u7684\u5df2\u77e5\u503c\u3001\u6ce2\u957f\u6f02\u79fb\u4ee5\u53ca\u6837\u54c1\u53d6\u5411\u504f\u5dee\uff1a\u5947\u5076\u6027\u662f\u51e0\u4f55\u6027\u8d28\uff0c\u800c\u975e\u5b9a\u6807\u7ed3\u679c\u3002\n139| \\textbf{7.} \u6676\u9762\u6570\u5c11\u65f6\u5e72\u6d89\u6781\u5927\u8f83\u4e3a\u949d\u5316\uff0c\u7c7b\u4f3c\u53ea\u6709\u4e94\u6761\u7f1d\u7684\u5149\u6805\uff1a\u73af\u7684\u5bbd\u5ea6 $\\sim$ \u5fae\u6676\u5c3a\u5bf8\u7684\u5012\u6570\uff08\u8c22\u4e50\u516c\u5f0f\uff09--- \u9510\u5229\u7684\u73af\u8bf4\u660e\u6676\u7c92\u751f\u957f\u826f\u597d\u3002\n140| \\textbf{8.} $a = \\lambda\\sqrt{h^2+k^2+l^2}/2\\sin\\theta = 4.088,\n141| 4.086, 4.089, 4.082\\,\\unit{\\angstrom}$\u3002\n142| \\textbf{9.} $a \\approx \\qty{4.09}{\\angstrom}$\u3002\n143| \\textbf{10.} $\\rho = 4M/N_{\\text{A}}a^3$\u3002\n144| \\textbf{11.} $4/N_{\\text{A}}a^3 = \\qty{9.74e4}{mol/m^3}$\uff1a\u94f6 $\\to \\qty{10.5}{g/cm^3}$\uff08\u4e0e\u94f6\u7684\u624b\u518c\u503c\u76f8\u7b26\uff09\uff0c\u91d1 $\\to 19.2$\uff08\u4e0e\u91d1\u7684\u624b\u518c\u503c\u76f8\u7b26\uff01\uff09\uff0c\u94c2 $\\to 19.0$\uff08\u4e0e\u94c2\u7684 21.4 \u77db\u76fe --- \u5176\u771f\u5b9e\u7684 $a$ \u4e3a \\qty{3.92}{\\angstrom}\uff09\u3002\u94c2\u88ab\u6392\u9664\uff1b\u94f6\u548c\u91d1\u90fd\u4fdd\u7559\u4e0b\u6765\uff0c\u56e0\u4e3a\u5b83\u4eec\u7684\u6676\u683c\u5e38\u6570\u51e0\u4e4e\u5b8c\u5168\u76f8\u540c\u3002\n145| \\textbf{12.} \u9700\u8981\u57fa\u4e8e\u8d28\u91cf\u7684\u6d4b\u91cf\uff1a\u5bc6\u5ea6\uff08\u6216\u4ec5\u6469\u5c14\u8d28\u91cf\uff09\u3002\u94f6\u548c\u91d1\u7684 $a$ \u76f8\u5dee\u4e0d\u8d85\u8fc7 0.2\\,\\%\uff0c\u4f46\u5b83\u4eec\u7684\u539f\u5b50\u8d28\u91cf\u76f8\u5dee 1.8 \u500d --- \u4efb\u4f55\u6676\u683c\u4e0a\u7684\u5de7\u5408\u90fd\u65e0\u6cd5\u5f25\u8865\u8fd9\u4e00\u5dee\u5f02\u3002\n146| \\textbf{13.} \u963f\u57fa\u7c73\u5fb7\u539f\u7406\u7528\u4e8e\u91d1\u952d\uff1a\u5bc6\u5ea6\u63a5\u8fd1 \\qty{10.5}{g/cm^3} $\\to$ \u94f6\uff0c\u4e0e\u5176\u9508\u8680\u60c5\u51b5\u76f8\u7b26\uff08\u94f6\u4f1a\u53d8\u6697\uff1b\u91d1\u5219\u4f1a\u4fdd\u6301\u5149\u4eae\uff09\u3002\u5fae\u89c2\u4e0a\u7684\u6676\u80de\u8d28\u91cf\u4e0e\u5b8f\u89c2\u79f0\u91cf\u7ed3\u679c\u4e00\u81f4 --- \u540c\u4e00\u4e2a $\\rho = 4M/N_{\\text{A}}a^3$ \u4ece\u4e24\u4e2a\u65b9\u5411\u8bfb\u53d6\u3002\n147| \\textbf{14.} \u539f\u5b50\u5728\\emph{\u5e73\u5747\u4f4d\u7f6e}\u9644\u8fd1\u632f\u52a8\uff1a\u51b3\u5b9a\u73af\u89d2\u5ea6\u7684\u5e73\u5747\u6676\u683c\u4fdd\u6301\u4e0d\u53d8\uff1b\u968f\u673a\u4f4d\u79fb\u53ea\u4f1a\u91cd\u65b0\u5206\u914d\u5f3a\u5ea6\u3002\n148| \\textbf{15.} \u5f3a\u5ea6\u968f $T$ \u5e73\u6ed1\u4e0b\u964d\uff08\u7c7b\u4f3c $\\exp(-q^2\\langle x^2\\rangle)$ \u5f62\u5f0f\u7684\u5fb7\u62dc--\u6c83\u52d2\u56e0\u5b50\uff09\uff0c\u635f\u5931\u7684\u5149\u4ee5\u73af\u4e0e\u73af\u4e4b\u95f4\u7684\u6f2b\u6563\u5c04\u80cc\u666f\u91cd\u65b0\u51fa\u73b0\u3002\n149| \\textbf{16.} $K \\approx Ea = \\qty{8.3e10}{}\\times\n150| \\qty{2.89e-10}{} \\approx \\qty{24}{N/m}$\u3002\n151| \\textbf{17.} $v = a\\sqrt{K/m} \\approx \\qty{3300}{m/s}$ ---\n152| \u4e0e\u5b9e\u6d4b\u7684 \\qty{2700}{m/s} \u76f8\u5dee 20\\,\\%\u3002\n153| \\textbf{18.} $\\langle x^2\\rangle = 3k_{\\text{B}}T/K$\uff1a\u5747\u65b9\u6839 $\\approx\\qty{0.23}{\\angstrom}$\uff0c\u5728\u5ba4\u6e29\u4e0b\u5df2\u7ea6\u4e3a\u952e\u957f\u7684 8\\,\\%\u3002\n154| \\textbf{19.} 10\\,\\% \u6807\u51c6\u5916\u63a8\u5f97\u5230 $\\sim\\qty{500}{K}$\uff0c\u800c\u5b9e\u9645\u4e3a \\qty{1235}{K}\uff1a\u91cf\u7ea7\u6b63\u786e\uff0c\u4f46\u76f8\u5dee\u7ea6\u4e24\u500d --- \u6211\u4eec\u7684\u5355\u5f39\u7c27 $K$ \u8fc7\u8f6f\uff0c\u4e14\u6797\u5fb7\u66fc\u5224\u636e\u53ea\u662f\u4e00\u6761\u6807\u5ea6\u89c4\u5219\uff0c\u800c\u975e\u5b9a\u5f8b\u3002\u7ed3\u8bba\u4f9d\u7136\u6210\u7acb\uff1a\u7194\u5316\u53d1\u751f\u4e8e\u70ed\u632f\u52a8\u53ef\u4e0e\u6676\u683c\u672c\u8eab\u76f8\u6297\u8861\u4e4b\u65f6\u3002\n155| \\textbf{20.} $d_{110} = a/\\sqrt2 = \\qty{2.04}{\\angstrom}$\uff1a$\\sin\\theta = 0.378$\uff0c$2\\theta \\approx 44.5^\\circ$\u3002\n156| \\textbf{21.} \u8026\u5408\u5f3a\u5ea6\uff1a\u7535\u5b50\uff08\u5e26\u7535\uff09\u5728\u7eb3\u7c73\u5c3a\u5ea6\u4e0a\u6563\u5c04 --- \u9002\u7528\u4e8e\u8868\u9762\u4e0e\u8584\u819c\uff1bX \u5c04\u7ebf\u5728\u5fae\u7c73\u5c3a\u5ea6\u4e0a\u6563\u5c04 --- \u9002\u7528\u4e8e\u5757\u4f53\u7c89\u672b\uff1b\u4e2d\u5b50\u5728\u5398\u7c73\u5c3a\u5ea6\u4e0a\u6563\u5c04 --- \u9002\u7528\u4e8e\u6574\u4e2a\u53d1\u52a8\u673a\u90e8\u4ef6\u3002\n157| \\textbf{22.} \u73af\u6536\u7f29\u4e3a\u4e00\u4e2a\u6216\u4e24\u4e2a\u5bbd\u9614\u7684\u5149\u6655\uff1a\u6db2\u4f53\u4fdd\u7559\u77ed\u7a0b\u6709\u5e8f\uff08\u504f\u597d\u7684\u8fd1\u90bb\u8ddd\u79bb\uff09\uff0c\u4f46\u4e0d\u5b58\u5728\u957f\u7a0b\u6709\u5e8f --- \u6ca1\u6709\u5269\u4f59\u7684\u5468\u671f\u6027\u7ed3\u6784\u6765\u4ea7\u751f\u9510\u5229\u7684\u5e72\u6d89\u3002\n158| \\textbf{23.} DNA --- \u7167\u7247 51\u3002\u884d\u5c04\u53ef\u8bfb\u51fa\u8fdc\u5c0f\u4e8e\u4efb\u4f55\u5149\u5b66\u663e\u5fae\u955c\u5206\u8fa8\u6781\u9650\u7684\u91cd\u590d\u8ddd\u79bb\uff1bX \u5c04\u7ebf\u56fe\u6837\u63ed\u793a\u4e86\u87ba\u65cb\u7ed3\u6784\uff0c\\qty{3.4}{\\angstrom} \u7684\u6a21\u7cca\u6761\u7eb9\u5bf9\u5e94\u5176\u5806\u53e0\u7684\u78b1\u57fa\u5bf9\u3002\n159| \\textbf{24.} \u7ed3\u6784\u662f\u786e\u5b9a\u6027\u6709\u5e8f\u7684\uff08\u51c6\u5468\u671f\u6027 --- \u6709\u5e8f\u4f46\u4e0d\u91cd\u590d\uff09\uff1a\u9510\u5229\u7684\u6591\u70b9\u9700\u8981\u957f\u7a0b\u76f8\u4f4d\u76f8\u5e72\u6027\uff0c\u800c\u975e\u5468\u671f\u6027 --- \u8fd9\u4e00\u53d1\u73b0\u62d3\u5bbd\u4e86\u6676\u4f53\u5b66\u5bf9\u6676\u4f53\u672c\u8eab\u7684\u5b9a\u4e49\u3002\n160| \\textbf{25.} \u6bd4\u503c $3:4:8:11 \\to$ \u9762\u5fc3\u7acb\u65b9\uff1b$a = \\qty{4.09}{\\angstrom}$ $+$ \u5bc6\u5ea6 $\\to$ \u94f6\uff0c\u800c\u975e\u91d1\u6216\u94c2\uff1b\u5e76\u4e14\u7531\u4e8e\u52a0\u70ed\u4f1a\u4f7f\u73af\u53d8\u