37| \\end{remark}\n38|=\n39| \\begin{theorem}[\u72ed\u4e49\u76f8\u5bf9\u8bba\u7684\u5047\u8bbe]\\label{thm:b3:relativistic-kinematics:postulates}\n40| \\index{\u76f8\u5bf9\u8bba!\u5047\u8bbe}\\index{\u60ef\u6027\u53c2\u8003\u7cfb}\n41| \\emph{(i) \u76f8\u5bf9\u6027\uff1a}\u7269\u7406\u5b9a\u5f8b\u5728\u6bcf\u4e00\n42| \u60ef\u6027\u53c2\u8003\u7cfb\u4e2d\u5f62\u5f0f\u76f8\u540c\uff1b\u4efb\u4f55\u5b9e\u9a8c\u90fd\u65e0\u6cd5\u533a\u5206\u9759\u6b62\u4e0e\u5300\u901f\u8fd0\u52a8\u3002\n43| \\emph{(ii) \u5149\u901f\uff1a}\u771f\u7a7a\u4e2d\u7684\u5149\u4ee5\u76f8\u540c\u901f\u7387 $c$\n44| \u5728\u6bcf\u4e00\u60ef\u6027\u53c2\u8003\u7cfb\u4e2d\u4f20\u64ad\uff0c\u65e0\u8bba\u5149\u6e90\u6216\n45| \u89c2\u5bdf\u8005\u5982\u4f55\u8fd0\u52a8\u3002\n46| \\end{theorem}\n47| \\admitted\n48|=\n49| \\begin{definition}[\u4e8b\u4ef6\u4e0e\u540c\u65f6\u6027]\\label{def:b3:relativistic-kinematics:event}\n50| \\index{\u4e8b\u4ef6}\\index{\u540c\u65f6\u6027}\n51| \\emph{\u4e8b\u4ef6}\u662f\u4e00\u4e2a\u70b9\u72b6\u7684\u53d1\u751f\uff1a\u6709\u786e\u5b9a\u7684\u4f4d\u7f6e\\emph{\u548c}\u786e\u5b9a\u7684\u65f6\u523b\u2014\u2014\u4e00\u6b21\u706b\u82b1\u3001\n52| \u4e00\u6b21\u63a2\u6d4b\u5668\u8ba1\u6570\u3001\u4e00\u6b21\u8870\u53d8\u3002\u6bcf\u4e00\u60ef\u6027\n53| \u53c2\u8003\u7cfb\u4e3a\u4e8b\u4ef6\u8d4b\u4e88\u5750\u6807 $(t, x, y, z)$\uff0c\u6240\u7528\u7684\u662f\u5728\u8be5\u53c2\u8003\u7cfb\u4e2d\n54| \u9759\u6b62\u7684\u5c3a\u5b50\u4ee5\u53ca\u5206\u5e03\u4e8e\u5176\u4e2d\u4e14\u5df2\u540c\u6b65\u7684\u65f6\u949f\u3002\n55| \u4e24\u4e8b\u4ef6\u79f0\u4e3a\\emph{\u5728\u67d0\u53c2\u8003\u7cfb\u4e2d\u540c\u65f6}\uff0c\u5f53\u8be5\u53c2\u8003\u7cfb\u7684\u65f6\u949f\n56| \u8d4b\u4e88\u5b83\u4eec\u76f8\u540c\u7684 $t$ \u65f6\u2014\u2014\u5047\u8bbe\u7684\u7b2c\u4e00\u4e2a\u727a\u7272\u54c1\uff0c\n57| \u6b63\u662f\u8fd9\u4e00\u6982\u5ff5\u4f9d\u8d56\u4e8e\u53c2\u8003\u7cfb\u3002\n58| \\end{definition}\n59|=\n60| \\begin{example}[\u5217\u8f66\u4e0e\u4e24\u6b21\u95ea\u7535]\\labe