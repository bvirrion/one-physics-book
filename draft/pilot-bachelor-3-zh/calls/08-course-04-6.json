 "result": "\\begin{exercise}[$\\star\\star$]\\label{exo:b3:quantum-formalism:6}\n\u4e8c\u80fd\u7ea7\u7a7a\u95f4\u4e0a\uff0c$\\hat A = \\begin{pmatrix}0&1\\\\1&0\n\\end{pmatrix}$\uff0c$\\hat B = \\begin{pmatrix}1&0\\\\0&-1\\end{pmatrix}$\u3002\n\uff08a\uff09\u8ba1\u7b97 $[\\hat A, \\hat B]$\uff1a\u4e8c\u8005\u662f\u5426\u76f8\u5bb9\uff1f\uff08b\uff09\u6001\u4e3a\n$\\ket1$\uff1a\u6c42\u6d4b\u91cf $\\hat B$ \u7684\u7ed3\u679c\u7edf\u8ba1\uff0c\u518d\u6c42\u5728 $\\hat B$ \u6d4b\u91cf\u5f97\u5230 $+1$ \\emph{\u4e4b\u540e}\u6d4b\u91cf $\\hat A$ \u7684\u7ed3\u679c\u7edf\u8ba1\u3002\n\uff08c\uff09\u5148\u6d4b $\\hat A$\uff08\u7ed3\u679c $+1$\uff09\uff0c\u518d\u6d4b $\\hat B$\uff0c\u6700\u540e\u518d\u6d4b $\\hat A$\uff1a\u672b\u6b21 $\\hat A$ \u7684\u7ed3\u679c\u4e0e\u7b2c\u4e00\u6b21\\emph{\u77db\u76fe}\u7684\u6982\u7387\u4e3a\u591a\u5c11\uff1f\uff08d\uff09\u82e5\u5bf9\u6613\u5b50\u4e3a\u96f6\uff0c\u5bf9\uff08c\uff09\u610f\u5473\u7740\u4ec0\u4e48\uff1f\n\\end{exercise}\n\n\\begin{exercise}[$\\star\\star$]\\label{exo:b3:quantum-formalism:7}\n\uff08a\uff09\u5bf9 \\cref{exo:b3:schrodinger-three-dimensions:1} \u4e2d\u7684\u9ad8\u65af\u6001\u9650\u5236\u5728\u4e00\u7ef4\uff0c\u8ba1\u7b97 $\\Delta x$ \u4e0e $\\Delta p$\uff08\u5229\u7528\u5085\u91cc\u53f6\u5bf9\u6216\u76f4\u63a5\u79ef\u5206\uff09\uff0c\u5e76\u9a8c\u8bc1\u6d77\u68ee\u5821\u5173\u7cfb\u53d6\u7b49\u53f7\u3002\uff08b\uff09\u54ea\u4e9b\u6001\u4f7f\u4e00\u822c\u4e0d\u786e\u5b9a\u6027\u5b9a\u7406\u53d6\u7b49\uff08\u5199\u51fa\u67ef\u897f\u2013\u65bd\u74e6\u8328\u7b49\u53f7\u6210\u7acb\u7684\u6761\u4ef6\uff09\uff1f\uff08c\uff09\u7535\u5b50\u88ab\u9650\u5236\u5728 $\\Delta x = \\qty{0.1}{nm}$ \u5185\uff1a\u5176\u52a8\u80fd\u7684\u6700\u5c0f\u91cf\u7ea7\u4e3a\u591a\u5c11\uff1f\uff08d\uff09\u5bf9\u4e8e\u5c40\u57df\u5728\u4e00\u5fae\u7c73\u5185\u7684\u5f39\u73e0\uff08$\\qty{10}{g}$\uff09\uff0c\u60c5\u5f62\u76f8\u540c\uff1a\u8bf7\u4f5c\u51fa\u7ed3\u8bba\u3002\n\\end{exercise}\n\n\\begin{exercise}[$\\star\\star$]\\label{exo:b3:quantum-formalism:8}\n\uff08a\uff09\u7531 \\cref{prop:b3:quantum-formalism:evolution} \u5bfc\u51fa $\\hat H = \\hat\np^2/2m + V$ \u65f6 $\\hat x$ \u4e0e $\\hat p$ \u7684\u57c3\u4f26\u8d39\u65af\u7279\u65b9\u7a0b\u7ec4\u3002\uff08b\uff09\u8bc1\u660e\u5b87\u79f0 $\\hat\\Pi$\uff08$\\hat\\Pi\\psi(x) =\n\\psi(-x)$\uff09\u662f\u5384\u7c73\u7684\uff0c\u5176\u5e73\u65b9\u4e3a\u6052\u7b49\u7b97\u7b26\uff0c\u4e14\u672c\u5f81\u503c\u4e3a $\\pm1$\u3002\uff08c\uff09\u5bf9\u5bf9\u79f0\u52bf\u8bc1\u660e $[\\hat H, \\hat\\Pi] = 0$\uff0c\u5e76\u7531\u6b64\u63a8\u51fa\u975e\u7b80\u5e76\u80fd\u7ea7\u5177\u6709\u786e\u5b9a\u7684\u5b87\u79f0\u3002\uff08d\uff09\u8fd9\u4e00\u7ed3\u8bba\u89e3\u91ca\u4e86\u5bf9\u79f0\u53cc\u52bf\u9631\u80fd\u7ea7\u7684\u54ea\u4e00\u4e2a\u5df2\u89c2\u5bdf\u5230\u7684\u4e8b\u5b9e\uff08\u56de\u5fc6\u7b2c\u4e8c\u5e74\u5206\u518c\u4e2d\u7684\u6c28\u5206\u5b50\u53cc\u91cd\u6001\uff09\uff1f\n\\end{exercise}\n\n\\begin{exercise}[$\\star\\star$]\\label{exo:b3:quantum-formalism:9}\nCSCO \u7684\u5e94\u7528\u3002\u5728\u6b63\u65b9\u5f62\u4e8c\u7ef4\u52bf\u7bb1\u4e2d\uff0c\u80fd\u7ea7 $E\n\\propto 5$ \u7531 $\\ket{1,2}$ \u4e0e $\\ket{2,1}$ \u5f20\u6210\u3002\uff08a\uff09\u8bc1\u660e\u4ec5\u80fd\u91cf\u4e0d\u8db3\u4ee5\u6807\u8bb0\u6001\u3002\uff08b\uff09\u8bbe $\\hat S$ \u4ea4\u6362 $x\n\\leftrightarrow y$\uff1a\u8bc1\u660e $\\hat S$ \u662f\u5384\u7c73\u7684\uff0c\u4e0e $\\hat\nH$ \u5bf9\u6613\uff0c\u5e76\u6c42\u5176\u5728\u8be5\u80fd\u7ea7\u5185\u7684\u672c\u5f81\u6001\u3002\uff08c\uff09\u9a8c\u8bc1\u4e8c\u5143\u7ec4 $(\\hat H, \\hat S)$ \u552f\u4e00\u6807\u8bb0\u8be5\u80fd\u7ea7\u7684\u6bcf\u4e00\u4e2a\u6001\u3002\uff08d\uff09\u7ed9\u51fa\u4e00\u822c\u6027\u7684\u7ed3\u8bba\uff1a\u7b80\u5e76\u610f\u5473\u7740\u6807\u8bb0\u96c6\u5c1a\u4e0d\u5b8c\u5907\uff0c\u800c\u5bf9\u79f0\u6027\u63d0\u4f9b\u4e86\u6240\u7f3a\u7684\u6807\u8bb0\u3002\n\\end{exercise}\n\n\\begin{exercise}[$\\star\\star\\star$]\\label{exo:b3:quantum-formalism:10}\n\u80fd\u91cf\u2013\u65f6\u95f4\u4e0d\u786e\u5b9a\u5173\u7cfb\uff0c\u4e25\u683c\u5904\u7406\u3002\u5bf9\u4efb\u610f\u53ef\u89c2\u6d4b\u91cf $\\hat A$\uff0c\u5b9a\u4e49\u6f14\u5316\u65f6\u95f4 $\\tau_A = \\Delta A\\,/\\,|\\dd\\langle\\hat\nA\\rangle/\\dd t|$\u2014\u2014\u5373\u5747\u503c\u79fb\u52a8\u4e00\u4e2a\u6807\u51c6\u5dee\u6240\u9700\u7684\u65f6\u95f4\u3002\uff08a\uff09\u7531 \\cref{thm:b3:quantum-formalism:uncertainty} \u4e0e\n\\cref{prop:b3:quantum-formalism:evolution}\uff0c\u8bc1\u660e $\\Delta\nE\\;\\tau_A \\ge \\hbar/2$\u3002\uff08b\uff09\u4e3a\u4f55\u8fd9\\emph{\u4e0d\u662f}\u4e24\u4e2a\u53ef\u89c2\u6d4b\u91cf\u4e4b\u95f4\u7684\u4e0d\u786e\u5b9a\u5173\u7cfb\uff08\u5728\u8be5\u5f62\u5f0f\u4f53\u7cfb\u4e2d\uff0c\u65f6\u95f4\u662f\u4ec0\u4e48\uff09\uff1f\uff08c\uff09\u5e94\u7528\u4e8e\u5bff\u547d\u4e3a \\qty{10}{ns} \u7684\u539f\u5b50\u6fc0\u53d1\u6001\uff1a\u6c42\u5176\u8c31\u7ebf\u5bbd\u5ea6\u3002\uff08d\uff09\u5e94\u7528\u4e8e\u4f60\u7684\u624b\u8868\uff1a\u82e5\u7cfb\u7edf\u4e2d\u67d0\u7269\u6bcf\u79d2\u90fd\u6709\u660e\u663e\u53d8\u5316\uff0c\u5219\u8be5\u7cfb\u7edf\u7684\u80fd\u91cf\u80fd\u88ab\u786e\u5b9a\u5230\u591a\u7cbe\u786e\uff1f\n\\end{exercise}\n\n\\begin{exercise}[$\\star\\star\\star$]\\label{exo:b3:quantum-formalism:11}\n\u4e0d\u786e\u5b9a\u6027\u5b9a\u7406\u7684\u8bc1\u660e\u3002\u53d6 $\\hat\\alpha, \\hat\\beta$ \u5982\u6b63\u6587\u6240\u8bbe\uff1a\uff08a\uff09\u5229\u7528\u5384\u7c73\u6027\u8bba\u8bc1 $\\Delta A^2 = \\|\\hat\\alpha\\ket\\psi\\|^2$\uff1b\uff08b\uff09\u5e94\u7528\u67ef\u897f\u2013\u65bd\u74e6\u8328\u4e0d\u7b49\u5f0f\uff0c\u5e76\u5c06 $\\braket{\\hat\\alpha\\psi}{\\hat\\beta\\psi}$ \u5206\u89e3\u4e3a\u5384\u7c73\u90e8\u5206\u4e0e\u53cd\u5384\u7c73\u90e8\u5206\uff0c\u5206\u522b\u8bc6\u522b\u4e3a\u53cd\u5bf9\u6613\u5b50\u4e0e\u5bf9\u6613\u5b50\u7684\u5e73\u5747\u503c\uff1b\uff08c\uff09\u7ed9\u51fa\u7ed3\u8bba\uff0c\u5e76\u8bf4\u660e\u7b49\u53f7\u4f55\u65f6\u6210\u7acb\uff1b\uff08d\uff09\u8bc1\u660e\u5bf9\u4e8e $[\\hat A, \\hat B] = \\iu\\hbar$\uff0c\u82e5\u4e24\u4e2a\u504f\u5dee\u90fd\u4fdd\u6301\u6709\u9650\uff0c\u5219\u4efb\u4f55\u6001\u90fd\u4e0d\u80fd\u662f\u5176\u4e2d\u4efb\u4e00\u53ef\u89c2\u6d4b\u91cf\u7684\u672c\u5f81\u77e2\u2014\u2014\u5e76\u4e0e\u5e73\u9762\u6ce2\u76f8\u534f\u8c03\u3002\n\\end{exercise}\n\n\\begin{exercise}[$\\star\\star\\star$]\\label{exo:b3:quantum-formalism:12}\n\u770b\u58f6\u7684\u6c34\u4e0d\u5f00\u3002\u4e8c\u80fd\u7ea7\u7cfb\u7edf\u521d\u59cb\u5904\u4e8e $\\ket1$\uff0c\u5176\u54c8\u5bc6\u987f\u91cf\u9a71\u52a8\u7c7b\u62c9\u6bd4\u632f\u8361\uff1a\u7ecf\u8fc7\u65f6\u95f4 $t$ \u540e\u6001\u4e3a $\\cos(\\omega t)\\ket1 + \\sin(\\omega t)\\ket2$\uff08\u89c6\u6b64\u4e3a\u5df2\u77e5\uff09\u3002\uff08a\uff09\u82e5\u4e0d\u4f5c\u6d4b\u91cf\uff0c\u4f55\u65f6\u624d\u5b8c\u6210\u5411 $\\ket2$ \u7684\u8f6c\u79fb\uff1f\uff08b\uff09\u5728\u65f6\u523b $T/N, 2T/N, \\dots$ \u6d4b\u91cf\u201c\u5904\u4e8e\u54ea\u4e2a\u6001\u201d\uff0c\u53d6 $T =\n\\pi/2\\omega$\uff1a\u8bc1\u660e\u6bcf\u6b21\u68c0\u6d4b\u65f6\u53d1\u73b0\u7cfb\u7edf\\emph{\u4ecd}\u5904\u4e8e $\\ket1$ \u7684\u6982\u7387\u4e3a $[\\cos^2(\\pi/2N)]^N$\u3002\uff08c\uff09\u5bf9 $N = 1, 4, 20, 100$ \u6c42\u5176\u503c\uff0c\u5e76\u8bc1\u660e\u5b83\u8d8b\u4e8e $1$\uff1a\u9891\u7e41\u89c2\u6d4b\u4f7f\u6f14\u5316\u51bb\u7ed3\uff08\u91cf\u5b50\u829d\u8bfa\u6548\u5e94\uff0c1990 \u5e74\u7528\u56da\u7981\u79bb\u5b50\u89c2\u6d4b\u5230\uff09\u3002\uff08d\uff09\u7528\u4e00\u53e5\u8bdd\u8bf4\u660e\u662f\u54ea\u4e00\u6761\u516c\u8bbe\u5bfc\u81f4\u4e86\u8fd9\u79cd\u51bb\u7ed3\u3002\n\\end{exercise}\n\n\\begin{omfigure}\n\\includegraphics[width=0.62\\linewidth]{images/book5/photo-solvay-1927.jpg}\n\n{\\small 1927 \u5e74\u7d22\u5c14\u7ef4\u4f1a\u8bae\uff08\u7167\u7247\uff1aBenjamin Couprie\uff0c\u516c\u6709\u9886\u57df\uff09\uff1a\u6784\u5efa\u672c\u7ae0\u516c\u8bbe\u7684\u4eba\u4eec\u9f50\u805a\u4e00\u5ba4\u2014\u2014\u800c\u5c31\u5728\u90a3\u4e00\u5468\uff0c\u4ed6\u4eec\u4ecd\u5728\u4e89\u8bba\u6d4b\u91cf\u7a76\u7adf\u610f\u5473\u7740\u4ec0\u4e48\u3002}\n\\end{omfigure}\n\n\\section{\u95ee\u9898\uff1a\u4e2d\u5fae\u5b50\u5728\u98de\u884c\u4e2d\u66f4\u6362\u201c\u5916\u8863\u201d}\n\n\\begin{problem}[{\u5468\u672b\u95ee\u9898 --- \u7a7f\u8d8a\u5730\u7403\u7684\u4e24\u80fd\u7ea7\u632f\u8361}]\\label{pb:b3:quantum-formalism:1}\n\u4e2d\u5fae\u5b50\u5728\u6838\u53cd\u5e94\u4e2d\u4ee5\\emph{\u5473}\u6001\u4ea7\u751f\u2014\u2014\u7535\u5b50\u4e2d\u5fae\u5b50 $\\ket{\\nu_e}$ \u6216 \u03bc \u5b50\u4e2d\u5fae\u5b50 $\\ket{\\nu_\\mu}$ \u2014\u2014\n\u4f46\u5b83\u4eec\u4ee5\u80fd\u91cf\uff08\u8d28\u91cf\uff09\u672c\u5f81\u6001 $\\ket{\\nu_1},\n\\ket{\\nu_2}$ \u7684\u5f62\u5f0f\\emph{\u4f20\u64ad}\u3002\u4e24\u7ec4\u57fa\u5e76\u4e0d\u91cd\u5408\uff1a\u5b83\u4eec\u76f8\u5dee\u4e00\u4e2a\\emph{\u6df7\u5408\u89d2} $\\theta$\uff0c\n\\[\n\\ket{\\nu_e} = \\cos\\theta\\,\\ket{\\nu_1} + \\sin\\theta\\,\\ket{\\nu_2} ,\n\\qquad\n\\ket{\\nu_\\mu} = -\\sin\\theta\\,\\ket{\\nu_1} + \\cos\\theta\\,\\ket{\\nu_2} .\n\\]\n\u4e2d\u5fae\u5b50\u56e0\u800c\u5728\u98de\u884c\u4e2d\\emph{\u632f\u8361}\u4e8e\u4e0d\u540c\u5473\u4e4b\u95f4\u2014\u2014\u4ece\u800c\u5177\u6709\u8d28\u91cf\u2014\u2014\u8fd9\u4e00\u53d1\u73b0\u8363\u83b7\u4e86 2015 \u5e74\u8bfa\u8d1d\u5c14\u7269\u7406\u5b66\u5956\u3002\u672c\u9898\u4ec5\u5229\u7528\u672c\u7ae0\u5185\u5bb9\u63a8\u5bfc\u8be5\u6548\u5e94\u3002\u52a8\u91cf\u4e3a $p$\u3001\u8d28\u91cf\u4e3a $m_i$ \u7684\u8d85\u76f8\u5bf9\u8bba\u6027\u4e2d\u5fae\u5b50\uff0c\u5176\u80fd\u91cf\u4e3a $E_i \\approx pc + m_i^2c^4/2pc \\approx E +\nm_i^2c^4/2E$\u3002",
