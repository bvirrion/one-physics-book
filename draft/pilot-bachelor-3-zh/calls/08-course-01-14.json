 "result": "1| \\chapter{\u91cf\u5b50\u529b\u5b66\u7684\u5f62\u5f0f\u4f53\u7cfb}\\label{ch:b3:quantum-formalism}\n2|=\n3| \u53d6\u4e09\u7247\u504f\u632f\u7247\u3002\u5176\u4e2d\u4e24\u7247\u4ee5 $90^\\circ$ \u4ea4\u53c9\u653e\u7f6e\uff0c\n4| \u5b8c\u5168\u6321\u5149\uff1b\u628a\u7b2c\u4e09\u7247\u63d2\u5165\u4e8c\u8005\u4e4b\u95f4\uff0c\u4f7f\u5176\u6210 $45^\\circ$\uff0c\n5| \u5149\u4fbf\\emph{\u7a7f\u8fc7}\u2014\u2014\u589e\u52a0\u4e00\u4e2a\u969c\u788d\uff0c\u53cd\u800c\u6253\u5f00\u4e86\u901a\u8def\u3002\n6| \u628a\u504f\u632f\u7247\u770b\u4f5c\u7b5b\u5b50\u7684\u56fe\u50cf\u7ecf\u4e0d\u8d77\u8fd9\u4e2a\u5b9e\u9a8c\uff1b\n7| \u7559\u4e0b\u6765\u7684\u662f\u7ebf\u6027\u4ee3\u6570\uff1a\u5149\u5b50\u7684\u504f\u632f\u662f\u4e00\u4e2a\n8| \\emph{\u77e2\u91cf}\uff0c\u6bcf\u7247\u504f\u632f\u7247\u6cbf\u67d0\u4e00\u8f74\u5bf9\u5176\u6d4b\u91cf\u5e76\u6295\u5f71\uff0c\n9| \u800c\u6982\u7387\u5373\u5206\u91cf\u7684\u6a21\u65b9\u3002\u672c\u7ae0\u5c06\u8fd9\u5957\u4ee3\u6570\u786e\u7acb\u4e3a\n10| \u91cf\u5b50\u529b\u5b66\u771f\u6b63\u7684\u57fa\u7840\u3002\u524d\u51e0\u7ae0\u7684\u6ce2\u51fd\u6570\n11| \u53ea\u662f\u4e00\u4ef6\u5177\u4f53\u7684\u5916\u8863\uff0c\n12| \u5305\u88f9\u7740\u66f4\u62bd\u8c61\u7684\u672c\u4f53\uff1a\u6001\u662f\u5e0c\u5c14\u4f2f\u7279\u7a7a\u95f4\u4e2d\u7684\u77e2\u91cf\uff0c\n13| \u53ef\u89c2\u6d4b\u91cf\u662f\u5384\u7c73\u7b97\u7b26\uff0c\u6d4b\u91cf\u503c\u662f\u672c\u5f81\u503c\uff0c\n14| \u6982\u7387\u662f\u6807\u91cf\u79ef\u7684\u6a21\u65b9\uff0c\u6f14\u5316\u7531\n15| \u54c8\u5bc6\u987f\u91cf\u751f\u6210\u3002\u4e94\u6761\u57fa\u672c\u5047\u8bbe\uff0c\u5728\u6211\u4eec\u5df2\u7ecf\u8ba1\u7b97\u8fc7\u7684\u4e00\u5207\u4e2d\u90fd\u5df2\u8d77\u4f5c\u7528\uff0c\n16| \u2014\u2014\u4e00\u7ecf\u6e05\u695a\u8868\u8ff0\uff0c\u5b83\u4eec\u4fbf\u8db3\u591f\u5f3a\u5927\uff0c\n17| \u8db3\u4ee5\u5904\u7406\u76f4\u7ebf\u4e0a\u7684\u6ce2\u65e0\u6cd5\u63cf\u8ff0\u7684\u7cfb\u7edf\uff1a\u5149\u5b50\u7684\n18| \u504f\u632f\u3001\u7535\u5b50\u7684\u81ea\u65cb\uff0c\u4ee5\u53ca\u4e2d\u5fae\u5b50\u2014\u2014\u5176\u8eab\u4efd\u4f1a\n19| \u5728\u7a7f\u8d8a\u5730\u7403\u65f6\u53d1\u751f\u632f\u8361\u3002\n20|=\n21|\\section{\u6001\u662f\u77e2\u91cf}\n22|=\n23|\\begin{definition}[\u6001\u7a7a\u95f4\u3001\u53f3\u77e2\u4e0e\u5de6\u77e2]\\label{def:b3:quantum-formalism:state}\n24|\\index{\u5e0c\u5c14\u4f2f\u7279\u7a7a\u95f4}\\index{\u53f3\u77e2}\\index{\u5de6\u77e2}\n25| \u91cf\u5b50\u7cfb\u7edf\u7684\u6001\u6784\u6210\u4e00\u4e2a\u5e26\u5185\u79ef\u7684\u590d\u77e2\u91cf\u7a7a\u95f4\uff0c\n26| \u5373\\emph{\u5e0c\u5c14\u4f2f\u7279\u7a7a\u95f4} $\\mathcal H$\uff08\u5176\u6570\u5b66\n27| \u5728\u672c\u79d1\u4e09\u5e74\u7ea7\u6570\u5b66\u5206\u518c\u4e2d\u5c55\u5f00\uff09\u3002\u6001\n28| \u662f\u4e00\u4e2a\u77e2\u91cf\uff0c\u8bb0\u4f5c\\emph{\u53f3\u77e2} $\\ket\\psi$\uff0c\u5e76\u5f52\u4e00\u5316\uff1a\n29| $\\braket\\psi\\psi = 1$\u3002\u4e24\u6001\u7684\u5185\u79ef\u4e3a\u590d\u6570\n30| $\\braket\\varphi\\psi$\uff0c\u5bf9\u7b2c\u4e00\u4e2a\u53d8\u5143\u5171\u8f6d\u7ebf\u6027\uff0c\n31| \u4e14 $\\braket\\varphi\\psi = \\braket\\psi\\varphi^*$\u3002\u53d6\u6807\u51c6\u6b63\u4ea4\n32| \u57fa $\\{\\ket{e_i}\\}$\uff0c\n33|=\n34| \\[\n35| \\ket\\psi = \\sum_i c_i\\ket{e_i} , \\qquad\n36| c_i = \\braket{e_i}\\psi , \\qquad\n37| \\sum_i|c_i|^2 = 1 .\n38| \\]\n39| \u524d\u51e0\u7ae0\u7684\u6ce2\u51fd\u6570\u662f\n40| $\\ket\\psi$ \u6cbf\u4f4d\u7f6e\u65b9\u5411\u5206\u91cf\u7684\u65cf\uff1a$\\psi(x) =\n41| \\braket{x}{\\psi}$\uff1b\u5e76\u672a\u4e22\u5931\u4efb\u4f55\u4fe1\u606f\uff0c\u800c\u5177\u6709\\emph{\u6709\u9650}\n42| \u6001\u7a7a\u95f4\u2014\u2014\u8fd9\u5728\u6ce2\u7684\u56fe\u50cf\u4e2d\u4e0d\u53ef\u60f3\u8c61\u2014\u2014\u4e5f\u53d8\u5f97\u53ef\u4ee5\u63cf\u8ff0\u3002\n43|\\end{definition}\n44|=\n45|\\begin{example}[\u5149\u5b50\u7684\u504f\u632f\uff1a\u4e8c\u7ef4\u4e16\u754c]\\label{ex:b3:quantum-formalism:polarization}\n46| \u6cbf $z$ \u8f74\u4f20\u64ad\u7684\u5149\u5b50\uff0c\u5176\u504f\u632f\u6001\u4f4d\u4e8e\u4e00\u4e2a\n47| \u4e8c\u7ef4\u5e0c\u5c14\u4f2f\u7279\u7a7a\u95f4\u4e2d\uff0c\u57fa\u4e3a $\\ket H$\uff08\u6c34\u5e73\uff09\u4e0e $\\ket V$\uff08\u7ad6\u76f4\u65b9\u5411\uff09\u3002\n48| \u504f\u632f\u89d2\u4e3a $\\theta$ \u7684\u5149\u4e3a\u53e0\u52a0\u6001\uff1a\n49|=\n50|=\n51|=\n52|=\n53| \u5706\u504f\u632f\u5219\u4e3a\u590d\u7ec4\u5408 $(\\ket H \\pm\n54| \\iu\\ket V)/\\sqrt2$\uff1a\u7cfb\u6570\u4e3a\u590d\u6570\uff0c\u5e76\u975e\n55| \u88c5\u9970\uff0c\u800c\u662f\u7269\u7406\u3002\u4e00\u5207\u91cf\u5b50\u4e24\u80fd\u7ea7\u7cfb\u7edf\u2014\u2014\u81ea\u65cb\u3001\u6c28\n56| \u5206\u5b50\u3001\u8d85\u5bfc\u91cf\u5b50\u6bd4\u7279\u2014\u2014\u90fd\u5c5e\u4e8e\u540c\u4e00\u77e2\u91cf\u7a7a\u95f4\uff0c\n57| \u53ea\u662f\u4ee5\u4e0d\u540c\u7684\u5916\u8863\u51fa\u73b0\u3002\n58|\\end{example}\n59|=\n60|=\n61|=\n62|=\n63|=\n64|=\n65|=\n66|=\n67|=\n68|=\n69|=\n70|=\n71|=\n72| {\u6cbf $\\ket H$ \u7684\u6982\u7387\uff1a$\\cos^2\\theta$\\\\[2pt]\n73| \u6cbf $\\ket V$ \u7684\u6982\u7387\uff1a$\\sin^2\\theta$};\n74|=\n75| {\uff08\u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\u4e2d\u7684\u9a6c\u5415\u65af\u5b9a\u5f8b\uff0c\\\\\u6539\u8bfb\u4e3a\u73bb\u6069\u5b9a\u5219\uff09};\n76|=\n77|=\n78| {\\small \u504f\u632f\u6001\u4f5c\u4e3a\u77e2\u91cf\uff1a\u5176\u5206\u91cf\u5728\n79| \u68c0\u504f\u5668\u57fa\u4e0b\u7684\u5e73\u65b9\u5373\u4e3a\u5404\u6d4b\u91cf\u7ed3\u679c\u7684\u6982\u7387\u2014\u2014\u51e0\u4f55\u53d8\u4e3a\n80| \u6982\u7387\u3002}\n81|=\n82|=\n83|\\section{\u53ef\u89c2\u6d4b\u91cf\u662f\u7b97\u7b26}\n84|=\n85|\\begin{definition}[\u53ef\u89c2\u6d4b\u91cf]\\label{def:b3:quantum-formalism:observable}\n86|\\index{\u53ef\u89c2\u6d4b\u91cf}\\index{\u5384\u7c73\u7b97\u7b26}\\index{\u672c\u5f81\u503c}\n87| \u4e00\u4e2a\\emph{\u53ef\u89c2\u6d4b\u91cf}\u662f\u7ebf\u6027\u7b97\u7b26 $\\hat A$\uff0c\u4f5c\u7528\u4e8e $\\mathcal H$\uff0c\n88| \u4e14\u4e3a\\emph{\u5384\u7c73\u7684}\uff1a$\\braket{\\varphi}{\\hat A\\psi} =\n89| \\braket{\\hat A\\varphi}{\\psi}$\uff0c\u5bf9\u6240\u6709\u6001\u6210\u7acb\uff08\u7528\u77e9\u9635\u8bed\u8a00\uff0c\n90| $A = A^{*\\top}$\uff09\u3002\u5176\\emph{\u672c\u5f81\u6001}\u4e0e\\emph{\u672c\u5f81\u503c}\uff0c\n91| $\\hat A\\ket{a} = a\\ket{a}$\uff0c\u627f\u8f7d\u7740\u5168\u90e8\u7269\u7406\uff1a$a$ \u5373\u4e3a\n92| \u53ef\u80fd\u7684\u6d4b\u91cf\u503c\u3002\u5e38\u89c1\u4f8b\u5b50\uff1a\u4f4d\u7f6e\uff08$\\hat x$\uff1a\n93| \u4e58\u4ee5 $x$\uff09\u3001\u52a8\u91cf\uff08$\\hat p = -\\iu\\hbar\\,\\dd/\\dd x$\uff09\uff0c\n94| \u80fd\u91cf\uff08$\\hat H = \\hat p^2/2m + V(\\hat x)$\uff09\u2014\u2014\u4ee5\u53ca\u4e8c\u7ef4\u4e2d\u7684\n95| \u4efb\u4e00\u5384\u7c73 $2\\times2$ \u77e9\u9635\u3002\n96|\\end{definition}\n97|=\n98|\\begin{theorem}[\u4e3a\u4f55\u8981\u6c42\u5384\u7c73]\\label{thm:b3:quantum-formalism:hermitian}\n99| \u5384\u7c73\u7b97\u7b26\u7684\u672c\u5f81\u503c\u4e3a\u5b9e\u6570\uff0c\u4e14\u672c\u5f81\u503c\u4e0d\u540c\u7684\u672c\u5f81\u6001\n100| \u5f7c\u6b64\u6b63\u4ea4\uff1b\u5728\u672c\u4e66\u6d89\u53ca\u7684\u7a7a\u95f4\u4e2d\uff0c\u5176\n101| \u672c\u5f81\u6001\u6784\u6210 $\\mathcal H$ \u7684\u4e00\u7ec4\u6807\u51c6\u6b63\u4ea4\u57fa\uff08\n102| \\emph{\u8c31\u5b9a\u7406}\uff0c\u6709\u9650\u7ef4\u60c5\u5f62\u5df2\u5728\u672c\u79d1\u4e8c\u5e74\u7ea7\n103| \u6570\u5b66\u5206\u518c\u4e2d\u8bc1\u660e\uff1b\u5bf9\u65e0\u754c\u7b97\u7b26 $\\hat x$\u3001$\\hat p$\uff0c\n104| $\\hat H$ \u7684\u5b8c\u6574\u8868\u8ff0\u5c5e\u4e8e\u672c\u79d1\u4e09\u5e74\u7ea7\u8c31\u7406\u8bba\uff0c\u4e14\n105| \u5728\u672c\u9636\u6bb5\u4e0d\u52a0\u8bc1\u660e\u5730\u627f\u8ba4\uff09\u3002\u6d4b\u91cf\u503c\u5fc5\u987b\u4e3a\u5b9e\u6570\uff0c\u4e14\u53ef\u533a\u5206\u7684\u7ed3\u679c\n106| \u5fc5\u987b\u5f7c\u6b64\u6b63\u4ea4\uff1a\u5384\u7c73\u6027\u6070\u597d\u662f\u4f7f\u7b97\u7b26\n107| \u80fd\u591f\u8868\u793a\u6d4b\u91cf\u7684\u6761\u4ef6\u3002\n108|\\end{theorem}\n109|=\n110|\\begin{proof}[\u90e8\u5206\u8bc1\u660e]\n111|=\n112| $a^*\\braket aa$\uff1a$a$ \u4e3a\u5b9e\u6570\u3002\u5bf9\u4e8e $\\hat A\\ket a = a\\ket a$\uff0c$\\hat A\\ket b\n113|=\n114| $Ab}{a} = b\\braket ba$\uff0c\u6545 $(a - b)\\braket ba = 0$\u3002\n115|\\end{proof}\n116|=",
