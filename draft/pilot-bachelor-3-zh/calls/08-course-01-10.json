| $\\hat A\\ket{a} = a\\ket{a}$\uff0c\u627f\u8f7d\u7269\u7406\u5185\u5bb9\uff1a$a$ \u5373\u4e3a\n92| \u53ef\u80fd\u7684\u6d4b\u91cf\u503c\u3002\u5e38\u89c1\u4f8b\u5b50\u5305\u62ec\uff1a\u4f4d\u7f6e\uff08$\\hat x$\uff1a\n93| \u4e58\u4ee5 $x$\uff09\u3001\u52a8\u91cf\uff08$\\hat p = -\\iu\\hbar\\,\\dd/\\dd x$\uff09\u3001\n94| \u80fd\u91cf\uff08$\\hat H = \\hat p^2/2m + V(\\hat x)$\uff09\u2014\u2014\u4ee5\u53ca\u5728\u4e8c\u7ef4\u60c5\u5f62\u4e0b\n95| \u7684\u4efb\u610f\u5384\u7c73 $2\\times2$ \u77e9\u9635\u3002\n96|=\n97|=\n98| \\begin{theorem}[\u4e3a\u4f55\u8981\u6c42\u5384\u7c73]\\label{thm:b3:quantum-formalism:hermitian}\n99| \u5384\u7c73\u7b97\u7b26\u7684\u672c\u5f81\u503c\u4e3a\u5b9e\u6570\uff0c\u4e14\u5177\u6709\n100| \u4e0d\u540c\u672c\u5f81\u503c\u7684\u672c\u5f81\u6001\u5f7c\u6b64\u6b63\u4ea4\uff1b\u5728\u672c\u4e66\u6240\u6d89\u53ca\u7684\u7a7a\u95f4\u4e2d\uff0c\u5176\n101| \u672c\u5f81\u6001\u6784\u6210 $\\mathcal H$ \u7684\u4e00\u7ec4\u6b63\u4ea4\u5f52\u4e00\u57fa\uff08\n102| \u5373\\emph{\u8c31\u5b9a\u7406}\uff0c\u5728\u6709\u9650\u7ef4\u60c5\u5f62\u5df2\u5728\u672c\u79d1\u4e8c\u5e74\u7ea7\u6570\u5b66\u5206\u518c\u4e2d\u8bc1\u660e\uff1b\n103| \u5bf9\u4e8e\u65e0\u754c\u7b97\u7b26 $\\hat x$\u3001$\\hat p$\uff0c\n104| $\\hat H$ \u7684\u5b8c\u6574\u8868\u8ff0\u5c5e\u4e8e\u672c\u79d1\u4e09\u5e74\u7ea7\u8c31\u7406\u8bba\uff0c\u5e76\n105| \u5728\u672c\u9636\u6bb5\u4e0d\u52a0\u8bc1\u660e\u5730\u627f\u8ba4\uff09\u3002\u6d4b\u91cf\u503c\u5fc5\u987b\u4e3a\u5b9e\u6570\uff0c\u53ef\u533a\u5206\u7684\u7ed3\u679c\n106| \u5fc5\u987b\u5f7c\u6b64\u6b63\u4ea4\uff1a\u5384\u7c73\u6027\u6070\u597d\u662f\u7b97\u7b26\n107| \u80fd\u591f\u8868\u793a\u6d4b\u91cf\u7684\u6761\u4ef6\u3002\n108|=\n109|=\n110| \\begin{proof}[\u90e8\u5206\u8bc1\u660e]\n111|=\n112| $a^*\\braket aa$\uff1a$a$ \u4e3a\u5b9e\u6570\u3002\u5bf9 $\\hat A\\ket a = a\\ket a$\uff0c$\\hat A\\ket b\n113|=\n114| Ab}{a} = b\\braket ba$\uff0c\u4e8e\u662f $(a - b)\\braket ba = 0$\u3002\n115|=\n116|=",
