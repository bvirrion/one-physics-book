\u4ee5\u53ca\u8eab\u4efd\u5728\u5730\u7403\u4e0a\u7a7a\u632f\u8361\u7684\n19| \u4e2d\u5fae\u5b50\u3002\n20|=\n21| \\section{\u6001\u662f\u77e2\u91cf}\n22|=\n23| \\begin{definition}[\u6001\u7a7a\u95f4\u3001\u53f3\u77e2\u4e0e\u62ec\u53f7]\\label{def:b3:quantum-formalism:state}\n24| \\index{\u5e0c\u5c14\u4f2f\u7279\u7a7a\u95f4}\\index{\u53f3\u77e2}\\index{\u5de6\u77e2}\n25| \u91cf\u5b50\u7cfb\u7edf\u7684\u6001\u6784\u6210\u4e00\u4e2a\u5e26\u5185\u79ef\u7684\u590d\u77e2\u91cf\u7a7a\u95f4\u2014\u2014\n26| \\emph{\u5e0c\u5c14\u4f2f\u7279\u7a7a\u95f4} $\\mathcal H$\uff08\n27| \u76f8\u5173\u6570\u5b66\u5728\u672c\u79d1\u4e09\u5e74\u7ea7\u6570\u5b66\u5206\u518c\u4e2d\u5c55\u5f00\uff09\u3002\u6001\u662f\u4e00\u4e2a\n28| \u77e2\u91cf\uff0c\u8bb0\u4f5c\\emph{\u53f3\u77e2} $\\ket\\psi$\uff0c\u5e76\u5df2\u5f52\u4e00\u5316\uff1a\n29| $\\braket\\psi\\psi = 1$\u3002\u4e24\u4e2a\u6001\u7684\u5185\u79ef\u662f\u590d\n30| \u6570 $\\braket\\varphi\\psi$\uff0c\u5b83\u5bf9\u7b2c\u4e00\u4e2a\u69fd\u662f\u5171\u8f6d\u7ebf\u6027\u7684\uff0c\n31| \u5e76\u6ee1\u8db3 $\\braket\\varphi\\psi = \\braket\\psi\\varphi^*$\u3002\u5728\u6b63\u4ea4\u5f52\u4e00\u57fa\n32| $\\{\\ket{e_i}\\}$ \u4e2d\uff0c\n33|=\n34|=\n35|=\n36|=\n37|=\n38| \u524d\u51e0\u7ae0\u7684\u6ce2\u51fd\u6570\u662f\n39| $\\ket\\psi$ \u6cbf\u4f4d\u7f6e\u65b9\u5411\u7684\u5404\u5206\u91cf\uff1a$\\psi(x) =\n40| \\braket{x}{\\psi}$\u3002\u4fe1\u606f\u5e76\u672a\u4e22\u5931\uff0c\u800c\u5177\u6709\\emph{\u6709\u9650}\n41| \u6001\u7a7a\u95f4\u7684\u4f53\u7cfb\uff08\u65e0\u6cd5\u60f3\u8c61\u4e3a\u6ce2\uff09\u4e5f\u80fd\u88ab\u63cf\u8ff0\u3002\n42|=\n43|=\n44| \\begin{example}[\u5149\u5b50\u7684\u504f\u632f\uff1a\u4e8c\u7ef4\u4e16\u754c]\\label{ex:b3:quantum-formalism:polarization}\n45| \u6cbf $z$ \u8f74\u4f20\u64ad\u7684\u5149\u5b50\uff0c\u5176\u504f\u632f\u6001\u4f4d\u4e8e\n46| \u4e00\u4e2a\\emph{\u4e8c}\u7ef4\u5e0c\u5c14\u4f2f\u7279\u7a7a\u95f4\uff0c\u57fa\u4e3a $\\ket H$\n47| \uff08\u6c34\u5e73\uff09\u4e0e $\\ket V$\uff08\u7ad6\u76f4\uff0