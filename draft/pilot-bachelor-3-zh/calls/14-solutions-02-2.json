 "result": "123| \\begin{solution}{exo:b3:identical-particles:12}\n124| (a) $\\hat{\\vect S}_1\\cdot\\hat{\\vect S}_2 = \\tfrac12(\\hat S^2 -\n125| \\tfrac32\\hbar^2)$\uff1a\u5355\u91cd\u6001\u4e0a\u4e3a $-\\tfrac34\\hbar^2$\uff0c\n126| \u4e09\u91cd\u6001\u4e0a\u4e3a $+\\tfrac14\\hbar^2$\u2014\u2014\u7ed9\u5b9a\u7684\u54c8\u5bc6\u987f\u91cf\u91cd\u73b0\u4e86 $2J$ \u7684\u5206\u88c2\u3002\n127| (b) \u8fd1\u90bb\u81ea\u65cb\u53d6\u5411\u4e00\u81f4\u7684\u6676\u683c\uff1a\u81ea\u53d1\u78c1\u5316\u2014\u2014\u94c1\u78c1\u6027\u3002\n128| (c) $J/k_{\\text{B}}\n129| \\approx \\qty{1200}{K}$\uff1a\u94c1\u7684 \\qty{1043}{K} \u6b63\u662f\u8fd9\u4e00\u6807\u5ea6\u3002\n130| (d) \u5076\u6781\u2014\u5076\u6781\u78c1\u76f8\u4e92\u4f5c\u7528\u4e3a $10^{-4}$ eV\uff1a\u5b83\u53ea\u4f1a\u5728\u6beb\u5f00\u5c14\u6587\u91cf\u7ea7\u624d\u6709\u5e8f\u3002\n131| \u94c1\u78c1\u6027\u662f\u5e93\u4ed1\u6392\u65a5\u901a\u8fc7\u4ea4\u6362\u51e0\u4f55\u6765\u9009\u62e9\u81ea\u65cb\u6392\u5e03\u3002\n132| \\end{solution}\n133| \n134| \\begin{solution}{pb:b3:identical-particles:1}\n135| \\textbf{1.} \u8f68\u9053 $(n, l, m)$ \u6bcf\u4e2a $n$ \u5bf9\u5e94 $n^2$ \u4e2a\uff1b\u81ea\u65cb\u4f7f\u4e4b\u52a0\u500d\uff1b\u6ce1\u5229\u539f\u7406\u4f7f\u6bcf\u4e2a\u5b8c\u6574\u6807\u8bb0\u81f3\u591a\u5bb9\u7eb3\u4e00\u4e2a\u7535\u5b50\uff1a$2$\u3001$8$\u3001$18$\u3002\n136| \\textbf{2.} \u5185\u5c42\u7535\u5b50\u5bf9\u539f\u5b50\u6838\u7684\u5c4f\u853d\u968f $l$ \u800c\u5f02\uff1a\u7a7f\u900f\u6027\u5f3a\u7684 $s$ \u8f68\u9053\u6c89\u5230\u7a7f\u900f\u6027\u8f83\u5f31\u7684 $p$ \u548c $d$ \u8f68\u9053\u4e4b\u4e0b\u2014\u2014\u80fd\u7ea7\u6b21\u5e8f\u7531 $(n, l)$ \u51b3\u5b9a\uff0c\u800c\u975e\u4ec5\u7531 $n$ \u51b3\u5b9a\u3002\n137| \\textbf{3.} \u6b21\u5e8f\u4e3a $1s\\,2s\\,2p\\,3s\\,3p\\,4s\\,3d$\uff1bNa\uff1a[Ne]$3s^1$\uff1b\n138| Cl\uff1a[Ne]$3s^23p^5$\uff1bK\uff1a[Ar]$4s^1$\uff1bFe\uff1a[Ar]$4s^23d^6$\u3002\n139| \\textbf{4.} \u6bcf\u4e2a\u60f0\u6027\u6c14\u4f53\u6784\u578b\u5904\u5468\u671f\u95ed\u5408\uff1a$2$\uff08$1s$\uff09\u3001\n140| $8$\uff08$2s2p$\uff09\u3001\u518d\u6b21 $8$\uff08$3s3p$\u2014\u2014\u56e0\u4e3a $3d$ \u4f4d\u4e8e $4s$ \u4e4b\u4e0a\u5e76\u8981\u7b49\u5f85\uff09\u3001\u7136\u540e\u662f $18$\uff08$4s3d4p$\uff09\u3002\n141| \\textbf{5.} \u6ee1\u58f3\u5c42\uff1a\u4e0e\u4e0b\u4e00\u8f68\u9053\u95f4\u9699\u5f88\u5927\uff0c\u65e2\u65e0\u5ec9\u4ef7\u7535\u5b50\u53ef\u5931\u53bb\uff0c\u4e5f\u65e0\u7a7a\u4f4d\u53ef\u63a5\u7eb3\u3002\n142| \\textbf{6.} $Z_{\\text{eff}}$ \u4e3a\u6838\u7535\u8377\u51cf\u53bb\u5185\u5c42\uff08\u4ee5\u53ca\u90e8\u5206\u540c\u58f3\u5c42\uff09\u7535\u5b50\u7684\u5c4f\u853d\uff1a\u94a0\u7684\u4ef7\u7535\u5b50\u611f\u53d7\u5230\u7684\u662f $11 - 10 \\approx 1$\uff1b\u6c26\u7684\u4e24\u4e2a\u7535\u5b50\u5171\u4eab\u88f8\u6838 $Z = 2$\uff0c\u5f7c\u6b64\u4ec5\u5c4f\u853d\u7ea6\u4e09\u5206\u4e4b\u4e00\u3002\n143| \\textbf{7.} Li $\\to$ Be \u4e0a\u5347\uff0c\u5728 B \u5904\u4e0b\u964d\uff1bN $\\to$ O \u4e0b\u964d\uff1a\u5373\u4e24\u4e2a\u51f9\u9677\u3002\n144| \\textbf{8.} \u787c\u5f00\u59cb\u586b\u5145 $2p$\uff0c$2p$ \u80fd\u7ea7\u9ad8\u4e8e $2s$ \u4e14\u7a7f\u900f\u6027\u66f4\u5f31\uff1a\u5176\u65b0\u589e\u7535\u5b50\u66f4\u6613\u88ab\u79fb\u9664\u3002\n145| \\textbf{9.} \u6c27\u9996\u6b21\u9700\u8981\u5728\u540c\u4e00\u4e2a $p$ \u8f68\u9053\u4e2d\\emph{\u6210\u5bf9}\u5bb9\u7eb3\u4e24\u4e2a\u7535\u5b50\uff1a\u989d\u5916\u7684\u6392\u65a5\uff0c\u5e76\u5931\u53bb\u4ea4\u6362\u7a33\u5b9a\u5316\u2014\u2014\u7b2c\u56db\u4e2a $2p$ \u7535\u5b50\u7684\u8d21\u732e\u88ab\u62b5\u6d88\u3002\n146| \\textbf{10.} \u6bcf\u4e2a\u7535\u5b50\u5bf9\u53e6\u4e00\u4e2a\u7535\u5b50\u7684\u5c4f\u853d\u90fd\u4e0d\u5b8c\u5168\uff1a\u62df\u5408\u5f0f $24.6 = 13.6\\,Z_{\\text{eff}}^2$ \u7ed9\u51fa $Z_{\\text{eff}} =\n147| 1.34$\u2014\u2014\u7ea6\u4e09\u5206\u4e4b\u4e8c\u7684\u7535\u8377\u88ab\u5c4f\u853d\u3002\n148| \\textbf{11.} \u8fd1\u4e4e\u5b8c\u6574\u7684\u5185\u6838\u5c4f\u853d\uff08$Z_{\\text{eff}}\n149| \\approx 1.3$\uff09\u4ee5\u53ca\u5916\u5c42\u7535\u5b50\u7684 $n = 2$\uff1a\u4e24\u8005\u90fd\u51cf\u5f31\u4e86\u675f\u7f1a\u3002\n150| \\textbf{12.} \u65b0\u589e\u7535\u5b50\u8fdb\u5165\\emph{\u540c\u4e00}\u58f3\u5c42\uff0c\u5f7c\u6b64\u5c4f\u853d\u8f83\u5f31\uff0c\u800c $Z$ \u589e\u5927\uff1a$Z_{\\text{eff}}$ \u589e\u957f\uff0c\u6574\u4e2a\u58f3\u5c42\u6536\u7f29\u2014\u2014\u6c16\u6bd4\u9502\u5c0f\u3002\n151| \\textbf{13.} \u60f0\u6027\u6c14\u4f53\u6838\u5916\u4e00\u4e2a\u6613\u5931\u7684 $s$ \u7535\u5b50\uff1a\u7535\u79bb\u80fd $\\sim\\qty{5}{eV}$\uff0c\u77ac\u95f4\u5f62\u6210 $+1$ \u79bb\u5b50\uff0c\u5267\u70c8\u5931\u53bb\u7535\u5b50\u2014\u2014\u65cf\u7684\u7279\u6027\u6e90\u4e8e\u540c\u4e00\u6784\u578b\u3002\n152| \\textbf{14.} $p^6$ \u6ee1\u58f3\u5c42\u4e2d\u7f3a\u4e00\u4e2a\u7535\u5b50\uff1a\u7535\u5b50\u4eb2\u548c\u80fd\u5f88\u5927\uff0c\u5f62\u6210 $-1$ \u79bb\u5b50\uff0c\u5e76\u4e14\u7a7a\u7a74\u4e24\u4e24\u914d\u5bf9\u5f62\u6210 X$_2$ \u5206\u5b50\u3002\n153| \\textbf{15.} $2s$ \u4e0e $2p$ \u80fd\u91cf\u63a5\u8fd1\uff1a$2s^22p^2 \\to$ \u56db\u4e2a\u534a\u6ee1\u6742\u5316\u8f68\u9053\u7684\u6fc0\u53d1\u4ee3\u4ef7\u5f88\u5c0f\uff0c\u5374\u6362\u6765\u4e24\u4e2a\u989d\u5916\u7684\u5316\u5b66\u952e\u2014\u2014\u78b3\u7684\u56db\u4ef7\u6027\u662f\u5bf9\u8fd1\u7b80\u5e76\u7684\u5229\u7528\u3002\n154| \\textbf{16.} \u56db\u4e2a\u7535\u5b50\u65f6\uff0c\u6210\u952e\u4e0e\u53cd\u952e\u7ec4\u5408\u90fd\u88ab\u586b\u6ee1\uff1a\u4e24\u8005\u7684\u6536\u76ca\u76f8\u4e92\u62b5\u6d88\uff0c\u6ca1\u6709\u5171\u4ef7\u952e\u2014\u2014\u6c26\u4ecd\u662f\u5b64\u7acb\u539f\u5b50\u3002\n155| \\textbf{17.} $d$ \u7535\u5b50\u57cb\u5165 $4s$ \u5916\u58f3\u4e4b\u5185\uff1a\u5916\u5c42\u5316\u5b66\u6027\u8d28\u7531 $s$ \u58f3\u5c42\u51b3\u5b9a\uff0c\u5728\u5341\u4e2a\u5143\u7d20\u4e4b\u95f4\u53d8\u5316\u751a\u5fae\u2014\u2014\u5f62\u6210\u5316\u5b66\u5e73\u53f0\u3002\n156| \\textbf{18.} \u94aa\uff0c[Ar]$4s^23d^1$\uff1a\u7b2c\u4e00\u4e2a\u672a\u6210\u5bf9\u7684 $d$ \u7535\u5b50\u3002\n157| \\textbf{19.} \u4e09\u4e2a\u81ea\u65cb\u53d6\u5411\u4e00\u81f4\u6240\u4ea7\u751f\u7684\u78c1\u77e9\uff08$\\sim3\\mu_{\\text{B}}$\uff09\uff1b\u8fd9\u79cd\u53d6\u5411\u662f\u7531\u4ea4\u6362\u4f5c\u7528\u4ed8\u51fa\u4ee3\u4ef7\u7684\u2014\u2014\u662f\u5e93\u4ed1\u80fd\u7684\u8282\u7701\uff0c\u800c\u975e\u78c1\u529b\u3002\n158| \\textbf{20.} \u7565\u6709\u533a\u522b\u7684\u7535\u5b50\u672c\u53ef\u5168\u90e8\u6324\u5411 $1s$\uff08\u5bf9\u79f0\u5316\u6001\u4e0d\u4f1a\u7cbe\u786e\u76f8\u6d88\uff09\uff1a\u58f3\u5c42\u5c06\u4f1a\u6cc4\u6f0f\uff0c\u95ed\u5408\u6784\u578b\u6a21\u7cca\uff0c\u5468\u671f\u5f8b\u968f\u4e4b\u74e6\u89e3\u3002\n159| \\textbf{21.} $v/c \\approx Z\\alpha = 0.58$\uff1a\u76f8\u5bf9\u8bba\u8d28\u91cf\u589e\u52a0\u4f7f $6s$ \u8f68\u9053\u6536\u7f29\u5e76\u8d8b\u4e8e\u7a33\u5b9a\uff1b\u91d1\u7684 $5d \\to 6s$ \u5438\u6536\u79fb\u5411\u84dd\u7aef\uff08\u7559\u4e0b\u53cd\u5c04\u7684\u9ec4\u8272\uff09\uff0c\u6c5e\u88ab\u6536\u7d27\u7684 $6s^2$ \u7535\u5b50\u5bf9\u6210\u952e\u6781\u5f31\uff0c\u56e0\u800c\u8be5\u91d1\u5c5e\u5448\u6db2\u6001\u3002\n160| \\textbf{22.} \u5b83\u4eec\u51e0\u4e4e\u5904\u4e8e\u540c\u4e00\u80fd\u7ea7\uff1a\u80fd\u7ea7\u6b21\u5e8f\u4f9d\u8d56\u4e8e\u5360\u636e\u60c5\u51b5\uff0c$4s$ \u7387\u5148\u7535\u79bb\uff0c\u4ee5\u53ca\u94ec\u548c\u94dc\u5bf9 $3d^5$ / $3d^{10}$ \u7684\u201c\u501f\u7528\u201d\u2014\u2014\u534a\u6ee1\u4e0e\u5168\u6ee1\u7684\u6b21\u58f3\u5c42\u4ee5\u4f4e\u5ec9\u4ee3\u4ef7\u6362\u53d6\u4ea4\u6362\u7a33\u5b9a\u6027\u3002\n161| \\textbf{23.} \u5316\u5b66\u662f\u7535\u5b50\u7684\u4e8b\u52a1\uff0c\u800c\u7535\u5b50\u53ea\u611f\u53d7\u5230\u539f\u5b50\u6838\u7684\\emph{\u7535\u8377}\uff1a\u8d28\u91cf\u4ec5\u901a\u8fc7\u5fae\u5c0f\u7684\u632f\u52a8\uff08\u540c\u4f4d\u7d20\uff09\u4f4d\u79fb\u624d\u8d77\u4f5c\u7528\u3002\n162| \\textbf{24.} \u58f3\u5c42\u7ed3\u6784\uff08\u6709\u5229\u4e8e\u60f0\u6027\u6c14\u4f53\u7684\u903b\u8f91\uff09\u4e0e\u76f8\u5bf9\u8bba\u7a33\u5b9a\u5316\u4ee5\u53ca\u5728 $Z\\alpha \\to 1$ \u65f6\u7eaf\u7cb9\u7684\u5e93\u4ed1\u5e94\u529b