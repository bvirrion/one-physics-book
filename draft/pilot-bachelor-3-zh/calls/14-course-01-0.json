 "result": "1| \\chapter{\u5168\u540c\u7c92\u5b50}\\label{ch:b3:identical-particles}\n2|=\n3| \u5b87\u5b99\u4e2d\u7684\u6bcf\u4e00\u4e2a\u7535\u5b50\u90fd\u4e25\u683c\u3001\u5b8c\u5168\u5730\u4e0e\u5176\u4ed6\u6bcf\u4e00\u4e2a\u7535\u5b50\u5168\u540c\u2014\u2014\u4e0d\u662f\u50cf\u540c\u4e00\u9020\u5e01\u5382\u94f8\u51fa\u7684\u4e24\u679a\u786c\u5e01\u90a3\u6837\u76f8\u4f3c\uff0c\n4| \u800c\u662f\u539f\u5219\u4e0a\u4e0d\u53ef\u533a\u5206\uff1a\u6ca1\u6709\u6807\u7b7e\uff0c\u6ca1\u6709\u5212\u75d5\uff0c\u4e5f\u6ca1\u6709\u5386\u53f2\u80fd\u591f\u6807\u8bb0\u5176\u4e2d\u4efb\u4f55\u4e00\u4e2a\u3002\u91cf\u5b50\u529b\u5b66\u5bf9\u6b64\u6781\u4e3a\u8ba4\u771f\uff0c\n5| \u5176\u540e\u679c\u652f\u914d\u7740\u6574\u4e2a\u4e16\u754c\u3002\u4ea4\u6362\u4e24\u4e2a\u5168\u540c\u7c92\u5b50\u4e0d\u80fd\u6539\u53d8\u4efb\u4f55\u53ef\u89c2\u6d4b\u7684\u4e1c\u897f\uff0c\u8fd9\u4f7f\u591a\u7c92\u5b50\u6ce2\u51fd\u6570\u53ea\u6709\u4e24\u79cd\u9009\u62e9\uff1a\n6| \u4fdd\u6301\u4e0d\u53d8\uff08\\emph{\u73bb\u8272\u5b50}\uff09\uff0c\u6216\u6539\u53d8\u7b26\u53f7\uff08\\emph{\u8d39\u7c73\u5b50}\uff09\u3002\u4ec5\u7531\u8d1f\u53f7\u4fbf\u53ef\u5bfc\u51fa\u6ce1\u5229\u4e0d\u76f8\u5bb9\u539f\u7406\u3001\u58f3\u5c42\u7ed3\u6784\n7| \u4e0e\u6574\u4e2a\u5143\u7d20\u5468\u671f\u8868\uff0c\u5bfc\u51fa\u811a\u4e0b\u7269\u8d28\u7684\u575a\u786c\uff0c\u4ee5\u53ca\u652f\u6491\u8d77\u6b7b\u4ea1\u6052\u661f\u7684\u538b\u5f3a\uff1b\u7531\u6b63\u53f7\u5219\u5bfc\u51fa\u5149\u5b50\u7684\u7fa4\u805a\u6027\u2014\u2014\n8| \u6fc0\u5149\u7531\u6b64\u800c\u6765\u2014\u2014\u4ee5\u53ca\u518d\u8fc7\u4e09\u7ae0\u5c06\u51fa\u73b0\u7684\u73bb\u8272\u2013\u7231\u56e0\u65af\u5766\u51dd\u805a\u3002\u7269\u7406\u5b66\u4e2d\u5f88\u5c11\u6709\u4e00\u4e2a\u7b26\u53f7\u627f\u8f7d\u5982\u6b64\u4e4b\u591a\u7684\u5185\u5bb9\u3002\n9|=\n10|\\section{\u5bf9\u79f0\u5316\u5047\u8bbe}\n11|=\n12|\\begin{definition}[\u4ea4\u6362]\\label{def:b3:identical-particles:exchange}\n13|\\index{identical particles}\\index{exchange operator}\n14|\u5bf9\u4e8e\u4e24\u4e2a\u5168\u540c\u7c92\u5b50\uff0c\u5176\u6001\u7a7a\u95f4\u7531\u4e58\u79ef\u6001 $\\ket{a}\\otimes\\ket{b}$ \u5f20\u6210\uff08\u7c92\u5b50 1 \u5904\u4e8e $\\ket a$\uff0c\u7c92\u5b50 2 \u5904\u4e8e\n15|$\\ket b$\u2014\u2014\u4f4d\u7f6e\u3001\u81ea\u65cb\u7b49\u5747\u5305\u62ec\u5728\u5185\uff09\uff0c\\emph{\u4ea4\u6362\u7b97\u7b26} $\\hat P_{12}$ \u4ea4\u6362\u4e24\u8005\u7684\u89d2\u8272\uff1a$\\hat P_{12}\\ket a\\otimes\\ket b =\n16|\\ket b\\otimes\\ket a$\u3002\u5b83\u662f\u5384\u7c73\u7684\uff0c\u5176\u5e73\u65b9\u4e3a\u5355\u4f4d\u7b97\u7b26\uff0c\u5e76\u4e14\u4e0e\u4efb\u4f55\u5bf9\u4e24\u7c92\u5b50\u7b49\u540c\u5904\u7406\u7684\u54c8\u5bc6\u987f\u91cf\u5bf9\u6613\uff1b\n17|\u5176\u672c\u5f81\u503c $\\pm1$ \u662f\u4e16\u754c\u4e2d\u5b88\u6052\u7684\u6807\u8bb0\u3002\n18|\\end{definition}\n19|=\n20|\\begin{theorem}[\u73bb\u8272\u5b50\u4e0e\u8d39\u7c73\u5b50]\\label{thm:b3:identical-particles:postulate}\n21|\\index{boson}\\index{fermion}\\index{spin-statistics theorem}\n22|\u5168\u540c\u7c92\u5b50\u7684\u6001\u4e0d\u4ec5\u5141\u8bb8\uff0c\u800c\u4e14\\emph{\u5fc5\u987b}\u662f\u6bcf\u4e00\u79cd\u4ea4\u6362\u7684\u672c\u5f81\u6001\uff1a\u5bf9\u4e8e\u4e00\u7c7b\u7c92\u5b50\u2014\u2014\\emph{\u73bb\u8272\u5b50}\u2014\u2014\n23|\u6001\u5b8c\u5168\\emph{\u5bf9\u79f0}\uff0c\u5bf9\u4e8e\u53e6\u4e00\u7c7b\u2014\u2014\\emph{\u8d39\u7c73\u5b50}\u2014\u2014\u6001\u5b8c\u5168\\emph{\u53cd\u5bf9\u79f0}\uff08\u6bcf\u6b21\u4ea4\u6362\u90fd\u6539\u53d8\u7b26\u53f7\uff09\u3002\n24|\u67d0\u4e00\u7269\u79cd\u5c5e\u4e8e\u54ea\u4e00\u7c7b\uff0c\u7531\u5176\u81ea\u65cb\u51b3\u5b9a\uff08\\emph{\u81ea\u65cb\u2013\u7edf\u8ba1\u5b9a\u7406}\uff0c\u4ec5\u5728\u76f8\u5bf9\u8bba\u91cf\u5b50\u573a\u8bba\u4e2d\u5f97\u5230\u8bc1\u660e\uff0c\u6b64\u5904\u4e88\u4ee5\u627f\u8ba4\uff09\uff1a\n25|=\n26|\\[\n27|\\text{\u6574\u6570\u81ea\u65cb} \\Rightarrow \\text{\u73bb\u8272\u5b50} , \\qquad\n28|\\text{\u534a\u6574\u6570\u81ea\u65cb} \\Rightarrow \\text{\u8d39\u7c73\u5b50} .\n29|\\]\n30|\u5149\u5b50\u3001\u03c0 \u4ecb\u5b50\u548c $^4$He \u539f\u5b50\u662f\u73bb\u8272\u5b50\uff1b\u7535\u5b50\u3001\u8d28\u5b50\u3001\u4e2d\u5b50\u548c $^3$He \u662f\u8d39\u7c73\u5b50\u3002\n31|\u590d\u5408\u7c92\u5b50\u7684\u884c\u4e3a\u4e0e\u5176\u7ec4\u6210\u90e8\u5206\u4e4b\u548c\u76f8\u540c\uff1a\u5076\u6570\u4e2a\u8d39\u7c73\u5b50\u675f\u7f1a\u5728\u4e00\u8d77\u662f\u73bb\u8272\u5b50\uff08$^4$He\uff1a2p + 2n + 2e\uff09\uff0c\n32|\u5947\u6570\u4e2a\u5219\u662f\u8d39\u7c73\u5b50\uff08$^3$He\uff09\u2014\u2014\u5176\u540e\u679c\u4e4b\u660e\u663e\uff0c\u72b9\u5982\u4e24\u79cd\u4e0d\u540c\u7684\u6db2\u6001\u6c26\u3002\n33|\\end{theorem}\n34|\\admitted\n35|=\n36|\\begin{corollary}[\u6ce1\u5229\u4e0d\u76f8\u5bb9\u539f\u7406]\\label{cor:b3:identical-particles:pauli}\n37|\\index{Pauli exclusion principle}\n38|\u4e24\u4e2a\u8d39\u7c73\u5b50\u6c38\u8fdc\u4e0d\u80fd\u5360\u636e\u540c\u4e00\u4e2a\u5355\u7c92\u5b50\u6001\uff1a\u5728\u53cd\u5bf9\u79f0\u7ec4\u5408\n39|$(\\ket a\\otimes\\ket b - \\ket b\\otimes\\ket a)/\\sqrt2$ \u4e2d\u4ee4 $\\ket a = \\ket b$\uff0c\u5f97\u5230\u96f6\u77e2\u91cf\u2014\u2014\n40|\u8fd9\u6837\u7684\u6001\u4e0d\u5b58\u5728\u3002\u5bf9\u4e8e\u7535\u5b50\uff08\u81ea\u65cb $\\tfrac12$\uff09\uff0c\n41|\u6bcf\u4e2a\u8f68\u9053\u81f3\u591a\u5bb9\u7eb3\u4e24\u4e2a\u7535\u5b50\uff0c\u4e14\u81ea\u65cb\u6295\u5f71\u76f8\u53cd\u3002\n42|\\end{corollary}\n43|=\n44|\\begin{example}[\u4e0d\u540c\u7684\u8ba1\u6570\u65b9\u5f0f]\\label{ex:b3:identical-particles:counting}\n45|\u4e24\u4e2a\u7c92\u5b50\u5904\u4e8e\u4e24\u4e2a\u6001 $a, b$ \u4e2d\uff1a\u7ecf\u5178\uff08\u53ef\u533a\u5206\uff09\u8ba1\u6570\u7ed9\u51fa\u56db\u79cd\u6784\u578b\uff1b\u73bb\u8272\u5b50\u6709\u4e09\u79cd\uff08$aa$\u3001$bb$\uff0c\n46|\u4ee5\u53ca\\emph{\u4e00}\u79cd\u6df7\u5408\u6001\uff09\uff1b\u8d39\u7c73\u5b50\u6070\u6709\u4e00\u79cd\uff08\u5373\u6df7\u5408\u7684\u53cd\u5bf9\u79f0\u6001\uff09\u3002\u7edf\u8ba1\u7269\u7406\u5c06\u6574\u4f53\u7ee7\u627f\u8fd9\u4e9b\u8ba1\u6570\n47|\uff08\\cref{ch:b3:quantum-statistics}\uff09\uff1b\u5728\u6b64\u5df2\u80fd\u6d88\u89e3\u5341\u4e5d\u4e16\u7eaa\u7684\u4e00\u4e2a\u96be\u9898\u2014\u2014\u5c06\u540c\u4e00\u79cd\u6c14\u4f53\u7684\u4e24\u4efd\u6837\u54c1\u201c\u6df7\u5408\u201d\n48|\u65f6\u7684\u71b5\uff08\\cref{exo:b3:identical-particles:10}\uff09\u3002\n49|\\end{example}\n50|=\n51|\\section{\u5468\u671f\u8868}\n52|=\n53|\\begin{proposition}[\u58f3\u5c42\uff0c\u4ee5\u53ca\u5316\u5b66\u5b58\u5728\u7684\u539f\u56e0]\\label{prop:b3:identical-particles:periodic}\n54|\\index{periodic table}\\index{aufbau principle}\n55|\u6309\u80fd\u91cf\u7531\u4f4e\u5230\u9ad8\uff0c\u5c06\u6bcf\u4e2a\u7c7b\u6c22\u8f68\u9053 $(n, l, m, m_s)$ \u5404\u586b\u5165\u4e00\u4e2a\u7535\u5b50\uff0c\u80fd\u7ea7\u6b21\u5e8f\u7531\u7a7f\u900f\u4e0e\u5c4f\u853d\u51b3\u5b9a\n56|\uff08$1s$\u3001$2s$\u3001$2p$\u3001$3s$\u3001$3p$\u3001$4s$\u3001$3d$\u3001\\dots \u2014\u2014\n57|\\cref{exo:b3:hydrogen-atom:8}\uff09\u3002\u6ce1\u5229\u539f\u7406\u4f7f\u586b\u5145\u8fbe\u5230\\emph{\u9971\u548c}\uff1a$2$ \u4e2a\u7535\u5b50\u586b\u6ee1\u7b2c\u4e00\u58f3\u5c42\uff0c$8$ \u4e2a\u586b\u6ee1\n58|\u7b2c\u4e8c\u548c\u7b2c\u4e09\u884c\uff0c\u5143\u7d20\u5468\u671f\u8868\u7531\u6b64\u5f62\u6210\u5468\u671f\u3002\u5316\u5b66\u7814\u7a76\u7684\u662f\u4e0d\u76f8\u5bb9\u539f\u7406\u7559\u7ed9\u6700\u5916\u5c42\u7684\u90a3\u4e9b\u7535\u5b50\uff1a\u6ee1\u58f3\u5c42\uff08\u7a00\u6709\u6c14\u4f53\uff09\n59|\u662f\u60f0\u6027\u7684\uff1b\u591a\u51fa\u4e00\u4e2a\u7535\u5b50\u4e8e\u6ee1\u58f3\u5c42\u4e4b\u5916\uff08\u78b1\u91d1\u5c5e\uff09\uff0c\u6216\u5dee\u4e00\u4e2a\u7535\u5b50\u624d\u6ee1\u58f3\u5c42\uff08\u5364\u7d20\uff09\uff0c\u4e24\u8005\u4ee5\u76f8\u53cd\u7684\u65b9\u5f0f\u5177\u6709\u53cd\u5e94\u6027\u3002\n60|\u82e5\u6ca1\u6709\u8d1f\u53f7\uff0c\u6bcf\u4e2a\u7535\u5b50\u90fd\u4f1a\u843d\u5165 $1s$\uff0c\u6bcf\u4e2a\u539f\u5b50\u90fd\u4f1a\u6210\u4e3a\u4e00\u4e2a\u7f29\u5c0f\u7684\u7c7b\u6c26\u5c0f\u7403\uff0c\u4e8e\u662f\u65e2\u6ca1\u6709\u5316\u5b