\u5fae\u79d2\u540e\uff0c\n221| \u5176\u8870\u53d8\u7535\u5b50\u5728\u540c\u4e00\u5757\u63a2\u6d4b\u5668\u4e2d\u4ea7\u751f\u7b2c\u4e8c\u6b21\u95ea\u70c1\u3002\u5ef6\u8fdf\u76f4\u65b9\u56fe\n222| \u662f\u4e00\u4e2a\u6307\u6570\u5206\u5e03\uff0c\u5176\u659c\u7387\\emph{\u6070\u4e3a}\n223| $\\tau = \\qty{2.2}{\\micro s}$\uff1a\u5728\u684c\u9762\u4e0a\u6d4b\u5f97\u7684\u5bff\u547d\u3002\n224| \\textbf{19.} \u73bb\u5c14\u516c\u5f0f\u90fd\u968f\u8d28\u91cf\u6807\u5ea6\uff1a\u03bc\u5b50\u6c22\u539f\u5b50\n225| \u8f68\u9053\u7f29\u5c0f $207$ \u500d\uff0c\u81f3\u7ea6 ${\\sim}\\qty{250}{fm}$ ---\n226| \u6df1\u5165\u7535\u5b50\u4e91\u4e4b\u5185\uff0c\u4ee5\u81f3\u4e8e \u03bc\u5b50\u80fd\u611f\u53d7\u5230\n227| \u8d28\u5b50\u7684\u5927\u5c0f\uff1a\u03bc\u5b50\u539f\u5b50\u662f\u8d28\u5b50\u7684\u5c3a\u5b50\u3002\n228| \\textbf{20.} $10^{15}/10^{6} = \\qty{e9}{eV}$\uff1a\u6bcf\u4e2a\u7c92\u5b50\u7ea6\n229| \u4e00 GeV --- \u4f60\u9601\u697c\u91cc\u7684 \u03bc\u5b50\u53ea\u662f\u666e\u901a\u7c07\u5c04\u6210\u5458\u3002\n230| \\textbf{21.} \u76f8\u5bf9\u8bba\u6027 \u03bc\u5b50\u5728\u6c34\u4e2d\u6bd4\u5149\u8dd1\u5f97\u66f4\u5feb\uff0c\u53d1\u51fa\n231| \u5207\u4f26\u79d1\u592b\u84dd\u5149\u5c04\u5165\u6c34\u7bb1\u7684\u5149\u7535\u500d\u589e\u7ba1\u3002\u4e00\u4e2a\n232| $10^{20}\\,\\unit{eV}$ \u7c07\u5c04\u7684\u8db3\u8ff9\u8de8\u8d8a\u8bb8\u591a\n233| \u5e73\u65b9\u5343\u7c73\uff0c\u56e0\u6b64\u7a00\u758f\u7684\u6c34\u7bb1\u5bf9\u5b83\u53d6\u6837\uff0c\u72b9\u5982\n234| \u6c34\u6876\u63a5\u96e8\u6ef4\u3002\n235| \\textbf{22.} \u7c92\u5b50\u5728\u4ecb\u8d28\u4e2d\u6c89\u79ef\u80fd\u91cf\uff0c\u4ecb\u8d28\u5c06\u5176\u8f6c\u6362\u4e3a\n236| \u5149\uff0c\u5149\u7535\u500d\u589e\u7ba1\u5c06\u5149\u8f6c\u6362\u4e3a\n237| \u7535\u5b50\uff0c\u7535\u5b50\u5b66\u7535\u8def\u8ba1\u6570\uff1a\u4ece\u9601\u697c\u5230\u5bf9\u649e\u673a\u7684\u6bcf\u4e00\u53f0\u91cf\u80fd\u5668\uff0c\n238| \u90fd\u5728\u91cd\u590d\u8fd9\u540c\u4e00\u53e5\u8bdd\u3002\n239| \\textbf{23.} \u5f2f\u66f2\u5f84\u8ff9\u7684\u534a\u5f84\u7ed9\u51fa\u52a8\u91cf\uff0c\u5176\u5f2f\u66f2\u65b9\u5411\u7ed9\u51fa\n240| \u7535\u8377\u7684\u7b26\u53f7\uff1b\u5149\u5b50\u3001\u4e2d\u5b50\u548c\u4e2d\u5fae\u5b50 ---\n241| \u4e0d\u5e26\u7535 --- \u4e0d\u7559\u5f84\u8ff9\uff0c\u53ea\u5728\n242| \u5b88\u6052\u8d26\u76ee\u4e2d\u53ea\u7559\u4e0b\u5b83\u4eec\u7684\u4e8f\u6b20\u3002\n243| \\textbf{24.} \u81ea\u7136\u754c\u52a0\u901f\u5355\u4e2a\u8d28\u5b50\u6240\u8fbe\u7684\u80fd\u91cf\uff0c\u6bd4\n244| LHC \u9ad8\u4e00\u5343\u4e07\u500d --- \u4ee4\u4eba\u8c26\u5351 --- \u4f46\u6bcf\u5e73\u65b9\u5343\u7c73\n245| \u6bcf\u4e16\u7eaa\u4ec5\u4e00\u4e2a\uff1a\u6211\u4eec\u7684\u673a\u5668\u4ee5\u5cf0\u503c\u80fd\u91cf\u6362\u53d6\n246| \u6bcf\u79d2 $10^{9}$ \u6b21\u53ef\u63a7\u78b0\u649e\u3002\n247| \\textbf{25.} \u8bde\u751f\u4e8e\u9ad8\u7a7a\u5341\u5343\u7c73\u5904\u7684\u8d28\u5b50\uff1b\n248| \u56e0\u65f6\u95f4\u5ef6\u7f13\u5f97\u4ee5\u5b89\u7136\u62b5\u8fbe\uff08$\\gamma \\approx 38$\uff0c\u7ea6\u534a\u6570\u5b58\u6d3b\uff09\uff1b\n249| \u7531\u76f8\u9694\u4e00\u767e\u7eb3\u79d2\u7684\u4e24\u6b21\u95ea\u70c1\u6240\u786e\u8ba4\uff0c\u5e76\n250| \u5b8c\u5168\u501f\u52a9\u4e00\u5f20\u6709\u5341\u4e8c\u4e2a\u5ea7\u4f4d\u548c\u56db\u79cd\n251| \u529b\u7684\u8868\u683c\u5f97\u5230\u89e3\u91ca\u3002\n252|=\n253|=",
