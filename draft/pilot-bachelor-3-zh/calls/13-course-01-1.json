n22|\u8bbe $\\hat H = \\hat H_0 + \\hat V$\uff0c\u5176\u4e2d $\\hat H_0$ \u5df2\u53ef\u7cbe\u786e\u6c42\u89e3\uff0c\n23|\uff08$\\hat H_0\\ket n = E_n\\ket n$\uff0c\u8c31\u975e\u7b80\u5e76\uff09\uff0c\u4e14 $\\hat V$\n24|\u4e3a\u5c0f\u91cf\u3002\u5219\u6309 $\\hat V$ \u9010\u9636\u5c55\u5f00\uff0c\n25|=\n26|=\n27|=\n28|=\n29|=\n30|\u4e14\u6001\u77e2\u83b7\u5f97\u6df7\u5165\u9879 $\\ket{n'} = \\ket n + \\sum_{m\\neq\n31|=\n32|\\emph{\u4e00\u9636}\uff1a\u80fd\u91cf\u79fb\u52a8\u5c31\u662f\u5fae\u6270\u5728\n33|\u672a\u5fae\u6270\u6001\u4e2d\u7684\u5e73\u5747\u503c\u3002\\emph{\u4e8c\u9636}\uff1a\u4e0e\u5176\u4ed6\u80fd\u7ea7\u7684\u8026\u5408\n34|\u4f1a\u4f7f $E_n$ \\emph{\u8fdc\u79bb}\u8fd9\u4e9b\u80fd\u7ea7\u2014\u2014\u9ad8\u4e8e\u5b83\u7684\u6bcf\u4e2a $m$ \u628a\u5b83\u5f80\u4e0b\u63a8\uff0c\n35|\u4f4e\u4e8e\u5b83\u7684\u6bcf\u4e2a $m$ \u628a\u5b83\u5f80\u4e0a\u63a8\u2014\u2014\u56e0\u6b64\u57fa\u6001\u7684\u4e8c\u9636\u79fb\u52a8\u603b\u662f\u8d1f\u7684\u3002\n36|\u6709\u6548\u6027\u8981\u6c42\u6df7\u5408\u6bd4\u4f8b\n37|$|\\bra m\\hat V\\ket n/(E_n - E_m)|$ \u5fc5\u987b\u5f88\u5c0f\u3002\n38|\\end{theorem}\n39|=\n40|\\begin{proof}[\u90e8\u5206\u8bc1\u660e]\n41|\u5c06 $E' = E + \\epsilon_1 + \\epsilon_2 + \\cdots$ \u4e0e $\\ket{\\psi} =\n42|\\ket n + \\ket{\\psi_1} + \\cdots$ \u6309 $\\hat V$ \u7684\u5e42\u6b21\u5c55\u5f00\uff0c\u4ee3\u5165\n43|$(\\hat H_0 + \\hat V)\\ket\\psi = E'\\ket\\psi$\uff0c\u5e76\u6309\u9636\u6570\u6bd4\u8f83\u3002\n44|\u5c06\u4e00\u9636\u65b9\u7a0b\u6295\u5f71\u5230 $\\bra n$ \u4e0a\uff0c\u5373\u5f97 $\\epsilon_1 =\n45|$\\bra n\\hat V\\ket n$\uff1b\u6295\u5f71\u5230 $\\bra m$\uff08$m \\neq n$\uff09\u4e0a\u5219\u5f97\u6df7\u5408\u7cfb\u6570\uff1b\n46|\u5c06\u5b83\u4eec\u4ee3\u5165\u4e8c\u9636\u65b9\u7a0b\uff0c\n47|\u518d\u6295\u5f71\u5230 $\\bra n$ \u4e0a\u5373\u5f97 $\\epsilon_2$\u3002\u5173\u4e8e\u57fa\u6001\u7684\u7b26\u53f7\u7ed3\u8bba\uff1a\n48|\u6bcf\u4e2a\u5206\u6bcd $E_0 - E_m$ \u5747\u4e3a\u8d1f\uff0c\n49|\u800c\u5206\u5b50\u662f\u5e73\u65b9\u9879\u3002\n50|\\end{proof}\n51|=\n52|\\begin{proposition}[\u53ef\u7cbe\u786e\u6c42\u89e3\u7684\u5fae\u6270]\\label{prop:b3:perturbation-theory:oscillator-field}\n53|\u7535\u8377\u4e3a $q$ \u7684\u632f\u5b50\u7f6e\u4e8e\u5747\u5300\u573a $\\mathcal E$ \u4e2d\uff0c\n54|\u5176 $\\hat V = -q\\mathcal E\\hat x$\u3002\u914d\u65b9\u53ef\u7cbe\u786e\u6c42\u89e3\uff1a\n55|\u52bf\u80fd\u4ecd\u662f\u540c\u4e00\u629b\u7269\u7ebf\uff0c\u53ea\u662f\u53d1\u751f\u5e73\u79fb\uff0c\u6240\u6709\u80fd\u7ea7\u6574\u4f53\u964d\u4f4e\n56|$q^2\\mathcal E^2/2m\\omega^2$\u3002\u5fae\u6270\u7406\u8bba\u5fc5\u987b\u4e0e\u4e4b\u76f8\u7b26\uff0c\n57|\u4e8b\u5b9e\u786e\u662f\u5982\u6b64\uff1a\u4e00\u9636\u4e3a\u96f6\uff08$\\langle\\hat\n58|x\\rangle_n = 0$\uff09\uff0c\u800c\u4e8c\u9636\u6c42\u548c\u4e2d $\\hat x$ \u4ec5\u4f7f $n$ \u4e0e $n \\pm 1$ \u8026\u5408\uff0c\n59|\u5bf9\u6bcf\u4e2a\u80fd\u7ea7\u6070\u597d\u7ed9\u51fa\n60|$-q^2\\mathcal E^2/2m\\omega^2$\u3002\n61|\uff08\u89c1\\cref{exo:b3:perturbation-theory:2}\uff09\u3002\u4e00\u4e2a\u53ef\u7cbe\u786e\u6c42\u89e3\u7684\u4f8b\u5b50\uff0c\u4e24\u79cd\u65b9\u6cd5\u4e92\u76f8\u9a8c\u8bc1\uff0c\n62|\u662f\u65b9\u6cd5\u6240\u80fd\u83b7\u5f97\u7684\u6700\u597d\u6821\u51c6\u3002\n63|\\end{proposition}\n64|=\n65|\\begin{proof}\n66|\u4e24\u4e2a\u77e9\u9635\u5143\u53ca\u5176\u5206\u6bcd\u7ed9\u51fa\n67|=\n68|=\n69|=\n70|=\n71|=\n72|=\n73|\u4e58\u4ee5 $q^2\\mathcal E^2$\u3002\n74|=\n75|=\n76|=\n77|=\n78|=\n79|=\n80|  xlabel={\u8026\u5408 $v$}, ylabel={\u80fd\u91cf},\n81|=\n82|=\n83|=\n84|=\n85|=\n86|=\n87|=\n88|    \\node[font=\\scriptsize, anchor=west] at (axis cs:0.05,0.44) {\u95f4\u9699 $\\ge$ \u88f8\u5206\u88c2};\n89|=\n90|    \\node[omThm, font=\\scriptsize, anchor=west] at (axis cs:0.05,-0.14) {\u6700\u8fd1\u5904 $2|v|$};\n91|    \\node[omDef, font=\\scriptsize, anchor=south] at (axis cs:-1.15,0.98) {\u4e0a\u80fd\u7ea7};\n92|    \\node[omDef, font=\\scriptsize, anchor=north] at (axis cs:-1.15,-1.02) {\u4e0b\u80fd\u7ea7};\n93|=\n94