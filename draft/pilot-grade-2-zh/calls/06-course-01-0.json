 "result": "\\chapter{\u63a8\u4e0e\u62c9\uff1a\u529b}\\label{ch:g2:pushes-and-pulls}\n=\n\u5f00\u95e8\u3001\u62c9\u62c9\u94fe\u3001\u8e22\u7403\u3001\u62d6\u96ea\u6a47\uff1a\u4f60\u7684\u4e00\u6574\u5929\u90fd\u5728\u63a8\u548c\u62c9\u3002\u7269\u7406\u5b66\u628a\u8fd9\u4e9b\u7edf\u79f0\u4e3a\u4e00\u4e2a\u4e86\u4e0d\u8d77\u7684\u540d\u5b57\u2014\u2014\u529b\u2014\u2014\u5e76\u63d0\u51fa\u4e24\u4e2a\u7b80\u5355\u7684\u95ee\u9898\uff1a\u529b\u80fd\u505a\u4ec0\u4e48\uff0c\u5b83\u671d\u54ea\u4e2a\u65b9\u5411\u4f5c\u7528\uff1f\n=\n\\section{\u5904\u5904\u90fd\u6709\u63a8\u548c\u62c9}\n=\n\\begin{definition}[\u529b]\\label{def:g2:pushes-and-pulls:force}\n\u4e00\u4e2a\\emph{\u529b}\\index{\u529b}\u5c31\u662f\u4e00\u6b21\u63a8\u6216\u4e00\u6b21\u62c9\u3002\u63a8\u79cb\u5343\u3001\u62c9\u5c0f\u8f66\u3001\u6309\u95e8\u94c3\u3001\u62c9\u4f38\u6a61\u76ae\u7b4b\u3001\u634f\u9762\u56e2\uff1a\u8fd9\u4e9b\u90fd\u662f\u6b63\u5728\u8d77\u4f5c\u7528\u7684\u529b\u3002\u529b\u603b\u6709\u5927\u5c0f\u2014\u2014\u8f7b\u67d4\u8fd8\u662f\u5f3a\u52b2\u2014\u2014\u8fd8\u6709\\emph{\u65b9\u5411}\uff1a\u5b83\u671d\\emph{\u67d0\u4e2a\u65b9\u5411}\u63a8\u6216\u62c9\u3002\n\\end{definition}\n=\n\\begin{example}[\u63a8\u8fd8\u662f\u62c9\uff1f]\\label{ex:g2:pushes-and-pulls:sort}\n\u60f3\u4e00\u60f3\uff0c\u4f60\u7684\u4e00\u5929\u91cc\uff1a\u7528\u811a\u8e22\u7403\uff0c\u662f\u63a8\u3002\u62c9\u5f00\u62bd\u5c49\uff0c\u662f\u62c9\u3002\u63a8\u4e0a\u62bd\u5c49\uff0c\u662f\u63a8\u3002\u62c9\u4e0a\u5916\u5957\u62c9\u94fe\uff0c\u662f\u62c9\u3002\u63c9\u9762\u56e2\uff0c\u662f\u8bb8\u591a\u6b21\u5c0f\u5c0f\u7684\u63a8\u3002\u62d4\u6cb3\uff0c\u662f\u4e24\u961f\u4eba\u671d\u76f8\u53cd\u65b9\u5411\u62c9\u540c\u4e00\u6839\u7ef3\u5b50\u3002\n\\end{example}\n=\n\\begin{method}[\u7528\u7bad\u5934\u753b\u529b]\\label{met:g2:pushes-and-pulls:arrow}\n\u7269\u7406\u5b66\u5bb6\u7528\u4e00\u4e2a\\emph{\u7bad\u5934}\u6765\u753b\u529b\uff1a\n=\n\\begin{enumerate}\n  \\item \u7bad\u5934\u4ece\u63a8\u6216\u62c9\u6293\u4f4f\u7269\u4f53\u7684\u5730\u65b9\u5f00\u59cb\uff1b\n  \\item \u7bad\u5934\u6307\u5411\u529b\u4f5c\u7528\u7684\u65b9\u5411\uff1b\n  \\item \u529b\u8d8a\u5927\uff0c\u7bad\u5934\u8d8a\u957f\u3002\n\\end{enumerate}\n=\n\u4e00\u652f\u5c0f\u5c0f\u7684\u7bad\u5934\uff0c\u5c31\u80fd\u8bf4\u6e05\u5168\u90e8\u60c5\u51b5\uff1a\u5728\u54ea\u91cc\uff0c\u671d\u54ea\u8fb9\uff0c\u7528\u4e86\u591a\u5927\u7684\u529b\u3002\n\u6211\u4eec\u4ee5\u540e\u8fd8\u4f1a\u753b\u5f88\u591a\u8fd9\u6837\u7684\u7bad\u5934\u3002\n=\n\\end{method}\n=\n\\begin{omfigure}\n=\n\\begin{tikzpicture}[scale=0.85]\n  \\draw[thick] (0,0) -- (4.6,0);\n  \\draw[thick, fill=omMeth, fill opacity=0.4] (1.4,0) rectangle (2.9,1.0);\n  \\draw[-Stealth, very thick, omThm] (0.2,0.5) -- (1.3,0.5);\n  \\node[below, font=\\small] at (2.3,-0.25) {\u8f7b\u8f7b\u4e00\u63a8\uff1a\u7bad\u5934\u77ed};\n  \\draw[thick] (6.4,0) -- (11.0,0);\n  \\draw[thick, fill=omMeth, fill opacity=0.4] (8.4,0) rectangle (9.9,1.0);\n  \\draw[-Stealth, very thick, omThm] (6.5,0.5) -- (8.3,0.5);\n  \\node[below, font=\\small] at (8.7,-0.25) {\u7528\u529b\u4e00\u63a8\uff1a\u7bad\u5934\u957f};\n\\end{tikzpicture}\n=\n{\\small \u540c\u4e00\u4e2a\u7bb1\u5b50\u88ab\u63a8\u4e86\u4e24\u6b21\u3002\u7bad\u5934\u8868\u793a\u63a8\u5728\u54ea\u91cc\uff0c\u671d\u54ea\u4e2a\u65b9\u5411\uff0c\u4ee5\u53ca\u7528\u4e86\u591a\u5927\u7684\u529b\u2014\u2014\u7bad\u5934\u8d8a\u957f\uff0c\u529b\u8d8a\u5927\u3002}\n=\n\\end{omfigure}\n=\n\\begin{omfigure}\n=\n\\includegraphics[width=0.58\\linewidth]{images/book1/ai/g2-pushes-kick.jpg}\n=\n{\\small \u529b\u4f5c\u7528\u7684\u90a3\u4e00\u523b\uff1a\u9774\u5b50\u5728\u63a8\uff0c\u9759\u6b62\u7684\u7403\u9a6c\u4e0a\u5c31\u8981\u98de\u51fa\u53bb\u3002}\n=\n\\end{omfigure}\n=\n\\section{\u529b\u80fd\u505a\u4ec0\u4e48}\n=\n\\begin{proposition}[\u529b\u7684\u56db\u79cd\u4f5c\u7528]\\label{prop:g2:pushes-and-pulls:jobs}\n\u529b\u53ef\u4ee5\u5bf9\u7269\u4f53\u505a\u56db\u4ef6\u4e8b\uff1a\n=\n\\begin{enumerate}\n  \\item \u4f7f\u5b83\\emph{\u5f00\u59cb}\u8fd0\u52a8\u2014\u2014\u4e00\u811a\u8e22\u51fa\uff0c\u9759\u6b62\u7684\u7403\u98de\u8d70\u4e86\uff1b\n  \\item \u4f7f\u5b83\\emph{\u505c\u4e0b}\u2014\u2014\u5b88\u95e8\u5458\u7684\u624b\u6321\u4f4f\u4e86\u5c04\u95e8\u7684\u7403\uff1b\n  \\item \u4f7f\u5b83\\emph{\u8f6c\u5411}\u2014\u2014\u4fa7\u9762\u8f7b\u8f7b\u4e00\u62e8\uff0c\u6eda\u52a8\u7684\u7403\u7684\u8def\u7ebf\u5c31\u5f2f\u4e86\uff1b\n  \\item \u4f7f\u5b83\\emph{\u6539\u53d8\u5f62\u72b6}\u2014\u2014\u6324\u538b\u4f7f\u6d77\u7ef5\u53d8\u6241\uff0c\u62c9\u4f38\u4f7f\u6a61\u76ae\u7b4b\u53d8\u957f\u3002\n\\end{enumerate}\n=\n\u6ca1\u6709\u529b\uff0c\u5c31\u6ca1\u6709\u8fd9\u56db\u79cd\u4f5c\u7528\uff1a\u4e00\u4e2a\u5b8c\u5168\u4e0d\u53d7\u5916\u529b\u7684\u7269\u4f53\uff0c\u4f1a\u4e00\u76f4\u4fdd\u6301\u539f\u6765\u7684\u72b6\u6001\u3002\n=\n\\end{proposition}\n=\n\\begin{omfigure}\n=\n\\begin{tikzpicture}[scale=0.85]\n  \\draw[dashed, omExo] (0,0.6) -- (4.2,0.6);\n  \\fill[omDef] (0.6,0.6) circle (0.24);\n  \\fill[omDef, opacity=0.45] (3.0,0.6) circle (0.24);\n  \\draw[-Stealth, very thick, omThm] (4.2,0.6) -- (6.0,1.7);\n  \\fill[omDef, opacity=0.45] (5.4,1.33) circle (0.24);\n  \\draw[-Stealth, thick, omThm] (4.2,-0.35) -- (4.2,0.5);\n  \\node[below, font=\\small, omThm] at (4.2,-0.5) {\u6b64\u5904\u4fa7\u9762\u8f7b\u62e8};\n  \\node[below, font=\\small] at (1.4,0.3) {\u6cbf\u76f4\u7ebf\u6eda\u52a8};\n  \\node[right, font=\\small] at (5.85,2.05) {\u65b9\u5411\u53d8\u4e86\uff01};\n\\end{tikzpicture}\n=\n{\\small \u7b2c\u4e09\u79cd\u4f5c\u7528\uff1a\u6eda\u52a8\u7684\u7403\u53d7\u5230\u4fa7\u9762\u7684\u8f7b\u62e8\uff0c\u8def\u7ebf\u671d\u7740\u63a8\u7684\u65b9\u5411\u5f2f\u4e86\u3002}\n=\n\\end{omfigure}\n=\n\\begin{example}[\u529b\u8d8a\u5f3a\uff0c\u6548\u679c\u8d8a\u5927]\\label{ex:g2:pushes-and-pulls:stronger}\n\u8f7b\u8f7b\u62e8\u4e00\u4e0b\u5f39\u73e0\uff0c\u5b83\u6162\u6162\u6eda\u5230\u684c\u5b50\u8fb9\u7f18\u3002\u7528\u529b\u5f39\u51fa\u53bb\uff0c\u5b83\u5c31\u98de\u8fc7\u6574\u4e2a\u623f\u95f4\u3002\u540c\u4e00\u9897\u5f39\u73e0\uff0c\u540c\u4e00\u6839\u624b\u6307\uff0c\u53ea\u662f\u63a8\u7684\u529b\u53d8\u4e86\uff0c\u5f39\u73e0\u7684\u98de\u884c\u4e5f\u968f\u4e4b\u6539\u53d8\u3002\u529b\u8f7b\uff0c\u6548\u679c\u5c31\u8f7b\uff1b\u529b\u5927\uff0c\u6548\u679c\u5c31\u5927\u3002\n\\end{example}\n=\n\\begin{example}[\u52a8\u624b\u8bd5\u4e00\u8bd5\uff1a\u6539\u53d8\u5f62\u72b6]\\label{ex:g2:pushes-and-pulls:shape}\n\u627e\u6765\u4e00\u5757\u6d77\u7ef5\u3001\u4e00\u6839\u6a61\u76ae\u7b4b\u3001\u4e00\u56e2\u6a61\u76ae\u6ce5\u548c\u4e00\u5757\u6728\u5757\u3002\u5206\u522b\u6324\u4e00\u6324\u3001\u62c9\u4e00\u62c9\u3002\u677e\u624b\u4ee5\u540e\uff0c\u6d77\u7ef5\u4f1a\u5f39\u56de\u539f\u6765\u7684\u6837\u5b50\uff1b\u6a61\u76ae\u7b4b\u4e5f\u4e00\u6837\u3002\u6a61\u76ae\u6ce5\u4f1a\u4fdd\u6301\u65b0\u7684\u5f62\u72b6\u2014\u2014\u4f60\u7684\u529b\u5728\u4e0a\u9762\u7559\u4e0b\u4e86\u6c38\u4e45\u7684\u51f9\u75d5\u3002\u90a3\u6728\u5757\u5462\uff1f\u4f60\u6700\u7528\u529b\u7684\u6324\u538b\uff0c\u4e5f\u6ca1\u6709\u8ba9\u5b83\u6709\u4efb\u4f55\u53d8\u5316\uff08\u81f3\u5c11\u4f60\u770b\u4e0d\u51fa\u6765\uff01\uff09\u3002\u5404\u79cd\u7269\u4f53\u5bf9\u529b\u7684\u53cd\u5e94\uff0c\u5404\u6709\u5404\u7684\u65b9\u5f0f\u3002\n\\end{example}\n=\n\\section{\u4e0d\u63a5\u89e6\u7684\u529b}\n=\n\\begin{example}[\u5730\u7403\u7684\u62c9\u529b]\\label{ex:g2:pushes-and-pulls:earthpull}\n\u677e\u624b\u8ba9\u52fa\u5b50\u6389\u4e0b\u53bb\uff1a\u5b83\u4f1a\u5f80\u4e0b\u843d\u3002\u628a\u7403\u629b\u5f97\u518d\u9ad8\uff0c\u5b83\u7ec8\u7a76\u4f1a\u843d\u56de\u6765\u3002\u6811\u53f6\u3001\u96e8\u6ef4\u3001\u788e\u5c51\u2014\u2014\u51e1\u662f\u677e\u624b\u7684\u4e1c\u897f\uff0c\u90fd\u4f1a\\emph{\u5411\u4e0b}\u843d\u3002\u603b\u6709\u4e00\u79cd\u529b\u5728\u65f6\u65f6\u523b\u523b\u62c9\u7740\u5b83\u4eec\uff0c\u5374\u5e76\u4e0d\u4e0e\u5b83\u4eec\u63a5\u89e6\uff1a\u8fd9\u5c31\u662f\u5730\u7403\u672c\u8eab\u3002\u5730\u7403\u7684\u62c9\u529b\u662f\u4f60\u751f\u6d3b\u4e2d\u6700\u7a33\u5b9a\u7684\u529b\u2014\u2014\u5b83\u4ece\u4e0d\u677e\u5f00\uff0c\u4e5f\u6b63\u56e0\u4e3a\u5982\u6b64\uff0c\u64cd\u573a\u4e0a\u7684\u201c\u4e0b\u201d\u5728\u4efb\u4f55\u5730\u65b9\u90fd\u662f\u540c\u4e00\u4e2a\u65b9\u5411\u3002\n\\end{example}\n=",
