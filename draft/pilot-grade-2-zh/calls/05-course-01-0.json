 "result": "1| \\chapter{\u6708\u4eae\u5728\u5929\u4e0a}\\label{ch:g2:moon-in-the-sky}\n2|=\n3| \u6709\u4e9b\u508d\u665a\uff0c\u4e00\u5f2f\u7ec6\u7ec6\u7684\u94f6\u8272\u6708\u7259\u6302\u5728\u5c4b\u9876\u4e0a\u7a7a\uff1b\u4e24\u5468\u540e\uff0c\u4e00\u8f6e\u5706\u5706\u7684\u6ee1\u6708\u628a\u82b1\u56ed\u7167\u5f97\u4e00\u7247\u82cd\u767d\u3002\u5b83\u4eec\u662f\u540c\u4e00\u4e2a\u6708\u4eae\u2014\u2014\u5929\u7a7a\u4e2d\u79bb\u6211\u4eec\u6700\u8fd1\u7684\u90bb\u5c45\uff0c\u4e5f\u662f\u4eba\u7c7b\u552f\u4e00\u66fe\u7ecf\u8e0f\u8db3\u7684\u53e6\u4e00\u4e2a\u4e16\u754c\u3002\u8ba9\u6211\u4eec\u597d\u597d\u8ba4\u8bc6\u4e00\u4e0b\u5b83\u3002\n4| \n5| \\section{\u5929\u7a7a\u4e2d\u7684\u90bb\u5c45}\n6|=\n7| \\begin{definition}[\u6708\u7403]\\label{def:g2:moon-in-the-sky:moon}\n8| \\emph{\u6708\u7403}\\index{\u6708\u7403}\u662f\u4e00\u4e2a\u5de8\u5927\u7684\u7070\u8272\u5ca9\u77f3\u7403\uff0c\u7ed5\u7740\u5730\u7403\u8fd0\u884c\uff0c\u662f\u6211\u4eec\u5728\u592a\u7a7a\u4e2d\u5fe0\u5b9e\u7684\u4f19\u4f34\u3002\u5b83\u6bd4\u5730\u7403\u5c0f\u5f97\u591a\uff0c\u800c\u4e14\u79bb\u6211\u4eec\u975e\u5e38\u9065\u8fdc\u2014\u2014\u6bd4\u4efb\u4f55\u98de\u673a\u98de\u5f97\u90fd\u8fdc\uff0c\u4ee5\u81f3\u4e8e\u66fe\u7ecf\u9020\u8bbf\u5b83\u7684\u5b87\u822a\u5458\uff0c\u82b1\u4e86\u4e09\u5929\u65f6\u95f4\u624d\u62b5\u8fbe\u90a3\u91cc\u3002\n9| \\end{definition}\n10|=\n11| \\begin{example}[\u4ed4\u7ec6\u89c2\u5bdf]\\label{ex:g2:moon-in-the-sky:closely}\n12| \u7528\u8089\u773c\u770b\u6708\u4eae\uff0c\u4f1a\u770b\u5230\u4e00\u4e9b\u6d45\u8272\u7684\u6591\u5757\u548c\u660e\u4eae\u7684\u533a\u57df\u2014\u2014\u6709\u4eba\u8fd8\u80fd\u5728\u5176\u4e2d\u770b\u51fa\u4e00\u5f20\u8138\u3002\u7528\u53cc\u7b52\u671b\u8fdc\u955c\uff08\u5728\u6ee1\u6708\u4e4b\u591c\u8bd5\u8bd5\uff0c\u975e\u5e38\u6709\u8da3\uff09\u770b\uff0c\u6591\u5757\u5c31\u53d8\u5f97\u6e05\u6670\uff0c\u6210\u4e86\u5e73\u539f\u548c\u4e00\u4e2a\u4e2a\u5706\u5f62\u7684\\emph{\u73af\u5f62\u5c71}\\index{\u73af\u5f62\u5c71}\uff0c\u90a3\u662f\u5f88\u4e45\u4ee5\u524d\u4ece\u592a\u7a7a\u4e2d\u843d\u4e0b\u7684\u5ca9\u77f3\u649e\u51fb\u7559\u4e0b\u7684\u7897\u72b6\u75a4\u75d5\u3002\u6708\u7403\u6c38\u8fdc\u4fdd\u7559\u7740\u8fd9\u4e9b\u75a4\u75d5\uff1a\u5b83\u6ca1\u6709\u98ce\uff0c\u4e5f\u6ca1\u6709\u96e8\u6765\u628a\u5b83\u4eec\u62b9\u53bb\u2014\u2014\u4e8b\u5b9e\u4e0a\uff0c\u5b83\u6839\u672c\u6ca1\u6709\u7a7a\u6c14\u3002\u6ca1\u6709\u7a7a\u6c14\u4e5f\u5c31\u610f\u5473\u7740\u4e00\u4e2a\u5bc2\u9759\u7684\u4e16\u754c\uff1a\u5728\u6708\u7403\u4e0a\uff0c\u5373\u4f7f\u5927\u58f0\u547c\u558a\uff0c\u4e5f\u542c\u4e0d\u5230\u4efb\u4f55\u58f0\u97f3\u3002\n13| \\end{example}\n14|=\n15| \\begin{omfigure}\n16| \\includegraphics[width=0.44\\linewidth]{images/book1/moon-nearside-lro.jpg}\n17|=\n18| {\\small \u4ece\u8f68\u9053\u4e0a\u62cd\u6444\u7684\u6708\u7403\u6b63\u9762\uff1a\u5230\u5904\u662f\u7897\u72b6\u7684\u73af\u5f62\u5c71\uff0c\u8fd8\u6709\u5927\u7247\u6df1\u8272\u7684\u5e73\u539f\u2014\u2014\u5374\u6ca1\u6709\u7a7a\u6c14\uff0c\u6ca1\u6709\u98ce\uff0c\u4e5f\u6ca1\u6709\u58f0\u97f3\u3002\\emph{\u56fe\u7247\u6765\u6e90\uff1aNASA/GSFC/\u4e9a\u5229\u6851\u90a3\u5dde\u7acb\u5927\u5b66\u3002}}\n19| \\end{omfigure}\n20|=\n21| \\begin{example}[\u8ddf\u7740\u4f60\u8d70\u7684\u6708\u4eae]\\label{ex:g2:moon-in-the-sky:follows}\n22| \u5728\u6708\u5149\u660e\u4eae\u7684\u591c\u665a\u6cbf\u7740\u8857\u9053\u8d70\uff0c\u623f\u5c4b\u548c\u6811\u6728\u4e0d\u65ad\u5411\u540e\u63a0\u8fc7\uff0c\u4f46\u6708\u4eae\u4f3c\u4e4e\u59cb\u7ec8\u8ddf\u5728\u4f60\u7684\u80a9\u5934\u3002\u5b83\u5176\u5b9e\u5e76\u6ca1\u6709\u8ffd\u7740\u4f60\u2014\u2014\u5b83\u79bb\u6211\u4eec\u592a\u8fdc\u4e86\uff0c\u8d70\u5b8c\u4e00\u6574\u6761\u8857\uff0c\u5b83\u5728\u4f60\u89c6\u91ce\u4e2d\u7684\u4f4d\u7f6e\u51e0\u4e4e\u4e0d\u53d8\uff0c\u800c\u8fd1\u5904\u7684\u623f\u5c4b\u5374\u4e00\u76f4\u5728\u53d8\u5316\u3002\u975e\u5e38\u9065\u8fdc\u7684\u7269\u4f53\u4f3c\u4e4e\u4f1a\u8ddf\u7740\u6bcf\u4e00\u4f4d\u884c\u4eba\uff1b\u6708\u4eae\u4e4b\u6240\