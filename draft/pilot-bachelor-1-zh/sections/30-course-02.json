.36/0.29, 0.45/0.53, 1.32/0.12, 0.85/1.02, 0.16/0.39, -1.09/0.88, -0.62/1.20, 0.12/0.22, 0.18/0.89, 0.03/0.67, 0.20/0.44, 0.73/0.37, -0.95/1.23, 0.05/0.95, 0.00/0.45, 3.02/1.19, -0.63/0.30} \\fill[omDef] (\\x,\\y) circle (0.8pt);", "    \\node[font=\\footnotesize] at (0,-0.35) {$2000$ 个电子：干涉条纹};", "  \\end{scope}", "\\end{tikzpicture}\\hfill", "\\begin{tikzpicture}", "\\begin{axis}[omaxis, axis x line=bottom, axis y line=left, width=6.6cm, height=5.0cm,", "    xlabel={屏幕上的位置}, ylabel={概率密度 $|\\psi|^2$},", "    xlabel style={at={(axis description cs:0.5,-0.08)}, anchor=north},", "    xmin=-3.2, xmax=3.2, ymin=0, ymax=1.1, xtick=\\empty, ytick=\\empty, samples=200]", "  \\addplot[omDef, thick, domain=-3.2:3.2] {cos(deg(pi*x/0.6))^2*(sin(deg(pi*x/2.4))/(pi*x/2.4+0.0001))^2};", "\\end{axis}", "\\end{tikzpicture}", "", "{\\small 一次一个地让电子通过双缝。每个电子都以一个点", "到达某处（左上）；这些点在双缝波强的地方聚集", "（左下），其分布遵循概率密度 $|\\psi|^2$，该密度对应于", "穿过两条狭缝的振幅（右图）。此图样对光子、中子和", "分子同样成立。}", "\\end{omfigure}", "", "\\section{振幅、概率与不确定性原理}", "", "\\begin{definition}[波函数]\\label{def:b1:quantum-introduction:wavefunction}", "\\index{波函数}\\index{概率密度}", "粒子的状态由\\emph{波函数}", "$\\psi(x, t)$（复值），使得 $|\\psi(x, t)|^2\\,\\dd x$ 是", "粒子在观测时位于 $x$ 与 $x + \\dd x$ 之间的概率，", "且 $|\\psi|^2$ 为\\emph{概率密度}，并满足 $\\int|\\psi|^2\\dd x =", "1$。振幅可相加（叠加）：若两条路径到达同一点，", "则 $\\psi = \\psi_1 + \\psi_2$，且 $|\\psi|^2 = |\\psi_1|^2 + |\\psi_2|^2 +", "2\\,\\mathrm{Re}(\\psi_1^\\ast\\psi_2)$——末项即为干涉项。", "测量给出可能结果之一，结果随机出现，概率由振幅决定，", "并使粒子处于所测得的", "状态。", "\\end{definition}", "", "\\begin{remark}[什么在波动]\\label{rem:b1:quantum-introduction:whatwaves}", "$\\psi$ 不像 $\\vect E$ 那样是物理场：它本身不被测量，只有", "其模的平方可以测得，它描述的是我们对粒子", "将在何处被找到的最佳可能认识。单个电子并非", "铺展在屏幕上；它整体地在某一点被探测到，铺展的是", "概率。这正是理论的内容，它从未在检验中失败", "过。", "\\end{remark}", "", "\\begin{theorem}[海森堡不确定性原理]\\label{thm:b1:quantum-introduction:heisenberg}", "\\index{不确定性原理}", "同一轴上粒子的位置与动量不能", "同时被精确确定：在任意状态下，它们的标准差满足", "\\[", "\\Delta x\\,\\Delta p_x \\geq \\frac{\\hbar}{2} .", "\\]", "因此，被限制在线度为 $\\ell$ 的区域内的粒子，其动量的不确定度", "至少为 $\\hbar/2\\ell$，由此动能的量级为", "$\\hbar^2/2m\\ell^2$，任何冷却都无法消除：限制空间需要付出能量。", "\\end{theorem}", "\\admitted", "", "\\begin{example}[氢原子的大小]\\label{ex:b1:quantum-introduction:hsize}", "\\index{玻尔半径}", "距质子在 $r$ 以内的电子，其 $p \\gtrsim \\hbar/r$，能量为", "$E(r) \\approx \\dfrac{\\hbar^2}{2m_er^2} - \\dfrac{e^2}{4\\pi\\varepsilon_0r}$：第一项", "在 $r$ 减小时趋于无穷大，第二项则在它增大时趋于无穷大。令 $\\dd E/\\dd r = 0$，得", "\\[", "a_0 = \\frac{4\\pi\\varepsilon_0\\hbar^2}{m_ee^2} = \\qty{53}{pm} , \\qquad", "E(a_0) = -\\frac{m_ee^4}{2(4\\pi\\varepsilon_0)^2\\hbar^2} = \\qty{-13.6}{eV} :", "\\]", "即\\emph{玻尔半径}与氢原子的电离能，精确到", "最后一位数字。经典物理无法解释为何电子不会螺旋", "落入原子核（它会辐射），也无法解释同一元素的所有", "原子为何完全相同；不确定性原理一行之内即可回答两者：", "原子的大小，是在动能不超过束缚能的前提下", "所能达到的最小尺度。", "\\end{example}", ""]}