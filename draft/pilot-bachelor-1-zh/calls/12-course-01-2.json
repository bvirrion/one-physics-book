\u4f53 $B$\uff0c\u5219 $B$ \u65bd\u529b $\\vect F_{B\\to A} = -\\vect F_{A\\to B}$\n51|         \u4e8e $A$\uff0c\u6cbf\u4e8c\u8005\u8fde\u7ebf\u65b9\u5411\u3002\n52|=\n53|=\n54|=\n55|=\n56| \\begin{remark}[\u5b9a\u5f8b\u7684\u542b\u4e49]\\label{rem:b1:newton-dynamics:meaning}\n57| \u7b2c\u4e00\u5b9a\u5f8b\u5e76\u975e\u7b2c\u4e8c\u5b9a\u5f8b\u7684\u7279\u4f8b\uff1a\u5b83\\emph{\u89c4\u5b9a}\u4e86\n58| \u7b2c\u4e8c\u5b9a\u5f8b\u6210\u7acb\u7684\u53c2\u8003\u7cfb\u3002\u5b9e\u9645\u4e0a\uff0c\u5bf9\u4e8e\u6301\u7eed\u6570\u5206\u949f\u7684\u5b9e\u9a8c\uff0c\n59| \u5730\u7403\u4e0a\u7684\u5b9e\u9a8c\u5ba4\u53ef\u89c6\u4e3a\u60ef\u6027\u7cfb\uff0c\u7cbe\u5ea6\u6781\u9ad8\uff08\u8bef\u5dee\u89c1\n60| \\cref{ch:b1:non-inertial-frames}\uff09\uff1b\u4e0e\u592a\u9633\u53ca\u9065\u8fdc\u6052\u661f\u76f8\u56fa\u8fde\u7684\u53c2\u8003\u7cfb\u5219\u66f4\u4e3a\u7cbe\u786e\u3002\n61| \u7b2c\u4e8c\u5b9a\u5f8b\u662f\u4e00\u4e2a\u77e2\u91cf\u65b9\u7a0b\uff0c\u7b49\u4ef7\u4e8e\u4e09\u4e2a\u6807\u91cf\u65b9\u7a0b\uff0c\u6bcf\u4e2a\u5750\u6807\u8f74\u4e00\u4e2a\uff0c\n62| \u9009\u53d6\u5750\u6807\u8f74\uff08\u89c1\\cref{ch:b1:point-kinematics}\uff09\n63| \u662f\u6bcf\u4e2a\u95ee\u9898\u7684\u7b2c\u4e00\u6b65\u51b3\u5b9a\u3002\n64| \u7b2c\u4e09\u5b9a\u5f8b\u5728\u672c\u518c\u6240\u6d89\u53ca\u7684\u63a5\u89e6\u529b\u4e0e\u5f15\u529b\u4e2d\uff0c\n65| \u6bcf\u4e00\u65f6\u523b\u90fd\u6210\u7acb\u3002\n66|=\n67|=\n68| \\begin{definition}[\u5c01\u95ed\u7cfb\u7edf\uff1b\u52a8\u91cf\u5b88\u6052]\\label{def:b1:newton-dynamics:conservation}\n69| \\index{\u5c01\u95ed\u7cfb\u7edf}\\index{\u52a8\u91cf\u5b88\u6052}\n70| \\emph{\u5c01\u95ed\u7cfb\u7edf}\u4e0e\u5916\u754c\u4e0d\u4ea4\u6362\u7269\u8d28\u3002\u5bf9\u4e8e\n71| \u8d28\u70b9\u7cfb\uff0c\u5185\u529b\u4e24\u4e24\u76f8\u6d88\uff08\u7b2c\u4e09\u5b9a\u5f8b\uff09\uff0c\n72| \u7cfb\u7edf\u7684\u603b\u52a8\u91cf $\\vect P = \\sum m_i\\vect v_i$ \u6ee1\u8db3\n73| $\\dd\\vect P/\\dd t = \\sum\\vect F_{\\mathrm{ext}}$\uff1a\u5f53\u5916\u529b\u4e3a\u96f