 "result": "1| \\chapter{\u6b63\u5f26\u7a33\u6001\u4e0e\u963b\u6297}\\label{ch:b1:sinusoidal-impedance}\n2|=\n3| \u8f6c\u52a8\u8001\u5f0f\u6536\u97f3\u673a\u7684\u8c03\u8c10\u65cb\u94ae\uff0c\u5728\u540c\u65f6\u62b5\u8fbe\u5929\u7ebf\u7684\u4e0a\u767e\u4e2a\u7535\u53f0\u4e2d\uff0c\n4| \u53ea\u6709\u4e00\u4e2a\u7535\u53f0\u80fd\u591f\u901a\u8fc7\uff1a\u7ebf\u5708\u4e0e\u53ef\u53d8\u7535\u5bb9\u5668\u5df2\u88ab\u8c03\u8c10\uff0c\n5| \u6070\u597d\u53ea\u6709\u4e00\u4e2a\u9891\u7387\u80fd\u4f7f\u5b83\u4eec\u53d1\u751f\u5171\u632f\u3002\n6| \u6bcf\u9762\u5899\u91cc\u55e1\u55e1\u4f5c\u54cd\u7684\u5e02\u7535\u662f \\qty{50}{Hz} \u7684\u6b63\u5f26\u91cf\uff1b\n7| \u7528\u5b83\u9a71\u52a8\u5927\u578b\u7535\u52a8\u673a\u7684\u5de5\u5382\uff0c\u82e5\u5176\u7535\u6d41\n8| \u6ede\u540e\u4e8e\u7535\u538b\u8fc7\u591a\uff0c\u5c31\u8981\u88ab\u7f5a\u6b3e\u3002\u6b63\u5f26\u91cf\u662f\u7ebf\u6027\u7535\u8def\u7684\n9| \u201c\u81ea\u7136\u8bed\u8a00\u201d\u2014\u2014\u8f93\u51fa\u4e0e\u8f93\u5165\u5f62\u5f0f\u76f8\u540c\uff0c\u53ea\u662f\u5e45\u5ea6\u88ab\u7f29\u653e\u3001\u76f8\u4f4d\u88ab\u5e73\u79fb\uff0c\n10| \u5e76\u7531\u6b64\u7ed9\u51fa\u5b83\u4eec\u7684\u4ee3\u6570\u65b9\u6cd5\uff1a\u590d\u632f\u5e45\u3001\n11| \u963b\u6297\u3001RLC \u7535\u8def\u7684\u5171\u632f\uff0c\u4ee5\u53ca\u6b63\u5f26\u7535\u6d41\n12| \u5b9e\u9645\u8f93\u9001\u7684\u529f\u7387\u3002\n13|=\n14|=\n15|=\n16|=\n17| {\\small \u793a\u6ce2\u5668\u663e\u793a\u7684\u4e00\u4e2a\u6b63\u5f26\u6ce2\u548c\u4e00\u4e2a\u65b9\u6ce2\uff1a\u6b63\u5f26\u6ce2\u662f\u672c\u7ae0\u7814\u7a76\u7684\u4fe1\u53f7\uff0c\u65b9\u6ce2\u5219\u662f\u4e0b\u4e00\u7ae0\u8981\u5206\u89e3\u4e3a\u6b63\u5f26\u91cf\u7684\u4fe1\u53f7\u3002}\n18|=\n19|=\n20|\\section{\u6b63\u5f26\u7a33\u6001}\n21|=\n22|\\begin{proposition}[\u5f3a\u8feb\u6b63\u5f26\u8fd0\u884c\u72b6\u6001]\\label{prop:b1:sinusoidal-impedance:forced}\n23|\\index{\u6b63\u5f26\u7a33\u6001}\\index{\u5f3a\u8feb\u8fd0\u884c\u72b6\u6001}\n24|\u5728\u7531\u6b63\u5f26\u6e90\u9a71\u52a8\u7684\u7ebf\u6027\u7535\u8def\u4e2d\uff0c\u8be5\u6e90\u7684\u89d2\u9891\u7387\u4e3a\n25|$\\omega$\uff0c\u5f85\u6682\u6001\u8870\u51cf\u5b8c\u6bd5\u540e\uff0c\u6bcf\u4e2a\u7535\u6d41\u548c\u7535\u538b\u90fd\u662f\n26|\u89d2\u9891\u7387\u540c\u4e3a $\\omega$ \u7684\u6b63\u5f26\u91cf\uff0c\u5404\u81ea\u6709\u81ea\u5df1\u7684\u5e45\u503c\u4e0e\u76f8\u4f4d\uff1a\n27|$x(t) = X\\cos(\\omega t + \\varphi)$\u3002\n28|\\end{proposition}\n29|=\n30|\\begin{proof}\n31|\u7535\u8def\u65b9\u7a0b\u662f\u5e38\u7cfb\u6570\u7ebf\u6027\u5fae\u5206\u65b9\u7a0b\uff0c\n32|\u5176\u901a\u89e3\u7b49\u4e8e\u4e00\u4e2a\u7279\u89e3\u52a0\u4e0a\u9f50\u6b21\u65b9\u7a0b\u7684\u89e3\uff0c\n33|\u9f50\u6b21\u65b9\u7a0b\u7684\u89e3\u5373\n34|\u5728\\cref{ch:b1:transient-regimes}\u4e2d\u7684\u6682\u6001\uff0c\u5b83\u4eec\u4f1a\u8870\u51cf\uff08\u6bcf\u4e2a\u5b9e\u9645\u7535\u8def\u90fd\u5177\u6709\n35|\u4e00\u5b9a\u7535\u963b\uff09\u3002\u6b63\u5f26\u7279\u89e3\u5b58\u5728\uff0c\u56e0\u4e3a\n36|\u5bf9\u9891\u7387\u4e3a $\\omega$ \u7684\u6b63\u5f26\u91cf\u6c42\u5bfc\uff0c\u6240\u5f97\u4ecd\u662f\n37|\u540c\u9891\u7387\u7684\u6b63\u5f26\u91cf\uff1a\u65b9\u7a0b\u53ef\u9010\u9879\u6ee1\u8db3\u2014\u2014\n38|\u4e0b\u9762\u7684\u590d\u6570\u65b9\u6cd5\u5c06\u663e\u5f0f\u5730\u6784\u9020\u51fa\u8fd9\u4e00\u7279\u89e3\u3002\n39|\\end{proof}\n40|=\n41|\\begin{definition}[\u590d\u632f\u5e45]\\label{def:b1:sinusoidal-impedance:complex}\n42|\\index{\u590d\u632f\u5e45}\\index{\u76f8\u91cf}\n43|\u5bf9\u4e8e\u6b63\u5f26\u91cf $x(t) = X\\cos(\\omega t + \\varphi)$\uff0c\u53ef\u5bf9\u5e94\u4e00\u4e2a\n44|\u590d\u4fe1\u53f7 $\\underline{x}(t) = X\\eu^{j(\\omega t + \\varphi)}$\uff0c\u4f7f\u5f97\n45|$x = \\Rea(\\underline{x})$\uff0c\u5e76\u79f0\\emph{\u590d\u632f\u5e45}\n46|=\n47|=\n48|=\n49|\u5b83\u5305\u542b\u5e45\u503c $X = \\abs{\\underline{X}}$ \u4e0e\u76f8\u4f4d\n50|$\\varphi = \\arg\\underline{X}$\u3002\u8fd9\u91cc $j$ \u8868\u793a\u865a\u5355\u4f4d\uff0c\n51|$j^2 = -1$\uff0c\u5b57\u6bcd $i$ \u7559\u7ed9\u7535\u6d41\u3002\u4ee5\u957f\u5ea6\u4e3a\n52|$X$\u3001\u4e0e\u5b9e\u8f74\u5939\u89d2\u4e3a $\\varphi$ \u7684\u77e2\u91cf\u8868\u793a $\\underline{X}$ \u65f6\uff0c\n53|\u5b83\u79f0\u4e3a\\emph{\u76f8\u91cf}\uff08\u83f2\u6d85\u8033\u77e2\u91cf\uff09\u3002\n54|\\end{definition}\n55|=\n56|\\begin{proposition}[\u590d\u6570\u65b9\u6cd5\u7684\u8fd0\u7b97\u6cd5\u5219]\\label{prop:b1:sinusoidal-impedance:rules}\n57|=\n58|  \\item \u7ebf\u6027\u8fd0\u7b97\u4e0e\u53d6\u5b9e\u90e8\u53ef\u4ee5\u4ea4\u6362\u6b21\u5e8f\uff1a\n59|        \u548c\u7684\u590d\u632f\u5e45\u7b49\u4e8e\u5404\u590d\u632f\u5e45\u4e4b\u548c\u3002\n60|  \\item \u5bf9\u65f6\u95f4\u6c42\u5bfc\uff0c\u590d\u632f\u5e45\u4e58\u4ee5 $j\\omega$\uff1b\n61|        \u5bf9\u65f6\u95f4\u79ef\u5206\u5219\u9664\u4ee5 $j\\omega$\u3002\n62|  \\item \u57fa\u5c14\u970d\u592b\u5b9a\u5f8b\u662f\u7ebf\u6027\u7684\uff0c\u5bf9\u590d\u632f\u5e45\u540c\u6837\u6210\u7acb\u3002\n63|=\n64|\\end{proposition}\n65|=\n66|=\n67|=\n68|=\n69|$\\dd x/\\dd t = \\Rea(\\dd\\underline x/\\dd t)$\uff0c\u56e0\u4e3a\u5fae\u5206\u662f\u5b9e\u7ebf\u6027\u7684\uff1b\n70|\u8282\u70b9\u5904\u7535\u6d41\u4e4b\u548c\u4e0e\u6cbf\u56de\u8def\u7684\u7535\u538b\u4e4b\u548c\n71|\u90fd\u662f\u7ebf\u6027\u7684\u3002\n72|=\n73|=\n74|\\begin{example}[\u4e24\u4e2a\u6b63\u5f26\u91cf\u76f8\u52a0]\\label{ex:b1:sinusoidal-impedance:add}\n75|$3\\cos\\omega t + 4\\sin\\omega t$\uff1a\u4e24\u8005\u7684\u590d\u632f\u5e45\u5206\u522b\u4e3a $3$ \u548c\n76|$4\\eu^{-j\\pi/2} = -4j$\uff08\u56e0\u4e3a $\\sin\\omega t = \\cos(\\omega t - \\pi/2)$\uff09\uff1b\n77|\u5b83\u4eec\u4e4b\u548c $3 - 4j$ \u7684\u6a21\u4e3a $5$\uff0c\u8f90\u89d2\u4e3a $-0.927\\ \\unit{rad}$\uff1a\n78|$5\\cos(\\omega t - 0.927)$\u3002\u65e0\u9700\u4f7f\u7528\u4e09\u89d2\u6052\u7b49\u5f0f\u3002\n79|=\n80|=\n81|\\section{\u963b\u6297}\n82|=\n83|\\begin{definition}[\u963b\u6297\u3001\u5bfc\u7eb3]\\label{def:b1:sinusoidal-impedance:impedance}\n84|\\index{\u963b\u6297}\\index{\u5bfc\u7eb3}\\index{\u7535\u6297}\n85|\u5bf9\u4e8e\u5904\u4e8e\u6b63\u5f26\u7a33\u6001\u7684\u7ebf\u6027\u4e8c\u7aef\u5143\u4ef6\uff08\u91c7\u7528\n86|\u5173\u8054\u53c2\u8003\u65b9\u5411\uff09\uff0c\\emph{\u963b\u6297}\u4e3a\u590d\u632f\u5e45\u4e4b\u6bd4\uff1a\n87|=\n88|=\n89|\\quad (\\text{\u6b27\u59c6}),\n90|=\n91|\u5176\u6a21 $Z = U/I$ \u8054\u7cfb\u4e24\u8005\u7684\u5e45\u503c\uff0c\u5176\u8f90\u89d2\n92|$\\varphi = \\varphi_u - \\varphi_i$ \u5373\u7535\u538b\u8d85\u524d\u4e8e\n93|\u7535\u6d41\u7684\u76f8\u4f4d\u5dee\u3002\u5176\u5012\u6570 $\\underline Y = 1/\\underline Z$ \u79f0\u4e3a\n94|\\emph{\u5bfc\u7eb3}\uff08\u5355\u4f4d\uff1a\u897f\u95e8\u5b50\uff09\u3002$\\underline Z$ \u7684\u5b9e\u90e8\u79f0\u4e3a\u5176\n95|\u7535\u963b\uff0c\u865a\u90e8\u79f0\u4e3a\u5176\\emph{\u7535\u6297}\u3002\n96|\\end{definition}\n97|=\n98|\\begin{proposition}[R\u3001L\u3001C \u7684\u963b\u6297]\\label{prop:b1:sinusoidal-impedance:rlc}\n99|=\n100|=\n101|=\n102|=\n103|\u7535\u963b\u4f7f\u7535\u538b\u4e0e\u7535\u6d41\u540c\u76f8\uff1b\u7ebf\u5708\u4e2d\u7684\u7535\u538b\n104|\u8d85\u524d\u7535\u6d41 $\\pi/2$\uff1b\u7535\u5bb9\u5668\u4e2d\u7684\u7535\u538b\u6ede\u540e $\\pi/2$\u3002\u4f4e\u9891\u65f6\n105|\u7ebf\u5708\u8d8b\u4e8e\u5bfc\u7ebf\uff0c\u7535\u5bb9\u5668\u8d8b\u4e8e\u65ad\u5f00\u7684\u7535\u8def\uff1b\n106|\u9ad8\u9891\u65f6\u5219\u76f8\u53cd\u3002\n107|\\end{proposition}\n108|=\n109|=\n110|=\n111|$i = C\\,\\dd u/\\dd t \\to \\underline I = jC\\omega\\,\\underline U$\u3002\n112|\u5176\u4e2d $1$\u3001$j$\u3001$-j$ \u7684\u8f90\u89d2\u4f9d\u6b21\u4e3a $0$\u3001$\\pi/2$\u3001$-\\pi/2$\u3002\n113|=\n114|=",
