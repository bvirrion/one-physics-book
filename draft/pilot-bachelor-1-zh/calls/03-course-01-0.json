u6210\u50cf}\u7684\uff0c$A'$ \u79f0\u4e3a $A$ \u7684\\emph{\u50cf}\u3002\u82e5\u51fa\u5c04\u5149\u7ebf\u786e\u5b9e\u76f8\u4ea4\u4e8e $A'$\uff08\u53ef\u4ee5\u5728\u5c4f\u5e55\u4e0a\u63a5\u6536\u5230\uff09\uff0c\u5219\u79f0\u8be5\u50cf\u4e3a\\emph{\u5b9e\u50cf}\uff1b\u82e5\u53ea\u6709\u51fa\u5c04\u5149\u7ebf\u7684\u53cd\u5411\u5ef6\u957f\u7ebf\u76f8\u4ea4\u4e8e $A'$\uff08\u9700\u900f\u8fc7\u7cfb\u7edf\u89c2\u770b\uff0c\u65e0\u6cd5\u6295\u5f71\u5230\u5c4f\u5e55\u4e0a\uff09\uff0c\u5219\u79f0\u4e3a\\emph{\u865a\u50cf}\u3002\u7c7b\u4f3c\u5730\uff0c\u82e5\u5165\u5c04\u5149\u7ebf\u4ece $A$ \u53d1\u6563\uff0c\u5219\u7269\u4e3a\u5b9e\u7269\uff1b\u82e5\u5165\u5c04\u5149\u7ebf\u5728\u7cfb\u7edf\u5165\u53e3\u4e4b\u540e\u4f1a\u805a\u4e8e $A$\uff0c\u5219\u7269\u4e3a\u865a\u7269\u3002\u6570\u5bf9 $(A, A')$ \u79f0\u4e3a\\emph{\u5171\u8f6d}\u7684\u3002\n31| \\end{definition}\n32|=\n33| \\begin{definition}[\u5171\u8f74\u7cfb\u7edf\uff1b\u9ad8\u65af\u6761\u4ef6]\\label{def:b1:mirrors-thin-lenses:gauss}\n34| \\index{optical axis}\\index{Gauss conditions}\\index{paraxial ray}\n35| \u4e00\u4e2a\\emph{\u5171\u8f74\u7cfb\u7edf}\u5177\u6709\u65cb\u8f6c\u5bf9\u79f0\u8f74\uff0c\u79f0\u4e3a\\emph{\u5149\u8f74}\u3002\u63a5\u8fd1\u5149\u8f74\u3001\u4e0e\u5149\u8f74\u5939\u5c0f\u89d2\u5ea6\u7684\u5149\u7ebf\u79f0\u4e3a\\emph{\u8fd1\u8f74\u5149\u7ebf}\uff1b\u4ec5\u5728\u8fd1\u8f74\u5149\u7ebf\u4e0b\u4f7f\u7528\u7684\u7cfb\u7edf\uff0c\u79f0\u5176\u6ee1\u8db3\\emph{\u9ad8\u65af\u6761\u4ef6}\u3002\u5728\u8fd9\u4e9b\u6761\u4ef6\u4e0b\uff0c\u5171\u8f74\u7cfb\u7edf\u5bf9\u6bcf\u4e2a\u70b9\u90fd\u8fd1\u4f3c\u4e25\u683c\u6210\u50cf\uff0c\u4e14\u4e0e\u5149\u8f74\u5782\u76f4\u7684\u7269\u5e73\u9762\u5bf9\u5e94\u4e0e\u5149\u8f74\u5782\u76f4\u7684\u50cf\u5e73\u9762\uff08\\emph{\u9f50\u660e}\uff09\u3002\n41|=\n42| \\end{definition}\n43| \\admitted\n44|=\n45| \\begin{remark}[\u4e3a\u4f55\u8981\u6c42\u5c0f\u89d2\u5ea6]\\label{rem:b1:mirrors-thin-lenses:why}\n46| \u5e73\u9762\u955c\u662f\u552f\u4e00\u5bf9\u6bcf\u4e2a\u70b9\u90fd\u4e25\u683c\u6210\u50cf\u7684\u7b80\u5355\u7cfb\u7edf\u3002\u7403\u9762\u955c\u6216\u900f\u955c\u53ea\u6709\u5728 $\\sin\\theta \\approx \\tan\\theta \\approx \\theta$ \u7684\u8303\u56f4\u5185\u624d\u8fd1\u4f3c\u6210\u50cf\uff1a\n47| \u6b63\u662f\u8fd9\u4e00\u8fd1\u4f3c\uff0c\u4f7f\u65af\u6d85\u8033\u5b9a\u5f8b\u5316\u4e3a\u8ddd\u79bb\u4e4b\u95f4\u7684\u7ebf\u6027\u5173\u7cfb\u3002\u8d85\u51fa\u6b64\u8303\u56f4\uff0c\u70b9\u7684\u50cf\u4fbf\u4f1a\u6a21\u7cca\uff08\\emph{\u50cf\u5dee}\uff09\uff0c\u8bbe\u8ba1\u8005\u7684\u4efb\u52a1\u2014\u2014\u5149\u9611\u3001\u900f\u955c\u7ec4\u5408\u3001\u975e\u7403\u9762\u2014\u2014\u5c31\u662f\u628a\u6a21\u7cca\u538b\u4f4e\u5230\u773c\u775b\u6216\u4f20\u611f\u5668\u65e0\u6cd5\u5206\u8fa8\u7684\u7a0b\u5ea6\u3002\n53|=\n54| \\end{remark}\n55|=\n56| \\begin{notation}[\u4ee3\u6570\u91cf\u4e0e\u653e\u5927\u7387]\\label{not:b1:mirrors-thin-lenses:signs}\n57| \\index{algebraic measure}\\index{transverse magnification}\n58| \u5149\u8f74\u7684\u65b9\u5411\u53d6\u5165\u5c04\u5149\u7684\u65b9\u5411\uff1b\u6a2a\u5411\u65b9\u5411\u53d6\u5411\u4e0a\u3002\u5bf9\u5149\u8f74\u4e0a\u7684\u70b9 $P$\u3001$Q$\uff0c$\\overline{PQ}$ \u8868\u793a\u4ee3\u6570\u91cf\uff08\u82e5 $Q$ \u4f4d\u4e8e $P$ \u7684\u4e0b\u6e38\uff0c\u5219 $\\overline{PQ} > 0$\uff09\uff1b\u5bf9\u4e0e\u5149\u8f74\u5782\u76f4\u7684\u7269 $AB$ \u53ca\u5176\u50cf $A'B'$\uff0c\\emph{\u6a2a\u5411\u653e\u5927\u7387}\u4e3a\n63| \\[\n64| \\gamma = \\frac{\\overline{A'B'}}{\\overline{AB}} ,\n65| \\]\n66| \u5012\u7acb\u7684\u50cf\u5176\u653e\u5927\u7387\u4e3a\u8d1f\uff0c\u653e\u5927\u7684\u50cf\u5176\u7edd\u5bf9\u503c\u5927\u4e8e $1$\u3002\n68| \\end{notation}\n69|=\n70| \\section{\u7403\u9762\u955c}\n71|=\n72| \\begin{definition}[\u7403\u9762\u955c]\\label{def:b1:mirrors-thin-lenses:mirror}\n73| \\index{spherical mirror}\\index{concave mirror}\\index{convex mirror}\\index{focus}\n74| \\emph{\u7403\u9762\u955c}\u662f\u7403\u51a0\u5f62\u7684\u53cd\u5c04\u9762\uff0c\u7403\u5fc3\u4e3a $C$\uff0c\u9876\u70b9\u4e3a $S$\uff08\u5373\u5176\u4e0e\u5149\u8f74\u7684\u4ea4\u70b9\uff09\u3002\u82e5\u5149\u7ebf\u7167\u5728\u51f9\u9762\u4e00\u4fa7\uff08$C$ \u4f4d\u4e8e\u5165\u5c04\u5149\u4e00\u4fa7\uff09\uff0c\u5219\u79f0\u4e3a\\emph{\u51f9\u9762\u955c}\uff1b\u5426\u5219\u79f0\u4e3a\\emph{\u51f8\u9762\u955c}\u3002\u5176\\emph{\u7126\u70b9} $F$ \u662f\u5149\u8f74\u4e0a\u65e0\u7a77\u8fdc\u70b9\u7684\u50cf\uff1b\u7126\u8ddd\u4e3a $f = \\overline{SF}$\u3002\n79|=\n80|=\n81| \\begin{proposition}[\u7403\u9762\u955c\u7684\u7126\u70b9]\\label{prop:b1:mirrors-thin-lenses:focus}\n82| \u5728\u9ad8\u65af\u6761\u4ef6\u4e0b\uff0c\u7126\u70b9\u4e3a $SC$ \u7684\u4e2d\u70b9\uff1a\n83| $\\overline{SF} = \\overline{SC}/2$\u3002\u51f9\u9762\u955c\u7684 $f < 0$\uff08\u7126\u70b9\u4e3a\u5b9e\u7126\u70b9\uff0c\u4f4d\u4e8e\u524d\u65b9\uff09\uff1b\u51f8\u9762\u955c\u7684 $f > 0$\uff08\u7126\u70b9\u4e3a\u865a\u7126\u70b9\uff0c\u4f4d\u4e8e\u540e\u65b9\uff09\u3002\n85| \\end{proposition}\n86|=\n87| \\begin{proof}\n88| \u4e00\u6761\u5e73\u884c\u4e8e\u5149\u8f74\u3001\u9ad8\u5ea6\u4e3a $h$ \u7684\u5149\u7ebf\u5728 $I$ \u5904\u5c04\u5230\u955c\u9762\u4e0a\uff1b$I$ \u5904\u7684\u6cd5\u7ebf\u5373\u534a\u5f84 $CI$\uff0c\u5b83\u4e0e\u5149\u8f74\u5939\u89d2\u4e3a $\\alpha$\uff0c$\\sin\\alpha = h/R$\u3002\n89| \u5149\u7ebf\u4ee5\u4e0e\u6cd5\u7ebf\u6210\u76f8\u540c\u89d2\u5ea6 $\\alpha$ \u53cd\u5c04\u540e\uff0c\u4e0e\u5149\u8f74\u76f8\u4ea4\u4e8e $F$\uff1b\u4e09\u89d2\u5f62 $CIF$ \u5728 $C$ \u4e0e $I$ \u5904\u7684\u89d2\u5747\u4e3a $\\alpha$\uff0c\u6545 $CF = IF$\uff0c\u6295\u5f71\u53ef\u5f97 $CF = R/(2\\cos\\alpha)$\u3002\n90| \u5bf9\u8fd1\u8f74\u5149\u7ebf $\\cos\\alpha \\to 1$\uff0c\u4e8e\u662f $CF = R/2$\uff1a\u6240\u6709\u6b64\u7c7b\u5149\u7ebf\u90fd\u4e0e\u5149\u8f74\u4ea4\u4e8e\u540c\u4e00\u70b9\uff0c\u5373 $SC$ \u7684\u4e2d\u70b9\u3002\u7b26\u53f7\u65b9\u9762\uff1a\u5bf9\u51f9\u9762\u955c\uff0c$C$ \u4e0e $F$ \u4f4d\u4e8e\u524d\u65b9\uff08\u4e0a\u6e38\uff09\uff0c$\\overline{SC} < 0$\u3002\n97|=\n98|=\n99| \\begin{theorem}[\u7403\u9762\u955c\u7684\u5171\u8f6d\u5173\u7cfb]\\label{thm:b1:mirrors-thin-lenses:mirrorconj}\n100| \\index{conjugation relation!spherical mirror}\n101| \u5728\u9ad8\u65af\u6761\u4ef6\u4e0b\uff0c\u5149\u8f74\u4e0a\u70b9 $A$ \u7684\u50cf $A'$ \u6ee1\u8db3\n103| \\[\n104| \\frac{1}{\\overline{SA'}} + \\frac{1}{\\overline{SA}} = \\frac{2}{\\overline{SC}}\n105| = \\frac{1}{\\overline{SF}},\n106| \\qquad\n107| \\gamma = -\\frac{\\overline{SA'}}{\\overline{SA}} .\n108| \\]\n109| \\end{theorem}\n110|=",
