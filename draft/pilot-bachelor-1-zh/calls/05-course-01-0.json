3f7]\\label{def:b1:wave-propagation:signal}\n24|\\index{\u4fe1\u53f7}\\index{\u6b63\u5f26\u4fe1\u53f7}\\index{\u632f\u5e45}\\index{\u76f8\u4f4d}\\index{\u89d2\u9891\u7387}\n25|\\emph{\u4fe1\u53f7}\u662f\u968f\u65f6\u95f4\u53d8\u5316\u5e76\u643a\u5e26\u4fe1\u606f\u7684\u7269\u7406\u91cf\uff0c\u4f8b\u5982\uff1a\n26|\u4f20\u58f0\u5668\u5904\u7684\u58f0\u8d85\u538b\u3001\u5929\u7ebf\u5904\u7684\u7535\u538b\u3001\n27|\u5f26\u4e0a\u67d0\u70b9\u7684\u6a2a\u5411\u4f4d\u79fb\u3002\n28|\\emph{\u6b63\u5f26\u4fe1\u53f7}\u4e3a\n29|=\n30|=\n31|=\n32|\u5176\\emph{\u632f\u5e45}\u4e3a $A > 0$\uff0c\\emph{\u89d2\u9891\u7387}\u4e3a $\\omega$\n33|\uff08\\unit{rad/s}\uff09\uff0c\\emph{\u9891\u7387}\u4e3a $f = \\omega/2\\pi$\uff0c\\emph{\u5468\u671f}\n34|\u4e3a $T = 1/f$\uff0c\\emph{\u521d\u76f8\u4f4d}\u4e3a $\\varphi$\uff1b$\\omega t + \\varphi$ \u662f\n35|\u65f6\u523b $t$ \u7684\\emph{\u76f8\u4f4d}\u3002\n36|\\end{definition}\n37|=\n38|\\begin{remark}[\u9891\u8c31]\\label{rem:b1:wave-propagation:spectrum}\n39|\\index{\u9891\u8c31!\u4fe1\u53f7\u7684}\\index{\u8c10\u6ce2}\n40|\u5468\u671f\u4e3a $T$ \u7684\u5468\u671f\u4fe1\u53f7\uff0c\u53ef\u8868\u793a\u4e3a\u82e5\u5e72\u6b63\u5f26\u4fe1\u53f7\u4e4b\u548c\uff0c\u5176\u9891\u7387\u4e3a\n41|$f_1 = 1/T$\uff08\\emph{\u57fa\u9891}\uff09\u53ca\u5176\u6574\u6570\u500d $nf_1$\uff08\n42|\\emph{\u8c10\u6ce2}\uff09\uff1b\u5b83\u4eec\u7684\u632f\u5e45\u5217\u8868\u5373\u4e3a\u8be5\u4fe1\u53f7\u7684\n43|\\emph{\u9891\u8c31}\u3002\u540c\u4e00\u97f3\u9ad8\u7684\u957f\u7b1b\u4e0e\u5c0f\u63d0\u7434\u5171\u4eab\n44|\u57fa\u9891\uff0c\u4f46\u9891\u8c31\u4e0d\u540c\u2014\u2014\u8fd9\u5c31\u662f\u97f3\u8272\u3002\u5085\u91cc\u53f6\u5206\u89e3\u5728\n45|\\cref{ch:b1:filters-transfer-functions}\u4e2d\u9648\u8ff0\u5e76\u4f7f\u7528\uff1b\u6b64\u5904\u5173\u5fc3\u5b83\uff0c\u662f\u56e0\u4e3a\n46|\u6b63\u5f26\u4fe1\u53f7\u7684\u4f20\u64ad\u5341\u5206\u7b80\u5355\uff0c\u5bf9\u6bcf\u4e2a\u6b63\u5f26\u4fe1\u53f7\u6210\u7acb\u7684\u7ed3\u8bba\uff0c\n47|\u7ecf\u53e0\u5