542c\u51fa\u3002\n93|\\end{example}\n94|=\n95|\\section{\u884c\u6ce2}\n96|=\n97|\\begin{definition}[\u884c\u6ce2\uff1b\u6ce2\u901f]\\label{def:b1:wave-propagation:travelling}\n98|\\index{\u884c\u6ce2}\\index{\u6ce2\u901f}\\index{\u975e\u8272\u6563\u4ecb\u8d28}\n99|\u6cbf\u67d0\u5750\u6807\u8f74\u5b9a\u4e49\u7684\u4fe1\u53f7 $s(x, t)$ \u79f0\u4e3a\\emph{\u884c\u6ce2}\uff0c\n100|\u5176\u6cbf $+x$ \u65b9\u5411\u4ee5\\emph{\u6ce2\u901f} $c$ \u4f20\u64ad\uff0c\u82e5\n101|=\n102|=\n103|=\n104|\u5bf9\u67d0\u4e2a\u51fd\u6570 $f$\uff08\u6216 $F$\uff09\u6210\u7acb\uff1a\u6ce2\u5f62\u4fdd\u6301\u4e0d\u53d8\u5730\u968f\u4e4b\n105|\u5e73\u79fb\uff0c\u5728\u65f6\u95f4 $\\Delta t$ \u5185\u5e73\u79fb\u4e86 $c\\,\\Delta t$\u3002\u6cbf $-x$ \u65b9\u5411\u4f20\u64ad\u7684\u6ce2\u4e3a\n106|$g(t + x/c)$\u3002\u82e5\u67d0\u4ecb\u8d28\u4e2d\u6bcf\u79cd\u5f62\u72b6\u90fd\u4ee5\n107|\u76f8\u540c\u7684 $c$ \u65e0\u7578\u53d8\u5730\u4f20\u64ad\uff0c\u5219\u8be5\u4ecb\u8d28\u79f0\u4e3a\\emph{\u975e\u8272\u6563\u7684}\u3002\n108|\\end{definition}\n109|=\n110|\\begin{proposition}[\u5ef6\u8fdf]\\label{prop:b1:wave-propagation:delay}\n111|\u5728 $x_2$ \u5904\u63a5\u6536\u5230\u7684\u4fe1\u53f7\uff0c\u5373\u5728 $x_1 < x_2$ \u5904\u53d1\u51fa\u7684\u4fe1\u53f7\uff0c\n112|\u5ef6\u8fdf $\\tau = (x_2 - x_1)/c$ \u540e\u7684\u7ed3\u679c\uff1a$s(x_2, t) = s(x_1, t - \\tau)$\u3002\n113|\\end{proposition}\n114|=",
