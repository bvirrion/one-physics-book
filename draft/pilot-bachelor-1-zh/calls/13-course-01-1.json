|=\n22|=\n23|\\section{\u529f\u4e0e\u529f\u7387}\n24|=\n25|\\begin{definition}[\u529b\u7684\u529f\u7387\u4e0e\u529f]\\label{def:b1:work-and-energy:work}\n26|\\index{\u529f\u7387}\\index{\u529f}\n27|\u529b\u7684\\emph{\u529f\u7387}\u662f\u4f5c\u7528\u4e8e\u8d28\u70b9\u4e0a\u7684\u529b $\\vect F$ \u4e0e\n28|\u8d28\u70b9\u901f\u5ea6 $\\vect v$ \u7684\u70b9\u79ef\uff0c\u5373\n29|=\n30|\\mathcal P = \\vect F\\cdot\\vect v \\qquad (\\text{\u74e6\u7279}),\n31|=\n32|\u800c\u529b\u7684\\emph{\u529f}\u5728\u65f6\u523b $t_1$ \u81f3 $t_2$ \u4e4b\u95f4\n33|\uff08\u4f4d\u7f6e\u4e3a $A$ \u4e0e $B$\uff09\u662f\u529f\u7387\u7684\u7d2f\u79ef\uff0c\n34|=\n35|=\n36|= \\int_A^B \\vect F\\cdot\\dd\\vect\\ell \\qquad (\\text{\u7126\u8033}),\n37|=\n38|\u5373\\emph{\u5143\u529f} $\\delta W = \\vect F\\cdot\\dd\\vect\\ell$ \u4e4b\u548c\uff0c\n39|\u6cbf\u8f68\u8ff9\u7684\u5143\u4f4d\u79fb\u4e3a $\\dd\\vect\\ell = \\vect v\\,\\dd t$\u3002\n40|\u529b\u6cbf\u8fd0\u52a8\u65b9\u5411\u63a8\u52a8\u65f6\u505a\u6b63\u529f\uff0c\n41|\uff08\\emph{\u52a8\u529b}\uff09\uff0c\u9006\u7740\u8fd0\u52a8\u65b9\u5411\u65f6\u505a\u8d1f\u529f\uff08\\emph{\u963b\u529b}\uff09\uff0c\u5782\u76f4\u65f6\n42|\u529f\u4e3a\u96f6\u3002\n43|=\n44|=\n45|\\begin{proposition}[\u5e38\u89c1\u7684\u529f]\\label{prop:b1:work-and-energy:works}\n46|=\n47|  \\item \u6052\u529b\uff1a$W_{A\\to B} = \\vect F\\cdot\\vect{AB}$\uff0c\u4e0e\n48|        \u8def\u5f84\u65e0\u5173\u3002\u91cd\u529b\uff1a$W = mg(z_A - z_B)$\uff0c$z$ \u7ad6\u76f4\u5411\u4e0a\u8ba1\u6570\u3002\n49|  \\item \u52b2\u5ea6\u7cfb\u6570\u4e3a $k$ \u7684\u5f39\u7c27\uff0c\u4f38\u957f\u91cf\u4ece $x_A$ \u53d8\u4e3a $x_B$\uff1a\n50|        $W = \\tfrac12 k(x_A^2 - x_B^2)$\u3002\n51|  \\item \u56fa\u5b9a\u8868\u9762\u7684\u6cd5\u5411\u529b\uff0c\u4ee5\u53ca\u7ef3\u5b50\u5f20\u529b\u4f5c\u7528\u4e8e\n52|        \u6cbf\u5782\u76f4\u4e8e\u8be5\u9762\u65b9\u5411\u8fd0\u52a8\u7684\u7269\u4f53\u4e0a\uff1a$W = 0$\uff08\u529b $\\perp$ \u4f4d\u79fb\uff09\u3002\n53|  \\item \u52a8\u646